# pc.rio: Rinc's host procs, the pc module. Apps don't import it: pc is there everywhere (pc.cls(0)).
# This is what pc is, written in Rio, and built into Rinc: each app compiles it first, against what
# rinc_start registers, so each declaration's types are checked, every host proc must be declared here,
# and the types they use (pc.Pointer) are here too. (Compiled images keep it, as part of the app.)

# ---------------------------------------------------------------- the screen: 320x240, palette indexes

cls* :: host proc(c: Int)                           # fill the screen with color c
pset* :: host proc(pos: [2]Int, c: Int)             # one pixel
pget* :: host proc(pos: [2]Int) -> Int
rect* :: host proc(pos, size: [2]Int, c: Int)       # a filled rectangle: its top left, and its size
rgb* :: host proc(c: Int) -> Int                    # color c of the palette, as 0xRRGGBB

# a rectangle on the screen: its top left and its size, in pixels
Rect* :: struct
  pos, size: [2]Int
end
Rect.of* :: static proc(pos, size: [2]Int) -> Rect do return {pos, size}   # Rect.of(at, {8, 8})
Rect.corner* :: proc() -> [2]Int do return self.pos + self.size   # just past its bottom right
Rect.has* :: proc(p: [2]Int) -> Bool                 # is p inside it
  q := p - self.pos
  return q.x >= 0 and q.y >= 0 and q.x < self.size.x and q.y < self.size.y
end
Rect.clip* :: proc(r: Rect) -> Rect                  # where the two overlap (an empty size if they don't)
  at := max(self.pos, r.pos)
  return Rect{pos = at, size = max(min(self.corner(), r.corner()) - at, 0)}
end
Rect.between* :: static proc(a, b: [2]Int) -> Rect   # from two corners, either way round, both inside it
  at := min(a, b)
  return Rect{pos = at, size = max(a, b) - at + 1}
end
# a picture: its pixels, a byte each, row by row (0: see-through), size.x to a row, and its size
Image* :: struct
  pixels: Blob
  size: [2]Int
end
# which part of a picture blit draws, and how; left out, the whole picture at its size
Blit* :: struct
  from: [2]Int  # the part's top left, in the picture
  size: [2]Int  # the part's size (a 0: the rest of the picture, that way)
  scale: [2]Int # each pixel so many wide and high (a 0: 1); negative mirrors it that way: {-1, 1}, left for right
end
# a picture, or part of it, as b says, its top left at at; color 0 is see-through: blit(image, {10, 20})
blit* :: host proc(image: Image, at: [2]Int, b?: Blit)
print* :: host proc(s: String, pos: [2]Int, c: Int)  # text at its top left, in the 5x8 font, 6 pixels a character

# ---------------------------------------------------------------- input

# 1 while button i is held: 0 left, 1 right, 2 up, 3 down (arrows), then the face buttons, as on an Xbox
# controller: 4 A (V key), 5 B (C), 6 X (X), 7 Y (Z); then a controller's 8 LB, 9 RB, 10 and 11 the
# sticks pressed in, 12 Start, 13 Back
btn* :: host proc(i: Int) -> Int
# the next key typed, or -1: 32-126 as typed, 13 Enter, 8 Backspace, 9 Tab, 27 Esc, Ctrl+letter as 1-26,
# and 128 left, 129 right, 130 up, 131 down, 132 Home, 133 End, 134 Delete, 135 Page Up, 136 Page Down,
# 140 to 151 F1 to F12 (where the Rinc gets them: a browser keeps some, F11 is the desktop's whole display);
# a key that isn't a character with the modifiers held added on: 256 Shift, 512 Ctrl, 1024 Alt; and
# 4096 + n, a command of the app's own picked from its list (Command, below)
key* :: host proc() -> Int
# the modifiers held now, as key() adds them: 256 Shift, 512 Ctrl, 1024 Alt (one locked, tapped twice, too;
# and in a pointer app, Pointer.ui, a controller's left trigger is Shift, its right one Ctrl); -1 where it
# can't tell (in a terminal): for a walk that goes on while Ctrl is held, as Ctrl+Tab's, and the d-pad
# with Shift, selecting
modsHeld* :: host proc() -> Int
# a controller's sticks: 0 left x, 1 left y, 2 right x, 3 right y; -1 to 1, + right and down
stick* :: host proc(i: Int) -> Float
trigger* :: host proc(i: Int) -> Float              # 0 left, 1 right; 0 to 1
time* :: host proc() -> Float                       # seconds since start
# a command, in the list the system key with P shows (or showCommands): an app's own come from its
# commandList* :: proc() -> []pc.Command, asked each time the list opens (up to 56 of them), and
# Rinc's are after them. Picking one types its key, as key() gives it next; while the list is up, the
# app waits (no update or draw)
Command* :: struct
  label: String # what it does: "Flip the sprite sideways" (38 characters show)
  keys: String  # its keys, as shown at the right: "H" ("" for none; 11 show)
  key: Int      # what picking it types: a key as key() gives it, or 4096 + n, a command of its own
end
showCommands* :: host proc()                        # the command list, after this frame (an app's own key for it)
# the pointer, which Rinc draws while it's shown: a mouse moving it or pressing a button shows it; typing,
# the arrows (the d-pad's too) and a controller's center buttons hide it. What it's for, pointer(mode):
Pointer* :: enum
  game  # (each app starts so) a mouse's only: the left stick is still the arrows
  ui    # a controller's too: its left stick moves it, its right one scrolls, A and B are its buttons
  none  # never shown
end
pointer* :: host proc(mode: Pointer)
pointerAt* :: host proc() -> [2]Int                 # where it points, in screen pixels: {x, y}
pointerX* :: host proc() -> Int                     # (its x, and its y, alone)
pointerY* :: host proc() -> Int
pointerDown* :: host proc(i: Int) -> Int            # 1 while button i is held: 0 primary, 1 secondary, 2 middle
pointerShown* :: host proc() -> Int
# the whole steps scrolled since it was last asked: 0 across, + right; 1 up and down, + up
scroll* :: host proc(i: Int) -> Int

# ---------------------------------------------------------------- data

# bytes from hex digits added to out (anything else in the text is skipped), until it's full: how many
fromHex* :: host proc(out: Blob[..], text: String) -> Int
# Rio code laid out the one way (as rio fmt does: only its spaces and line breaks change), added to out:
# how long, or -1 (too little room in out: nothing added) or -2 (it couldn't be sure of keeping the code
# the same)
formatRio* :: host proc(out: Blob[..], code: String) -> Int
# a module's source, in Rio, added to out, as much as fits (for an editor's completion): pc's (this), or
# core's (the builtins: Rio's core.rio); its whole length, or -1 for another
moduleSource* :: host proc(name: String, out: Blob[..]) -> Int
# an editor's completion, in two steps. checkRio: main (an app's main file, by its path: path itself if
# it's the one) checked, up to path's text, code: the file being edited as the editor has it, cut at the
# start of the cursor's line. Its compiler's tables go in room, the app's own memory, lent (60 KB is
# plenty): 0, or -1 (an error before the cut; rioError says what; the cut's own, missing 'end', is
# expected). It uses the session's place: a session is over
checkRio* :: host proc(main: String, path: String, code: String, room: Blob) -> Int
# then the names that fit at the end of line (the cursor's line, to the cursor), from what the check
# found (if room is as it left it), added to out, a line each: the name, a tab, what it is (k a word of
# Rio's, v a variable, c a constant, t a type, p a proc, m a method, f a field, M a module, e an enum's
# value), a tab, its type or signature. How long
completeRio* :: host proc(line: String, out: Blob[..]) -> Int

# ---------------------------------------------------------------- sound: 8 voices, 0 to 7

# how sound reads its data; left out, 16-bit mono at 16000 frames a second
Sound* :: struct
  bits: Int       # 16 or 8 (signed), or 4 for IMA ADPCM (0: 16)
  channels: Int   # 1 or 2 (0: 1)
  rate: Float     # frames a second (0: 16000)
end
sound* :: host proc(v: Int, data: Blob, s: Sound) # play data on voice v, once, as s says
soundWav* :: host proc(v: Int, data: Blob) -> Int   # a WAV file's sound, at its own rate: 1 if it could
soundRate* :: host proc(v: Int, rate: Float)
soundVolume* :: host proc(v: Int, volume: Float)    # 0 to 1
soundPan* :: host proc(v: Int, pan: Float)          # -1 to 1
soundLoop* :: host proc(v, start, stop: Int)        # from frame stop, back to start (stop 0: no loop)
soundStop* :: host proc(v: Int)                     # (on the synth, fading out, as after its last note)
soundPlaying* :: host proc(v: Int) -> Int
# the synth: play notes on voice v, 4 bytes each: pitch (0 is C0, 65.4 Hz; a semitone a step), wave (0
# triangle, tilted, saw, square, pulse, organ, noise, 7 phaser; 8 to 15 the app's, from synthWave),
# volume (0 to 7) and effect (0 none, slide, vibrato, drop, fade in, fade out, fast arpeggio, 7 slow),
# each speed 120ths of a second. The sound procs above work on it too: its loop's start and stop are
# notes
synth* :: host proc(v: Int, notes: Blob, speed: Int)
# the notes made instead, added to out, as 16-bit samples at voice -1's rate (16000 a second unless set),
# to their end or out's: how many samples (speed 0: on from where the last one stopped, for more than out
# holds)
synthMake* :: host proc(out: Blob[..], notes: Blob, speed: Int) -> Int
# a voice's synth settings, kept from one synth to the next, and heard at once if it's playing (voice
# -1: synthMake's): samples made a second (8000 to 48000; 16000 to start), every pitch moved (in
# semitones), seconds the volume takes to rise and fall about 2/3 of the way to a note's (0.0062 to
# start), and the saw, square and pulse smoothed where they jump (1) or not (0, to start)
synthRate* :: host proc(v: Int, rate: Float)
synthBend* :: host proc(v: Int, semitones: Float)
synthEnvelope* :: host proc(v: Int, attack, release: Float)
synthSmooth* :: host proc(v, on: Int)
# wave w (8 to 15) for every voice: a cycle of 16-bit samples, read as it plays (so keep it in globals)
synthWave* :: host proc(w: Int, cycle: Blob)
# on from frame at (on the synth, note at), as it plays
soundSeek* :: host proc(v, at: Int)

# ---------------------------------------------------------------- apps, for home and the console

# A name is an installed app's (chord), or with a + after it, its project's (chord+): the app in work,
# with a save space of its own
apps* :: host proc() -> Int                         # the apps and projects (sorted, each project after its app): how many
# what adds text to out below adds as much as fits, and gives its whole length
appName* :: host proc(i: Int, out: Blob[..]) -> Int # app i's name (a project's with its +): how long
appInfo* :: host proc(i: Int, out: Blob[..]) -> Int # its first line: "Title: what it does"
launch* :: host proc(name: String)                  # switch to an app or project (or "home", "console") after this frame
# one app calling another: call starts it with args (after this frame), which it reads with args; done goes
# back to the caller (this app forgotten, as the system key's Q does), which, starting again, reads result
call* :: host proc(name: String, args: String)
args* :: host proc(out: Blob[..]) -> Int            # the args this app was called with: how long (0: none)
done* :: host proc(result: String)                  # back to the caller, with a result (or to the app before)
result* :: host proc(out: Blob[..]) -> Int          # the result of the app this one called: how long, or -1 (taken)
# where the last app to stop with an error stopped, for an editor to go to: its file's path added to path,
# and what was wrong to message (as much as fits). Taken: a second call gives none
AppError* :: struct
  line: Int             # from 1 (0: there's none)
  col: Int              # from 1 (0: not known, as for a runtime error)
  len: Int              # how wide what's wrong is (0: not known)
  runtime: Bool         # a runtime error (else it didn't compile)
end
appError* :: host proc(path: Blob[..], message: Blob[..]) -> AppError

# the last checkRio's error, as appError has an app's (line 0: none), its file the main file or one it
# includes or imports (/rinc/...): for an editor's underline. Checking the whole file finds its first
checkError* :: host proc(path: Blob[..], message: Blob[..]) -> AppError
# an app's source added to out, as much as fits: its whole length, or -1 if there's no such app
appSource* :: host proc(name: String, out: Blob[..]) -> Int
appSave* :: host proc(name: String, text: String) -> Int   # 0, or -1
appDelete* :: host proc(name: String) -> Int               # all of its folder, its compiled image too: 0, or -1
appInstall* :: host proc(name: String) -> Int              # project name* installed as app name: 0, or -1
appCopy* :: host proc(from: String, to: String) -> Int     # app or project from, as new project to (to*): 0, or -1
# the installed apps that open files ending .ext (as each one's opens.txt says: a line each, the
# extension, then what such a file is), into out a line each, "name what": how many. The one picked for
# them is the setting files/appreg/ext; an app is given one as pc.call(name, "open /its/path")
appsFor* :: host proc(ext: String, out: Blob[..]) -> Int
appRename* :: host proc(from: String, to: String) -> Int   # project from (from*) as new project to (to*): 0, or -1

# ---------------------------------------------------------------- files, by path, for a file browser

# A path is absolute (/rinc/save/chord/best), in /rinc, the root: looking goes anywhere in it, changing
# only inside it. Or, not starting with /, it's one of the app's own files, in its folder (as a project,
# /rinc/projects/chord/, or installed, /rinc/apps/chord/): imageRead("sprites.png", pixels), for reading
# only. What reads into a builder adds to what's in it, as much as fits: out.len() tells how much it holds
dir* :: host proc(path: String, out: Blob[..]) -> Int      # its entries, folders first, a line each ("d name", "f name"): how many, or -1
fileRead* :: host proc(path: String, out: Blob[..]) -> Int # its whole length, or -1
fileWrite* :: host proc(path: String, data: String) -> Int # 0, or -1
fileReadAt* :: host proc(path: String, at: Int, out: Blob[..]) -> Int # from byte at on, added: its whole length, or -1
fileWriteAt* :: host proc(path: String, at: Int, data: String) -> Int # over it from byte at on (-1: its end), made if need be: where it went, or -1
fileDelete* :: host proc(path: String) -> Int              # a file, or a folder and all in it: 0, or -1
fileCopy* :: host proc(from: String, to: String) -> Int    # a file or a folder, to a path not taken: 0, or -1
fileRename* :: host proc(from: String, to: String) -> Int  # to a path not taken: 0, or -1
dirMake* :: host proc(path: String) -> Int                 # a folder, at a path not taken: 0, or -1
# pictures in files (Image: its pixels and size). imageRead adds one's pixels to pixels, each color the
# palette's nearest (exactly, for one imageWrite wrote), and gives it as an Image, viewing them (size {0,
# 0} for none). pixels needs room past what it holds for the file's rows as they come: (w + 1) * h bytes
# for a PNG of the palette's; without it, the Image has its size but no pixels, and the log says why. imageWrite writes one as o says, and
# imageNotes adds its notes to out. Only PNG files, so far
ImageFormat* :: enum
  fromName
  png
end
imageLoad :: host proc(path: String, pixels: Blob[..]) -> [2]Int # (imageRead's: the pixels added, and its size)
imageRead* :: proc(path: String, pixels: Blob[..]) -> Image
  start := pixels.len()
  size := imageLoad(path, pixels)
  return {pixels = pixels[start..<pixels.len()], size = size}
end
# how imageWrite writes a picture; left out, as its name ends (.png), with no notes
ImageWrite* :: struct
  notes: String        # the app's notes about it (text, up to 512 bytes, kept in the file: a sprite sheet's sprite size, say)
  format: ImageFormat  # fromName: as its name ends
end
imageWrite* :: host proc(path: String, image: Image, o?: ImageWrite) -> Int # 0, or -1
imageNotes* :: host proc(path: String, out: Blob[..]) -> Int  # how many bytes, or -1 (none)

# ---------------------------------------------------------------- help texts, for a help app: /rinc/help, and the bundle's

# the help texts (Markdown): their names (paths, .md left off: rinc/spec/apps; a project's, chord+/...),
# in order, added to out, each with a 10 after it, as many as fit: how many
helps* :: host proc(out: Blob[..]) -> Int
# a help text added to out, as much as fits (storage's, else the bundle's): its whole length, or -1 if there's none
helpRead* :: host proc(name: String, out: Blob[..]) -> Int
# the help app, after this frame, at a help text (and maybe a heading): help("rio/spec/statements#if")
help* :: host proc(topic: String)
helpTopic* :: host proc(out: Blob[..]) -> Int         # for the help app: the topic it was opened at, taken (0: none)

# ---------------------------------------------------------------- this app's own files: /rinc/save/<app>

# a file's contents added to out, as much as fits: its whole length, or -1 if there's no such file. Names
# are 1 to 32 letters, digits, _, - and . (not first)
saveRead* :: host proc(file: String, out: Blob[..]) -> Int
saveWrite* :: host proc(file: String, data: String) -> Int  # 0, or -1
saveDelete* :: host proc(file: String) -> Int               # 0, or -1

# ---------------------------------------------------------------- this app's stash: /rinc/stash/<app>/<key>

# what an app keeps of where it was, for its next start, under keys of its own (named as save files are),
# written as it goes; Rinc drops all of it on Sys+Q and Sys+R, where it never touches the save space
stashWrite* :: host proc(key: String, data: String) -> Int  # 0, or -1
stashRead* :: host proc(key: String, out: Blob[..]) -> Int  # added to out, as much as fits: its whole length, or -1 for none
stashReadAt* :: host proc(key: String, at: Int, out: Blob[..]) -> Int # as fileReadAt, what's kept under key
stashWriteAt* :: host proc(key: String, at: Int, data: String) -> Int # as fileWriteAt
stashDelete* :: host proc(key: String) -> Int               # 0, or -1
# ---------------------------------------------------------------- this app's cache: /rinc/cache/<app>

# what an app can make again (a project's, chord+, its own), named as save files are; any of it may go at
# any time. Rinc keeps the app's log there, as log: what it logged lately, and what Rinc said about it
cacheRead* :: host proc(file: String, out: Blob[..]) -> Int  # added to out, as much as fits: its whole length, or -1 for none
cacheWrite* :: host proc(file: String, data: String) -> Int  # 0, or -1
cacheDelete* :: host proc(file: String) -> Int               # 0, or -1

# the whole Rinc's settings, shared by the apps (/rinc/settings/<key>): "active" is the app or project
# being worked on (chord, or chord+); keys are named as save files are
settingRead* :: host proc(key: String, out: Blob[..]) -> Int  # added to out, as much as fits: its whole length, or -1
settingWrite* :: host proc(key: String, data: String) -> Int  # 0, or -1

# the theme: a color for each role, which the system apps draw with, so they look alike and a theme (the
# theme setting: owner/id, a file owner/themes/id.theme.rio) changes them all. Read at each app's start
Role* :: enum
  bg       # the background
  bar      # bars (a title's, the keys' at the bottom), and boxes to type in
  text     # text
  soft     # long text, a little quieter (help's)
  dim      # what goes with text: descriptions, line numbers, notes
  faint    # hints: the keys at the bottom, an empty box's placeholder
  accent   # what stands out: the main heading, the cursor, marks
  heading  # other headings, emphasis
  pick     # behind the row or item picked
  select   # behind selected text
  link     # links
  error    # what went wrong
  ok       # what went right
  codeBg   # behind code, among text
  code     # code: names
  punct    # code: operators and punctuation
  keyword  # code: if, for, proc...
  type     # code: a name with a capital (Int, Blob)
  call     # code: a name called, f(...)
  number   # code: 12, 1.5
  string   # code: "text"
  comment  # code: # comments
end
theme* :: host proc(role: Role) -> Int
boot* :: host proc() -> Int                                 # how many times this Rinc has started (0: no storage)

# ---------------------------------------------------------------- Rio inside an app: a session

# a fresh session, for a console or an editor: its code and data in mem, its compiler's tables in
# tables, both the app's own memory, handed over: 0, or -1
rioStart* :: host proc(mem, tables: Blob) -> Int
rioEval* :: host proc(text: String) -> Int          # run a piece: 0 done, 1 unfinished (needs more), -1 error
rioFrame* :: host proc() -> Int                     # its update then draw: 0, 1 if it has neither, -1 error
rioType* :: host proc(key: Int)                     # a key for its pc.key()
rioError* :: host proc(out: Blob[..]) -> Int        # the last error, as text, added to out: how long
rioLog* :: host proc(out: Blob[..]) -> Int          # what it logged since, as much as fits, taken: how much (lines end with 10)
rioIndent* :: host proc(text: String) -> Int        # the indent steps an unfinished input's next line takes

# ---------------------------------------------------------------- a line of text, edited

# a line of text being edited (a name, something to find): its text, in room of the app's own
# (Field{text = room}, room a Blob[..n]), the cursor (0 to its length), the selection's other end
# (anchor == cursor: none), and draw's scroll. key() edits it as a text box does in Windows: typing
# (in place of what's selected), Backspace and Delete (with Ctrl, a word), left and right (with Ctrl, by
# words; with Shift, selecting), Home and End, and Ctrl+A (all of it); draw() shows it
Field* :: struct
  text: Blob[..]
  cursor: Int
  anchor: Int
  scroll: Int
end
Field.set* :: proc(s: String) # its text, all of it selected (typing takes its place)
  self.text.clear()
  for c in s
    _ = self.text.push(c)
  end
  self.anchor = 0
  self.cursor = self.text.len()
  self.scroll = 0
end
Field.select* :: proc(from: Int, to: Int) # from to, the cursor at to
  self.anchor = max(0, min(from, self.text.len()))
  self.cursor = max(0, min(to, self.text.len()))
end
Field.selected* :: proc() -> Bool do return self.anchor != self.cursor
Field.wordAt :: proc(i: Int) -> Bool # (a letter, digit or _)
  c := self.text[i]
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
end
Field.wordLeft :: proc(from: Int) -> Int # (the start of the word before from)
  i := from
  for i > 0 and not self.wordAt(i - 1)
    i -= 1
  end
  for i > 0 and self.wordAt(i - 1)
    i -= 1
  end
  return i
end
Field.wordRight :: proc(from: Int) -> Int # (the end of the word after from, as Windows': past what's after it too)
  i := from
  n := self.text.len()
  for i < n and self.wordAt(i)
    i += 1
  end
  for i < n and not self.wordAt(i)
    i += 1
  end
  return i
end
Field.cut :: proc(a: Int, b: Int) # (a to b taken out, the cursor there)
  n := self.text.len()
  for i in b..<n
    self.text[a + i - b] = self.text[i]
  end
  for _ in a..<b
    _ = self.text.pop()
  end
  self.cursor = a
  self.anchor = a
end
Field.cutSelected :: proc()
  if self.anchor != self.cursor
    self.cut(min(self.anchor, self.cursor), max(self.anchor, self.cursor))
  end
end
Field.moveTo :: proc(i: Int, shift: Bool)
  self.cursor = i
  if not shift
    self.anchor = i
  end
end
Field.key* :: proc(c: Int) -> Bool # a key, as key() gives it: true if it was the field's
  k := c & 255
  shift := c & 256 != 0
  ctrl := c & 512 != 0
  lo := min(self.anchor, self.cursor)
  hi := max(self.anchor, self.cursor)
  if c >= 32 and c < 127 # (typed, in place of what's selected)
    self.cutSelected()
    if self.text.push(c) # (room for it: then moved up to the cursor)
      i := self.text.len() - 1
      for i > self.cursor
        self.text[i] = self.text[i - 1]
        i -= 1
      end
      self.text[self.cursor] = c
      self.cursor += 1
      self.anchor = self.cursor
    end
  case k == 8 # Backspace, Ctrl+Backspace
    if lo != hi
      self.cutSelected()
    case ctrl
      self.cut(self.wordLeft(self.cursor), self.cursor)
    case self.cursor > 0
      self.cut(self.cursor - 1, self.cursor)
    end
  case k == 134 # Delete, Ctrl+Delete
    if lo != hi
      self.cutSelected()
    case ctrl
      self.cut(self.cursor, self.wordRight(self.cursor))
    case self.cursor < self.text.len()
      self.cut(self.cursor, self.cursor + 1)
    end
  case k == 128 # left: by a word with Ctrl; with nothing held, out of a selection to its start
    if ctrl
      self.moveTo(self.wordLeft(self.cursor), shift)
    case lo != hi and not shift
      self.moveTo(lo, false)
    else
      self.moveTo(max(self.cursor - 1, 0), shift)
    end
  case k == 129
    if ctrl
      self.moveTo(self.wordRight(self.cursor), shift)
    case lo != hi and not shift
      self.moveTo(hi, false)
    else
      self.moveTo(min(self.cursor + 1, self.text.len()), shift)
    end
  case k == 132
    self.moveTo(0, shift)
  case k == 133
    self.moveTo(self.text.len(), shift)
  case c == 1 # Ctrl+A
    self.select(0, self.text.len())
  else
    return false
  end
  return true
end
Field.draw* :: proc(at: [2]Int, chars: Int, color: Int, selectColor: Int, cursorColor: Int) # chars across, scrolled to show the cursor
  if self.cursor < self.scroll
    self.scroll = self.cursor
  end
  if self.cursor > self.scroll + chars - 1
    self.scroll = self.cursor - chars + 1
  end
  self.scroll = max(0, min(self.scroll, self.text.len()))
  upTo := min(self.text.len(), self.scroll + chars)
  lo := max(min(self.anchor, self.cursor), self.scroll)
  hi := min(max(self.anchor, self.cursor), upTo)
  if hi > lo
    rect(at + {(lo - self.scroll) * 6 - 1, -1}, {(hi - lo) * 6 + 1, 9}, selectColor)
  end
  print(self.text[self.scroll..<upTo].asString(), at, color)
  rect(at + {(self.cursor - self.scroll) * 6 - 1, -1}, {1, 9}, cursorColor)
end

