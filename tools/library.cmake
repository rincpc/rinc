# cmake -DLIB=library -DOUT=library.c -P tools/library.cmake
# Rinc's library (library/*.rio) as C arrays, built into every Rinc: what an app imports (import tilemap)
# when the card has no /rinc/lib file of that name (a card's own wins), so the library's always there, a
# board with no card too (docs/spec/apps.md#more-files)
file(GLOB libs RELATIVE "${LIB}" "${LIB}/*.rio")
list(SORT libs)
set(arrays "")
set(table "")
set(i 0)
foreach(lib ${libs})
  file(READ "${LIB}/${lib}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  set(arrays "${arrays}static const char rinc_lib${i}[] = {${hex}0};\n")
  set(table "${table}  {\"${lib}\", rinc_lib${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}" "/* generated by tools/library.cmake: Rinc's library, ${libs} */\n#include \"rinc.h\"\n${arrays}"
  "const rinc_File rinc_library[] = {\n${table}  {0, 0, 0}};\n")
