# cmake -DAPPS="a.rio|b.rio" [-DHELP="rinc=docs|rio=lib/rio/docs"] -DHOME=home -DOUT=bundle.c -P tools/bundle.cmake
# A bundle of app sources (docs/spec/apps.md#bundles), as a C array: the Fruit Jam firmware's built-in
# apps (RINC_BUNDLE), each as apps/<name>/<name>.rio, named for its file (in a folder of its own name,
# its other .rio files too, as apps/<name>/..., and its help folder, as apps/<name>/help/...); HOME names the one home means (by default the only app,
# else one named home). And help texts (RINC_HELP): each name=folder's Markdown files, as
# help/<name>/<path in the folder>.md.

# n as 4 bytes, little-endian, in hex
function(le32 n out)
  math(EXPR v "${n}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${v}" 2 -1 v)
  string(LENGTH "${v}" k)
  while(k LESS 8)
    set(v "0${v}")
    math(EXPR k "${k} + 1")
  endwhile()
  string(SUBSTRING "${v}" 6 2 b0)
  string(SUBSTRING "${v}" 4 2 b1)
  string(SUBSTRING "${v}" 2 2 b2)
  string(SUBSTRING "${v}" 0 2 b3)
  set(${out} "${b0}${b1}${b2}${b3}" PARENT_SCOPE)
endfunction()

# text as exactly size bytes, 0-padded, in hex
function(padded text size out)
  string(HEX "${text}" h)
  string(LENGTH "${h}" k)
  math(EXPR want "${size} * 2")
  if(k GREATER want)
    string(SUBSTRING "${h}" 0 ${want} h)
    set(k ${want})
  endif()
  while(k LESS want)
    set(h "${h}00")
    math(EXPR k "${k} + 2")
  endwhile()
  set(${out} "${h}" PARENT_SCOPE)
endfunction()

string(REPLACE "|" ";" APPS "${APPS}")
string(REPLACE "|" ";" HELP "${HELP}")
set(files "") # (path in the bundle, then its file, for each)
foreach(app ${APPS})
  get_filename_component(name "${app}" NAME_WE)
  get_filename_component(dir "${app}" DIRECTORY)
  list(APPEND files "apps/${name}/${name}.rio" "${app}")
  get_filename_component(folder "${dir}" NAME)
  if(folder STREQUAL name) # (an app in a folder of its own: its other files, apps/<name>/parts/a.rio say:
    # its files.txt's, as tools/install.py takes them, else all its .rio files)
    if(EXISTS "${dir}/files.txt")
      file(STRINGS "${dir}/files.txt" parts REGEX "^[^#].*\\.rio$")
    else()
      file(GLOB_RECURSE parts RELATIVE "${dir}" "${dir}/*.rio")
      list(REMOVE_ITEM parts "test.rio") # (its tests: not bundled)
    endif()
    list(SORT parts)
    foreach(part ${parts})
      if(NOT part STREQUAL "${name}.rio")
        list(APPEND files "apps/${name}/${part}" "${dir}/${part}")
      endif()
    endforeach()
  endif()
  if(IS_DIRECTORY "${dir}/help") # (an app in a folder of its own, with help texts: apps/<name>/help/...)
    file(GLOB_RECURSE docs RELATIVE "${dir}/help" "${dir}/help/*.md")
    list(SORT docs)
    foreach(doc ${docs})
      list(APPEND files "apps/${name}/help/${doc}" "${dir}/help/${doc}")
    endforeach()
  endif()
endforeach()
foreach(set ${HELP})
  string(REPLACE "=" ";" set "${set}")
  list(GET set 0 prefix)
  list(GET set 1 dir)
  file(GLOB_RECURSE docs RELATIVE "${dir}" "${dir}/*.md")
  list(SORT docs)
  foreach(doc ${docs})
    list(APPEND files "help/${prefix}/${doc}" "${dir}/${doc}")
  endforeach()
endforeach()
list(LENGTH files count)
math(EXPR count "${count} / 2")
list(LENGTH APPS appCount)
if(NOT HOME AND appCount EQUAL 1)
  get_filename_component(HOME "${APPS}" NAME_WE)
elseif(NOT HOME)
  set(HOME home)
endif()
math(EXPR at "76 + ${count} * 104")
padded("RINCBUN1" 8 head)
le32(${count} c)
padded("" 32 storage)
padded("${HOME}" 32 home)
set(head "${head}${c}${storage}${home}")
set(entries "")
set(data "")
math(EXPR last "${count} * 2 - 1")
if(count GREATER 0) # (none: the firmware's default, and RANGE 0 -1 is an error)
  foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET files ${i} inside)
    list(GET files ${j} file)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" k)
    math(EXPR len "${k} / 2")
    padded("${inside}" 96 path)
    le32(${at} where)
    le32(${len} size)
    set(entries "${entries}${path}${where}${size}")
    set(data "${data}${hex}")
    math(EXPR at "${at} + ${len}")
  endforeach()
endif()
set(all "${head}${entries}${data}")
string(TOLOWER "${all}" all)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," all "${all}")
file(WRITE ${OUT} "/* generated by tools/bundle.cmake: ${count} files, the apps ${APPS} and help ${HELP} */\n#include <stdint.h>\n"
  "const uint8_t rinc_firmwareBundle[] = {${all}};\n"
  "const uint32_t rinc_firmwareBundleSize = ${at};\n")
