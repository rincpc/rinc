# Console: the session, typing (part of console.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- the session

showLog :: proc()
  for
    logBufIn: Blob[..] = logBuf
    n := pc.rioLog(logBufIn)
    if n <= 0
      break
    end
    say(logBuf[..<n].asString(), softColor)
  end
end

showError :: proc()
  logBufIn2: Blob[..] = logBuf
  n := pc.rioError(logBufIn2)
  say(logBuf[..<n].asString(), errorColor)
end

fresh :: proc(app?: String) -> Bool # (app: whose folder its paths start in, as load gives it)
  if pc.rioStart(sessionMem[], sessionTables[], app) != 0
    showError()
    return false
  end
  return true
end

# ---------------------------------------------------------------- typing

Mode :: enum
  typing, running, saving
end
mode: Mode
acc: Blob[..4096]  # an unfinished input's lines so far
line: Blob[..200]  # the line being typed
cur := 0           # where in it
HISTORY :: "/rinc/save/console/history.txt" # the lines typed: up and down bring them back, after a restart too
HISTORY_MOST :: 8192
hist: Blob[..HISTORY_MOST] # (its lines, oldest first, a newline after each)
histCount := 0
back := 0          # how far back up and down have gone (0: the line being typed)
saveName: Blob[..100] # (an app, or a file of its own: chord/parts/sound.rio)

blank :: proc(t: String) -> Bool
  for c in t
    if c != 32
      return false
    end
  end
  return true
end

trim :: proc(t: String) -> String
  a := 0
  b := t.len()
  for a < b and t[a] == 32
    a += 1
  end
  for b > a and t[b - 1] == 32
    b -= 1
  end
  return t[a..<b]
end

setLine :: proc(t: String)
  line.clear()
  for c in t
    _ = line.push(c)
  end
  cur = line.len()
end

# line b of the history from its end (1: the last)
histLine :: proc(b: Int) -> String
  stop := hist.len() - 1 # (the newline after it)
  for _ in 1..<b
    stop -= 1
    for hist[stop] != 10 do stop -= 1
  end
  start := stop
  for start > 0 and hist[start - 1] != 10 do start -= 1
  return hist[start..<stop].asString()
end
# a line typed, kept for up and down (the same again: once); the oldest go, to make room
addLine :: proc(t: String)
  if blank(t) or (histCount > 0 and histLine(1) == t)
    return
  end
  for histCount > 0 and hist.len() + t.len() + 1 > HISTORY_MOST
    k := 0
    for hist[k] != 10 do k += 1
    k += 1
    n := hist.len()
    for i in 0..<n - k do hist[i] = hist[i + k]
    for _ in 0..<k do _ = hist.pop()
    histCount -= 1
  end
  _ = hist.pushAll(t)
  _ = hist.push(10)
  histCount += 1
end
remember :: proc(t: String) # (and in its file: there again after a restart, or another app's run)
  addLine(t)
  _ = pc.fileWrite(HISTORY, hist.asString())
end
readHistory :: proc() # (as it starts: the lines kept, back)
  hist.clear()
  histCount = 0
  if pc.fileRead(HISTORY, hist) <= 0
    hist.clear()
    return
  end
  if hist[hist.len() - 1] != 10 do _ = hist.push(10) # (cut short, or written by hand: a last line)
  for c in hist
    if c == 10 do histCount += 1
  end
end
readHistory()
clearHistory :: proc()
  hist.clear()
  histCount = 0
  back = 0
  _ = pc.fileDelete(HISTORY)
end

recall :: proc(step: Int)
  b := back + step
  if b < 0 or b > histCount
    return
  end
  back = b
  if b == 0
    setLine("")
  else
    setLine(histLine(b))
  end
end

insert :: proc(c: Int)
  if line.push(c)
    i := line.len() - 1
    for i > cur
      line[i] = line[i - 1]
      i -= 1
    end
    line[cur] = c
    cur += 1
  end
end
