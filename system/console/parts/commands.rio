# Console: commands (part of console.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- commands

ls :: proc()
  n := pc.apps()
  if n == 0
    say("no apps (or no card): /rinc/apps", softColor)
    return
  end
  names: Blob[..2048]
  name: Blob[32]
  for i in 0..<n
    k := min(pc.appName(i, name[]), 32)
    names.pushAll(name[..<k].asString())
    names.pushAll("  ")
  end
  say(names[].asString(), textColor)
end

load :: proc(name: String)
  msg: Blob[..80]
  n := pc.appSource(name, file[])
  if n < 0
    msg.print("can't open ", name)
    say(msg[].asString(), errorColor)
    return
  end
  if n > file.len()
    msg.print(name, " is too big to load here (", n, " bytes)")
    say(msg[].asString(), errorColor)
    return
  end
  if not fresh()
    return
  end
  r := pc.rioEval(file[..<n].asString())
  showLog()
  if r < 0
    showError()
  case r == 1
    say("(it ends unfinished)", errorColor)
  else
    msg.print("loaded ", name)
    say(msg[].asString(), softColor)
  end
end

startSave :: proc(name: String)
  saveName.clear()
  if not saveName.pushAll(name)
    say("names are up to 32 letters, digits, _ and -, and a file's path up to 100", errorColor)
    return
  end
  fileLen = 0
  mode = .saving
  say("type or paste it, then Ctrl-D (Ctrl-C gives up)", softColor)
end

# save name: the app's source; save name/a/file: a file of its own, in its folder (chord/parts/sound.rio,
# or a project's, chord+/parts/sound.rio)
saveTo :: proc() -> Int
  slash := -1
  for i in 0..<saveName.len()
    if slash < 0 and saveName[i] == '/'
      slash = i
    end
  end
  if slash < 0
    return pc.appSave(saveName[].asString(), file[..<fileLen].asString())
  end
  if slash == 0
    return -1
  end
  path: Blob[..128]
  if saveName[slash - 1] == '+'
    path.print("/rinc/projects/", saveName[0..<slash - 1], saveName[slash..])
  else
    path.print("/rinc/apps/", saveName[])
  end
  return pc.fileWrite(path[].asString(), file[..<fileLen].asString())
end

finishSave :: proc()
  msg: Blob[..80]
  mode = .typing
  if saveTo() != 0
    msg.print("couldn't save ", saveName[])
    say(msg[].asString(), errorColor)
  else
    msg.print("saved ", fileLen, " bytes")
    say(msg[].asString(), softColor)
  end
end

# a line on its own that's a command: true if it was one
command :: proc(t: String) -> Bool
  msg: Blob[..80]
  switch t # (a word alone)
  case "run"
    mode = .running
    return true
  case "ls"
    ls()
    return true
  case "home"
    pc.launch("home")
    return true
  case "active"                          # the active app or project, the whole Rinc's setting
    v: Blob[34]
    n := pc.settingRead("active", v[])
    if n > 0
      msg.print("active: ", v[0..<min(n, 34)])
      say(msg[].asString(), softColor)
    else
      say("nothing active: active name makes one active (name+ for a project)", softColor)
    end
    return true
  end
  w := 0
  for w < t.len() and t[w] != 32
    w += 1
  end
  if w == t.len()
    return false
  end
  word := t[..<w]
  name := trim(t[w..])
  switch word # (a word, then a name)
  case "load"
    load(name)
  case "run"
    pc.launch(name)                      # an app runs as itself, in all of its memory
  case "save"
    startSave(name)
  case "active"                          # app or project (name+) name, active: the editor opens it next
    if pc.appSource(name, msg[0..<0]) >= 0 and pc.settingWrite("active", name) == 0
      msg.print("active: ", name)
      say(msg[].asString(), softColor)
    else
      msg.print("no app or project ", name)
      say(msg[].asString(), errorColor)
    end
  case "install"                         # project name+ as the app name
    if pc.appInstall(name) == 0
      msg.print("installed ", name)
      say(msg[].asString(), softColor)
    else
      msg.print("can't install ", name, " (from its project, ", name, "*)")
      say(msg[].asString(), errorColor)
    end
  case "delete"
    if pc.appDelete(name) == 0
      msg.print("deleted ", name)
      say(msg[].asString(), softColor)
    else
      msg.print("can't delete ", name)
      say(msg[].asString(), errorColor)
    end
  else
    return false
  end
  return true
end

startsWith :: proc(t: String, word: String) -> Bool
  return t.len() >= word.len() and t[..<word.len()] == word
end

# the next line's indent, as it's given: spaces typed at its start take its place first (so pasted,
# already indented code isn't indented twice), as the C console does
autoIndent := 0

enter :: proc()
  shown: Blob[..256]
  t := trim(line[].asString())
  indent := 0
  for indent < line.len() and line[indent] == 32
    indent += 1
  end
  # (a step back out, if the indent is still all there: not when Backspace already took it)
  if acc.len() > 0 and indent >= 2 and indent >= pc.rioIndent(acc[].asString()) * 2 and
      (startsWith(t, "end") or startsWith(t, "else") or startsWith(t, "case"))
    line.remove(0)
    line.remove(0)
  end
  if acc.len() == 0
    shown.pushAll("> ")
  else
    shown.pushAll(". ")
  end
  shown.pushAll(line[].asString())
  say(shown[].asString(), CODE_ROW)
  text := line[].asString()
  remember(text)
  back = 0
  if blank(text)
    if acc.len() > 0
      say("(unfinished input dropped)", softColor)
      acc.clear()
    end
  case acc.len() == 0 and command(trim(text))
    acc.clear()
  case not (acc.pushAll(text) and acc.push(10))
    say("(input too long)", errorColor)
    acc.clear()
  else
    r := pc.rioEval(acc[].asString())
    showLog()
    if r == 1
      setLine("")
      for i in 0..<pc.rioIndent(acc[].asString()) * 2
        line.push(32)
      end
      cur = line.len()
      autoIndent = cur
      return
    end
    if r < 0
      showError()
    end
    acc.clear()
  end
  setLine("")
end

typing :: proc(c: Int)
  if c != 32
    autoIndent = 0
  end
  switch c
  case 13
    enter()
  case 8 # (in the indent, at its end: a whole step, back to the one before)
    if cur > 0 and cur == line.len() and blank(line[].asString()) and cur >= 2
      for k in 0..<2 - cur % 2
        line.remove(cur - 1)
        cur -= 1
      end
    case cur > 0
      line.remove(cur - 1)
      cur -= 1
    end
  case 134 # Delete
    if cur < line.len()
      line.remove(cur)
    end
  case 128
    cur = max(cur - 1, 0)
  case 129
    cur = min(cur + 1, line.len())
  case 132, 1 # Home, Ctrl-A
    cur = 0
  case 133, 5 # End, Ctrl-E
    cur = line.len()
  case 130
    recall(1)
  case 131
    recall(-1)
  case 3 # Ctrl-C: drop what's typed
    say("^C", softColor)
    acc.clear()
    setLine("")
  case 9
    insert(32)
    insert(32)
  case 32
    if autoIndent > 0 and cur == line.len() and blank(line[].asString())
      autoIndent -= 1
    else
      autoIndent = 0
      insert(32)
    end
  else
    if c >= 32 and c < 127
      insert(c)
    end
  end
end

saving :: proc(c: Int)
  if c == 4                              # Ctrl-D: done
    if line.len() > 0
      say(line[].asString(), softColor)
    end
    setLine("")
    finishSave()
  case c == 3
    setLine("")
    mode = .typing
    say("gave up", softColor)
  case c == 13 or c == 9 or (c >= 32 and c < 127)
    if fileLen == file.len()
      setLine("")
      mode = .typing
      say("too big to save here", errorColor)
      return
    end
    if c == 13
      file[fileLen] = 10
      say(line[].asString(), softColor)
      setLine("")
    else
      file[fileLen] = c
      line.push(c)
    end
    fileLen += 1
  end
end
