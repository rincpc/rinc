# Console: Rio, typed and run
#
# And the apps in storage. A line on its own can be a command: run (what's been typed, as a game: Esc
# stops it), ls, load name, run name, save name, delete name, install name, active [name], home. A name with a +
# after it is a project's (chord+), and install name copies project name+ over app name. An ordinary app
# (the Fruit Jam's firmware has it built in): the Rio it runs is a session (pc.rioStart) in memory of its own.

COLS :: 53        # 6x9 characters, on the 320x240 screen
ROWS :: 26
backColor := pc.theme(pc.Role.bg) # colors: the theme's (pc.Role)
textColor := pc.theme(pc.Role.text)
softColor := pc.theme(pc.Role.soft)
errorColor := pc.theme(pc.Role.error)
accentColor := pc.theme(pc.Role.accent)
codeColor := pc.theme(pc.Role.code) # code, as typed: colored as the editor colors it
punctColor := pc.theme(pc.Role.punct)
keywordColor := pc.theme(pc.Role.keyword)
typeColor := pc.theme(pc.Role.type)
callColor := pc.theme(pc.Role.call)
numberColor := pc.theme(pc.Role.number)
stringColor := pc.theme(pc.Role.string)
commentColor := pc.theme(pc.Role.comment)
CODE_ROW :: -1 # a row's color, for a row of typed code: colored as code

# the session's memory, handed over to it: the typed program's code and data, and its compiler's tables
sessionMem: Blob[147456]
sessionTables: Blob[40960]
file: Blob[24576]  # an app's source, loading or saving
fileLen := 0
logBuf: Blob[2048]

# code, colored as the editor colors it: comments, strings, numbers, keywords, names with a capital
# (types), names called, other names, and the rest (operators and punctuation)
KEYWORDS :: " proc struct if else for in end return break continue import include enum union switch case is nil and or not true false "
isWordChar :: proc(c: Int) -> Bool
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
end
isKeyword :: proc(w: String) -> Bool
  n := w.len()
  for p in 1..<KEYWORDS.len() - n
    if KEYWORDS[p - 1] == ' ' and KEYWORDS[p + n] == ' ' and KEYWORDS[p..<p + n] == w
      return true
    end
  end
  return false
end
printCode :: proc(t: String, x: Int, y: Int)
  i := 0
  quote := 0 # (in a string: its quote)
  for i < t.len()
    j := i + 1
    color := punctColor
    c := t[i]
    if quote != 0 or c == '"' or c == 39
      if quote == 0
        quote = c
      else
        j = i
      end
      for j < t.len() and t[j] != quote # (to its end, a backslash's next character skipped)
        j += 1 + (t[j] == 92).toInt()
      end
      j = min(j + 1, t.len())
      quote = 0
      color = stringColor
    case c == '#'
      j = t.len()
      color = commentColor
    case isWordChar(c)
      for j < t.len() and isWordChar(t[j])
        j += 1
      end
      w := t[i..<j]
      if c >= '0' and c <= '9'
        color = numberColor
      case isKeyword(w)
        color = keywordColor
      case c >= 'A' and c <= 'Z'
        color = typeColor
      case j < t.len() and t[j] == '('
        color = callColor
      else
        color = codeColor
      end
    end
    pc.print(t[i..<j], x + i * 6, y, color)
    i = j
  end
end

# the screen: finished rows, then the line being typed
Row :: struct
  text: Blob[..53]
  color: Int
end
rows: [26]Row
rowCount := 0

addRow :: proc(text: String, color: Int)
  if rowCount == ROWS
    for i in 0..<ROWS - 1
      rows[i] = rows[i + 1]
    end
    rowCount -= 1
  end
  r := &rows[rowCount]
  r.text.clear()
  for c in text
    r.text.push(c)
  end
  r.color = color
  rowCount += 1
end

# text on the screen, its lines wrapped at the screen's width, and each line to the log too (the
# serial port, on the board)
say :: proc(text: String, color: Int)
  start := 0
  for i in 0..=text.len()
    if i == text.len() or text[i] == 10
      if i < text.len() or start < i or text.len() == 0
        line := text[start..<i]
        log(line)
        at := 0
        for at + COLS < line.len()
          addRow(line[at..<at + COLS], color)
          at += COLS
        end
        addRow(line[at..], color)
      end
      start = i + 1
    end
  end
end

# ---------------------------------------------------------------- its parts

include "parts/typing.rio"
include "parts/commands.rio"

# ---------------------------------------------------------------- frames

say("Rinc console: Rio, typed and run", textColor)
say("run, ls, load, run, save, delete, install, active name, home", softColor)
ok := fresh()

update* :: proc()
  if mode == .running
    for
      c := pc.key()
      if c < 0
        break
      end
      if c == 27
        mode = .typing
        say("stopped", softColor)
        return
      end
      pc.rioType(c)
    end
    r := pc.rioFrame()
    showLog()
    if r != 0
      mode = .typing
      if r == 1
        say("nothing to run: define update* or draw*", softColor)
      else
        showError()
      end
    end
    return
  end
  for
    c := pc.key()
    if c < 0 or mode == .running
      break
    end
    if mode == .saving
      saving(c)
    else
      typing(c)
    end
  end
end

draw* :: proc()
  if mode == .running
    return                               # (what's running drew)
  end
  pc.cls(backColor)
  shown: Blob[..256]
  if mode == .typing
    if acc.len() == 0
      shown.pushAll("> ")
    else
      shown.pushAll(". ")
    end
  end
  at := shown.len() + cur                # the cursor, in what's shown
  shown.pushAll(line[].asString())
  inputRows := shown.len() / COLS + 1
  first := max(rowCount + inputRows - ROWS, 0)
  y := 0
  for i in first..<rowCount
    if rows[i].color == CODE_ROW
      printCode(rows[i].text[].asString(), 0, y * 9)
    else
      pc.print(rows[i].text[].asString(), 0, y * 9, rows[i].color)
    end
    y += 1
  end
  for k in 0..<inputRows
    a := k * COLS
    if mode == .typing
      printCode(shown[a..<min(a + COLS, shown.len())].asString(), 0, (y + k) * 9)
    else
      pc.print(shown[a..<min(a + COLS, shown.len())].asString(), 0, (y + k) * 9, textColor)
    end
  end
  if (pc.time() * 2.0).toInt() % 2 == 0
    pc.rect(at % COLS * 6, (y + at / COLS) * 9 + 8, 5, 1, accentColor)
  end
end
