# Themes: the colors the system apps share, to pick from and make your own
#
# A theme gives a color to each role the system apps draw with (pc.Role: the background, text, the
# pick, code's keywords and strings...), so they all look alike, and changing it changes them all, from
# the next app started. The list shows every theme, from every app and project (owner/themes/*.theme.rio),
# with what the picked one looks like at the right. Enter uses it, E edits it, N makes a new one from
# it, R renames one of yours and Delete deletes one. Rinc's own themes (/rinc/apps/rinc/themes, named
# rinc/slate and so on) and any installed app's are locked: editing one changes your copy of it, slate+,
# in the save space (/rinc/save/rinc/themes/slate.theme.rio), made the first time; renaming that gives it
# a name of its own, and deleting it leaves the original. Editing, Enter opens Colors to pick a role's
# color, and left and right step through the colors.

MOST :: 48            # themes listed
ROLES :: 22           # pc.Role's, in its order
LIST_ROWS :: 16
PREVIEW_X :: 158      # the preview, at the right
APPS :: 0             # where a theme is: an installed app's (locked), a project's, or a save space's
PROJECTS :: 1
OWN :: 2
LIST :: 0             # what's on the screen
EDIT :: 1
LEFT_KEY :: 128
RIGHT_KEY :: 129
DELETE_KEY :: 134

roleNames := [ROLES]String{"bg", "bar", "text", "soft", "dim", "faint", "accent", "heading", "pick", "select", "link",
                           "error", "ok", "codeBg", "code", "punct", "keyword", "type", "call", "number", "string", "comment"}
defaults := [ROLES]Int{1, 0, 7, 6, 13, 5, 10, 9, 12, 2, 12, 8, 11, 17, 7, 6, 14, 15, 12, 9, 11, 13}
picoNames := [32]String{"black", "dark blue", "dark purple", "dark green", "brown", "dark gray", "light gray", "white",
                        "red", "orange", "yellow", "green", "blue", "lavender", "pink", "peach",
                        "brown black", "night blue", "plum", "teal", "rust", "dusk", "stone", "pale yellow",
                        "crimson", "tangerine", "lime", "emerald", "royal blue", "mauve", "coral", "salmon"}

# ---------------------------------------------------------------- the themes found

names: Blob[2048]     # each one's owner/id, one after another
nameAt: [MOST]Int
nameLen: [MOST]Int
titles: Blob[4096]    # and its title (its first line, # left off)
titleAt: [MOST]Int
titleLen: [MOST]Int
place: [MOST]Int
colors: [MOST * ROLES]Int
count := 0
current := -1         # the one the theme setting names

nameOf :: proc(t: Int) -> String
  return names[nameAt[t]:nameAt[t] + nameLen[t]].asString()
end
# its owner and its id, either side of the slash (a copy's + left on the id)
slashOf :: proc(n: String) -> Int
  for k in 0..<n.len()
    if n[k] == 47
      return k
    end
  end
  return 0
end
ownerOf :: proc(t: Int) -> String
  n := nameOf(t)
  return n[0:slashOf(n)]
end
idOf :: proc(t: Int) -> String
  n := nameOf(t)
  return n[slashOf(n) + 1:n.len()]
end
isCopy :: proc(t: Int) -> Bool # (a locked theme's copy: its name ends with +)
  return nameLen[t] > 0 and names[nameAt[t] + nameLen[t] - 1] == 43
end
# its title's name, before the colon (else all of it)
titleName :: proc(t: Int) -> String
  n := titleLen[t]
  for k in 0..<titleLen[t]
    if n == titleLen[t] and titles[titleAt[t] + k] == 58
      n = k
    end
  end
  return titles[titleAt[t]:titleAt[t] + n].asString()
end
color :: proc(t: Int, role: Int) -> Int
  if t < 0
    return defaults[role]
  end
  return colors[t * ROLES + role]
end

# a theme's file: where it is, by its name and place
pathBuf: Blob[..112]
fine := true
pathOf :: proc(t: Int) -> String
  n := nameOf(t)
  slash := slashOf(n)
  pathBuf.clear()
  if place[t] == OWN # (a copy, slate+, is slate's file in the save space)
    fine = pathBuf.format("/rinc/save/", n[0:slash], "/themes/", n[slash + 1:n.len() - isCopy(t).toInt()], ".theme.rio")
  case place[t] == PROJECTS
    fine = pathBuf.format("/rinc/projects/", n[0:slash - 1], "/themes/", n[slash + 1:n.len()], ".theme.rio")
  else
    fine = pathBuf.format("/rinc/apps/", n[0:slash], "/themes/", n[slash + 1:n.len()], ".theme.rio")
  end
  return pathBuf[0:pathBuf.len()].asString()
end

# one theme's text read into its colors and title: lines of name :: number (a star after the name, or
# not), as Rinc reads them; the first line, a comment, its title
fileBuf: Blob[2048]
isNameChar :: proc(c: Int) -> Bool
  return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
end
parse :: proc(t: Int, n: Int)
  for r in 0..<ROLES
    colors[t * ROLES + r] = defaults[r]
  end
  i := 0
  if n > 0 and fileBuf[0] == 35 # (the title)
    i = 1
    for i < n and fileBuf[i] == 32
      i += 1
    end
    a := i
    for i < n and fileBuf[i] != 10 and fileBuf[i] != 13
      i += 1
    end
    titleAt[t] = titleAt[t]
    m := min(i - a, 60)
    for k in 0..<m
      if titleAt[t] + titleLen[t] < 4096
        titles[titleAt[t] + titleLen[t]] = fileBuf[a + k]
        titleLen[t] += 1
      end
    end
  end
  for i < n
    for i < n and (fileBuf[i] == 32 or fileBuf[i] == 9)
      i += 1
    end
    a := i
    for i < n and isNameChar(fileBuf[i])
      i += 1
    end
    b := i
    if i < n and fileBuf[i] == 42
      i += 1
    end
    for i < n and fileBuf[i] == 32
      i += 1
    end
    if b > a and i + 1 < n and fileBuf[i] == 58 and fileBuf[i + 1] == 58
      i += 2
      for i < n and fileBuf[i] == 32
        i += 1
      end
      v := 0
      digits := 0
      for i < n and fileBuf[i] >= 48 and fileBuf[i] <= 57 and digits < 4
        v = v * 10 + fileBuf[i] - 48
        digits += 1
        i += 1
      end
      word := fileBuf[a:b].asString()
      for r in 0..<ROLES
        if digits > 0 and v < 256 and word == roleNames[r]
          colors[t * ROLES + r] = v
        end
      end
    end
    for i < n and fileBuf[i] != 10
      i += 1
    end
    i += 1
  end
end

# a theme found: added, its file read
titlesUsed := 0
namesUsed := 0
add :: proc(owner: String, id: String, where: Int, path: String, plus: Bool)
  if count >= MOST or namesUsed + owner.len() + id.len() + 3 > 2048
    return
  end
  n := pc.fileRead(path, fileBuf[:])
  if n < 0
    return
  end
  t := count
  nameAt[t] = namesUsed
  for k in 0..<owner.len()
    names[namesUsed] = owner[k]
    namesUsed += 1
  end
  names[namesUsed] = 47
  namesUsed += 1
  for k in 0..<id.len()
    names[namesUsed] = id[k]
    namesUsed += 1
  end
  if plus
    names[namesUsed] = 43
    namesUsed += 1
  end
  nameLen[t] = namesUsed - nameAt[t]
  place[t] = where
  titleAt[t] = titlesUsed
  titleLen[t] = 0
  parse(t, min(n, 2048))
  if titleLen[t] == 0 # (no title: its name)
    for k in 0..<min(id.len(), 60)
      titles[titleAt[t] + k] = id[k]
    end
    titleLen[t] = min(id.len(), 60)
  end
  titlesUsed += titleLen[t]
  count += 1
end

find :: proc(name: String) -> Int
  for t in 0..<count
    if nameOf(t) == name
      return t
    end
  end
  return -1
end

# every theme in a folder's themes/: folder is /rinc/apps/<owner> and so on
sub: Blob[2048]
idBuf: Blob[..40]
scanThemes :: proc(folder: String, owner: String, where: Int)
  pathBuf.clear()
  fine = pathBuf.format(folder, "/themes")
  n := pc.dir(pathBuf[0:pathBuf.len()].asString(), sub[:])
  at := 0
  for i in 0..<sub.len()
    if n > 0 and sub[i] == 10
      e := sub[at + 2:i].asString() # (its name, after "f ")
      if sub[at] == 102 and e.len() > 10 and e[e.len() - 10:e.len()] == ".theme.rio"
        idBuf.clear()
        fine = idBuf.pushAll(e[0:e.len() - 10])
        file: Blob[..112]
        fine = file.format(folder, "/themes/", e)
        probe: Blob[..80] # (in a save space, a locked theme's name: its copy)
        fine = probe.format(owner, "/", idBuf[0:idBuf.len()].asString())
        plus := where == OWN and find(probe[0:probe.len()].asString()) >= 0
        add(owner, idBuf[0:idBuf.len()].asString(), where, file[0:file.len()].asString(), plus)
      end
      n -= 1
      at = i + 1
    end
  end
end

# every folder of a top folder (/rinc/apps, /rinc/projects, /rinc/save), each one's themes
top: Blob[4096]
ownerBuf: Blob[..40]
folderBuf: Blob[..80]
scanAll :: proc(root: String, where: Int)
  n := pc.dir(root, top[:])
  at := 0
  for i in 0..<top.len()
    if n > 0 and top[i] == 10
      if top[at] == 100
        e := top[at + 2:i].asString()
        ownerBuf.clear()
        fine = ownerBuf.pushAll(e)
        if where == PROJECTS
          fine = ownerBuf.push(42) # (a project's: its star)
        end
        folderBuf.clear()
        fine = folderBuf.format(root, "/", e)
        scanThemes(folderBuf[0:folderBuf.len()].asString(), ownerBuf[0:ownerBuf.len()].asString(), where)
      end
      n -= 1
      at = i + 1
    end
  end
end

setting: Blob[80]
findAll :: proc()
  count = 0
  namesUsed = 0
  titlesUsed = 0
  scanAll("/rinc/apps", APPS)
  scanAll("/rinc/projects", PROJECTS)
  scanAll("/rinc/save", OWN)
  current = -1
  n := pc.settingRead("theme", setting[:])
  for n > 0 and (setting[n - 1] == 10 or setting[n - 1] == 13 or setting[n - 1] == 32)
    n -= 1
  end
  want := "rinc/rinc" # (no setting: Rinc's own colors)
  if n > 0 and n <= 80
    want = setting[0:n].asString()
  end
  for t in 0..<count
    if nameOf(t) == want
      current = t
    end
  end
end
# ---------------------------------------------------------------- writing one

# a color's name, for the comment after it in the file
colorText: Blob[..24]
levels := [6]Int{0, 95, 135, 175, 215, 255}
grayLevels := [8]Int{19, 38, 57, 76, 115, 155, 195, 235}
colorName :: proc(c: Int) -> String
  if c < 32
    return picoNames[c]
  end
  colorText.clear()
  if c < 248
    k := c - 32
    fine = colorText.format("cube ", levels[k / 36], " ", levels[k / 6 % 6], " ", levels[k % 6])
  else
    fine = colorText.format("gray ", grayLevels[c - 248])
  end
  return colorText[0:colorText.len()].asString()
end

out: Blob[..2048]
save :: proc(t: Int) -> Bool
  out.clear()
  fine = out.format("# ", titles[titleAt[t]:titleAt[t] + titleLen[t]].asString(), "\n")
  for r in 0..<ROLES
    fine = out.format(roleNames[r], "*")
    for k in roleNames[r].len() + 1..<8 # (lined up: comment*, the longest, is 8)
      fine = out.push(32)
    end
    c := colors[t * ROLES + r]
    fine = out.format(" :: ", c)
    for k in 0..<4 - (c >= 10).toInt() - (c >= 100).toInt()
      fine = out.push(32)
    end
    fine = out.format("# ", colorName(c), "\n")
  end
  return pc.fileWrite(pathOf(t), out[0:out.len()].asString()) == 0
end

# a new theme in owner's save space, from theme t: a locked one's copy (owner/id+, its title as is), or
# one of a name of its own (owner/id), its title "id: from Slate", or, renaming (keep), "id" and what
# t's title says from its colon on. Its number, or -1 (the name's taken, or no room)
make :: proc(t: Int, owner: String, id: String, plus: Bool, keep: Bool) -> Int
  idBuf.clear()
  fine = idBuf.format(owner, "/", id)
  if plus
    fine = idBuf.push(43)
  end
  if count >= MOST or find(idBuf[0:idBuf.len()].asString()) >= 0
    return -1
  end
  n := count
  nameAt[n] = namesUsed
  for k in 0..<idBuf.len()
    names[namesUsed] = idBuf[k]
    namesUsed += 1
  end
  nameLen[n] = idBuf.len()
  place[n] = OWN
  titleAt[n] = titlesUsed
  colorText.clear()
  old := titles[titleAt[t]:titleAt[t] + titleLen[t]].asString()
  if plus
    fine = colorText.pushAll(old[0:min(old.len(), 24)])
  case keep
    fine = colorText.pushAll(id)
    rest := titleName(t).len()
    for k in rest..<min(old.len(), rest + 24 - colorText.len())
      fine = colorText.push(old[k])
    end
  else
    fine = colorText.format(id, ": from ")
    t2 := titleName(t)
    for k in 0..<min(t2.len(), 24 - colorText.len())
      fine = colorText.push(t2[k])
    end
  end
  for k in 0..<colorText.len()
    titles[titlesUsed + k] = colorText[k]
  end
  titleLen[n] = colorText.len()
  titlesUsed += titleLen[n]
  for r in 0..<ROLES
    colors[n * ROLES + r] = color(t, r)
  end
  count += 1
  if not save(n)
    count -= 1
    return -1
  end
  return n
end

# ---------------------------------------------------------------- the state: kept, for coming back from Colors

screen := LIST
pick := 0             # the theme picked in the list
top := 0
role := 0             # the role picked, editing
editing := -1         # the theme being edited
message: Blob[..64]
messageColor := 0
prompting := 0        # 0 none; 1 a name for a new one; 2 a new name for one of yours
input: Blob[..20]

say :: proc(s: String, c: Int)
  message.clear()
  fine = message.pushAll(s)
  messageColor = c
end
remember :: proc()
  state: Blob[..4]
  fine = state.push(screen)
  fine = state.push(pick)
  fine = state.push(role)
  ok := pc.stashWrite("view", state[0:state.len()].asString())
  if editing >= 0
    ok = pc.stashWrite("edit", nameOf(editing))
  end
end

# the colors Themes itself draws with: the current theme's (or, editing, the one being edited's)
ink :: proc(r: Int) -> Int
  return color(current, r)
end

follow :: proc()
  if pick < top
    top = pick
  end
  if pick >= top + LIST_ROWS
    top = pick - LIST_ROWS + 1
  end
  top = max(0, min(top, count - LIST_ROWS))
end

use :: proc(t: Int)
  if pc.settingWrite("theme", nameOf(t)) == 0
    current = t
    message.clear()
    fine = message.format("Using ", titleName(t), ": apps started from now")
    messageColor = ink(12)
  else
    say("Couldn't change the setting", ink(11))
  end
end

edit :: proc(t: Int)
  if place[t] == APPS # (locked: its copy, made the first time)
    probe: Blob[..80]
    fine = probe.format(nameOf(t), "+")
    c := find(probe[0:probe.len()].asString())
    if c < 0
      c = make(t, ownerOf(t), idOf(t), true, false)
    end
    if c < 0
      say("Couldn't make its copy", ink(11))
      return
    end
    t = c
    pick = c
    follow()
  end
  editing = t
  screen = EDIT
  role = 0
end

# Colors, to pick role's color; Themes starts again when it's done
pickColor :: proc()
  remember()
  args: Blob[..16]
  fine = args.format("pick ", colors[editing * ROLES + role])
  pc.call("colors", args[0:args.len()].asString())
end

nameOk :: proc(s: String) -> Bool
  if s.len() == 0 or s.len() > 20
    return false
  end
  for k in 0..<s.len()
    if not isNameChar(s[k]) and s[k] != 45
      return false
    end
  end
  return true
end

# a name typed: what it was for
answered :: proc()
  id := input[0:input.len()].asString()
  if not nameOk(id)
    say("A name is up to 20 letters, digits, _ and -", ink(11))
    return
  end
  if prompting == 1 # (a new one, from the one picked: yours, in Rinc's save space)
    n := make(pick, "rinc", id, false, false)
    if n < 0
      say("Couldn't make it: is that name taken?", ink(11))
      return
    end
    prompting = 0
    pick = n
    follow()
    edit(n)
    return
  end
  if prompting == 2 # (a new name, for one of yours: a copy gets a name of its own)
    old: Blob[..112]
    fine = old.pushAll(pathOf(pick))
    wasCurrent := pick == current
    n := make(pick, ownerOf(pick), id, false, true)
    if n < 0
      say("Couldn't rename it: is that name taken?", ink(11))
      return
    end
    made: Blob[..80]
    fine = made.pushAll(nameOf(n))
    gone := pc.fileDelete(old[0:old.len()].asString())
    findAll()
    pick = max(0, find(made[0:made.len()].asString()))
    if wasCurrent
      use(pick)
    end
    follow()
    prompting = 0
  end
end

# ---------------------------------------------------------------- starting, and coming back from Colors

findAll()
pick = max(0, current)
view: Blob[4]
viewLen := pc.stashRead("view", view[:])
editName: Blob[64]
editLen := pc.stashRead("edit", editName[:])
picked: Blob[8]
pickedLen := pc.result(picked[:])
if viewLen == 3
  screen = view[0]
  pick = min(view[1], max(count - 1, 0))
  role = min(view[2], ROLES - 1)
end
if editLen > 0 and editLen <= 64
  editing = find(editName[0:editLen].asString())
end
if screen == EDIT and editing < 0
  screen = LIST
end
if pickedLen > 0 and editing >= 0 and screen == EDIT # (Colors' answer: the role's new color)
  v := 0
  for k in 0..<min(pickedLen, 8)
    if picked[k] >= 48 and picked[k] <= 57
      v = v * 10 + picked[k] - 48
    end
  end
  if v < 256
    colors[editing * ROLES + role] = v
    if not save(editing)
      say("Couldn't save it", ink(11))
    end
  end
end
follow()
pc.pointer(pc.Pointer.ui)

# the role's color, a step on (up 1) or back (up 0), saved
step :: proc(up: Int)
  if editing < 0
    return
  end
  k := editing * ROLES + role
  colors[k] = (colors[k] + up * 2 - 1 + 256) % 256
  if not save(editing)
    say("Couldn't save it", ink(11))
  end
end

# ---------------------------------------------------------------- input

held := 0
repeat := 0
clicked := 0
still := 0
update* :: proc()
  c := pc.key()
  for c >= 0
    if prompting > 0
      if c == 13
        answered()
      case c == 27
        prompting = 0
        say("", 0)
      case c == 8
        if input.len() > 0
          input.pop()
        end
      case c >= 32 and c < 127 and input.len() < 20
        fine = input.push(c)
      end
    case screen == LIST
      if c == 13 and count > 0
        use(pick)
      case (c == 101 or c == 69) and count > 0 # e
        edit(pick)
      case (c == 110 or c == 78) and count > 0 # n
        prompting = 1
        input.clear()
      case (c == 114 or c == 82) and count > 0 and place[pick] == OWN # r
        prompting = 2
        input.clear()
        id := idOf(pick)
        fine = input.pushAll(id[0:id.len() - isCopy(pick).toInt()])
      case c == DELETE_KEY and count > 0
        if place[pick] == APPS
          say("Locked: it's an installed app's", ink(11))
        case pick == current
          say("It's in use: use another first", ink(11))
        else
          if pc.fileDelete(pathOf(pick)) == 0
            say("Deleted", ink(12))
          end
          findAll()
          pick = min(pick, max(count - 1, 0))
          follow()
        end
      end
    else
      if c == 13
        pickColor()
        return
      case c == 27
        screen = LIST
        message.clear()
      case c == LEFT_KEY or c == RIGHT_KEY
        step(c - LEFT_KEY)
      end
    end
    c = pc.key()
  end
  # the arrows (and the d-pad): up and down move, held they repeat; editing, left and right step colors
  bits := pc.btn(2) + pc.btn(3) * 2 + pc.btn(0) * 4 + pc.btn(1) * 8
  move := 0
  side := 0
  if bits != held
    repeat = 12
    move = (bits & 2) / 2 - (bits & 1)
    side = (bits & 8) / 8 - (bits & 4) / 4
  case bits != 0
    repeat -= 1
    if repeat == 0
      repeat = 4
      move = (bits & 2) / 2 - (bits & 1)
      side = (bits & 8) / 8 - (bits & 4) / 4
    end
  end
  held = bits
  if prompting == 0
    if screen == LIST and count > 0
      pick = (pick + move + count) % count
      follow()
    case screen == EDIT
      role = (role + move + ROLES) % ROLES
      if side != 0 and (bits & 12) != 0
        step((side + 1) / 2)
      end
    end
  end
  # a click: on a theme picks it (on the one picked, uses it); on a role, Colors for it
  click := pc.pointerDown(0)
  if click == 1 and clicked == 0 and prompting == 0
    x := pc.pointerX()
    y := pc.pointerY()
    if screen == LIST and x < PREVIEW_X - 4 and y >= 14
      t := top + (y - 14) / 12
      if t < count and t == pick
        use(t)
      case t < count
        pick = t
      end
    case screen == EDIT and x < PREVIEW_X - 4 and y >= 14
      r := (y - 14) / 9
      if r < ROLES and r == role
        pickColor()
      case r < ROLES
        role = r
      end
    end
  end
  clicked = click
  still += 1
  if move != 0 or side != 0
    still = 0
  end
  if still == 30
    remember()
  end
end

# ---------------------------------------------------------------- the screen

# what a theme looks like: a little of home, of code, and of messages, in its colors
rows := [3]String{"Chord", "Bounce", "Notes"}
about := [3]String{"8 voices", "a ball", "jot down"}
promptLabels := [2]String{"New theme, from this: ", "Rename to: "}
preview :: proc(t: Int, x: Int, y: Int)
  w := 316 - x
  pc.rect(x, y, w, 196, color(t, 0))
  pc.rect(x, y, w, 10, color(t, 1))
  pc.print("Home", x + 3, y + 1, color(t, 2))
  pc.print("3 apps", x + w - 39, y + 1, color(t, 5))
  pc.rect(x + 4, y + 13, 30, 1, color(t, 6))
  for i in 0..<3
    ry := y + 18 + i * 11
    if i == 1
      pc.rect(x + 3, ry - 2, w - 6, 11, color(t, 8))
    end
    pc.print(rows[i], x + 7, ry, color(t, 2))
    d := 4
    if i == 1
      d = 3
    end
    pc.print(about[i], x + 58, ry, color(t, d))
  end
  # code, as the editor colors it
  cy := y + 56
  pc.rect(x + 3, cy - 2, w - 6, 48, color(t, 13))
  pc.print("if", x + 6, cy, color(t, 16))
  pc.print("n", x + 24, cy, color(t, 14))
  pc.print(">", x + 36, cy, color(t, 15))
  pc.print("10", x + 48, cy, color(t, 19))
  pc.print("# big", x + 66, cy, color(t, 21))
  pc.print("log(", x + 12, cy + 10, color(t, 18))
  pc.print("\"hi\"", x + 36, cy + 10, color(t, 20))
  pc.print(")", x + 60, cy + 10, color(t, 15))
  pc.print("s", x + 12, cy + 20, color(t, 14))
  pc.print(":", x + 18, cy + 20, color(t, 15))
  pc.print("Blob", x + 30, cy + 20, color(t, 17))
  pc.print("end", x + 6, cy + 30, color(t, 16))
  pc.rect(x + 35, cy + 29, 31, 9, color(t, 9))
  pc.print("text", x + 36, cy + 30, color(t, 14))
  # text, as help shows it
  hy := y + 110
  pc.print("Heading", x + 4, hy, color(t, 6))
  pc.print("Another", x + 4, hy + 11, color(t, 7))
  pc.print("Some longer text", x + 4, hy + 22, color(t, 3))
  pc.print("a link", x + 4, hy + 33, color(t, 10))
  pc.rect(x + 4, hy + 41, 35, 1, color(t, 10))
  pc.print("a note", x + 50, hy + 33, color(t, 4))
  pc.print("Saved", x + 4, hy + 46, color(t, 12))
  pc.print("Can't", x + 46, hy + 46, color(t, 11))
  pc.rect(x, y + 186, w, 10, color(t, 1))
  pc.print("Enter open", x + 3, y + 187, color(t, 5))
end

swatch :: proc(t: Int, x: Int, y: Int)
  pc.rect(x, y, 18, 8, color(t, 0))
  pc.rect(x + 2, y + 3, 4, 2, color(t, 2))
  pc.rect(x + 7, y + 3, 4, 2, color(t, 6))
  pc.rect(x + 12, y + 3, 4, 2, color(t, 16))
end

drawList :: proc()
  for row in 0..<min(count - top, LIST_ROWS)
    t := top + row
    y := 16 + row * 12
    if t == pick
      pc.rect(2, y - 2, PREVIEW_X - 6, 12, ink(8))
    end
    if t == current
      pc.rect(0, y - 1, 2, 9, ink(6))
    end
    swatch(t, 5, y)
    name := titleName(t)
    pc.print(name[0:min(name.len(), 17)], 27, y, ink(2))
    if isCopy(t) # (a locked theme's copy, until it's renamed)
      pc.print("+", 27 + min(name.len(), 17) * 6, y, ink(6))
    end
  end
  if count == 0
    pc.print("No themes: install rinc", 6, 16, ink(4))
  end
  if count > 0
    preview(pick, PREVIEW_X, 14)
  end
end

drawEdit :: proc()
  t := editing
  for r in 0..<ROLES
    y := 16 + r * 9
    if r == role
      pc.rect(2, y - 1, PREVIEW_X - 6, 9, ink(8))
    end
    c := colors[t * ROLES + r]
    pc.rect(5, y, 14, 7, 0)
    pc.rect(6, y + 1, 12, 5, c)
    pc.print(roleNames[r], 24, y, ink(2))
    n: Blob[..4]
    fine = n.format(c)
    pc.print(n[0:n.len()].asString(), PREVIEW_X - 10 - n.len() * 6, y, ink(4))
  end
  preview(t, PREVIEW_X, 14)
end

draw* :: proc()
  pc.cls(ink(0))
  pc.rect(0, 0, 320, 11, ink(1))
  if screen == EDIT and editing >= 0
    pc.print(titleName(editing), 3, 2, ink(6))
    pc.print(nameOf(editing), 317 - nameLen[editing] * 6, 2, ink(4))
    drawEdit()
  else
    pc.print("Themes", 3, 2, ink(6))
    if count > 0
      pc.print(nameOf(pick), 317 - nameLen[pick] * 6, 2, ink(4))
    end
    drawList()
  end
  pc.rect(0, 216, 320, 24, ink(1))
  if prompting > 0
    label := promptLabels[prompting - 1]
    pc.print(label, 3, 219, ink(6))
    pc.print(input[0:input.len()].asString(), 3 + label.len() * 6, 219, ink(2))
    pc.rect(3 + (label.len() + input.len()) * 6, 218, 1, 9, ink(6))
    pc.print("Enter: done  Esc: no", 3, 230, ink(5))
  else
    if message.len() > 0
      pc.print(message[0:message.len()].asString(), 3, 219, messageColor)
    end
    if screen == EDIT
      pc.print("Enter pick  Left/Right step  Esc back", 3, 230, ink(5))
    else
      pc.print("Enter use  E edit  N new  R rename  Del", 3, 230, ink(5))
    end
  end
end
