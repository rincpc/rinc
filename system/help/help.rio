# Help: Rinc's and Rio's docs, and other help texts
#
# Reads the help texts a Rinc has (pc.helps: its own, rinc/..., and Rio's, rio/..., in the firmware;
# more in storage, /rinc/help/name.md), rendered from Markdown: headings, lists, tables, code, and links
# to follow. Up and down, Page Up and Down, Home and End scroll; Tab and Shift+Tab pick a link, Enter
# follows it, Backspace or Esc (or Alt+Left) goes back and Alt+Right forward, Alt+Up goes up to the
# contents (a set's, then all), and Ctrl+O shows all the contents. With a mouse: click a link, the
# wheel scrolls, the right button goes back. With a controller: the d-pad scrolls (left and right, or LB
# and RB, pick links), A follows, B goes back; or the left stick points, the right one scrolls, and A
# clicks. Other apps open it at a text, and a heading in it, with pc.help("rio/spec/statements#if").

COLS :: 52            # characters a row, 6 pixels each
ROWS :: 24            # rows, 9 pixels each
TOP_Y :: 12
TEXT_X :: 4
SRC :: 24576          # the most of a text read
OUT :: 24576          # and rendered
LINES :: 2048         # rendered lines, before wrapping
SHOWN :: 3072         # rows, wrapped
LINKS :: 256
HEADS :: 160

# styles, a byte for each character rendered
PLAIN :: 0
H1 :: 1
H2 :: 2
H3 :: 3
CODE :: 4
BLOCK :: 5
BOLD :: 6
EM :: 7
LINK :: 8
DIM :: 9

# colors: the theme's, for each role (pc.Role)
backColor := pc.theme(pc.Role.bg)
codeBackColor := pc.theme(pc.Role.codeBg)
barColor := pc.theme(pc.Role.bar)
textColor := pc.theme(pc.Role.text)
softColor := pc.theme(pc.Role.soft)
dimColor := pc.theme(pc.Role.dim)
faintColor := pc.theme(pc.Role.faint)
accentColor := pc.theme(pc.Role.accent)
headingColor := pc.theme(pc.Role.heading)
pickColor := pc.theme(pc.Role.pick)
linkColor := pc.theme(pc.Role.link)
codeColor := pc.theme(pc.Role.code)

styleColor :: proc(s: Int) -> Int
  switch
  case s == H1
    return accentColor
  case s == H2 or s == H3 or s == EM
    return headingColor
  case s == CODE or s == BLOCK
    return codeColor
  case s == BOLD
    return textColor
  case s == LINK
    return linkColor
  case s == DIM
    return dimColor
  end
  return softColor
end

# ---------------------------------------------------------------- its parts

include "parts/text.rio"
include "parts/reading.rio"
include "parts/moving.rio"
include "parts/screen.rio"

# where it was asked to open (pc.help), else the contents
topic: Blob[96]
topicLen := min(pc.helpTopic(topic[0..<96]), 96)
hash := topicLen
for k in 0..<topicLen
  if topic[k] == 35 and hash == topicLen
    hash = k
  end
end
if topicLen > 0 and open(topic[0..<hash], topic[min(hash + 1, topicLen)..<topicLen])
  histLen = 0 # (opened at a topic: a fresh history, from there)
else
  if not restorePlace()
    ok := open(doc[0..<0], doc[0..<0])
  end
end
if histLen == 0
  ok := histName[0].pushAll(doc[0..<doc.len()]) # (where it's been: here)
  histLen = 1
  histAt = 0
end
