# Colors: the colors as numbers and RGB, and the cube's view: where things are, and moving over them (part of colors.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- the color picked

cubeColor :: proc(r: Int, g: Int, b: Int) -> Int
  return 32 + 36 * r + 6 * g + b
end
# the color picked, as a palette number
picked :: proc() -> Int
  if view == HUE_VIEW
    return hue
  end
  switch area
  case PICO
    return onPico.y * 16 + onPico.x
  case GRAYS
    return grays[gray]
  end
  return cubeColor(pos[0], pos[1], pos[2])
end

# a color's RGB, as 0xRRGGBB (docs/spec/screen.md's palette)
rgb :: proc(c: Int) -> Int
  if c < 32
    return pico[c]
  case c < 248
    k := c - 32
    return levels[k / 36] * 65536 + levels[k / 6 % 6] * 256 + levels[k % 6]
  end
  return grayLevels[c - 248] * 65793
end

# the face's channels: across, and down (its slices are the depth's steps)
across :: proc() -> Int
  return (axis + 2) % 3
end
down :: proc() -> Int
  return (axis + 1) % 3
end

# going to a color in the cube's view, wherever it is: PICO-8's, a gray, else the cube (or the cube
# first, for the grays it has too)
pickColor :: proc(c: Int, cubeFirst: Bool)
  if not cubeFirst and c < 32
    area = PICO
    onPico = {c % 16, c / 16}
    return
  end
  for i in 0..<14
    if not cubeFirst and grays[i] == c
      area = GRAYS
      gray = i
      return
    end
  end
  if c >= 32 and c < 248
    k := c - 32
    area = CUBE
    pos[0] = k / 36
    pos[1] = k / 6 % 6
    pos[2] = k % 6
  end
end

# ---------------------------------------------------------------- where things are

# gray i, as a box: 14 across, each as wide as its share of the span
grayRect :: proc(i: Int) -> pc.Rect
  at := grayPos.x + i * SPAN / 14
  return pc.Rect.of({at, grayPos.y}, {grayPos.x + (i + 1) * SPAN / 14 - at, 12})
end
# the nearest of each, under a point across: for moving up and down between them
picoAt :: proc(x: Int) -> Int
  return clamp((x - picoPos.x) / picoCell.x, 0, 15)
end
grayAt :: proc(x: Int) -> Int
  return clamp((x - grayPos.x) * 14 / SPAN, 0, 13)
end
faceAt :: proc(x: Int) -> Int
  return clamp((x - facePos.x) / CELL, 0, 5)
end
# the middle, across, of what's picked
pickedX :: proc() -> Int
  switch area
  case PICO
    return picoPos.x + onPico.x * picoCell.x + 9
  case GRAYS
    r := grayRect(gray)
    return r.pos.x + r.size.x / 2
  end
  return facePos.x + pos[across()] * CELL + CELL / 2
end

# ---------------------------------------------------------------- moving

clampStep :: proc(v: Int) -> Int
  return clamp(v, 0, 5)
end

# a step d (across, down): within an area, and up and down between them
moveInCube :: proc(d: [2]Int)
  if d.x != 0
    switch area
    case PICO
      onPico.x = clamp(onPico.x + d.x, 0, 15)
    case GRAYS
      gray = clamp(gray + d.x, 0, 13)
    else
      pos[across()] = clampStep(pos[across()] + d.x)
    end
  end
  if d.y != 0
    x := pickedX()
    switch area
    case PICO
      if d.y > 0 and onPico.y == 1
        area = GRAYS
        gray = grayAt(x)
      else
        onPico.y = clamp(onPico.y + d.y, 0, 1)
      end
    case GRAYS
      if d.y < 0
        area = PICO
        onPico = {picoAt(x), 1}
      else
        area = CUBE
        pos[across()] = faceAt(x)
        pos[down()] = 0
      end
    else
      if d.y < 0 and pos[down()] == 0
        area = GRAYS
        gray = grayAt(x)
      else
        pos[down()] = clampStep(pos[down()] + d.y)
      end
    end
  end
end

deeper :: proc(d: Int)   # (in the cube: elsewhere, the depth's for nothing)
  if view == CUBE_VIEW and area == CUBE
    pos[axis] = clampStep(pos[axis] + d)
  end
end

turn :: proc()
  if view == CUBE_VIEW
    axis = (axis + 1) % 3
  end
end
