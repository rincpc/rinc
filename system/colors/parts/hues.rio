# Colors: the view by hue, and what a color is as OKLCH (part of colors.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- by hue

# the color at each cell (-1: none), from each color's cell
colorAt: [COLS * ROWS]Int
for i in 0..<COLS * ROWS
  colorAt[i] = -1
end
for c in 0..<256
  colorAt[hueCells[c]] = c
end

# color c's cell in the grid: {column, row}
hueCell :: proc(c: Int) -> [2]Int do return {hueCells[c] % COLS, hueCells[c] / COLS}
grid := pc.Rect.of({0, 0}, {COLS, ROWS}) # (in cells)

# the nearest color that way, d: the first step out with one in reach (as far to the side as it's gone
# along), the one least to the side
moveInHues :: proc(d: [2]Int)
  at := hueCell(hue)
  for k in 1..<COLS
    best := -1
    side := 0
    for o in -k..=k
      c := at + d * k + d.yx * o # (k along d, o to the side)
      if grid.has(c) and colorAt[c.y * COLS + c.x] >= 0 and (best < 0 or abs(o) < abs(side))
        best = colorAt[c.y * COLS + c.x]
        side = o
      end
    end
    if best >= 0
      hue = best
      return
    end
  end
end

# the color under point p, picked (true: there was one)
pointAtHue :: proc(p: [2]Int) -> Bool
  c := (p - huePos) / HUE_CELL
  if not hueBox.has(p) or colorAt[c.y * COLS + c.x] < 0
    return false
  end
  hue = colorAt[c.y * COLS + c.x]
  return true
end

# the other view, at the same color
setView :: proc(v: Int)
  if v == view
    return
  end
  if v == HUE_VIEW
    hue = picked()
  else
    pickColor(hue, false)
  end
  view = v
end

# ---------------------------------------------------------------- OKLCH: lightness, chroma, hue

# a color as OKLCH (Björn Ottosson's OKLab, from sRGB, round): lightness 0 to 1, chroma (0.37 at most
# here), and hue in degrees
okL := 0.0
okC := 0.0
okH := 0.0
linear :: proc(v: Int) -> Float
  c := v.toFloat() / 255.0
  if c <= 0.04045
    return c / 12.92
  end
  return pow((c + 0.055) / 1.055, 2.4)
end
oklch :: proc(color: Int)
  v := rgb(color)
  r := linear(v / 65536)
  g := linear(v / 256 % 256)
  b := linear(v % 256)
  l := pow(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b, 1.0 / 3.0)
  m := pow(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b, 1.0 / 3.0)
  s := pow(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b, 1.0 / 3.0)
  okL = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
  a := 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
  bb := 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
  okC = sqrt(a * a + bb * bb)
  okH = atan2(bb, a) * 180.0 / 3.14159265
  if okH < 0.0
    okH += 360.0
  end
end
