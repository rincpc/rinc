# Colors: being called, the stash, and keys, buttons and the pointer (part of colors.rio, included there, in order: the names it uses are declared before it)

TAB :: 9              # keys, as pc.key() gives them
SHIFT_TAB :: 265      # (Tab with the Shift bit, 256)
ENTER :: 13
ESC :: 27
LEFT_KEY :: 128
RIGHT_KEY :: 129
UP_KEY :: 130
DOWN_KEY :: 131
PAGE_UP :: 135
PAGE_DOWN :: 136

# ---------------------------------------------------------------- called, and the stash

calledFor := false    # (a caller waits for a color)
leaving := false
finish :: proc(result: String)
  leaving = true
  pc.done(result)
end
# text, made up: numbers onto it in decimal, and in hex
text: Blob[..32]
pushNumber :: proc(v: Int)
  step := 1
  for step * 10 <= v
    step *= 10
  end
  for step > 0
    ok := text.push('0' + v / step % 10)
    step /= 10
  end
end
pushHex :: proc(v: Int, digits: Int)
  for i in 0..<digits
    d := v
    for _ in 0..<digits - 1 - i
      d /= 16
    end
    d %= 16
    if d < 10
      ok := text.push('0' + d)
    else
      ok := text.push('A' + d - 10)
    end
  end
end

choose :: proc()
  if calledFor
    text.clear()
    pushNumber(picked)
    finish(text[].asString())
  end
end

stashed: Blob[1]      # where it was: the color
saved := -1
last := -1
still := 0
remember :: proc()   # (once it's rested a moment: not each step of a drag or a held arrow)
  if picked != last
    last = picked
    still = 0
  end
  still += 1
  if still == 30 and picked != saved
    saved = picked
    stashed[0] = picked
    ok := pc.stashWrite("pick", stashed[].asString())
  end
end

# ---------------------------------------------------------------- keys, buttons and the pointer

# an arrow typed but not held as a button (a terminal's, say): the buttons, below, take the rest
key :: proc(c: Int)
  k := c & 255
  if c < 1024 and k >= LEFT_KEY and k <= DOWN_KEY and pc.btn(k - LEFT_KEY) == 0
    switch k
    case LEFT_KEY
      move({-1, 0})
    case RIGHT_KEY
      move({1, 0})
    case UP_KEY
      move({0, -1})
    else
      move({0, 1})
    end
    return
  end
  switch c
  case TAB, SHIFT_TAB
    otherHalf()
  case PAGE_UP
    move({0, -4})
  case PAGE_DOWN
    move({0, 4})
  case ENTER
    choose()
  case ESC
    if calledFor
      finish("")
    end
  end
end

# the big color: a click there chooses it
onBig :: proc(p: [2]Int) -> Bool do return pc.Rect.of(infoPos, infoSize).has(p)

held := 0
repeat := 0
clicked := 0
pc.pointer(pc.Pointer.ui)
update* :: proc()
  c := pc.key()
  for c >= 0
    key(c)
    c = -1
    if not leaving # (gone back to its caller: the rest typed is its)
      c = pc.key()
    end
  end
  if leaving
    return
  end
  # the arrows and the d-pad, as buttons: a step a press, then more while it's held; Y, the other half
  bits := pc.btn(0) + pc.btn(1) * 2 + pc.btn(2) * 4 + pc.btn(3) * 8 + pc.btn(7) * 16
  pressed := bits & ~held
  step := false
  if bits & 15 != held & 15
    repeat = 15
    step = true
  case bits & 15 != 0
    repeat -= 1
    if repeat == 0
      repeat = 4
      step = true
    end
  end
  held = bits
  if step
    move({(bits & 2) / 2 - (bits & 1), (bits & 8) / 8 - (bits & 4) / 4})
  end
  if pressed & 16 != 0
    otherHalf()
  end
  # the pointer: held down over a color picks it (a drag goes through them); pressed on the one
  # already picked, or the big one, chooses it; the secondary button, the other half
  click := pc.pointerDown(0) + pc.pointerDown(1) * 2
  p := pc.pointerAt()
  if click & 1 != 0
    was := picked
    over := pointAt(p)
    if clicked & 1 == 0 and ((over and picked == was) or onBig(p))
      choose()
    end
  end
  if click & 2 != 0 and clicked & 2 == 0
    otherHalf()
  end
  clicked = click
  s := pc.scroll(1)
  if s != 0
    move({0, -s})
  end
  remember()
end
