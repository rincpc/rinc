# Colors: the screen (part of colors.rio, included there, in order: the names it uses are declared before it)

# a line around a box, just outside it
outline :: proc(r: pc.Rect, c: Int)
  at := r.pos - 1
  far := r.corner()
  pc.rect(at, {r.size.x + 2, 1}, c)
  pc.rect({at.x, far.y}, {r.size.x + 2, 1}, c)
  pc.rect({at.x, r.pos.y}, {1, r.size.y}, c)
  pc.rect({far.x, r.pos.y}, {1, r.size.y}, c)
end
# a frame around what's picked: white, then black inside, to show on any color
frame :: proc(r: pc.Rect)
  outline(r, 7)
  outline(pc.Rect.of(r.pos + 1, r.size - 2), 0)
end

# the text color for what's picked, else the faint one
brightIf :: proc(on: Bool) -> Int
  if on
    return textColor
  end
  return faintColor
end
# a half's name: the tints' warm and cool, a hue's vivid and muted
halfName :: proc(row: Int, first: Bool) -> String
  if row == 14
    if first
      return "warm"
    end
    return "cool"
  end
  if first
    return "vivid"
  end
  return "muted"
end

# what the color picked is, a line each from at down: its number, its RGB, its band and its step there,
# and as OKLCH (lightness and chroma, out of 100, and hue: none, for a gray)
describe :: proc(at: [2]Int)
  c := picked
  row := c / 16
  step := c % 8 + 1
  text.clear()
  _ = text.pushAll("color ")
  pushNumber(c)
  pc.print(text[].asString(), at, textColor)
  text.clear()
  _ = text.pushAll("#")
  pushHex(pc.rgb(c), 6)
  pc.print(text[].asString(), at + {0, 10}, softColor)
  text.clear()
  if row < 2
    _ = text.pushAll("PICO-8 ")
    pushNumber(c % 16 + row * 128)
  case row == 15
    _ = text.pushAll("gray ")
    pushNumber(c % 16 + 1)
    _ = text.pushAll("/16")
  else
    _ = text.pushAll(halfName(row, c % 16 < 8))
    _ = text.push(' ')
    pushNumber(step)
    _ = text.pushAll("/8")
  end
  pc.print(text[].asString(), at + {0, 20}, softColor)
  oklch(c)
  text.clear()
  _ = text.pushAll("L ")
  pushNumber((okL * 100.0 + 0.5).toInt())
  _ = text.pushAll(" C ")
  pushNumber((okC * 100.0 + 0.5).toInt())
  pc.print(text[].asString(), at + {0, 30}, softColor)
  if okC >= 0.03
    text.clear()
    _ = text.pushAll("h ")
    pushNumber((okH + 0.5).toInt() % 360)
    pc.print(text[].asString(), at + {0, 40}, softColor)
  end
end

draw* :: proc()
  pc.cls(backColor)
  # the colors, on the gray behind them
  far := cellPos(255) + CELL
  pc.rect(gridPos - 4, far - gridPos + 8, behind)
  for c in 0..<256
    pc.rect(cellPos(c), {CELL - 1, CELL - 1}, c)
  end
  frame(cellRect(picked))
  # each band's name, at its left: the picked one's brighter
  row := picked / 16
  for r in 0..<16
    pc.print(names[r], {4, cellPos(r * 16).y + 2}, brightIf(r == row))
  end
  # the color, big, and what it is
  pc.rect(infoPos - 3, infoSize + 6, behind)
  pc.rect(infoPos, infoSize, picked)
  describe(infoPos + {0, infoSize.y + 8})
  if calledFor
    pc.print("arrows  Tab vivid/muted  Enter pick", {8, 228}, faintColor)
  else
    pc.print("arrows  Tab vivid/muted", {8, 228}, faintColor)
  end
end
