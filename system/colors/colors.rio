# Colors: Rinc's 256 colors, to look through and pick from
#
# One view: all 256 in their numbers' order, 16 a row, each row a band. PICO-8's 32 at the top (0 to 15,
# and under each its partner, 16 to 31); then each hue's row, red round to crimson: 8 vivid, dark to
# light, then 8 muted; then the tints (8 warm, 8 cool) and the grays, dark to light. The arrows (or the
# d-pad) move over them, Tab (Y) goes between a hue's vivid and muted, the wheel goes up and down, and a
# click or a drag picks. Called with pc.call("colors", "pick"), or "pick 12" to start at a color, it's a
# picker: Enter (A, or a click on the color picked) gives its number back as text (pc.done), Esc nothing.

CELL :: 12            # each color's square
BAND_GAP :: 3         # between PICO-8's, the hues, and the tints and grays
gridPos := {52, 12}   # the colors' top left
infoPos := {256, 12}  # the color, big, and under it what it is
infoSize := {58, 40}
names := [16]String{"PICO-8", "secret", "red", "orange", "yellow", "lime", "green", "teal", "cyan", "azure",
  "blue", "violet", "magenta", "crimson", "tints", "grays"}

# colors: the theme's, for the screen and its text
backColor := pc.theme(pc.Role.bg)
textColor := pc.theme(pc.Role.text)
softColor := pc.theme(pc.Role.soft)
faintColor := pc.theme(pc.Role.faint)

picked := 37          # the color picked (red's sixth vivid step)

include "parts/grid.rio"
include "parts/keys.rio"
include "parts/screen.rio"

# ---------------------------------------------------------------- starting

args: Blob[16]
argsIn: Blob[..] = args
argsLen := min(pc.args(argsIn), 16)
start := -1
if argsLen >= 4 and args[0..<4].asString() == "pick" # (pick, or pick 12)
  calledFor = true
  for i in 5..<argsLen
    if args[i] >= '0' and args[i] <= '9' and start < 256
      start = max(start, 0) * 10 + args[i] - '0'
    end
  end
end
back: Blob[..4]
_ = pc.stashRead("pick", back)
if back.len() >= 1
  picked = back[0]
end
if start >= 0 and start < 256
  picked = start
end
