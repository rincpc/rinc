# Help: Rinc's and Rio's docs, and other help texts
#
# Reads the help texts a Rinc has (pc.helps: its own, rinc/..., and Rio's, rio/..., in the firmware;
# more in storage, /rinc/help/name.md), rendered from Markdown: headings, lists, tables, code, and links
# to follow. Up and down, Page Up and Down, Home and End scroll; Tab and Shift+Tab pick a link, Enter
# follows it, Backspace or Esc goes back; Ctrl+O shows the contents. With a controller: the d-pad
# scrolls (left and right pick links), A follows, B goes back. Other apps open it at a text, and a
# heading in it, with pc.help("rio/spec/statements#if").

COLS :: 52            # characters a row, 6 pixels each
ROWS :: 24            # rows, 9 pixels each
TOP_Y :: 12
TEXT_X :: 4
SRC :: 24576          # the most of a text read
OUT :: 24576          # and rendered
LINES :: 2048         # rendered lines, before wrapping
SHOWN :: 3072         # rows, wrapped
LINKS :: 256
HEADS :: 160

# styles, a byte for each character rendered
PLAIN :: 0
H1 :: 1
H2 :: 2
H3 :: 3
CODE :: 4
BLOCK :: 5
BOLD :: 6
EM :: 7
LINK :: 8
DIM :: 9

# colors
BACK :: 1
CODE_BACK :: 17
BAR :: 0
TEXT :: 6
WHITE :: 7

styleColor :: proc(s: Int) -> Int
  switch
  case s == H1
    return 10
  case s == H2
    return 9
  case s == H3
    return 15
  case s == CODE
    return 26
  case s == BLOCK
    return 11
  case s == BOLD
    return WHITE
  case s == EM
    return 14
  case s == LINK
    return 12
  case s == DIM
    return 13
  end
  return TEXT
end

# ---------------------------------------------------------------- the text and what it renders to

src: Blob[24576]
srcLen := 0
out: Blob[24576]       # rendered characters
sty: Blob[24576]       # and their styles
outLen := 0
logAt: [2048]Int       # each rendered line: where it starts in out
logIndent: [2048]Int   # its wrapped rows' indent
logBack: [2048]Int     # its background (0: none)
logCount := 0
rowAt: [3072]Int       # each row on screen: where it starts in out, how long, its indent and background
rowLen: [3072]Int
rowIndent: [3072]Int
rowBack: [3072]Int
rowOfLog: [2048]Int    # each rendered line's first row
rowCount := 0
linkFrom: [256]Int     # each link: its characters in out
linkTo: [256]Int
targetAt: [256]Int     # and where it goes, in targets
targetLen: [256]Int
targets: Blob[8192]
targetsLen := 0
linkCount := 0
headLog: [160]Int      # each heading: its rendered line, and its anchor (as GitHub and mdbook make them)
slugAt: [160]Int
slugLen: [160]Int
slugs: Blob[4096]
slugsLen := 0
headCount := 0

emit :: proc(c: Int, s: Int)
  if outLen < OUT
    out[outLen] = c
    sty[outLen] = s
    outLen += 1
  end
end

# a new rendered line, its wrapped rows indented by indent
newLine :: proc(indent: Int, back: Int)
  if logCount < LINES
    logAt[logCount] = outLen
    logIndent[logCount] = indent
    logBack[logCount] = back
    logCount += 1
  end
end

# a blank line between blocks, unless there's one already (or nothing yet)
blank :: proc()
  if logCount == 0
    return
  end
  if logAt[logCount - 1] == outLen # (a blank line there already)
    return
  end
  newLine(0, 0)
end

# the position of byte c in src[a:b], or -1
find :: proc(c: Int, a: Int, b: Int) -> Int
  for i in a..<b
    if src[i] == c
      return i
    end
  end
  return -1
end

# src[a:b] starts with s?
startsWith :: proc(a: Int, b: Int, s: String) -> Bool
  if b - a < s.len()
    return false
  end
  for i in 0..<s.len()
    if src[a + i] != s[i]
      return false
    end
  end
  return true
end

# src[a:b] rendered inline, in base style: `code`, **bold**, *emphasis*, [links](to), \escapes
inline :: proc(a: Int, b: Int, base: Int)
  i := a
  for i < b
    c := src[i]
    switch
    case c == 96 # `code`
      e := find(96, i + 1, b)
      if e < 0
        emit(c, base)
        i += 1
      else
        for k in i + 1..<e
          emit(src[k], CODE)
        end
        i = e + 1
      end
    case c == 42 and i + 1 < b and src[i + 1] == 42 # **bold**
      e := i + 2
      for e + 1 < b and not (src[e] == 42 and src[e + 1] == 42)
        e += 1
      end
      if e + 1 >= b
        emit(c, base)
        i += 1
      else
        for k in i + 2..<e
          emit(src[k], BOLD)
        end
        i = e + 2
      end
    case c == 42 and i + 1 < b and src[i + 1] != 32 # *emphasis*
      e := find(42, i + 1, b)
      if e < 0
        emit(c, base)
        i += 1
      else
        for k in i + 1..<e
          emit(src[k], EM)
        end
        i = e + 1
      end
    case c == 91 # [text](to)
      e := find(93, i + 1, b)
      if e < 0 or e + 1 >= b or src[e + 1] != 40
        emit(c, base)
        i += 1
      else
        t := find(41, e + 2, b)
        if t < 0
          emit(c, base)
          i += 1
        else
          if linkCount < LINKS and targetsLen + (t - e - 2) <= 8192
            linkFrom[linkCount] = outLen
            targetAt[linkCount] = targetsLen
            for k in e + 2..<t
              targets[targetsLen] = src[k]
              targetsLen += 1
            end
            targetLen[linkCount] = t - e - 2
          end
          k := i + 1
          for k < e
            if src[k] != 96
              emit(src[k], LINK)
            end
            k += 1
          end
          if linkCount < LINKS
            linkTo[linkCount] = outLen
            linkCount += 1
          end
          i = t + 1
        end
      end
    case c == 60 and startsWith(i, b, "<!--") # (a comment)
      e := i + 4
      for e + 2 < b and not (src[e] == 45 and src[e + 1] == 45 and src[e + 2] == 62)
        e += 1
      end
      i = min(b, e + 3)
    case c == 92 and i + 1 < b # \escaped
      emit(src[i + 1], base)
      i += 2
    else
      emit(c, base)
      i += 1
    end
  end
end

# the end of the line starting at a (its newline, or the text's end)
lineEnd :: proc(a: Int) -> Int
  e := a
  for e < srcLen and src[e] != 10
    e += 1
  end
  return e
end

# the line's end, without a \r or spaces at the end
trimEnd :: proc(a: Int, e: Int) -> Int
  k := e
  for k > a and (src[k - 1] == 13 or src[k - 1] == 32)
    k -= 1
  end
  return k
end

spaces :: proc(a: Int, e: Int) -> Int
  k := a
  for k < e and src[k] == 32
    k += 1
  end
  return k - a
end

# a heading's anchor: its rendered text, lowercase, spaces as -, other punctuation left out
addHead :: proc(from: Int)
  if headCount >= HEADS
    return
  end
  headLog[headCount] = logCount - 1
  slugAt[headCount] = slugsLen
  for k in from..<outLen
    c := out[k]
    if c >= 65 and c <= 90
      c += 32
    end
    if c == 32
      c = 45
    end
    if ((c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45 or c == 95) and slugsLen < 4096
      slugs[slugsLen] = c
      slugsLen += 1
    end
  end
  slugLen[headCount] = slugsLen - slugAt[headCount]
  headCount += 1
end

# is the line at a..e a table's |---|---| row?
ruleRow :: proc(a: Int, e: Int) -> Bool
  for k in a..<e
    c := src[k]
    if c != 124 and c != 45 and c != 58 and c != 32
      return false
    end
  end
  return true
end

# the rendered lines as rows on the screen, each wrapped at a space to fit
wrap :: proc()
  rowCount = 0
  for l in 0..<logCount
    a := logAt[l]
    e := outLen
    if l + 1 < logCount
      e = logAt[l + 1]
    end
    rowOfLog[l] = rowCount
    indent := 0
    first := true
    for first or a < e
      width := COLS - indent
      n := min(width, e - a)
      if a + n < e and logBack[l] == 0 # (break at the last space that fits)
        k := n
        for k > 0 and out[a + k] != 32
          k -= 1
        end
        if k > 0
          n = k
        end
      end
      if rowCount < SHOWN
        rowAt[rowCount] = a
        rowLen[rowCount] = n
        rowIndent[rowCount] = indent
        rowBack[rowCount] = logBack[l]
        rowCount += 1
      end
      a += n
      if a < e and out[a] == 32 and logBack[l] == 0
        a += 1
      end
      indent = logIndent[l]
      first = false
    end
  end
end

# src[0:srcLen] as Markdown, into out
render :: proc()
  outLen = 0
  logCount = 0
  linkCount = 0
  targetsLen = 0
  headCount = 0
  slugsLen = 0
  a := 0
  inCode := false
  inPara := false   # a paragraph (or list item) is open: the next line joins it
  tableRow := 0     # rows of the table so far
  for a < srcLen
    e0 := lineEnd(a)
    e := trimEnd(a, e0)
    lead := spaces(a, e)
    s := a + lead
    next := e0 + 1
    switch
    case startsWith(s, e, "```")
      if inCode
        inCode = false
        blank()
      else
        blank()
        inCode = true
      end
      inPara = false
    case inCode
      newLine(0, CODE_BACK)
      for k in a..<e
        emit(src[k], BLOCK)
      end
    case startsWith(s, e, "<!--") # (a comment, to its end)
      k := s
      for k + 2 < srcLen and not (src[k] == 45 and src[k + 1] == 45 and src[k + 2] == 62)
        k += 1
      end
      next = lineEnd(k) + 1
    case s == e # (a blank line: the block ends)
      inPara = false
      tableRow = 0
    case src[s] == 35 # a heading
      level := 0
      for s + level < e and src[s + level] == 35
        level += 1
      end
      blank()
      newLine(0, 0)
      from := outLen
      style := H3
      if level == 1
        style = H1
      case level == 2
        style = H2
      end
      inline(min(e, s + level + 1), e, style)
      addHead(from)
      blank()
      inPara = false
    case src[s] == 124 # a table's row: its cells, a | between
      if tableRow == 0
        blank()
      end
      if not ruleRow(s, e)
        newLine(2, 0)
        k := s + 1
        first := true
        for k < e
          c := find(124, k, e)
          if c < 0
            c = e
          end
          from := k + spaces(k, c)
          to := trimEnd(from, c)
          if from < to
            if not first
              emit(32, DIM)
              emit(124, DIM)
              emit(32, DIM)
            end
            style := PLAIN
            if tableRow == 0
              style = BOLD
            end
            inline(from, to, style)
            first = false
          end
          k = c + 1
        end
        tableRow += 1
      end
      inPara = false
    case (src[s] == 45 or src[s] == 42) and s + 1 < e and src[s + 1] == 32 # a list item
      if not inPara
        blank()
      end
      newLine(lead + 2, 0)
      for k in 0..<lead
        emit(32, PLAIN)
      end
      emit(45, DIM)
      emit(32, PLAIN)
      inline(s + 2, e, PLAIN)
      inPara = true
    case src[s] >= 48 and src[s] <= 57 and find(46, s, min(e, s + 4)) > s and find(46, s, min(e, s + 4)) + 1 < e and src[find(46, s, min(e, s + 4)) + 1] == 32 # 1. a numbered item
      d := find(46, s, e)
      if not inPara
        blank()
      end
      newLine(lead + d - s + 2, 0)
      for k in a..<d + 1
        emit(src[k], DIM)
      end
      emit(32, PLAIN)
      inline(d + 2, e, PLAIN)
      inPara = true
    case src[s] == 62 # > a quote
      if not inPara
        blank()
        newLine(2, 0)
        emit(124, DIM)
        emit(32, PLAIN)
      else
        emit(32, PLAIN)
      end
      inline(min(e, s + 2), e, PLAIN)
      inPara = true
    case startsWith(s, e, "---") and ruleRow(s, e)
      blank()
      newLine(0, 0)
      for k in 0..<COLS
        emit(45, DIM)
      end
      blank()
      inPara = false
    else # a paragraph's line (or a list item's, going on)
      if inPara
        emit(32, PLAIN)
      else
        blank()
        newLine(0, 0)
      end
      inline(s, e, PLAIN)
      inPara = true
    end
    a = next
  end
  wrap()
end

# ---------------------------------------------------------------- reading, and where it's been

doc: Blob[..64]        # the help text shown ("": the contents)
top := 0               # the first row shown
pick := -1             # the link picked
message: Blob[..53]
backName: [16]Blob[..64]
backTop: [16]Int
backCount := 0

names: Blob[8192]      # the help texts there are
nameAt: [128]Int
nameLen: [128]Int
nameCount := 0

say :: proc(s: String)
  message.clear()
  for c in s
    if message.len() < 53
      ok := message.push(c)
    end
  end
end

addSrc :: proc(s: String)
  for c in s
    if srcLen < SRC
      src[srcLen] = c
      srcLen += 1
    end
  end
end
addSrcBlob :: proc(s: Blob)
  for c in s
    if srcLen < SRC
      src[srcLen] = c
      srcLen += 1
    end
  end
end

# is help text i in set (its first part)?
inSet :: proc(i: Int, set: Blob) -> Bool
  n := nameLen[i]
  if n <= set.len() or names[nameAt[i] + set.len()] != 47
    return false
  end
  for k in 0..<set.len()
    if names[nameAt[i] + k] != set[k]
      return false
    end
  end
  return true
end

hasName :: proc(s: String) -> Bool
  for i in 0..<nameCount
    if nameLen[i] == s.len()
      k := 0
      for k < s.len() and names[nameAt[i] + k] == s[k]
        k += 1
      end
      if k == s.len()
        return true
      end
    end
  end
  return false
end

setName: Blob[..64]
summary: Blob[..80]

# the contents, as Markdown: each set of texts (the first part of their names), by its SUMMARY if it
# has one, else each of its texts; then the texts in no set
contents :: proc()
  srcLen = 0
  nameCount = min(pc.helps(), 128)
  at := 0
  for i in 0..<nameCount
    nameAt[i] = at
    nameLen[i] = min(pc.helpName(i, names[at:at + 64]), 64)
    at += nameLen[i]
  end
  addSrc("# Help\n\nThe help texts here: Tab picks a link, Enter follows it, and Backspace comes back.\n\n")
  i := 0
  for i < nameCount
    n := names[nameAt[i]:nameAt[i] + nameLen[i]]
    slash := -1
    for k in 0..<n.len()
      if slash < 0 and n[k] == 47
        slash = k
      end
    end
    if slash < 0
      addSrc("- [")
      addSrcBlob(n)
      addSrc("](")
      addSrcBlob(n)
      addSrc(")\n")
      i += 1
    else
      setName.clear()
      ok := setName.pushAll(n[0:slash])
      summary.clear()
      ok = summary.pushAll(setName[0:setName.len()])
      ok = summary.pushAll("/SUMMARY")
      if hasName(summary[0:summary.len()].asString())
        addSrc("- [")
        addSrcBlob(setName[0:setName.len()])
        addSrc("](")
        addSrcBlob(summary[0:summary.len()])
        addSrc("): its contents\n")
      else
        for j in i..<nameCount
          if inSet(j, setName[0:setName.len()])
            addSrc("- [")
            addSrcBlob(names[nameAt[j]:nameAt[j] + nameLen[j]])
            addSrc("](")
            addSrcBlob(names[nameAt[j]:nameAt[j] + nameLen[j]])
            addSrc(")\n")
          end
        end
      end
      for i < nameCount and inSet(i, setName[0:setName.len()])
        i += 1
      end
    end
  end
  if nameCount == 0
    addSrc("No help texts here yet. They go in storage as /rinc/help/name.md.\n")
  end
end

# help text name, shown from row 0 (or its heading anchor): false if there's none
open :: proc(name: Blob, anchor: Blob) -> Bool
  if name.len() == 0
    contents()
  else
    n := pc.helpRead(name.asString(), src[0:SRC])
    if n < 0
      say("No help text there")
      return false
    end
    srcLen = min(n, SRC)
    if n > SRC
      say("(too long: just the start)")
    end
  end
  doc.clear()
  ok := doc.pushAll(name)
  render()
  top = 0
  pick = -1
  if anchor.len() > 0
    for h in 0..<headCount
      if slugLen[h] == anchor.len()
        k := 0
        for k < anchor.len() and slugs[slugAt[h] + k] == anchor[k]
          k += 1
        end
        if k == anchor.len()
          top = rowOfLog[headLog[h]]
        end
      end
    end
  end
  return true
end

# where a link goes: a help text's name (from the folder of the one shown), and an anchor
goName: Blob[..64]
goAnchor: Blob[..64]
resolve :: proc(l: Int) -> Bool
  t := targets[targetAt[l]:targetAt[l] + targetLen[l]]
  goName.clear()
  goAnchor.clear()
  if t.len() >= 4 and t[0] == 104 and t[1] == 116 and t[2] == 116 and t[3] == 112 # (http: a web page)
    say("A web page: not here")
    return false
  end
  hash := t.len()
  for k in 0..<t.len()
    if t[k] == 35 and hash == t.len()
      hash = k
    end
  end
  if hash + 1 < t.len()
    ok := goAnchor.pushAll(t[hash + 1:])
  end
  path := t[0:hash]
  if path.len() == 0 # (an anchor here)
    ok := goName.pushAll(doc[0:doc.len()])
    return true
  end
  if doc.len() > 0 # (from the shown text's folder)
    d := doc.len()
    for d > 0 and doc[d - 1] != 47
      d -= 1
    end
    ok := goName.pushAll(doc[0:d])
  end
  k := 0
  for k < path.len()
    e := k
    for e < path.len() and path[e] != 47
      e += 1
    end
    part := path[k:e]
    if part.len() == 2 and part[0] == 46 and part[1] == 46 # (..: the folder up)
      if goName.len() > 0
        goName.pop()
      end
      for goName.len() > 0 and goName[goName.len() - 1] != 47
        goName.pop()
      end
    case not (part.len() == 1 and part[0] == 46) and part.len() > 0
      ok := goName.pushAll(part)
      if e < path.len()
        ok = goName.push(47)
      end
    end
    k = e + 1
  end
  if goName.len() > 3 and goName[goName.len() - 3] == 46 and goName[goName.len() - 2] == 109 and goName[goName.len() - 1] == 100
    goName.pop() # (.md left off)
    goName.pop()
    goName.pop()
  end
  return true
end

follow :: proc()
  if pick < 0 or pick >= linkCount or not resolve(pick)
    return
  end
  if backCount == 16
    for i in 0..<15
      backName[i].clear()
      ok := backName[i].pushAll(backName[i + 1][0:backName[i + 1].len()])
      backTop[i] = backTop[i + 1]
    end
    backCount = 15
  end
  backName[backCount].clear()
  ok := backName[backCount].pushAll(doc[0:doc.len()])
  backTop[backCount] = top
  backCount += 1
  if not open(goName[0:goName.len()], goAnchor[0:goAnchor.len()])
    backCount -= 1
  end
end

back :: proc()
  if backCount == 0
    return
  end
  backCount -= 1
  ok := open(backName[backCount][0:backName[backCount].len()], doc[0:0])
  top = backTop[backCount]
end

# ---------------------------------------------------------------- moving about

rowOf :: proc(at: Int) -> Int
  for r in 0..<rowCount
    if at < rowAt[r] + rowLen[r] or (r + 1 < rowCount and at < rowAt[r + 1])
      return r
    end
  end
  return max(0, rowCount - 1)
end

scroll :: proc(by: Int)
  top = max(0, min(top + by, rowCount - ROWS))
end

# the next link (dir 1) or the one before, from the picked one, or from what's shown
pickNext :: proc(dir: Int)
  if linkCount == 0
    return
  end
  if pick < 0
    pick = -1
    if dir < 0
      pick = linkCount
    end
    first := rowAt[min(top, max(0, rowCount - 1))]
    for l in 0..<linkCount
      if dir > 0 and pick < 0 and linkFrom[l] >= first
        pick = l
      end
    end
    if pick < 0 or pick == linkCount
      pick = (linkCount + dir) % linkCount
      if dir > 0
        pick = 0
      end
    end
  else
    pick = (pick + dir + linkCount) % linkCount
  end
  r := rowOf(linkFrom[pick])
  if r < top or r >= top + ROWS
    top = max(0, min(r - 3, rowCount - ROWS))
  end
end

held := 0
update* :: proc()
  c := pc.key()
  for c >= 0
    k := c & 255
    message.clear()
    switch
    case k == 130
      scroll(-1)
    case k == 131
      scroll(1)
    case k == 135
      scroll(-(ROWS - 1))
    case k == 136 or (k == 32 and c < 256)
      scroll(ROWS - 1)
    case k == 132
      top = 0
    case k == 133
      scroll(rowCount)
    case k == 9
      dir := 1
      if c & 256 != 0
        dir = -1
      end
      pickNext(dir)
    case k == 13
      follow()
    case k == 8 or k == 27
      back()
    case k == 15 # Ctrl+O
      ok := open(doc[0:0], doc[0:0])
    end
    c = pc.key()
  end
  bits := pc.btn(0) + pc.btn(1) * 2 + pc.btn(2) * 4 + pc.btn(3) * 8 + pc.btn(4) * 16 + pc.btn(5) * 32
  pressed := bits & ~held
  if pressed & 4 != 0
    scroll(-1)
  end
  if pressed & 8 != 0
    scroll(1)
  end
  if pressed & 1 != 0
    pickNext(-1)
  end
  if pressed & 2 != 0
    pickNext(1)
  end
  if pressed & 16 != 0
    follow()
  end
  if pressed & 32 != 0
    back()
  end
  held = bits
end

# ---------------------------------------------------------------- the screen

title: Blob[..53]
draw* :: proc()
  pc.cls(BACK)
  for row in 0..<ROWS
    r := top + row
    if r >= rowCount
      break
    end
    y := TOP_Y + row * 9
    if rowBack[r] != 0
      pc.rect(0, y - 1, 320, 9, rowBack[r])
    end
    x := TEXT_X + rowIndent[r] * 6
    a := rowAt[r]
    e := a + rowLen[r]
    if pick >= 0 and linkFrom[pick] < e and linkTo[pick] > a # (the picked link)
      from := max(linkFrom[pick], a)
      to := min(linkTo[pick], e)
      pc.rect(x + (from - a) * 6 - 1, y - 1, (to - from) * 6 + 1, 9, 28)
    end
    k := a
    for k < e # (each run of one style)
      s := sty[k]
      j := k
      for j < e and sty[j] == s
        j += 1
      end
      color := styleColor(s)
      if s == LINK and pick >= 0 and k >= linkFrom[pick] and k < linkTo[pick]
        color = WHITE
      end
      pc.print(out[k:j].asString(), x + (k - a) * 6, y, color)
      if s == LINK or s == H1 or s == H2 # (underlined)
        pc.rect(x + (k - a) * 6, y + 8, (j - k) * 6 - 1, 1, color)
      end
      k = j
    end
  end
  # the title bar: what's shown, and how far down
  pc.rect(0, 0, 320, 10, BAR)
  title.clear()
  if doc.len() == 0
    ok := title.pushAll("Help")
  else
    ok := title.pushAll(doc[0:min(doc.len(), 40)])
  end
  pc.print(title[0:title.len()].asString(), 2, 1, WHITE)
  if rowCount > ROWS
    title.clear()
    ok := title.format(min(100, (top + ROWS) * 100 / rowCount), "%")
    pc.print(title[0:title.len()].asString(), 318 - title.len() * 6, 1, 5)
  end
  # the bottom bar: a message, else the keys
  pc.rect(0, 229, 320, 11, BAR)
  if message.len() > 0
    pc.print(message[0:message.len()].asString(), 2, 231, 9)
  else
    pc.print("Tab link  Enter open  Bksp back  ^O contents", 2, 231, 5)
  end
end

# where it was asked to open (pc.help), else the contents
topic: Blob[96]
topicLen := min(pc.helpTopic(topic[0:96]), 96)
hash := topicLen
for k in 0..<topicLen
  if topic[k] == 35 and hash == topicLen
    hash = k
  end
end
if topicLen == 0 or not open(topic[0:hash], topic[min(hash + 1, topicLen):topicLen])
  ok := open(doc[0:0], doc[0:0])
end
