# Editor tests: its parts on their own, without the app. Run as edit/test (run edit/test in the console,
# where it's beside edit.rio), or on the desktop, rinc system/edit/test.rio. A failed assert stops it at
# its line. Not one of the app's files (files.txt), so it's not installed with it.

include "parts/setup.rio"
include "parts/text.rio"
include "parts/editing.rio"

# the text is s, the cursor at its end
start :: proc(s: String)
  ok := edit(0, textLen, s, 0)
  cursor = textLen
  anchor = cursor
end

# Enter at the end of line s: the next line's indent
indentAfter :: proc(s: String) -> Int
  start(s)
  enter()
  return textLen - lineAt[lineCount - 1]
end

assert(indentAfter("if x") == 2, "if opens a block")
assert(indentAfter("  for i in 0..<3") == 4, "for, indented")
assert(indentAfter("x :: proc()") == 2, "a proc")
assert(indentAfter("do") == 2, "do alone opens a block")
assert(indentAfter("if done do return") == 0, "a one-line if")
assert(indentAfter("for i in 0..<3 do log(i)") == 0, "a one-line for")
assert(indentAfter("  case .a do f()") == 2, "a one-line case")
assert(indentAfter("switch x") == 0, "a switch's cases line up with it")
assert(indentAfter("x := 1") == 0, "a plain line")

# typing the last letter of end or else, alone on its line, steps it back out (keys.rio: then dedent)
typed :: proc(s: String, c: Int) -> String
  start(s)
  typeChar(c)
  dedent()
  return text[0..<textLen].asString()
end
assert(typed("if x\n  y()\n  en", 100) == "if x\n  y()\nend", "end dedents")
assert(typed("if x\n  en", 100) == "if x\nend", "end dedents an empty block")
assert(typed("if x\n  y()\n  els", 101) == "if x\n  y()\nelse", "else dedents")
assert(typed("if x\n  y()\nen", 100) == "if x\n  y()\nend", "already dedented")

# Enter in a comment line goes on with the comment; in an empty one, ends it
entered :: proc(s: String) -> String
  start(s)
  enter()
  return text[0..<textLen].asString()
end
assert(entered("  # hello") == "  # hello\n  # ", "a comment goes on")
assert(entered("#x") == "#x\n# ", "a comment with no space after its # goes on with one")
assert(entered("if x # why") == "if x # why\n  ", "code with a comment after it: just code")
assert(entered("  # hello\n  # ") == "  # hello\n  ", "an empty comment line ends the comment")

# Ctrl+Shift+J joins the next line (or the selected lines) onto this one
joined :: proc(s: String, a, b: Int) -> String
  start(s)
  anchor = a
  cursor = b
  joinLines()
  return text[0..<textLen].asString()
end
assert(joined("f(\n  a,\n  b\n)", 0, 0) == "f(a,\n  b\n)", "after an opener: no space")
assert(joined("f(a,  \n  b)", 0, 0) == "f(a, b)", "a space between, the spaces at the ends gone")
assert(joined("f(\n  a,\n  b\n)", 0, 13) == "f(a, b)", "the selected lines, all")
assert(joined("x := a\n  .b()", 0, 0) == "x := a.b()", "before a dot: no space")
assert(joined("  # one\n  # two", 0, 0) == "  # one two", "a comment going on: one comment")
assert(joined("x := 1", 0, 0) == "x := 1", "the last line: nothing to join")

# laid out as rio fmt does, the cursor kept on the same code
laid :: proc(s: String, at: Int) -> Int
  start(s)
  cursor = at
  anchor = at
  layOut()
  return cursor
end
c := laid("x:=f( a,b )\ny:=2", 8)
assert(text[0..<textLen].asString() == "x := f(a, b)\ny := 2", "laid out")
assert(text[c] == 98, "the cursor still on b")
c = laid("if a\n      x:=1\nend", 11)
assert(text[0..<textLen].asString() == "if a\n  x := 1\nend", "indented")
assert(text[c] == 120, "the cursor still on x")
undo()
assert(text[0..<textLen].asString() == "if a\n      x:=1\nend", "and undone")
log("all edit tests passed")
