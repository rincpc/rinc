# Editor tests: its parts on their own, without the app. Run as edit/test (run edit/test in the console,
# where it's beside edit.rio), or on the desktop, rinc system/edit/test.rio. A failed assert stops it at
# its line. Not one of the app's files (files.txt), so it's not installed with it.

include "parts/setup.rio"
include "parts/text.rio"
include "parts/editing.rio"
include "parts/files.rio"
include "parts/prompts.rio"
include "parts/complete.rio"

# the text is s, the cursor at its end
start :: proc(s: String)
  ok := edit(0, textLen, s, 0)
  cursor = textLen
  anchor = cursor
end

# Enter at the end of line s: the next line's indent
indentAfter :: proc(s: String) -> Int
  start(s)
  enter()
  return textLen - lineAt[lineCount - 1]
end

assert(indentAfter("if x") == 2, "if opens a block")
assert(indentAfter("  for i in 0..<3") == 4, "for, indented")
assert(indentAfter("x :: proc()") == 2, "a proc")
assert(indentAfter("do") == 2, "do alone opens a block")
assert(indentAfter("if done do return") == 0, "a one-line if")
assert(indentAfter("for i in 0..<3 do log(i)") == 0, "a one-line for")
assert(indentAfter("  case .a do f()") == 2, "a one-line case")
assert(indentAfter("switch x") == 0, "a switch's cases line up with it")
assert(indentAfter("x := 1") == 0, "a plain line")

# typing the last letter of end or else, alone on its line, steps it back out (keys.rio: then dedent)
typed :: proc(s: String, c: Int) -> String
  start(s)
  typeChar(c)
  dedent()
  return text[0..<textLen].asString()
end
assert(typed("if x\n  y()\n  en", 100) == "if x\n  y()\nend", "end dedents")
assert(typed("if x\n  en", 100) == "if x\nend", "end dedents an empty block")
assert(typed("if x\n  y()\n  els", 101) == "if x\n  y()\nelse", "else dedents")
assert(typed("if x\n  y()\nen", 100) == "if x\n  y()\nend", "already dedented")

# Enter in a comment line goes on with the comment; in an empty one, ends it
entered :: proc(s: String) -> String
  start(s)
  enter()
  return text[0..<textLen].asString()
end
assert(entered("  # hello") == "  # hello\n  # ", "a comment goes on")
assert(entered("#x") == "#x\n# ", "a comment with no space after its # goes on with one")
assert(entered("if x # why") == "if x # why\n  ", "code with a comment after it: just code")
assert(entered("  # hello\n  # ") == "  # hello\n  ", "an empty comment line ends the comment")

# Ctrl+Shift+J joins the next line (or the selected lines) onto this one
joined :: proc(s: String, a, b: Int) -> String
  start(s)
  anchor = a
  cursor = b
  joinLines()
  return text[0..<textLen].asString()
end
assert(joined("f(\n  a,\n  b\n)", 0, 0) == "f(a,\n  b\n)", "after an opener: no space")
assert(joined("f(a,  \n  b)", 0, 0) == "f(a, b)", "a space between, the spaces at the ends gone")
assert(joined("f(\n  a,\n  b\n)", 0, 13) == "f(a, b)", "the selected lines, all")
assert(joined("x := a\n  .b()", 0, 0) == "x := a.b()", "before a dot: no space")
assert(joined("  # one\n  # two", 0, 0) == "  # one two", "a comment going on: one comment")
assert(joined("x := 1", 0, 0) == "x := 1", "the last line: nothing to join")

# Ctrl+/ comments the lines (at the least indent), or uncomments them if they're all comments
commented :: proc(s: String, a, b: Int) -> String
  start(s)
  anchor = a
  cursor = b
  toggleComment()
  return text[0..<textLen].asString()
end
assert(commented("if x\n  y()\nend", 0, 14) == "# if x\n#   y()\n# end", "lines commented, at the least indent")
assert(commented("  a()\n\n    b()", 0, 14) == "  # a()\n\n  #   b()", "a blank line left as it is")
assert(commented("  # a()\n  #b()", 0, 14) == "  a()\n  b()", "all comments: uncommented")
assert(commented("  # a()\n  b()", 0, 13) == "  # # a()\n  # b()", "not all comments: commented again")
assert(commented("  x := 1", 5, 5) == "  # x := 1" and cursor == 7, "the cursor's line, the cursor on its code")

# laid out as rio fmt does, the cursor kept on the same code
laid :: proc(s: String, at: Int) -> Int
  start(s)
  cursor = at
  anchor = at
  layOut()
  return cursor
end
c := laid("x:=f( a,b )\ny:=2", 8)
assert(text[0..<textLen].asString() == "x := f(a, b)\ny := 2", "laid out")
assert(text[c] == 98, "the cursor still on b")
c = laid("if a\n      x:=1\nend", 11)
assert(text[0..<textLen].asString() == "if a\n  x := 1\nend", "indented")
assert(text[c] == 120, "the cursor still on x")
undo()
assert(text[0..<textLen].asString() == "if a\n      x:=1\nend", "and undone")

# completion: Rio's names where the cursor is (a check of the text above its line: the proc's own, with
# what each is), Rio's words that fit there, then the file's words; after a dot, what's before it has
offered :: proc(i: Int) -> String
  return offerText(shown[i])
end
offeredAt :: proc(s: String) -> Int
  for i in 0..<shownCount
    if offered(i) == s
      return i
    end
  end
  return -1
end
start("alpha := 1\nalphabet := 2\nx := al")
complete(0)
assert(completing and shownCount == 2 and offered(0) == "alphabet" and offered(1) == "alpha", "names in scope, the newest first")
completing = false
start("width := 1\nx := wid")
complete(0)
assert(text[0..<textLen].asString() == "width := 1\nx := width" and not completing, "just one: put in")
start("f :: proc(count: Int)\n  total := count\n  to")
complete(0)
assert(text[0..<textLen].asString() == "f :: proc(count: Int)\n  total := count\n  total", "a proc's own locals")
start("P :: struct\n  across, down: Int\nend\nf :: proc(p: P)\n  p.")
complete(0)
assert(completing and shownCount == 2 and offered(0) == "across" and offerSig(shown[0]) == "Int", "a parameter's fields, after a dot")
completing = false
start("pc.rec")
complete(0)
i := offeredAt("rect")
assert(i >= 0 and offerSigLen[shown[i]] > 0, "pc's names, with what each is")
completing = false
start("r: pc.Rect\nr.")
complete(0)
assert(completing and offeredAt("pos") >= 0 and offeredAt("size") >= 0 and offeredAt("has") >= 0, "a struct's fields and methods")
completing = false
start("pc.Rect.")
complete(0)
assert(completing and offeredAt("of") >= 0 and offeredAt("between") >= 0 and offeredAt("pos") < 0, "a type's static procs (not its fields)")
completing = false
start("xs: [..4]Int\nxs.pushA")
complete(0)
assert(text[0..<textLen].asString() == "xs: [..4]Int\nxs.pushAll", "a builder's methods")
start("foo.")
complete(0)
assert(not completing, "after a dot that isn't anything's: nothing")
start("f :: proc()\n  ret")
complete(0)
assert(text[0..<textLen].asString() == "f :: proc()\n  return", "Rio's words, where a statement goes")
start("zebra := 1\nx := ze\nzebu := 2") # (zebu: below the cursor, not compiled there: one of the file's words)
cursor = 18
anchor = cursor
complete(0)
assert(completing and offered(0) == "zebra", "Rio's names before the file's words")
completing = false
# errors: the whole file checked, its first error where it is
start("x := 1\ny := nope + x\n")
checkErrors()
assert(errLine == 1 and errCol == 5 and errLen == 4 and errText[0..<errTextLen].asString() == "undefined name near 'nope'", "an error, underlined where it is")
start("x := 1\n")
checkErrors()
assert(errLine == -1 and checkedEdits == edits, "and none")
start("f :: proc()\n  x := 1\n")
checkErrors()
assert(errLine == 1, "an unfinished block: at its end")
showNumbers(true)
assert(textX == TEXT_X and cols == COLS, "line numbers")
showNumbers(false)
assert(textX < TEXT_X and cols > COLS, "and not")
# the clipboard: a file, so it's there after another file's opened (and in other apps)
start("hello world")
anchor = 0
cursor = 5
copy(false)
start("ab")
cursor = 1
anchor = 1
paste()
assert(text[0..<textLen].asString() == "ahellob", "a selection, pasted into another text")
start("one\ntwo")
cursor = 1
anchor = 1
copy(false)
start("x")
paste()
assert(text[0..<textLen].asString() == "one\nx", "a whole line, pasted as one, above")
log("all edit tests passed")
