# Editor: the text, messages, undo (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- the text

text: Blob[32768]
textLen := 0
changedFrom := 0       # the first byte changed since completion's last check (CAP + 1: none)
checkedAt := -1        # where that check was cut (a line's start), or -1: none, or not to be trusted
edits := 0             # how many changes the text's had (the error check is of one of them)
editedAt := 0.0        # when the last was
checkCost := 0.0       # how long a check took, the last (on the board, a big app's: about half a second)
scratch: Blob[..32768] # the text after an edit, moving over
lineAt: [4096]Int      # where each line starts
lineCount := 1
cursor := 0
anchor := 0            # the selection's other end (anchor == cursor: nothing selected)
wantCol := -1          # the column up and down keep to
top := 0               # the first line on the screen, and column
left := 0
path: Blob[..96]       # the file's path ("": new, not saved yet)
one: Blob[1]
built: Blob[..8192]

lineEnd :: proc(l: Int) -> Int
  if l + 1 < lineCount
    return lineAt[l + 1] - 1
  end
  return textLen
end

lineOf :: proc(p: Int) -> Int
  lo := 0
  hi := lineCount - 1
  for lo < hi
    mid := (lo + hi + 1) / 2
    if lineAt[mid] <= p
      lo = mid
    else
      hi = mid - 1
    end
  end
  return lo
end

rebuildLines :: proc()
  lineCount = 1
  lineAt[0] = 0
  for i in 0..<textLen
    if text[i] == 10 and lineCount < MAX_LINES
      lineAt[lineCount] = i + 1
      lineCount += 1
    end
  end
end

newlines :: proc(s: String) -> Int
  n := 0
  for c in s
    if c == 10
      n += 1
    end
  end
  return n
end

# text[a..<b] becomes s (which isn't part of text): false if there's no room
replaceRaw :: proc(a, b: Int, s: String) -> Bool
  if textLen - (b - a) + s.len() > CAP
    return false
  end
  scratch.clear()
  _ = scratch.pushAll(text[b..<textLen])
  w: Blob[..] = text[a..]
  _ = w.pushAll(s)
  _ = w.pushAll(scratch[0..<scratch.len()])
  textLen += s.len() - (b - a)
  changedFrom = min(changedFrom, a)
  edits += 1
  editedAt = pc.time()
  rebuildLines()
  return true
end

selStart :: proc() -> Int
  return min(cursor, anchor)
end
selEnd :: proc() -> Int
  return max(cursor, anchor)
end

# ---------------------------------------------------------------- messages

message: Blob[..53]
messageColor := softColor
messageAt := 0.0

say :: proc(s: String, color: Int)
  message.clear()
  for c in s
    if message.len() < 53
      _ = message.push(c)
    end
  end
  messageColor = color
  messageAt = pc.time()
end

# s, then the file's name (its path's end), then t
sayName :: proc(s: String, t: String, color: Int)
  say(s, color)
  k := path.len()
  for k > 0 and path[k - 1] != 47
    k -= 1
  end
  for c in path[k..<path.len()]
    if message.len() < 53
      _ = message.push(c)
    end
  end
  for c in t
    if message.len() < 53
      _ = message.push(c)
    end
  end
end

# ---------------------------------------------------------------- undo

# each edit a step in a log on the card (rinc's undolog: the stash's "undo"), as far back as the file was
# opened or started, and there again after another app's run: where it is, how many bytes it took out
# and put in, the cursor and anchor before and the cursor after (EDIT_HEAD bytes), then the bytes it took
# out and the ones it put in. A run of typing (or of Backspace, or Delete) goes on in one group: what one
# undo takes back. An edit too big for a step goes as several, in its group: its bytes taken out a PIECE at
# a time, then put in. Each is checked as it's undone (the text it put in is there) or redone (the text
# it took out is): one that isn't, and the log starts again
EDIT_HEAD :: 22
PIECE :: 2000
undoRoom: Blob[..PIECE + EDIT_HEAD + 64]
u := undolog.Log{room = undoRoom, version = 1}
u.start("undo", "") # (a log from the first, so steps always have one: opening a file starts its own, or takes on its old one)
stepBuf: Blob[..PIECE + EDIT_HEAD]
savedAt := 0           # where undo was when it was saved (-1: somewhere undo and redo can't reach now)
merging := 0           # what the last edit was, to group with: 1 typing, 2 Backspace, 3 Delete
mergeAt := -1          # where the log was after it (an undo since: no going on with it)
lastPos := 0           # where it was, and what it put in (typing goes on after it)
lastIns := 0
mergedDel := 0         # what a run of Backspace has taken out (64 at most, a group)

# a new log (a file opened or started): nothing to undo
forgetAll :: proc()
  u.start("undo", path[0..<path.len()].asString())
  merging = 0
  savedAt = u.at
end

modified :: proc() -> Bool
  return u.at != savedAt
end
# where undo was when it was saved, kept with its log (as leaving, the app goes)
savedText: Blob[..12]
keepSaved :: proc()
  savedText.clear()
  _ = savedText.print(savedAt)
  _ = pc.stashWrite("undo.saved", savedText.asString())
end
savedKept :: proc() -> Int
  savedText.clear()
  if pc.stashRead("undo.saved", savedText) <= 0
    return -1
  end
  v := 0
  for c in savedText.asString()
    if c == '-'
      return -1
    end
    v = v * 10 + c - '0'
  end
  return v
end

# a step: at pos, del taken out and ins put in; the cursor and anchor as they are, the cursor after
pushStep :: proc(pos: Int, del: String, ins: String, after: Int)
  stepBuf.clear()
  for i in 0..<EDIT_HEAD
    _ = stepBuf.push(0)
  end
  stepBuf.setInt(0, 32, pos)
  stepBuf.setInt(4, 24, del.len())
  stepBuf.setInt(7, 24, ins.len())
  stepBuf.setInt(10, 32, cursor)
  stepBuf.setInt(14, 32, anchor)
  stepBuf.setInt(18, 32, after)
  _ = stepBuf.pushAll(del) and stepBuf.pushAll(ins)
  if not u.step(stepBuf.asString())
    say("(too big to undo)", softColor)
  end
end
# text[a..<b] becoming s, its step (or steps, a PIECE at a time), before it does
logEdit :: proc(a, b: Int, s: String)
  after := a + s.len()
  if (b - a) + s.len() <= PIECE
    pushStep(a, text[a..<b].asString(), s, after)
    return
  end
  k := a
  for k < b # (taken out a piece at a time, each where the first was)
    n := min(PIECE, b - k)
    pushStep(a, text[k..<k + n].asString(), "", after)
    k += n
  end
  k = 0
  for k < s.len()
    n := min(PIECE, s.len() - k)
    pushStep(a + k, "", s[k..<k + n], after)
    k += n
  end
end

# text[a..<b] becomes s, remembered for undo (kind: what it is, to group with the edit before)
edit :: proc(a, b: Int, s: String, kind: Int) -> Bool
  if textLen - (b - a) + s.len() > CAP
    say("No room: 32 KB at most", errorColor)
    return false
  end
  if lineCount - newlines(text[a..<b].asString()) + newlines(s) > MAX_LINES
    say("Too many lines: 4096 at most", errorColor)
    return false
  end
  goesOn := kind > 0 and kind == merging and u.at == mergeAt and
    ((kind == 1 and a == b and lastPos + lastIns == a) or (kind == 2 and s.len() == 0 and lastIns == 0 and b == lastPos and mergedDel < 64) or
     (kind == 3 and s.len() == 0 and lastIns == 0 and a == lastPos))
  if not goesOn
    u.group()
    mergedDel = 0
  end
  if savedAt > u.at # (what could be redone, gone: where it was saved with it)
    savedAt = -1
  end
  logEdit(a, b, s)
  if kind == 2
    mergedDel += b - a
  end
  lastPos = a
  lastIns = s.len()
  ok := replaceRaw(a, b, s)
  cursor = a + s.len()
  anchor = cursor
  wantCol = -1
  merging = kind
  mergeAt = u.at
  return ok
end

# a number of a step's, n bytes at its byte at (low first)
stepNum :: proc(s: String, at: Int, n: Int) -> Int
  v := 0
  for i in 0..<n
    v += s[at + i] << (8 * i)
  end
  return v
end
# a step undone (back) or redone: false if the text isn't as it left it (or found it)
applyEdit :: callback proc(step: String, back: Bool) -> Bool
  if step.len() < EDIT_HEAD
    return false
  end
  pos := stepNum(step, 0, 4)
  del := stepNum(step, 4, 3)
  ins := stepNum(step, 7, 3)
  if step.len() != EDIT_HEAD + del + ins or pos > textLen
    return false
  end
  out := step[EDIT_HEAD..<EDIT_HEAD + del]
  put := step[EDIT_HEAD + del..<step.len()]
  if back
    if pos + ins > textLen or text[pos..<pos + ins].asString() != put or not replaceRaw(pos, pos + ins, out)
      return false
    end
    cursor = stepNum(step, 10, 4)
    anchor = stepNum(step, 14, 4)
  else
    if pos + del > textLen or text[pos..<pos + del].asString() != out or not replaceRaw(pos, pos + del, put)
      return false
    end
    cursor = stepNum(step, 18, 4)
    anchor = cursor
  end
  cursor = min(cursor, textLen)
  anchor = min(anchor, textLen)
  return true
end

undo :: proc()
  if not u.undo(applyEdit)
    if u.broke
      say("Undo's log didn't fit the text: it starts again", errorColor)
      savedAt = -1
    else
      say("Nothing to undo", softColor)
    end
  end
  merging = 0
  wantCol = -1
end

redo :: proc()
  if not u.redo(applyEdit)
    if u.broke
      say("Undo's log didn't fit the text: it starts again", errorColor)
      savedAt = -1
    else
      say("Nothing to redo", softColor)
    end
  end
  merging = 0
  wantCol = -1
end
