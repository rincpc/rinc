# Editor: keys (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- keys

key :: proc(k: Int)
  base := k & 255
  shift := k & SHIFT != 0
  ctrl := k & CTRL != 0
  alt := k & ALT != 0
  if walking and not (base == 9 and ctrl) # (another key: Ctrl+Tab's list closes, nothing opened; Esc just that)
    walking = false
    walkStep = 0
    if base == 27
      return
    end
  end
  if mode != NONE
    promptKey(k)
    return
  end
  if completing and completeKey(k)
    return
  end
  if k == NUMBERS_COMMAND # (from the command list)
    toggleNumbers()
    return
  end
  if base != 14 and base != 15 and not (base == 9 and ctrl)
    confirm = 0 # (a warning stands only until the next key)
    walkStep = 0 # (and Ctrl+Tab's walk back, only while it's Ctrl+Tab again)
  end
  if base >= 32 and base < 127 and k < 256
    typeChar(base)
    if base == 100 or base == 101
      dedent()
    end
  case k == (32 | CTRL) # Ctrl+Space
    complete(0)
  case k == (47 | CTRL) # Ctrl+/
    toggleComment()
  case base == 13
    enter()
  case base == 8
    backspace(ctrl or alt)
  case base == DELETE
    deleteForward(ctrl or alt)
  case base == 9 and ctrl # Ctrl+Tab: the file before this one (Shift: the one longest ago, round them all)
    if modified() and confirm != 9
      say("Unsaved changes: Ctrl+Tab again drops them", warnColor)
      confirm = 9
    else
      confirm = 0
      switchRecent(shift)
    end
  case base == 9
    tab(shift)
  case base == 27
    anchor = cursor
  case base == LEFT
    if cursor != anchor and not shift and not ctrl
      moveTo(selStart(), false)
    case ctrl
      moveTo(wordLeft(cursor), shift)
    else
      moveTo(cursor - 1, shift)
    end
    wantCol = -1
  case base == RIGHT
    if cursor != anchor and not shift and not ctrl
      moveTo(selEnd(), false)
    case ctrl
      moveTo(wordRight(cursor), shift)
    else
      moveTo(cursor + 1, shift)
    end
    wantCol = -1
  case base == UP or base == DOWN
    step := 1
    if base == UP
      step = -1
    end
    if alt
      moveLines(step)
    case ctrl
      top = max(0, min(top + step, lineCount - 1))
    else
      moveToLine(lineOf(cursor) + step, shift)
    end
  case base == PAGE_UP or base == PAGE_DOWN
    step := ROWS - 1
    if base == PAGE_UP
      step = -step
    end
    top = max(0, min(top + step, lineCount - 1))
    moveToLine(lineOf(cursor) + step, shift)
  case base == HOME
    if ctrl
      moveTo(0, shift)
    else
      l := lineOf(cursor)
      p := indentEnd(l)
      if cursor == p
        p = lineAt[l]
      end
      moveTo(p, shift)
    end
    wantCol = -1
  case base == KEY_END
    if ctrl
      moveTo(textLen, shift)
    else
      moveTo(lineEnd(lineOf(cursor)), shift)
    end
    wantCol = -1
  case base == 1 # Ctrl+A
    anchor = 0
    cursor = textLen
  case base == 3
    copy(false)
  case base == 24
    copy(true)
  case base == 22
    paste()
  case base == 26 and shift
    redo()
  case base == 26
    undo()
  case base == 25
    redo()
  case base == 11 and shift
    deleteLines()
  case base == 10 and shift # Ctrl+Shift+J
    joinLines()
  case base == 12 # Ctrl+L: the line, and the next with each again
    l := lineOf(cursor)
    if cursor != anchor and lineAt[lineOf(selEnd())] == selEnd() # (whole lines already: one more)
      l = lineOf(selEnd())
      anchor = selStart()
    else
      anchor = lineAt[l]
    end
    if l + 1 < lineCount
      cursor = lineAt[l + 1]
    else
      cursor = textLen
    end
  case base == 19 and shift # Ctrl+Shift+S
    saveAs()
  case base == 19
    ok := save()
  case base == 18 # Ctrl+R: save, then run its app
    run()
  case base == 15 # Ctrl+O
    if modified() and confirm != 15
      say("Unsaved changes: Ctrl+O again drops them", warnColor)
      confirm = 15
    else
      confirm = 0
      callFiles("pick")
    end
  case base == 16 and shift # Ctrl+Shift+P: every command
    pc.showCommands()
  case base == 14 # Ctrl+N
    if modified() and confirm != 14
      say("Unsaved changes: Ctrl+N again drops them", warnColor)
      confirm = 14
    else
      confirm = 0
      fresh()
      path.clear()
      say("New: Ctrl+S saves it, where Files says", softColor)
    end
  case base == 6
    if cursor != anchor and selEnd() - selStart() <= 48 # (what's selected, to find)
      query.clear()
      _ = query.pushAll(text[selStart()..<selEnd()])
    end
    startPrompt(FIND)
  case base == 7
    startPrompt(GO_TO)
  end
end

# the cursor in view
reveal :: proc()
  l := lineOf(cursor)
  col := cursor - lineAt[l]
  if l < top
    top = l
  end
  if l >= top + ROWS
    top = l - ROWS + 1
  end
  if col < left
    left = max(0, col - 8)
  end
  if col >= left + cols
    left = col - cols + 8
  end
end

movedAt := 0.0 # (the cursor stays lit while it moves)

# where in the text a point on the screen is: the nearest place between characters, on the line it's on
# (the first or last line shown, above or below them)
textAt :: proc(px: Int, py: Int) -> Int
  row := 0
  if py >= TOP_Y - 1
    row = min((py - TOP_Y + 1) / 9, ROWS - 1)
  end
  l := min(top + row, lineCount - 1)
  col := left
  if px >= textX
    col = left + (px - textX + 3) / 6
  end
  return lineAt[l] + min(col, lineEnd(l) - lineAt[l])
end

# the pointer: a click puts the cursor there (dragging, selecting to there); in the
# list of commands, a click does one, and one outside it closes it; scrolling, three lines a step
dragging := false
clicked := 0
pc.pointer(pc.Pointer.ui)
pointer :: proc()
  down := pc.pointerDown(0)
  px := pc.pointerX()
  py := pc.pointerY()
  inList := completing and px >= listBox[0] and px < listBox[0] + listBox[2] and py >= listBox[1] and py < listBox[1] + listBox[3] * 9
  if down == 1 and clicked == 0 and inList # (the completion list: a click puts that one in)
    offerPick = offerTop + (py - listBox[1]) / 9
    takeOffer()
    clicked = down
    return
  end
  if down == 1 and clicked == 0 and completing # (elsewhere: it closes)
    completing = false
  end
  if inList # (the wheel over it: it scrolls)
    s := pc.scroll(1)
    offerPick = max(0, min(offerPick - 3 * s, shownCount - 1))
  end
  if down == 1 and clicked == 0
    if mode == NONE and py < 229
      moveTo(textAt(px, py), false)
      wantCol = -1
      dragging = true
      movedAt = pc.time()
    end
  case down == 1 and dragging and mode == NONE
    was := cursor
    moveTo(textAt(px, py), true)
    if py < TOP_Y and top > 0 # (dragged above or below: scrolls)
      top -= 1
    case py >= TOP_Y + ROWS * 9 and top + ROWS < lineCount
      top += 1
    end
    if cursor != was
      movedAt = pc.time()
    end
  end
  if down == 0
    dragging = false
  end
  clicked = down
  s := pc.scroll(1)
  if mode == NONE and s != 0
    top = max(0, min(top - 3 * s, lineCount - 1))
  end
  # sideways (a wheel that tilts, a trackpad, a controller's right stick): as far as the longest line
  # shown goes
  across := pc.scroll(0)
  if mode == NONE and across != 0
    widest := 0
    for l in top..<min(lineCount, top + ROWS)
      widest = max(widest, lineEnd(l) - lineAt[l])
    end
    left = max(0, min(left + 4 * across, widest - cols / 2))
  end
end

# where it is (cursor, selection, scrolled), kept once it's rested a moment (not each step of a held
# arrow), so leaving for another app and coming back finds it so
placeWas: [5]Int
placeSaved: [5]Int
placeStill := 0
keepPlace :: proc()
  now := [5]Int{cursor, anchor, top, left, path.len()}
  if now != placeWas
    placeWas = now
    placeStill = 0
  end
  placeStill += 1
  if placeStill == 15 and now != placeSaved and path.len() > 0 and not toFiles
    placeSaved = now
    remember()
  end
end
# leaving for another app (the system key's Tab, say): where it is, kept now, not after the moment's rest;
# and what's not saved, as a draft (as for Files), to have again on coming back
leaving* :: proc()
  placeStill = 14
  keepPlace()
  u.flush() # (undo's steps onto the card, and where it was saved)
  keepSaved()
  if modified() and not toFiles
    ok := pc.stashWrite("draft", text[0..<textLen].asString())
    ok = pc.stashWrite("draftPath", here())
    ok = pc.stashWrite("calling", "away")
  end
end

update* :: proc()
  held := pc.modsHeld()
  if held >= 0 and held & CTRL == 0 # (Ctrl let go: Ctrl+Tab's walk is over, its pick opened)
    if walking
      walking = false
      switchTo(walkStep)
    end
    walkStep = 0
  end
  c := pc.key()
  for c >= 0
    was := cursor
    key(c)
    if cursor != was
      movedAt = pc.time()
    end
    if naming # (save or run, on a new file: its project's name, asked for)
      naming = false
      startPrompt(NAMING)
    end
    if mode == NONE
      reveal()
    end
    c = -1
    if not toFiles # (gone to Files: the rest typed is its)
      c = pc.key()
    end
  end
  pointer()
  idleCheck()
  keepPlace()
end
