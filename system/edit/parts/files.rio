# Editor: files (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- files

last: Blob[..128] # the file it had last, and where: "path cursor top anchor left" (its save file "last")
# the files it had lately, the latest first, each with where it was (cursor, top, anchor, left: its
# place), for Ctrl+Tab and Ctrl+W (rinc's recent library, its stash "recent")
files := recent.Recent{}

here :: proc() -> String
  return path[0..<path.len()].asString()
end
# is it Rio (a new file, unnamed yet, is), so checked, completed and laid out as Rio
isRio :: proc() -> Bool
  return path.len() == 0 or (path.len() >= 4 and path[path.len() - 4..<path.len()].asString() == ".rio")
end

startsWith :: proc(s: String, start: String) -> Bool
  return s.len() >= start.len() and s[0..<start.len()] == start
end

# the app (chord) or project (chord+) a path is in, else ""
appIn: Blob[..34]
appOf :: proc(p: String) -> String
  appIn.clear()
  for k in 0..<2
    start := "/apps/"
    if k == 1
      start = "/projects/"
    end
    if p.len() > start.len() and startsWith(p, start)
      e := start.len()
      for e < p.len() and p[e] != 47
        e += 1
      end
      ok := appIn.pushAll(p[start.len()..<e])
      if k == 1
        ok = appIn.push(43)
      end
    end
  end
  return appIn[0..<appIn.len()].asString()
end

# read only: an installed app's files (saving makes its project)
readOnly :: proc() -> Bool
  p := here()
  return p.len() > 0 and startsWith(p, "/apps/")
end

# a line of recent's (or last): its path, what's before the numbers at its end (up to 4: older lines have
# 2); and where it was: its cursor, top line, anchor and left column (an older line's anchor: its cursor)
isNumber :: proc(s: String) -> Bool
  for i in 0..<s.len()
    if s[i] < 48 or s[i] > 57
      return false
    end
  end
  return s.len() > 0
end
pathOf :: proc(line: String) -> String
  e := line.len()
  for _ in 0..<4
    s := e - 1
    for s >= 0 and line[s] != 32
      s -= 1
    end
    if s < 0 or not isNumber(line[s + 1..<e])
      return line[0..<e]
    end
    e = s
  end
  return line[0..<e]
end
placeOf :: proc(line: String) -> [4]Int
  r := [4]Int{0, 0, -1, 0}
  part := -1
  for i in pathOf(line).len()..<line.len()
    c := line[i]
    if c == 32
      part += 1
    case c >= 48 and c <= 57 and part >= 0 and part < 4
      r[part] = max(r[part], 0) * 10 + c - 48
    end
  end
  if r[2] < 0
    r[2] = r[0]
  end
  return r
end
# where a line of recent's (or last) says it was, again: cursor, selection, and scrolled as it was
restore :: proc(at: [4]Int)
  cursor = min(at[0], textLen)
  anchor = min(at[2], textLen)
  top = max(0, min(at[1], lineCount - 1))
  left = max(at[3], 0)
  wantCol = -1
end
# line k of a list of recent's lines (from 0): "" if there's none; and how many lines it has
lineIn :: proc(list: String, k: Int) -> String
  at := 0
  n := 0
  for i in 0..<list.len()
    if list[i] == 10
      if n == k
        return list[at..<i]
      end
      n += 1
      at = i + 1
    end
  end
  return ""
end
linesIn :: proc(list: String) -> Int
  n := 0
  for i in 0..<list.len()
    if list[i] == 10
      n += 1
    end
  end
  return n
end

# where it is, kept for next time: on opening, saving and running (last, and first in recent); and the
# app or project it's in is the active one, the whole Rinc's setting
remember :: proc()
  last.clear()
  ok := last.pushAll(path[0..<path.len()])
  _ = last.print(" ", cursor, " ", top, " ", anchor, " ", left)
  saved := pc.fileWrite("save:last", last[0..<last.len()].asString())
  if path.len() > 0
    files.note(here(), last[path.len()..<last.len()].asString()) # (its place: " cursor top anchor left")
  end
  a := appOf(here())
  if a.len() > 0
    saved = pc.fileWrite("settings:active", a)
  end
end

# a fresh, empty text
fresh :: proc()
  textLen = 0
  cursor = 0
  anchor = 0
  top = 0
  left = 0
  wantCol = -1
  rebuildLines()
  forgetAll()
end

setPath :: proc(p: String)
  path.clear()
  ok := path.pushAll(p[0..<min(p.len(), 96)])
end

# an app's or project's main file: /apps/chord/chord.rio, /projects/chord/chord.rio
mainBuf: Blob[..96]
mainPath :: proc(ref: String) -> String
  mainBuf.clear()
  n := ref
  ok := mainBuf.pushAll("/apps/")
  if ref.len() > 1 and ref[end] == 43
    n = ref[0..<end]
    mainBuf.clear()
    ok = mainBuf.pushAll("/projects/")
  end
  ok = mainBuf.pushAll(n)
  ok = mainBuf.push(47)
  ok = mainBuf.pushAll(n)
  ok = mainBuf.pushAll(".rio")
  return mainBuf[0..<mainBuf.len()].asString()
end

# what's in text, its lines ending with 10 alone (13s taken out)
settle :: proc(n: Int)
  k := 0
  for i in 0..<n
    if text[i] != 13
      text[k] = text[i]
      k += 1
    end
  end
  textLen = k
  checkedAt = -1 # (another file, or the same read again)
  edits += 1
  rebuildLines()
end

# how long app name's source is, without reading it: -1 if there's no such app
sourceLen :: proc(name: String) -> Int
  none: Blob[..] = one[0..<0]
  return appfiles.source(name, none)
end
# is file p text, n bytes long: UTF-8, with no control bytes but tab, line breaks and a 13 before a 10?
# (Anything else, a sheet's pixels say, saving here would change: 13s are taken out as it's read, and
# bytes that aren't text can't be shown.) Read a piece at a time, before what's open is let go
piece: Blob[..256]
isText :: proc(p: String, n: Int) -> Bool
  more := 0 # (bytes still to come in a character of UTF-8)
  was13 := false
  at := 0
  for at < n
    piece.clear()
    if pc.fileReadAt(p, at, piece) < 0 or piece.len() == 0
      return true # (what can be read of it)
    end
    for i in 0..<piece.len()
      c := piece[i]
      if was13 and c != 10
        return false
      end
      was13 = c == 13
      if more > 0
        if c < 128 or c >= 192
          return false
        end
        more -= 1
      case c >= 128
        if c >= 194 and c < 224
          more = 1
        case c >= 224 and c < 240
          more = 2
        case c >= 240 and c < 245
          more = 3
        else
          return false
        end
      case c < 32 and c != 9 and c != 10 and c != 13 or c == 127
        return false
      end
    end
    at += piece.len()
  end
  return more == 0 and not was13
end
# the file at p: false if it can't be had (a new one, if it isn't there yet and it could be saved)
load :: proc(p: String) -> Bool
  sizeOnly: Blob[..] = one[0..<0]
  n := pc.fileRead(p, sizeOnly)
  a := appOf(p)
  bundled := false
  if n < 0 and a.len() > 0 and a[end] != 42 and p == mainPath(a) # (an app the Rinc has built in)
    n = sourceLen(a)
    bundled = n >= 0
  end
  if n > CAP
    say("Too big for the editor: 32 KB at most", errorColor)
    return false
  end
  if n > 0 and not bundled and not isText(p, n)
    say("Not a text file (not UTF-8, or control bytes): not opened", errorColor)
    return false
  end
  fresh()
  setPath(p)
  if n < 0
    if readOnly()
      say("Can't read it", errorColor)
      path.clear()
      return false
    end
    sayName("New: ", "", softColor)
  else
    if bundled
      textIn: Blob[..] = text[0..<CAP]
      n = appfiles.source(a, textIn)
    else
      got: Blob[..] = text[0..<CAP]
      n = pc.fileRead(p, got)
    end
    settle(min(n, CAP))
    if u.resume("undo", p) # (its log, as it was, if it's this file's: the file as saved, where undo is)
      savedAt = u.at
    end
    if not readOnly()
      sayName("", ": ^S saves, ^R runs", softColor)
    case appOf(here()).len() > 0
      sayName("", ": read only (saving makes its project)", softColor)
    else
      sayName("", ": read only (^Shift+S saves a copy)", softColor)
    end
  end
  remember()
  return true
end

# Ctrl+Tab: the file it had before this one, where it was; again while Ctrl's still held, the one before
# that, and so on (back, Ctrl+Shift+Tab: the other way, from the one it had longest ago): rinc's recent
# library walks them, the list on the screen while Ctrl's held (letting go opens the pick: update)
switchTarget: Blob[..128]
# the walk's pick, opened where it was
openPick :: proc()
  switchTarget.clear()
  ok := switchTarget.pushAll(files.pickPath())
  at := placeOf(files.pickPlace())
  if load(switchTarget[0..<switchTarget.len()].asString())
    restore(at)
    remember()
  end
end
switchRecent :: proc(back: Bool)
  if path.len() > 0 and not files.walking
    remember() # (this one's place, first)
  end
  k := files.step(back, here())
  if k < 0
    say("No other file lately", softColor)
  case k > 0
    openPick()
  end
end
# Ctrl+W: this file closed: out of the recent list, the latest still in it opened where it was (none: a
# new file)
closeFile :: proc()
  next := files.drop(here())
  if next.len() == 0
    fresh()
    say("Closed: no other file lately", softColor)
    return
  end
  switchTarget.clear()
  ok := switchTarget.pushAll(next)
  at := placeOf(files.placeAt(0))
  if load(switchTarget[0..<switchTarget.len()].asString())
    restore(at)
    remember()
  else
    fresh()
  end
end

# where the last app to stop with an error stopped (taken, so once): its file, opened, with what's
# wrong selected (a runtime error's line, from its indent), and what it said. False if there's none
errorPath: Blob[128]
errorText: Blob[96]
goToError :: proc() -> Bool
  errorPathIn: Blob[..] = errorPath
  errorTextIn: Blob[..] = errorText
  e := pc.appError(errorPathIn, errorTextIn)
  if e.line < 1 or not load(errorPathIn.asString())
    return false
  end
  l := min(e.line, lineCount) - 1
  a := indentEnd(l)
  if e.col > 0
    a = lineAt[l] + min(e.col - 1, lineEnd(l) - lineAt[l])
  end
  moveTo(a, false)
  moveTo(min(a + e.len, lineEnd(l)), true)
  wantCol = -1
  say(errorTextIn.asString(), errorColor)
  return true
end

# /apps/chord/a.rio, in its project: /projects/chord/a.rio
inProject: Blob[..96]
projectPath :: proc(p: String) -> String
  inProject.clear()
  ok := inProject.pushAll("/projects/")
  ok = inProject.pushAll(p[6..<p.len()]) # (after /apps/)
  return inProject[0..<inProject.len()].asString()
end

# Files, called to pick a file to open, or a place to save as: what it has kept in its stash meanwhile
# (unsaved too), to have again when it comes back (with what was picked, or nothing)
argsBuf: Blob[..128]
toFiles := false
callFiles :: proc(how: String)
  if sourceLen("files") < 0
    say("There's no Files app here", errorColor)
    return
  end
  ok := pc.fileWrite("stash:draft", text[0..<textLen].asString())
  ok = pc.fileWrite("stash:draftPath", here())
  ok = pc.fileWrite("stash:calling", how)
  remember()
  toFiles = true # (what's typed next is Files')
  argsBuf.clear()
  pushed := argsBuf.pushAll(how)
  pushed = argsBuf.push(32)
  p := here()
  if p.len() == 0
    a: Blob[..34]
    _ = pc.fileRead("settings:active", a)
    p = "/projects"
    if a.len() > 0
      p = mainPath(a.asString())
    end
  end
  slash := p.len() - 1
  for slash > 0 and p[slash] != 47
    slash -= 1
  end
  if startsWith(p, "/projects") and slash < 9 # (/projects itself)
    slash = p.len()
  end
  pushed = argsBuf.pushAll(p[0..<max(slash, 1)])
  pc.call("files", argsBuf[0..<argsBuf.len()].asString())
end

saveAs :: proc()
  callFiles("save")
end

# a .rio file, laid out the one way (rio fmt) as it's saved: layOut
tidy :: proc()
  p := here()
  if p.len() >= 4 and p[p.len() - 4..<p.len()] == ".rio"
    layOut()
  end
end

refBuf: Blob[..34]
naming := false   # (a new file: a project's name asked for, to save it as that project's main file)
runAfter := false # (and then run it)
save :: proc() -> Bool
  if path.len() == 0
    if sourceLen("files") >= 0
      saveAs()
    else
      naming = true
    end
    return false
  end
  if readOnly()
    a := appOf(here())
    if a.len() == 0
      say("Read only here: ^Shift+S saves a copy", warnColor)
      return false
    end
    # an installed app's file: saved in its project, the app copied as one first if it hasn't one
    refBuf.clear()
    ok := refBuf.pushAll(a)
    ok = refBuf.push(43)
    if sourceLen(refBuf[0..<refBuf.len()].asString()) < 0 and appfiles.copy(a, refBuf[0..<refBuf.len()].asString()) != 0
      say("Couldn't make its project", errorColor)
      return false
    end
    setPath(projectPath(here()))
  end
  tidy()
  if pc.fileWrite(here(), text[0..<textLen].asString()) < 0
    sayName("Couldn't save ", "", errorColor)
    return false
  end
  savedAt = u.at
  merging = 0
  if u.about.asString() != here() # (saved as another: its log goes with it)
    u.retitle(here())
  end
  u.flush()
  keepSaved()
  sayName("Saved ", "", okColor)
  remember()
  return true
end

# Ctrl+R: saved, then its app or project run (an installed app, unchanged, as it is; a new file, as a
# new project's main file, its name asked for)
run :: proc()
  if path.len() == 0
    naming = true
    runAfter = true
    return
  end
  a := appOf(here())
  if a.len() == 0
    say("Not in an app: nothing to run", warnColor)
    return
  end
  if modified() and not save()
    return
  end
  remember() # (where it is, for coming back: saving keeps it, but an unchanged file isn't saved)
  refBuf.clear()
  ok := refBuf.pushAll(appOf(here()))
  pc.launch(refBuf[0..<refBuf.len()].asString())
end
