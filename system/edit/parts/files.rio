# Editor: files (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- files

last: Blob[..128] # the file it had last, and where: "path cursor top anchor left" (its save file "last")
# the files it had lately, the latest first, a line each as last is (its stash "recent"), for Ctrl+Tab
recent: Blob[..1024]
recentWas: Blob[..1024]
RECENT :: 8

here :: proc() -> String
  return path[0..<path.len()].asString()
end
# is it Rio (a new file, unnamed yet, is), so checked, completed and laid out as Rio
isRio :: proc() -> Bool
  return path.len() == 0 or (path.len() >= 4 and path[path.len() - 4..<path.len()].asString() == ".rio")
end

startsWith :: proc(s: String, start: String) -> Bool
  return s.len() >= start.len() and s[0..<start.len()] == start
end

# the app (chord) or project (chord+) a path is in, else ""
appIn: Blob[..34]
appOf :: proc(p: String) -> String
  appIn.clear()
  for k in 0..<2
    start := "/rinc/apps/"
    if k == 1
      start = "/rinc/projects/"
    end
    if p.len() > start.len() and startsWith(p, start)
      e := start.len()
      for e < p.len() and p[e] != 47
        e += 1
      end
      ok := appIn.pushAll(p[start.len()..<e])
      if k == 1
        ok = appIn.push(43)
      end
    end
  end
  return appIn[0..<appIn.len()].asString()
end

# read only: an installed app's files (saving makes its project), and anything outside /rinc
readOnly :: proc() -> Bool
  p := here()
  return p.len() > 0 and (not startsWith(p, "/rinc/") or startsWith(p, "/rinc/apps/"))
end

# a line of recent's (or last): its path, what's before the numbers at its end (up to 4: older lines have
# 2); and where it was: its cursor, top line, anchor and left column (an older line's anchor: its cursor)
isNumber :: proc(s: String) -> Bool
  for i in 0..<s.len()
    if s[i] < 48 or s[i] > 57
      return false
    end
  end
  return s.len() > 0
end
pathOf :: proc(line: String) -> String
  e := line.len()
  for _ in 0..<4
    s := e - 1
    for s >= 0 and line[s] != 32
      s -= 1
    end
    if s < 0 or not isNumber(line[s + 1..<e])
      return line[0..<e]
    end
    e = s
  end
  return line[0..<e]
end
placeOf :: proc(line: String) -> [4]Int
  r := [4]Int{0, 0, -1, 0}
  part := -1
  for i in pathOf(line).len()..<line.len()
    c := line[i]
    if c == 32
      part += 1
    case c >= 48 and c <= 57 and part >= 0 and part < 4
      r[part] = max(r[part], 0) * 10 + c - 48
    end
  end
  if r[2] < 0
    r[2] = r[0]
  end
  return r
end
# where a line of recent's (or last) says it was, again: cursor, selection, and scrolled as it was
restore :: proc(at: [4]Int)
  cursor = min(at[0], textLen)
  anchor = min(at[2], textLen)
  top = max(0, min(at[1], lineCount - 1))
  left = max(at[3], 0)
  wantCol = -1
end
# line k of a list of recent's lines (from 0): "" if there's none; and how many lines it has
lineIn :: proc(list: String, k: Int) -> String
  at := 0
  n := 0
  for i in 0..<list.len()
    if list[i] == 10
      if n == k
        return list[at..<i]
      end
      n += 1
      at = i + 1
    end
  end
  return ""
end
linesIn :: proc(list: String) -> Int
  n := 0
  for i in 0..<list.len()
    if list[i] == 10
      n += 1
    end
  end
  return n
end

# where it is, kept for next time: on opening, saving and running (last, and first in recent); and the
# app or project it's in is the active one, the whole Rinc's setting
remember :: proc()
  last.clear()
  ok := last.pushAll(path[0..<path.len()])
  _ = last.print(" ", cursor, " ", top, " ", anchor, " ", left)
  saved := pc.saveWrite("last", last[0..<last.len()].asString())
  if path.len() > 0
    recentWas.clear()
    _ = pc.stashRead("recent", recentWas)
    recent.clear()
    ok = recent.pushAll(last[0..<last.len()])
    ok = recent.push(10)
    n := 1
    at := 0
    for i in 0..<recentWas.len()
      if recentWas[i] == 10
        line := recentWas[at..<i].asString()
        if n < RECENT and line.len() > 0 and pathOf(line) != here()
          ok = recent.pushAll(line)
          ok = recent.push(10)
          n += 1
        end
        at = i + 1
      end
    end
    saved = pc.stashWrite("recent", recent[0..<recent.len()].asString())
  end
  a := appOf(here())
  if a.len() > 0
    saved = pc.settingWrite("active", a)
  end
end

# a fresh, empty text
fresh :: proc()
  textLen = 0
  cursor = 0
  anchor = 0
  top = 0
  left = 0
  wantCol = -1
  rebuildLines()
  forgetAll()
  savedTop = 0
end

setPath :: proc(p: String)
  path.clear()
  ok := path.pushAll(p[0..<min(p.len(), 96)])
end

# an app's or project's main file: /rinc/apps/chord/chord.rio, /rinc/projects/chord/chord.rio
mainBuf: Blob[..96]
mainPath :: proc(ref: String) -> String
  mainBuf.clear()
  n := ref
  ok := mainBuf.pushAll("/rinc/apps/")
  if ref.len() > 1 and ref[end] == 43
    n = ref[0..<end]
    mainBuf.clear()
    ok = mainBuf.pushAll("/rinc/projects/")
  end
  ok = mainBuf.pushAll(n)
  ok = mainBuf.push(47)
  ok = mainBuf.pushAll(n)
  ok = mainBuf.pushAll(".rio")
  return mainBuf[0..<mainBuf.len()].asString()
end

# what's in text, its lines ending with 10 alone (13s taken out)
settle :: proc(n: Int)
  k := 0
  for i in 0..<n
    if text[i] != 13
      text[k] = text[i]
      k += 1
    end
  end
  textLen = k
  checkedAt = -1 # (another file, or the same read again)
  edits += 1
  rebuildLines()
end

# how long app name's source is, without reading it: -1 if there's no such app
sourceLen :: proc(name: String) -> Int
  none: Blob[..] = one[0..<0]
  return pc.appSource(name, none)
end
# the file at p: false if it can't be had (a new one, if it isn't there yet and it could be saved)
load :: proc(p: String) -> Bool
  sizeOnly: Blob[..] = one[0..<0]
  n := pc.fileRead(p, sizeOnly)
  a := appOf(p)
  bundled := false
  if n < 0 and a.len() > 0 and a[end] != 42 and p == mainPath(a) # (an app the Rinc has built in)
    n = sourceLen(a)
    bundled = n >= 0
  end
  if n > CAP
    say("Too big for the editor: 32 KB at most", errorColor)
    return false
  end
  fresh()
  setPath(p)
  if n < 0
    if readOnly()
      say("Can't read it", errorColor)
      path.clear()
      return false
    end
    sayName("New: ", "", softColor)
  else
    if bundled
      textIn: Blob[..] = text[0..<CAP]
      n = pc.appSource(a, textIn)
    else
      got: Blob[..] = text[0..<CAP]
      n = pc.fileRead(p, got)
    end
    settle(min(n, CAP))
    if not readOnly()
      sayName("", ": ^S saves, ^R runs", softColor)
    case appOf(here()).len() > 0
      sayName("", ": read only (saving makes its project)", softColor)
    else
      sayName("", ": read only (^Shift+S saves a copy)", softColor)
    end
  end
  remember()
  return true
end

# Ctrl+Tab: the file it had before this one, where it was; again while Ctrl's still held, the one before
# that, and so on, through the list as it was when the walk began (back, Ctrl+Shift+Tab: the other way,
# from the one it had longest ago). While Ctrl's held, the list is on the screen (walking) and Tab just
# moves its pick: letting go opens it (update, in keys.rio), and another key, Esc too, closes it. Where
# Rinc can't tell what's held (pc.modsHeld, -1), each press opens its file, and the walk goes on while
# the presses come within 1.5 seconds; another key ends it there too (keys.rio sets walkStep to 0)
walk: Blob[..1024]
walkStep := 0
walkAt := 0.0
walking := false
switchTarget: Blob[..128]
# line k of the walk's list, opened where it was (nothing, if it's this one)
switchTo :: proc(k: Int)
  line := lineIn(walk.asString(), k)
  if line.len() == 0 or pathOf(line) == here()
    return
  end
  at := placeOf(line)
  switchTarget.clear()
  ok := switchTarget.pushAll(pathOf(line))
  if load(switchTarget[0..<switchTarget.len()].asString())
    restore(at)
    remember()
  end
end
switchRecent :: proc(back: Bool)
  held := pc.modsHeld() >= 0
  if not walking and (walkStep == 0 or (not held and pc.time() - walkAt > 1.5)) # (a walk begins)
    if path.len() > 0
      remember() # (this one's place, first)
    end
    walk.clear()
    _ = pc.stashRead("recent", walk)
    walkStep = 0
  end
  n := linesIn(walk.asString())
  k := walkStep + 1
  if back
    k = walkStep - 1 + n
  end
  if n > 0
    k = k % n
  end
  if path.len() == 0 and k == 0 and n > 1 # (nothing open: the latest isn't this one)
    k = walkStep
  end
  line := lineIn(walk.asString(), k)
  if line.len() == 0 or (n < 2 and pathOf(line) == here())
    say("No other file lately", softColor)
    return
  end
  walkStep = k
  walkAt = pc.time()
  if held # (the pick, on the list: letting go of Ctrl opens it)
    walking = true
    return
  end
  switchTo(k)
end

# where the last app to stop with an error stopped (taken, so once): its file, opened, with what's
# wrong selected (a runtime error's line, from its indent), and what it said. False if there's none
errorPath: Blob[128]
errorText: Blob[96]
goToError :: proc() -> Bool
  errorPathIn: Blob[..] = errorPath
  errorTextIn: Blob[..] = errorText
  e := pc.appError(errorPathIn, errorTextIn)
  if e.line < 1 or not load(errorPathIn.asString())
    return false
  end
  l := min(e.line, lineCount) - 1
  a := indentEnd(l)
  if e.col > 0
    a = lineAt[l] + min(e.col - 1, lineEnd(l) - lineAt[l])
  end
  moveTo(a, false)
  moveTo(min(a + e.len, lineEnd(l)), true)
  wantCol = -1
  say(errorTextIn.asString(), errorColor)
  return true
end

# /rinc/apps/chord/a.rio, in its project: /rinc/projects/chord/a.rio
inProject: Blob[..96]
projectPath :: proc(p: String) -> String
  inProject.clear()
  ok := inProject.pushAll("/rinc/projects/")
  ok = inProject.pushAll(p[11..<p.len()])
  return inProject[0..<inProject.len()].asString()
end

# Files, called to pick a file to open, or a place to save as: what it has kept in its stash meanwhile
# (unsaved too), to have again when it comes back (with what was picked, or nothing)
argsBuf: Blob[..128]
leaving := false
callFiles :: proc(how: String)
  if sourceLen("files") < 0
    say("There's no Files app here", errorColor)
    return
  end
  ok := pc.stashWrite("draft", text[0..<textLen].asString())
  ok = pc.stashWrite("draftPath", here())
  ok = pc.stashWrite("calling", how)
  remember()
  leaving = true # (what's typed next is Files')
  argsBuf.clear()
  pushed := argsBuf.pushAll(how)
  pushed = argsBuf.push(32)
  p := here()
  if p.len() == 0
    a: Blob[..34]
    _ = pc.settingRead("active", a)
    p = "/rinc/projects"
    if a.len() > 0
      p = mainPath(a.asString())
    end
  end
  slash := p.len() - 1
  for slash > 0 and p[slash] != 47
    slash -= 1
  end
  if startsWith(p, "/rinc/projects") and slash < 14
    slash = p.len()
  end
  pushed = argsBuf.pushAll(p[0..<max(slash, 1)])
  pc.call("files", argsBuf[0..<argsBuf.len()].asString())
end

saveAs :: proc()
  callFiles("save")
end

# a .rio file, laid out the one way (rio fmt) as it's saved: layOut
tidy :: proc()
  p := here()
  if p.len() >= 4 and p[p.len() - 4..<p.len()] == ".rio"
    layOut()
  end
end

refBuf: Blob[..34]
naming := false   # (a new file: a project's name asked for, to save it as that project's main file)
runAfter := false # (and then run it)
save :: proc() -> Bool
  if path.len() == 0
    if sourceLen("files") >= 0
      saveAs()
    else
      naming = true
    end
    return false
  end
  if readOnly()
    a := appOf(here())
    if a.len() == 0
      say("Read only here: ^Shift+S saves a copy", warnColor)
      return false
    end
    # an installed app's file: saved in its project, the app copied as one first if it hasn't one
    refBuf.clear()
    ok := refBuf.pushAll(a)
    ok = refBuf.push(43)
    if sourceLen(refBuf[0..<refBuf.len()].asString()) < 0 and pc.appCopy(a, refBuf[0..<refBuf.len()].asString()) != 0
      say("Couldn't make its project", errorColor)
      return false
    end
    setPath(projectPath(here()))
  end
  tidy()
  if pc.fileWrite(here(), text[0..<textLen].asString()) < 0
    sayName("Couldn't save ", "", errorColor)
    return false
  end
  savedTop = recTop
  merging = 0
  sayName("Saved ", "", okColor)
  remember()
  return true
end

# Ctrl+R: saved, then its app or project run (an installed app, unchanged, as it is; a new file, as a
# new project's main file, its name asked for)
run :: proc()
  if path.len() == 0
    naming = true
    runAfter = true
    return
  end
  a := appOf(here())
  if a.len() == 0
    say("Not in an app: nothing to run", warnColor)
    return
  end
  if modified() and not save()
    return
  end
  remember() # (where it is, for coming back: saving keeps it, but an unchanged file isn't saved)
  refBuf.clear()
  ok := refBuf.pushAll(appOf(here()))
  pc.launch(refBuf[0..<refBuf.len()].asString())
end
