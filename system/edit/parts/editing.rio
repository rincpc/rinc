# Editor: moving, editing, the clipboard (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- moving

isWord :: proc(c: Int) -> Bool
  return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
end
isSpace :: proc(c: Int) -> Bool
  return c == 32 or c == 9 or c == 10
end

wordLeft :: proc(p: Int) -> Int
  q := p
  for q > 0 and isSpace(text[q - 1])
    q -= 1
  end
  if q > 0 and isWord(text[q - 1])
    for q > 0 and isWord(text[q - 1])
      q -= 1
    end
  else
    for q > 0 and not isWord(text[q - 1]) and not isSpace(text[q - 1])
      q -= 1
    end
  end
  return q
end

wordRight :: proc(p: Int) -> Int
  q := p
  for q < textLen and isSpace(text[q])
    q += 1
  end
  if q < textLen and isWord(text[q])
    for q < textLen and isWord(text[q])
      q += 1
    end
  else
    for q < textLen and not isWord(text[q]) and not isSpace(text[q])
      q += 1
    end
  end
  return q
end

# the first character on line l that isn't a space
indentEnd :: proc(l: Int) -> Int
  p := lineAt[l]
  e := lineEnd(l)
  for p < e and text[p] == 32
    p += 1
  end
  return p
end

moveTo :: proc(p: Int, extend: Bool)
  cursor = max(0, min(p, textLen))
  if not extend
    anchor = cursor
  end
  merging = 0
end

# to line l, at the column up and down keep to
moveToLine :: proc(l: Int, extend: Bool)
  cl := lineOf(cursor)
  if wantCol < 0
    wantCol = cursor - lineAt[cl]
  end
  target := max(0, min(l, lineCount - 1))
  col := wantCol
  moveTo(lineAt[target] + min(col, lineEnd(target) - lineAt[target]), extend)
  wantCol = col
end

# ---------------------------------------------------------------- editing

typeChar :: proc(c: Int)
  if c == 32 and cursor > 0 and text[cursor - 1] != 32
    merging = 0 # (a word and the space after it undo together)
  end
  one[0] = c
  kind := 1
  if cursor != anchor
    kind = 0
  end
  ok := edit(selStart(), selEnd(), one[0..<1].asString(), kind)
end

# does line l's text, after its indent, start with word w (then a space or its end)?
startsWord :: proc(l: Int, w: String) -> Bool
  p := indentEnd(l)
  e := lineEnd(l)
  if e - p < w.len()
    return false
  end
  for i in 0..<w.len()
    if text[p + i] != w[i]
      return false
    end
  end
  return p + w.len() == e or not isWord(text[p + w.len()])
end

# does line l have s in it?
lineHas :: proc(l: Int, s: String) -> Bool
  a := lineAt[l]
  e := lineEnd(l)
  for p in a..<e - s.len() + 1
    k := 0
    for k < s.len() and text[p + k] == s[k]
      k += 1
    end
    if k == s.len()
      return true
    end
  end
  return false
end

# a line that opens a block: the next is indented one more step (not a switch: its cases line up with it,
# and not a one-line block: `if done do return`)
opensBlock :: proc(l: Int) -> Bool
  if lineHas(l, " do ")
    return false
  end
  return startsWord(l, "if") or startsWord(l, "else") or startsWord(l, "for") or startsWord(l, "do") or
         startsWord(l, "case") or lineHas(l, ":: proc") or lineHas(l, ":: struct") or lineHas(l, ":: enum") or
         lineHas(l, ":: union")
end

# a line that's a comment (after its indent, a #): how far its # and the spaces after it go, else 0
commentMark :: proc(l: Int) -> Int
  p := indentEnd(l)
  e := lineEnd(l)
  if p == e or text[p] != 35
    return 0
  end
  q := p + 1
  for q < e and text[q] == 32
    q += 1
  end
  return q - p
end

# Enter: a new line, with the line's indent (a step more after a line that opens a block); in a comment
# line, after its #, the comment goes on (# and its spaces, again), unless it's empty: then it ends there
enter :: proc()
  l := lineOf(selStart())
  indent := min(indentEnd(l), selStart()) - lineAt[l]
  mark := commentMark(l)
  if mark > 0 and selStart() >= indentEnd(l) + 1 and indentEnd(l) + mark == lineEnd(l) and selEnd() == lineEnd(l)
    merging = 0 # (an empty comment line: its # taken off, the comment done)
    ok := edit(indentEnd(l), lineEnd(l), "", 0)
    return
  end
  if opensBlock(l) and selStart() > indentEnd(l)
    indent += 2
  end
  built.clear()
  _ = built.push(10)
  for _ in 0..<indent
    _ = built.push(32)
  end
  if mark > 0 and selStart() >= indentEnd(l) + 1
    _ = built.pushAll(text[indentEnd(l)..<indentEnd(l) + mark])
    if mark == 1
      _ = built.push(32) # ("#" alone: "# " to go on)
    end
  end
  merging = 0
  ok := edit(selStart(), selEnd(), built[0..<built.len()].asString(), 0)
end

# having typed the end of `end`, `else` or `case` alone on its line, a step back out of the block
dedent :: proc()
  l := lineOf(cursor)
  p := indentEnd(l)
  if cursor != lineEnd(l) or p - lineAt[l] < 2 or not (startsWord(l, "end") or startsWord(l, "else") or startsWord(l, "case"))
    return
  end
  if cursor - p != 3 and cursor - p != 4
    return
  end
  if l > 0
    k := l - 1
    for k > 0 and indentEnd(k) == lineEnd(k) # (blank lines)
      k -= 1
    end
    if indentEnd(k) - lineAt[k] < p - lineAt[l] and not opensBlock(k)
      return # (already dedented, unless the block is empty: if x, then end)
    end
  end
  c := cursor
  ok := edit(lineAt[l], lineAt[l] + 2, "", 0)
  cursor = c - 2
  anchor = cursor
end

backspace :: proc(ctrl: Bool)
  if cursor != anchor
    ok := edit(selStart(), selEnd(), "", 0)
    return
  end
  if cursor == 0
    return
  end
  if ctrl
    ok := edit(wordLeft(cursor), cursor, "", 0)
    return
  end
  l := lineOf(cursor)
  col := cursor - lineAt[l]
  if col > 0 and indentEnd(l) >= cursor # (in the indent: back to the step before)
    n := 2 - col % 2
    ok := edit(cursor - n, cursor, "", 2)
    return
  end
  ok := edit(cursor - 1, cursor, "", 2)
end

deleteForward :: proc(ctrl: Bool)
  if cursor != anchor
    ok := edit(selStart(), selEnd(), "", 0)
  case cursor < textLen
    if ctrl
      ok := edit(cursor, wordRight(cursor), "", 0)
    else
      ok := edit(cursor, cursor + 1, "", 3)
    end
  end
end

# the lines the selection is on (or the cursor's): into first and last
first := 0
last := 0
selectedLines :: proc()
  first = lineOf(selStart())
  last = lineOf(selEnd())
  if last > first and lineAt[last] == selEnd()
    last -= 1
  end
end

# the selected lines (or the cursor's), each a step in (dir 1) or out (-1)
indentLines :: proc(dir: Int)
  selectedLines()
  a := lineAt[first]
  b := lineEnd(last)
  had := cursor != anchor
  c := cursor
  built.clear()
  for l in first..=last
    p := lineAt[l]
    e := lineEnd(l)
    if dir > 0 and e > p
      _ = built.push(32)
      _ = built.push(32)
    case dir < 0
      k := 0
      for k < 2 and p < e and text[p] == 32
        p += 1
        k += 1
      end
    end
    if built.len() + (e - p) + 1 > BUILT
      say("Too much to indent at once", errorColor)
      return
    end
    _ = built.pushAll(text[p..<e])
    if l < last
      _ = built.push(10)
    end
  end
  delta := built.len() - (b - a)
  merging = 0
  ok := edit(a, b, built[0..<built.len()].asString(), 0)
  if had or first != last
    anchor = a
    cursor = a + built.len()
  else
    cursor = max(a, c + delta)
    anchor = cursor
  end
end

tab :: proc(shift: Bool)
  if shift or lineOf(selStart()) != lineOf(selEnd())
    if shift
      indentLines(-1)
    else
      indentLines(1)
    end
    return
  end
  col := selStart() - lineAt[lineOf(selStart())]
  if col % 2 == 1
    ok := edit(selStart(), selEnd(), " ", 0)
  else
    ok := edit(selStart(), selEnd(), "  ", 0)
  end
end

# the selected lines (or the cursor's) moved up (dir -1) or down past their neighbor
moveLines :: proc(dir: Int)
  selectedLines()
  if (dir < 0 and first == 0) or (dir > 0 and last == lineCount - 1)
    return
  end
  a := lineAt[first]
  b := lineEnd(last)
  o := last + 1 # the neighbor
  if dir < 0
    o = first - 1
  end
  oa := lineAt[o]
  oe := lineEnd(o)
  if (b - a) + (oe - oa) + 1 > BUILT
    say("Too much to move at once", errorColor)
    return
  end
  c := cursor
  n := anchor
  built.clear()
  if dir < 0
    _ = built.pushAll(text[a..<b])
    _ = built.push(10)
    _ = built.pushAll(text[oa..<oe])
    merging = 0
    ok := edit(oa, b, built[0..<built.len()].asString(), 0)
    cursor = c - (oe - oa) - 1
    anchor = n - (oe - oa) - 1
  else
    _ = built.pushAll(text[oa..<oe])
    _ = built.push(10)
    _ = built.pushAll(text[a..<b])
    merging = 0
    ok := edit(a, oe, built[0..<built.len()].asString(), 0)
    cursor = c + (oe - oa) + 1
    anchor = n + (oe - oa) + 1
  end
end

deleteLines :: proc()
  selectedLines()
  a := lineAt[first]
  b := lineEnd(last)
  if b < textLen
    b += 1 # (the newline after)
  case a > 0
    a -= 1 # (the last line: the newline before)
  end
  merging = 0
  ok := edit(a, b, "", 0)
  moveTo(lineAt[lineOf(min(a + 1, textLen))], false)
  if a == 0
    moveTo(0, false)
  end
end

# Ctrl+Shift+J: the next line joined onto this one (or the selected lines, all onto the first): each
# one's indent and the spaces at the ends taken off, and a space between them, but none after an opening
# bracket or before a closing one, a comma or a dot; a comment line joined onto a comment line loses its
# #. The cursor goes where the first two lines met
joinLines :: proc()
  selectedLines()
  if last == first
    last = first + 1
  end
  if last >= lineCount
    return
  end
  a := lineAt[first]
  b := lineEnd(last)
  if b - a + 1 > BUILT
    say("Too much to join at once", errorColor)
    return
  end
  built.clear()
  e := lineEnd(first)
  for e > a and text[e - 1] == 32
    e -= 1
  end
  _ = built.pushAll(text[a..<e])
  at := -1
  for l in first + 1..=last
    p := indentEnd(l)
    e = lineEnd(l)
    for e > p and text[e - 1] == 32
      e -= 1
    end
    if commentMark(l) > 0 and commentMark(l - 1) > 0
      p += commentMark(l) # (a comment going on: one comment)
    end
    n := built.len()
    if p < e and n > 0 and built[n - 1] != 32 and built[n - 1] != 40 and built[n - 1] != 91 and built[n - 1] != 123 and
        text[p] != 41 and text[p] != 93 and text[p] != 125 and text[p] != 44 and text[p] != 46
      _ = built.push(32)
    end
    if at < 0
      at = a + built.len()
    end
    _ = built.pushAll(text[p..<e])
  end
  merging = 0
  ok := edit(a, b, built[0..<built.len()].asString(), 0)
  moveTo(at, false)
end

# ---------------------------------------------------------------- laid out (rio fmt)

formatted: Blob[32769] # the text, as rio fmt lays it out (a byte more than the text can have: its end)

# a character rio fmt keeps (it changes only spaces and line breaks, and may add a comma)
kept :: proc(c: Int) -> Bool
  return c != 32 and c != 10 and c != 13 and c != 9 and c != 44
end

# how many kept characters come before p in s
keptBefore :: proc(s: String, p: Int) -> Int
  n := 0
  for i in 0..<p
    if kept(s[i])
      n += 1
    end
  end
  return n
end

# where in s, after n kept characters: just after the nth, or (on) at the next one
placeAfter :: proc(s: String, n: Int, on: Bool) -> Int
  k := 0
  for i in 0..<s.len()
    if kept(s[i])
      if k == n and on
        return i
      end
      k += 1
      if k == n and not on
        return i + 1
      end
    end
  end
  return s.len()
end

# where p is, as code: kept characters before it, and whether it's on the next one (it's at that one,
# or in the spaces at a line's start before it) rather than just after the one before
mark :: proc(p: Int) -> [2]Int
  on := p < textLen and (kept(text[p]) or p <= indentEnd(lineOf(p)))
  n := keptBefore(text[0..<textLen].asString(), p)
  if on
    return {n, 1}
  end
  return {n, 0}
end

# the text laid out the one way (rio fmt): the cursor and selection on the same code, and the cursor's
# line where it was on the screen. Undo takes it back, as an edit of just the part that changed
layOut :: proc()
  n := pc.formatRio(formatted[], text[0..<textLen].asString())
  if n < 0 or n > CAP
    return # (too big, or not sure of it: as it is)
  end
  a := 0 # (what changed: text[a..<textLen - b] becomes formatted[a..<n - b])
  for a < n and a < textLen and text[a] == formatted[a]
    a += 1
  end
  if a == n and a == textLen
    return
  end
  b := 0
  for b < n - a and b < textLen - a and text[textLen - 1 - b] == formatted[n - 1 - b]
    b += 1
  end
  row := lineOf(cursor) - top
  c := mark(cursor)
  s := mark(anchor)
  merging = 0
  if not edit(a, textLen - b, formatted[a..<n - b].asString(), 0)
    return
  end
  merging = 0
  laid := text[0..<textLen].asString()
  cursor = placeAfter(laid, c[0], c[1] == 1)
  anchor = placeAfter(laid, s[0], s[1] == 1)
  top = max(0, min(lineOf(cursor) - row, lineCount - 1))
  wantCol = -1
end

# ---------------------------------------------------------------- the clipboard

clip: Blob[..16384]
clipIsLine := false # copied with nothing selected: a whole line, pasted as one

copy :: proc(cut: Bool)
  a := selStart()
  b := selEnd()
  clipIsLine = a == b
  if clipIsLine
    l := lineOf(cursor)
    a = lineAt[l]
    b = lineEnd(l)
    if b < textLen
      b += 1
    end
  end
  if b - a > CLIP
    say("Too much to copy: 16 KB at most", errorColor)
    return
  end
  clip.clear()
  _ = clip.pushAll(text[a..<b])
  if clipIsLine and (b == a or text[b - 1] != 10)
    _ = clip.push(10)
  end
  if cut
    merging = 0
    ok := edit(a, b, "", 0)
  end
end

paste :: proc()
  merging = 0
  if clipIsLine and cursor == anchor # (a whole line: above this one)
    c := cursor
    l := lineOf(cursor)
    ok := edit(lineAt[l], lineAt[l], clip[0..<clip.len()].asString(), 0)
    cursor = c + clip.len()
    anchor = cursor
    return
  end
  ok := edit(selStart(), selEnd(), clip[0..<clip.len()].asString(), 0)
end
