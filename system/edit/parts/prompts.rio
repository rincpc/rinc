# Editor: prompts (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- prompts

NONE :: 0
PALETTE :: 1
NAMING :: 2
FIND :: 3
GO_TO :: 4
mode := NONE
input: Blob[..33]
query: Blob[..48]
confirm := 0     # an action asked for again after a warning: it goes ahead

lower :: proc(c: Int) -> Int
  if c >= 65 and c <= 90
    return c + 32
  end
  return c
end

has :: proc(s: String, f: Blob) -> Bool
  for p in 0..<s.len() - f.len() + 1
    k := 0
    for k < f.len() and lower(s[p + k]) == lower(f[k])
      k += 1
    end
    if k == f.len()
      return true
    end
  end
  return false
end

# every command, for the list Ctrl+Shift+P shows
COMMANDS :: 25
Command :: struct
  label: String   # what it does
  keys: String    # its keys, as shown
  key: Int        # the key it is, as typed (-1: help, -2: home)
end
commands := [COMMANDS]Command{
  {label = "Open a file", keys = "^O", key = 15},
  {label = "Save", keys = "^S", key = 19},
  {label = "Save as", keys = "^Shift+S", key = 19 | SHIFT},
  {label = "Run its app", keys = "^R", key = 18},
  {label = "New file", keys = "^N", key = 14},
  {label = "Find", keys = "^F", key = 6},
  {label = "Go to line", keys = "^G", key = 7},
  {label = "Undo", keys = "^Z", key = 26},
  {label = "Redo", keys = "^Y", key = 25},
  {label = "Select all", keys = "^A", key = 1},
  {label = "Select the line", keys = "^L", key = 12},
  {label = "Cut", keys = "^X", key = 24},
  {label = "Copy", keys = "^C", key = 3},
  {label = "Paste", keys = "^V", key = 22},
  {label = "Delete the lines", keys = "^Shift+K", key = 11 | SHIFT},
  {label = "Join the lines", keys = "^Shift+J", key = 10 | SHIFT},
  {label = "Complete the word", keys = "^Space", key = 32 | CTRL},
  {label = "Comment the lines", keys = "^/", key = 47 | CTRL},
  {label = "Move the lines up", keys = "Alt+Up", key = UP | ALT},
  {label = "Move the lines down", keys = "Alt+Down", key = DOWN | ALT},
  {label = "Indent", keys = "Tab", key = 9},
  {label = "Outdent", keys = "Shift+Tab", key = 9 | SHIFT},
  {label = "Line numbers, shown or not", keys = "", key = -3},
  {label = "Help", keys = "", key = -1},
  {label = "Home", keys = "Sys+Esc", key = -2},
}
listed: [COMMANDS]Int
nlisted := 0
pick := 0

narrow :: proc()
  nlisted = 0
  for i in 0..<COMMANDS
    if has(commands[i].label, input[0..<input.len()])
      listed[nlisted] = i
      nlisted += 1
    end
  end
  pick = max(0, min(pick, nlisted - 1))
end

startPrompt :: proc(m: Int)
  mode = m
  input.clear()
  if m == PALETTE
    pick = 0
    narrow()
  end
end

# a command from the list
queued := 0
command :: proc(i: Int)
  mode = NONE
  if commands[i].key == -1
    pc.help("edit/README")
  case commands[i].key == -2
    pc.launch("home")
  case commands[i].key == -3 # (and kept, for next time)
    showNumbers(not numbers)
    v := "0"
    if numbers
      v = "1"
    end
    saved := pc.saveWrite("numbers", v)
  else
    queued = commands[i].key # (as typed: update does it)
  end
end

# Ctrl+F's text, found after the selection (or from the start, after the end), and selected
findNext :: proc()
  f := query.len()
  if f == 0
    return
  end
  for pass in 0..<2
    from := selEnd()
    if pass == 1
      from = 0
    end
    for p in from..<textLen - f + 1
      k := 0
      for k < f and lower(text[p + k]) == lower(query[k])
        k += 1
      end
      if k == f
        anchor = p
        cursor = p + f
        wantCol = -1
        merging = 0
        return
      end
    end
  end
  say("Not found", softColor)
end

# what the prompt does with Enter
promptDone :: proc()
  m := mode
  s := input[0..<input.len()].asString()
  if m == PALETTE
    if nlisted > 0
      command(listed[pick])
    end
  case m == NAMING # (a new file, as a new project's main file)
    ok := true
    for c in s
      ok = ok and ((c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 45)
    end
    if s.len() == 0 or s.len() > 32 or not ok
      say("A name is letters, digits, _ and -", errorColor)
      return
    end
    refBuf.clear()
    pushed := refBuf.pushAll(s)
    pushed = refBuf.push(43)
    if sourceLen(refBuf[0..<refBuf.len()].asString()) >= 0
      say("There's a project of that name already", errorColor)
      return
    end
    mode = NONE
    setPath(mainPath(refBuf[0..<refBuf.len()].asString()))
    if save() and runAfter
      run()
    end
    runAfter = false
  case m == GO_TO
    n := 0
    for c in s
      if c >= 48 and c <= 57
        n = n * 10 + c - 48
      end
    end
    mode = NONE
    if n > 0
      moveTo(lineAt[min(n, lineCount) - 1], false)
      wantCol = -1
    end
  case m == FIND
    findNext()
  end
end

promptKey :: proc(k: Int)
  if k == 27
    mode = NONE
    confirm = 0
    runAfter = false
    return
  end
  if k == 13
    promptDone()
    return
  end
  if mode == FIND
    if k == 8
      if query.len() > 0
        _ = query.pop()
      end
    case k >= 32 and k < 127 and query.len() < 48
      _ = query.push(k)
    end
    return
  end
  if k == 8
    if input.len() > 0
      _ = input.pop()
    end
  case k >= 32 and k < 127 and input.len() < 32
    _ = input.push(k)
  case mode == PALETTE and (k & 255) == UP
    pick = max(0, pick - 1)
  case mode == PALETTE and (k & 255) == DOWN
    pick = min(nlisted - 1, pick + 1)
  end
  if mode == PALETTE
    narrow()
  end
end
