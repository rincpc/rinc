# Editor: completion (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- completion
#
# Ctrl+Space offers what could finish the word at the cursor, as Rio sees it there: the names in scope
# (the proc's own first), with what each is, and Rio's words that fit (a statement's, an expression's,
# after a value and, or, is); then the file's own words (the nearest first). With just one, it's put
# in. After a dot, what's before it has: a value's fields and methods (its kind's built-in ones too), a
# type's values and static procs, a module's names. It opens only for Ctrl+Space, never by itself (a
# check can take half a second on the board: typing isn't held up). Typing narrows the list, Up and Down
# (and Page Up and Down) pick, Tab or Enter puts the pick in, and Esc or any other key closes it. Rio's view of it comes from a check (pc.checkRio): the app's main
# file compiled up to the start of the cursor's line, in formatted (saving's: a save means another);
# another only once the line, or anything above it, changes.

OFFERED :: 256           # names offered at once (the nearest, of the file's words)
SHOWN_ROWS :: 10         # the most rows the list shows
ITEMS :: 4096            # what pc.completeRio says fits (a hundred names or more)

completing := false
wordFrom := 0            # where the word being finished starts
offerKind: [256]Int      # each name offered: 0 in pool (the file's words), 1 in items (Rio's)
offerAt: [256]Int
offerLen: [256]Int
offerSigAt: [256]Int     # what it is (a proc's signature, a variable's type), in items (offerSigLen 0: nothing)
offerSigLen: [256]Int
offerRank: [256]Int      # the order: Rio's names, then its words, then the file's words by their distance
offers := 0
pool: Blob[..4096]       # the file's words offered
items: Blob[4096]        # pc.completeRio's: a line each, name, tab, kind, tab, what it is
shown: [256]Int          # the offers that start with what's typed, in order
shownCount := 0
offerPick := 0
offerTop := 0
listBox := [4]Int{0, 0, 0, 0} # where the list was drawn: x, y, width, rows (for the pointer)

offerText :: proc(i: Int) -> String
  a := offerAt[i]
  if offerKind[i] == 0
    return pool[a..<a + offerLen[i]].asString()
  end
  return items[a..<a + offerLen[i]].asString()
end

offerSig :: proc(i: Int) -> String
  return items[offerSigAt[i]..<offerSigAt[i] + offerSigLen[i]].asString()
end

# s starts with what's typed (any case)
startsTyped :: proc(s: String) -> Bool
  n := cursor - wordFrom
  if s.len() < n
    return false
  end
  for k in 0..<n
    if lower(s[k]) != lower(text[wordFrom + k])
      return false
    end
  end
  return true
end

# a name offered, s (kind 0: one of the text's words, kept in pool), if it starts with what's typed and
# isn't offered already (the nearer rank stays). Full, the farthest gives way to a nearer one
offer :: proc(kind, at, n, sigAt, sigLen, rank: Int, s: String)
  if not startsTyped(s)
    return
  end
  for i in 0..<offers
    if offerLen[i] == n and offerText(i) == s
      offerRank[i] = min(offerRank[i], rank)
      return
    end
  end
  slot := offers
  if offers == OFFERED
    slot = 0
    for i in 1..<offers
      if offerRank[i] > offerRank[slot]
        slot = i
      end
    end
    if rank >= offerRank[slot]
      return
    end
  end
  where := at
  if kind == 0
    where = pool.len()
    if not pool.pushAll(s)
      return
    end
  end
  offerKind[slot] = kind
  offerAt[slot] = where
  offerLen[slot] = n
  offerSigAt[slot] = sigAt
  offerSigLen[slot] = sigLen
  offerRank[slot] = rank
  if slot == offers
    offers += 1
  end
end

# the file's words (not in comments or strings), each ranked by how far it is from the cursor
offerWords :: proc()
  pool.clear()
  p := 0
  for p < textLen
    c := text[p]
    if c == 35 # (a comment, to its line's end)
      for p < textLen and text[p] != 10
        p += 1
      end
    case c == 34 or c == 39 # (a string or character)
      p += 1
      for p < textLen and text[p] != c and text[p] != 10
        if text[p] == 92
          p += 1
        end
        p += 1
      end
      p += 1
    case isWord(c)
      q := p
      for q < textLen and isWord(text[q])
        q += 1
      end
      if q - p >= 2 and p != wordFrom and (c < 48 or c > 57)
        offer(0, 0, q - p, 0, 0, 1000000 + abs(p - cursor), text[p..<q].asString())
      end
      p = q
    else
      p += 1
    end
  end
end

# Rio's names for the cursor: a check first, unless the last still holds (cut at this line, and nothing
# changed above it since), then what fits there, each ranked as it came (the proc's own first), Rio's
# words after the names
# the file a check compiles: the app's main file (this one is it, or one it includes or imports), else this
checkMain :: proc() -> String
  main := here()
  app := appOf(main)
  if app.len() > 0
    main = mainPath(app)
  end
  return main
end

offerRio :: proc()
  a := lineAt[lineOf(cursor)]
  if checkedAt != a or changedFrom < a
    t := pc.time()
    _ = pc.checkRio(checkMain(), here(), text[0..<a].asString(), formatted[])
    checkCost = pc.time() - t
    checkedAt = a
    changedFrom = CAP + 1
  end
  itemsIn: Blob[..] = items
  n := min(pc.completeRio(text[a..<cursor].asString(), itemsIn), ITEMS)
  p := 0
  i := 0
  for p < n
    t := p # (name, tab, kind, tab, what it is, 10)
    for t < n and items[t] != 9
      t += 1
    end
    e := t
    for e < n and items[e] != 10
      e += 1
    end
    if t + 3 <= e
      rank := i
      if items[t + 1] == 107 # (k: a word of Rio's)
        rank = 500000 + i
      end
      offer(1, p, t - p, t + 3, e - t - 3, rank, items[p..<t].asString())
    end
    i += 1
    p = e + 1
  end
end

# ---------------------------------------------------------------- errors
#
# Once typing pauses, the whole file is checked (pc.checkRio, as for completion, but to its end), and
# its first error, if it's in this file, underlined; what it says shows on the bottom bar while the
# cursor's on its line. The pause is longer where a check takes long (a big app's, on the board: about
# half a second)

errLine := -1            # the first error's line here (-1: none, or it's in another file)
errCol := 0              # where on it (from 0), and how wide (at least 1)
errLen := 1
errText: Blob[96]
errTextLen := 0
errPath: Blob[128]
checkedEdits := -1       # the edits the last check of the whole file was of

checkErrors :: proc()
  t := pc.time()
  r := pc.checkRio(checkMain(), here(), text[0..<textLen].asString(), formatted[])
  checkCost = pc.time() - t
  checkedAt = -1 # (the tables are this check's now: completion makes its own)
  checkedEdits = edits
  errLine = -1
  if r < 0
    errPathIn: Blob[..] = errPath
    errTextIn: Blob[..] = errText
    e := pc.checkError(errPathIn, errTextIn)
    errTextLen = errTextIn.len()
    if e.line >= 1 and e.line <= lineCount and errPathIn.asString() == here()
      errLine = e.line - 1
      errCol = max(0, e.col - 1)
      errLen = max(1, e.len)
    end
  end
end

# each frame: the check, when the text's changed and typing has paused
idleCheck :: proc()
  if checkedEdits != edits and not completing and mode == NONE and isRio() and pc.time() - editedAt > 0.6 + checkCost * 4.0
    checkErrors()
  end
end

# ---------------------------------------------------------------- the list

# s starts with what's typed, in its case too
typedExactly :: proc(s: String) -> Bool
  n := cursor - wordFrom
  return s.len() >= n and s[0..<n] == text[wordFrom..<cursor].asString()
end

# offer a goes after offer b: by rank, then the ones typed in their case, then by name
after :: proc(a, b: Int) -> Bool
  if offerRank[a] != offerRank[b]
    return offerRank[a] > offerRank[b]
  end
  ea := typedExactly(offerText(a))
  if ea != typedExactly(offerText(b))
    return not ea
  end
  return offerText(a) > offerText(b)
end

# the offers that start with what's typed, in order (after)
narrowOffers :: proc()
  shownCount = 0
  for i in 0..<offers
    if startsTyped(offerText(i))
      j := shownCount # (in place: the ones after it, along)
      for j > 0 and after(shown[j - 1], i)
        shown[j] = shown[j - 1]
        j -= 1
      end
      shown[j] = i
      shownCount += 1
    end
  end
  offerPick = max(0, min(offerPick, shownCount - 1))
end

# the pick, in place of the word typed
takeOffer :: proc()
  completing = false
  built.clear()
  _ = built.pushAll(offerText(shown[offerPick]))
  merging = 0
  ok := edit(wordFrom, cursor, built[0..<built.len()].asString(), 0)
end

# the list, for the word at the cursor. how: 0 asked for (Ctrl+Space: one, put in; none, said), 2 again
# as it's typed (quietly)
complete :: proc(how: Int)
  completing = false
  if not isRio() # (text: no Rio to complete)
    return
  end
  p := cursor
  for p > 0 and isWord(text[p - 1])
    p -= 1
  end
  wordFrom = p
  offers = 0
  dot := p > 0 and text[p - 1] == 46 and (p < 2 or text[p - 2] != 46)
  offerRio()
  if not dot or offers == 0 # (after a dot, the file's words only when Rio has nothing)
    offerWords()
  end
  narrowOffers()
  if shownCount == 0
    if how == 0
      say("Nothing to complete it with", softColor)
    end
    return
  end
  if how == 0 and shownCount == 1
    offerPick = 0
    takeOffer()
    return
  end
  completing = true
  offerPick = 0
  offerTop = 0
end

# a key while the list is open: true if it was the list's (else it closes, and the key does what it does)
completeKey :: proc(k: Int) -> Bool
  move := k & ~SHIFT # (Shift held, or locked, too)
  if move == UP or move == DOWN or move == PAGE_UP or move == PAGE_DOWN
    step := 1
    if move == PAGE_UP or move == PAGE_DOWN
      step = SHOWN_ROWS - 1
    end
    if move == UP or move == PAGE_UP
      step = -step
    end
    offerPick = max(0, min(offerPick + step, shownCount - 1))
    return true
  case k == 9 or k == 13
    takeOffer()
    return true
  case k == 27 or k == (32 | CTRL)
    completing = false
    return true
  case k < 128 and isWord(k)
    typeChar(k)
    narrowOffers()
    completing = shownCount > 0
    return true
  case k == 8
    backspace(false)
    if cursor <= wordFrom and (cursor == 0 or text[cursor - 1] != 46)
      completing = false
    else
      complete(2)
    end
    return true
  end
  completing = false
  return false
end
