# Editor: the screen (part of edit.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- the screen

KEYWORDS :: " proc struct if else for in end return break continue import include enum union switch case is nil and or not do true false "

isKeyword :: proc(a, b: Int) -> Bool
  n := b - a
  for p in 1..<KEYWORDS.len() - n
    if KEYWORDS[p - 1] == 32 and KEYWORDS[p + n] == 32
      k := 0
      for k < n and KEYWORDS[p + k] == text[a + k]
        k += 1
      end
      if k == n
        return true
      end
    end
  end
  return false
end

num: Blob[..16]

drawLine :: proc(l: Int, y: Int)
  a := lineAt[l]
  e := lineEnd(l)
  s0 := selStart()
  s1 := selEnd()
  if s0 < s1 and s0 <= e and s1 > a # (the selection's part of this line)
    c0 := max(s0, a) - a - left
    c1 := min(s1, e + 1) - a - left
    c0 = max(0, c0)
    c1 = min(COLS, c1)
    if c1 > c0
      pc.rect({TEXT_X + c0 * 6 - 1, y - 1}, {(c1 - c0) * 6, 9}, selectColor)
    end
  end
  inString := 0 # its quote, while in one
  inComment := false
  wordEnd := a
  wordColor := codeColor
  runStart := -1
  runColor := codeColor
  for p in a..=e
    color := codeColor
    if p < e
      c := text[p]
      if inComment
        color = commentColor
      case inString > 0
        color = stringColor
        if c == inString and text[p - 1] != 92
          inString = 0
        end
      case p < wordEnd
        color = wordColor
      case c == 35
        inComment = true
        color = commentColor
      case c == 34 or c == 39
        inString = c
        color = stringColor
      case isWord(c)
        q := p
        for q < e and isWord(text[q])
          q += 1
        end
        wordEnd = q
        wordColor = codeColor
        if c >= 48 and c <= 57
          wordColor = numberColor
        case isKeyword(p, q)
          wordColor = keywordColor
        case c >= 65 and c <= 90
          wordColor = typeColor
        case q < e and text[q] == 40
          wordColor = callColor
        end
        color = wordColor
      else
        color = punctColor
      end
    end
    col := p - a - left
    visible := p < e and col >= 0 and col < COLS
    if runStart >= 0 and (not visible or color != runColor)
      pc.print(text[runStart..<p].asString(), {TEXT_X + (runStart - a - left) * 6, y}, runColor)
      runStart = -1
    end
    if visible and runStart < 0
      runStart = p
      runColor = color
    end
    if col >= COLS
      return
    end
  end
end

# the pick in a list on the bar's color: the selection's, unless the theme has them the same (slate,
# green), then the text's background
pickColor :: proc() -> Int
  if selectColor == barColor
    return backColor
  end
  return selectColor
end

# the completion list, under the cursor's line (or over it, where there's more room), as wide as its
# names and what they are need (moved left to fit): the part typed lit, the pick on the selection's
# color, and a bar at its right edge when there are more than it shows
drawOffers :: proc()
  cl := lineOf(cursor)
  row := cl - top
  if row < 0 or row >= ROWS
    return
  end
  below := min(ROWS - row - 1, (229 - TOP_Y - (row + 1) * 9) / 9)
  above := row
  rows := min(shownCount, SHOWN_ROWS)
  y := TOP_Y + (row + 1) * 9
  if below < rows and above > below
    rows = min(rows, above)
    y = TOP_Y + (row - rows) * 9
  else
    rows = max(1, min(rows, below))
  end
  offerTop = max(0, min(offerTop, shownCount - rows))
  if offerPick < offerTop
    offerTop = offerPick
  case offerPick >= offerTop + rows
    offerTop = offerPick - rows + 1
  end
  names := 0 # (the widest name and what it is, of all of them: the list stays as wide as it scrolls)
  sigs := 0
  for i in 0..<shownCount
    names = max(names, offerLen[shown[i]])
    if offerKind[shown[i]] == 1
      sigs = max(sigs, offerSigLen[shown[i]])
    end
  end
  names = min(names, 24)
  w := names * 6 + 6
  if sigs > 0
    w = min(316, w + 12 + sigs * 6)
  end
  x := TEXT_X + (wordFrom - lineAt[cl] - left) * 6 - 3
  x = max(2, min(x, 318 - w))
  pc.rect({x - 1, y - 1}, {w + 2, rows * 9 + 2}, faintColor)
  pc.rect({x, y}, {w, rows * 9}, barColor)
  typed := cursor - wordFrom
  for r in 0..<rows
    i := shown[offerTop + r]
    yy := y + r * 9
    if offerTop + r == offerPick
      pc.rect({x, yy}, {w, 9}, pickColor())
    end
    s := offerText(i)
    if s.len() > 24
      s = s[0..<24]
    end
    pc.print(s, {x + 3, yy + 1}, textColor)
    pc.print(s[0..<min(typed, s.len())], {x + 3, yy + 1}, accentColor)
    if offerKind[i] == 1 and offerSigLen[i] > 0
      g := offerSig(i)
      room := (x + w - 6 - (x + 3 + names * 6 + 12)) / 6
      if g.len() > room
        g = g[0..<max(0, room)]
      end
      pc.print(g, {x + 3 + names * 6 + 12, yy + 1}, dimColor) # (dim: unlike faint, never the bar's own color)
    end
  end
  if shownCount > rows # (the bar: where the rows shown are, of all of them)
    h := max(3, rows * 9 * rows / shownCount)
    pc.rect({x + w - 2, y + (rows * 9 - h) * offerTop / max(1, shownCount - rows)}, {2, h}, softColor)
  end
  listBox = {x, y, w, rows}
end

# Ctrl+Shift+P's list of commands, narrowed by what's typed
drawPalette :: proc()
  pc.rect({40, 24}, {240, 40 + LIST_ROWS * 10}, barColor)
  pc.print("Every command (type to narrow):", {46, 28}, accentColor)
  pc.rect({44, 38}, {232, 11}, backColor)
  pc.print(input[0..<input.len()].asString(), {46, 40}, textColor)
  pc.rect({46 + input.len() * 6, 39}, {1, 9}, accentColor)
  from := max(0, pick - LIST_ROWS + 1)
  for row in 0..<min(nlisted - from, LIST_ROWS)
    i := from + row
    k := listed[i]
    y := 54 + row * 10
    color := softColor
    if i == pick
      pc.rect({44, y - 2}, {232, 10}, pickColor())
      color = textColor
    end
    pc.print(commands[k].label, {48, y}, color)
    pc.print(commands[k].keys, {272 - commands[k].keys.len() * 6, y}, dimColor)
  end
  if nlisted == 0
    pc.print("No such command", {48, 54}, faintColor)
  end
end

draw* :: proc()
  pc.cls(backColor)
  cl := lineOf(cursor)
  # the title bar: the app, whether it's changed, and where the cursor is
  pc.rect({0, 0}, {320, 10}, barColor)
  shown := 0
  if path.len() > 0 # (its path, /rinc/ left off; its end, if it's long)
    t := path[0..<path.len()].asString()
    if startsWith(t, "/rinc/")
      t = t[6..<t.len()]
    end
    if t.len() > 36
      t = t[t.len() - 36..<t.len()]
    end
    color := textColor
    if readOnly()
      color = softColor
    end
    pc.print(t, {2, 1}, color)
    shown = t.len()
  else
    pc.print("(new)", {2, 1}, softColor)
    shown = 5
  end
  if modified()
    pc.print("*", {4 + shown * 6, 1}, warnColor)
  end
  num.clear()
  _ = num.print("Ln ", cl + 1, ", Col ", cursor - lineAt[cl] + 1)
  pc.print(num[0..<num.len()].asString(), {318 - num.len() * 6, 1}, softColor)
  # the lines
  for row in 0..<ROWS
    l := top + row
    if l >= lineCount
      break
    end
    y := TOP_Y + row * 9
    num.clear()
    _ = num.print(l + 1)
    numColor := faintColor
    if l == cl
      numColor = softColor
    end
    pc.print(num[0..<num.len()].asString(), {TEXT_X - 6 - num.len() * 6, y}, numColor)
    drawLine(l, y)
  end
  # the cursor: lit while it moves, else blinking
  ccol := cursor - lineAt[cl] - left
  if mode == NONE and cl >= top and cl < top + ROWS and ccol >= 0 and ccol <= COLS
    if pc.time() - movedAt < 0.5 or (pc.time() * 2.0).toInt() % 2 == 0
      pc.rect({TEXT_X + ccol * 6 - 1, TOP_Y + (cl - top) * 9 - 1}, {1, 9}, accentColor)
    end
  end
  # the bottom bar: a prompt, a message, or the keys
  pc.rect({0, 229}, {320, 11}, barColor)
  if mode == GO_TO or mode == FIND or mode == NAMING
    label := "Go to line: "
    if mode == FIND
      label = "Find (Enter: next): "
    case mode == NAMING
      label = "A new project, called: "
    end
    pc.print(label, {2, 231}, accentColor)
    t := input[0..<input.len()]
    if mode == FIND
      t = query[0..<query.len()]
    end
    pc.print(t.asString(), {2 + label.len() * 6, 231}, textColor)
    pc.rect({2 + (label.len() + t.len()) * 6, 230}, {1, 9}, accentColor)
  case message.len() > 0 and pc.time() - messageAt < 4.0
    pc.print(message[0..<message.len()].asString(), {2, 231}, messageColor)
  else
    pc.print("^O open  ^S save  ^R run  ^Shift+P all", {2, 231}, faintColor)
  end
  if completing and mode == NONE
    drawOffers()
  end
  if mode == PALETTE
    drawPalette()
  end
end
