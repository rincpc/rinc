# Editor: a text editor, for apps' Rio
#
# A file at a time, by path: Ctrl+O opens one (Files, called to pick it), Ctrl+S saves it, Ctrl+Shift+S
# saves it as another (Files, to pick where), Ctrl+R saves it and runs the app or project it's in,
# Ctrl+N starts a new one, and Ctrl+Shift+P lists every command. An installed app's files (chord, in
# /rinc/apps) and anything outside /rinc are read only: saving an app's file saves it in its project
# (chord*, in /rinc/projects), made from the app first if there's none. It starts with the active app
# or project (the whole Rinc's setting), else the file it had last. The keys are most editors': arrows,
# Home, End, Page Up and Down move, with Ctrl by words and to either end, and with Shift they select.
# Ctrl+A selects all; Ctrl+X, C and V cut, copy and paste (the line, with nothing selected); Ctrl+Z
# undoes, Ctrl+Y (or Ctrl+Shift+Z) redoes. Tab and Shift+Tab indent and outdent, Alt+Up and Down move
# lines, Ctrl+Shift+K deletes them, Ctrl+L selects one, Ctrl+F finds, Ctrl+G goes to a line. Up to 32
# KB of text. With a mouse: a click puts the cursor there, dragging selects, and the wheel scrolls. An
# ordinary app (the Fruit Jam's firmware has it built in).

CAP :: 32768          # the most text
MAX_LINES :: 4096
UNDOS :: 256          # edits remembered
UNDO_BYTES :: 16384   # the text they changed
CLIP :: 16384
BUILT :: 8192         # lines being remade (indenting, moving)
ROWS :: 24            # text rows, 9 pixels each
COLS :: 48            # characters in a row, after the line numbers
TOP_Y :: 12
TEXT_X :: 30
LIST_ROWS :: 16       # commands shown in the list

SHIFT :: 256          # pc.key()'s modifier bits
CTRL :: 512
ALT :: 1024
LEFT :: 128
RIGHT :: 129
UP :: 130
DOWN :: 131
HOME :: 132
KEY_END :: 133
DELETE :: 134
PAGE_UP :: 135
PAGE_DOWN :: 136

BACK :: 1             # colors
DARK :: 0
DIM :: 5
GRAY :: 6
WHITE :: 7
RED :: 8
ORANGE :: 9
YELLOW :: 10
GREEN :: 11
BLUE :: 12
LAVENDER :: 13
PINK :: 14
PEACH :: 15
SELECTED :: 2

# ---------------------------------------------------------------- the text

text: Blob[32768]
textLen := 0
scratch: Blob[..32768] # the text after an edit, moving over
lineAt: [4096]Int      # where each line starts
lineCount := 1
cursor := 0
anchor := 0            # the selection's other end (anchor == cursor: nothing selected)
wantCol := -1          # the column up and down keep to
top := 0               # the first line on the screen, and column
left := 0
path: Blob[..96]       # the file's path ("": new, not saved yet)
one: Blob[1]
built: Blob[..8192]

lineEnd :: proc(l: Int) -> Int
  if l + 1 < lineCount
    return lineAt[l + 1] - 1
  end
  return textLen
end

lineOf :: proc(p: Int) -> Int
  lo := 0
  hi := lineCount - 1
  for lo < hi
    mid := (lo + hi + 1) / 2
    if lineAt[mid] <= p
      lo = mid
    else
      hi = mid - 1
    end
  end
  return lo
end

rebuildLines :: proc()
  lineCount = 1
  lineAt[0] = 0
  for i in 0..<textLen
    if text[i] == 10 and lineCount < MAX_LINES
      lineAt[lineCount] = i + 1
      lineCount += 1
    end
  end
end

newlines :: proc(s: String) -> Int
  n := 0
  for c in s
    if c == 10
      n += 1
    end
  end
  return n
end

# text[a:b] becomes s (which isn't part of text): false if there's no room
replaceRaw :: proc(a, b: Int, s: String) -> Bool
  if textLen - (b - a) + s.len() > CAP
    return false
  end
  scratch.clear()
  scratch.pushAll(text[b:textLen])
  w: Blob[..] = text[a:]
  w.pushAll(s)
  w.pushAll(scratch[0:scratch.len()])
  textLen += s.len() - (b - a)
  rebuildLines()
  return true
end

selStart :: proc() -> Int
  return min(cursor, anchor)
end
selEnd :: proc() -> Int
  return max(cursor, anchor)
end

# ---------------------------------------------------------------- messages

message: Blob[..53]
messageColor := GRAY
messageAt := 0.0

say :: proc(s: String, color: Int)
  message.clear()
  for c in s
    if message.len() < 53
      message.push(c)
    end
  end
  messageColor = color
  messageAt = pc.time()
end

# s, then the file's name (its path's end), then t
sayName :: proc(s: String, t: String, color: Int)
  say(s, color)
  k := path.len()
  for k > 0 and path[k - 1] != 47
    k -= 1
  end
  for c in path[k:path.len()]
    if message.len() < 53
      message.push(c)
    end
  end
  for c in t
    if message.len() < 53
      message.push(c)
    end
  end
end

# ---------------------------------------------------------------- undo

# each edit: text[pos:pos + del] became ins bytes; its deleted bytes then its inserted ones are in
# undoText from at; the cursor and anchor before, and the cursor after
recPos: [256]Int
recDel: [256]Int
recIns: [256]Int
recAt: [256]Int
recBefore: [256]Int
recAnchor: [256]Int
recAfter: [256]Int
recCount := 0          # edits remembered
recTop := 0            # of those, done (the rest can be redone)
undoText: Blob[16384]
undoLen := 0
savedTop := 0          # recTop when it was saved (-1: that's been forgotten)
merging := 0           # what the last edit was, to group with: 1 typing, 2 Backspace, 3 Delete

undoPush :: proc(s: String)
  w: Blob[..] = undoText[undoLen:]
  w.pushAll(s)
  undoLen += s.len()
end

forgetOldest :: proc()
  n := recDel[0] + recIns[0]
  scratch.clear()
  scratch.pushAll(undoText[n:undoLen])
  w: Blob[..] = undoText[0:]
  w.pushAll(scratch[0:scratch.len()])
  undoLen -= n
  for i in 0..<recCount - 1
    recPos[i] = recPos[i + 1]
    recDel[i] = recDel[i + 1]
    recIns[i] = recIns[i + 1]
    recAt[i] = recAt[i + 1] - n
    recBefore[i] = recBefore[i + 1]
    recAnchor[i] = recAnchor[i + 1]
    recAfter[i] = recAfter[i + 1]
  end
  recCount -= 1
  recTop -= 1
  if savedTop >= 0
    savedTop -= 1
  end
end

forgetAll :: proc()
  recCount = 0
  recTop = 0
  undoLen = 0
  merging = 0
end

modified :: proc() -> Bool
  return recTop != savedTop
end

# text[a:b] becomes s, remembered for undo (kind: what it is, to group with the edit before)
edit :: proc(a, b: Int, s: String, kind: Int) -> Bool
  merged := false
  r := recTop - 1
  if textLen - (b - a) + s.len() > CAP
    say("No room: 32 KB at most", RED)
    return false
  end
  if lineCount - newlines(text[a:b].asString()) + newlines(s) > MAX_LINES
    say("Too many lines: 4096 at most", RED)
    return false
  end
  if kind > 0 and kind == merging and recTop == recCount and recTop > 0 and undoLen + (b - a) + s.len() <= UNDO_BYTES
    if kind == 1 and a == b and recPos[r] + recIns[r] == a
      undoPush(s)
      recIns[r] += s.len()
      merged = true
    case kind == 2 and s.len() == 0 and recIns[r] == 0 and b == recPos[r] and recDel[r] < 64
      # (deleted bytes come before the ones already deleted: they go in front)
      scratch.clear()
      scratch.pushAll(undoText[recAt[r]:undoLen])
      undoLen = recAt[r]
      undoPush(text[a:b].asString())
      undoPush(scratch[0:scratch.len()].asString())
      recPos[r] = a
      recDel[r] += b - a
      merged = true
    case kind == 3 and s.len() == 0 and recIns[r] == 0 and a == recPos[r]
      undoPush(text[a:b].asString())
      recDel[r] += b - a
      merged = true
    end
  end
  if not merged
    if recTop < recCount # (a new edit: what could be redone can't now)
      recCount = recTop
      undoLen = recAt[recTop]
      if savedTop > recTop
        savedTop = -1
      end
    end
    if (b - a) + s.len() > UNDO_BYTES
      if modified()
        savedTop = -1
      end
      forgetAll()
      savedTop = -1
      say("(too big to undo)", GRAY)
    else
      for recCount == UNDOS or undoLen + (b - a) + s.len() > UNDO_BYTES
        forgetOldest()
      end
      r = recCount
      recPos[r] = a
      recDel[r] = b - a
      recIns[r] = s.len()
      recAt[r] = undoLen
      recBefore[r] = cursor
      recAnchor[r] = anchor
      undoPush(text[a:b].asString())
      undoPush(s)
      recCount += 1
      recTop = recCount
    end
  end
  ok := replaceRaw(a, b, s)
  cursor = a + s.len()
  anchor = cursor
  wantCol = -1
  if recTop > 0
    recAfter[recTop - 1] = cursor
  end
  merging = kind
  return ok
end

undo :: proc()
  if recTop == 0
    say("Nothing to undo", GRAY)
    return
  end
  r := recTop - 1
  ok := replaceRaw(recPos[r], recPos[r] + recIns[r], undoText[recAt[r]:recAt[r] + recDel[r]].asString())
  cursor = recBefore[r]
  anchor = recAnchor[r]
  recTop -= 1
  merging = 0
  wantCol = -1
end

redo :: proc()
  if recTop == recCount
    say("Nothing to redo", GRAY)
    return
  end
  r := recTop
  at := recAt[r] + recDel[r]
  ok := replaceRaw(recPos[r], recPos[r] + recDel[r], undoText[at:at + recIns[r]].asString())
  cursor = recAfter[r]
  anchor = cursor
  recTop += 1
  merging = 0
  wantCol = -1
end

# ---------------------------------------------------------------- moving

isWord :: proc(c: Int) -> Bool
  return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
end
isSpace :: proc(c: Int) -> Bool
  return c == 32 or c == 9 or c == 10
end

wordLeft :: proc(p: Int) -> Int
  q := p
  for q > 0 and isSpace(text[q - 1])
    q -= 1
  end
  if q > 0 and isWord(text[q - 1])
    for q > 0 and isWord(text[q - 1])
      q -= 1
    end
  else
    for q > 0 and not isWord(text[q - 1]) and not isSpace(text[q - 1])
      q -= 1
    end
  end
  return q
end

wordRight :: proc(p: Int) -> Int
  q := p
  for q < textLen and isSpace(text[q])
    q += 1
  end
  if q < textLen and isWord(text[q])
    for q < textLen and isWord(text[q])
      q += 1
    end
  else
    for q < textLen and not isWord(text[q]) and not isSpace(text[q])
      q += 1
    end
  end
  return q
end

# the first character on line l that isn't a space
indentEnd :: proc(l: Int) -> Int
  p := lineAt[l]
  e := lineEnd(l)
  for p < e and text[p] == 32
    p += 1
  end
  return p
end

moveTo :: proc(p: Int, extend: Bool)
  cursor = max(0, min(p, textLen))
  if not extend
    anchor = cursor
  end
  merging = 0
end

# to line l, at the column up and down keep to
moveToLine :: proc(l: Int, extend: Bool)
  cl := lineOf(cursor)
  if wantCol < 0
    wantCol = cursor - lineAt[cl]
  end
  target := max(0, min(l, lineCount - 1))
  col := wantCol
  moveTo(lineAt[target] + min(col, lineEnd(target) - lineAt[target]), extend)
  wantCol = col
end

# ---------------------------------------------------------------- editing

typeChar :: proc(c: Int)
  if c == 32 and cursor > 0 and text[cursor - 1] != 32
    merging = 0 # (a word and the space after it undo together)
  end
  one[0] = c
  kind := 1
  if cursor != anchor
    kind = 0
  end
  ok := edit(selStart(), selEnd(), one[0:1].asString(), kind)
end

# does line l's text, after its indent, start with word w (then a space or its end)?
startsWord :: proc(l: Int, w: String) -> Bool
  p := indentEnd(l)
  e := lineEnd(l)
  if e - p < w.len()
    return false
  end
  for i in 0..<w.len()
    if text[p + i] != w[i]
      return false
    end
  end
  return p + w.len() == e or not isWord(text[p + w.len()])
end

# does line l have s in it?
lineHas :: proc(l: Int, s: String) -> Bool
  a := lineAt[l]
  e := lineEnd(l)
  for p in a..<e - s.len() + 1
    k := 0
    for k < s.len() and text[p + k] == s[k]
      k += 1
    end
    if k == s.len()
      return true
    end
  end
  return false
end

# a line that opens a block: the next is indented one more step (not a switch: its cases line up with it)
opensBlock :: proc(l: Int) -> Bool
  return startsWord(l, "if") or startsWord(l, "else") or startsWord(l, "for") or
         startsWord(l, "case") or lineHas(l, ":: proc") or lineHas(l, ":: struct") or lineHas(l, ":: enum") or
         lineHas(l, ":: union")
end

enter :: proc()
  l := lineOf(selStart())
  indent := min(indentEnd(l), selStart()) - lineAt[l]
  if opensBlock(l) and selStart() > indentEnd(l)
    indent += 2
  end
  built.clear()
  built.push(10)
  for i in 0..<indent
    built.push(32)
  end
  merging = 0
  ok := edit(selStart(), selEnd(), built[0:built.len()].asString(), 0)
end

# having typed the end of `end`, `else` or `case` alone on its line, a step back out of the block
dedent :: proc()
  l := lineOf(cursor)
  p := indentEnd(l)
  if cursor != lineEnd(l) or p - lineAt[l] < 2 or not (startsWord(l, "end") or startsWord(l, "else") or startsWord(l, "case"))
    return
  end
  if cursor - p != 3 and cursor - p != 4
    return
  end
  if l > 0
    k := l - 1
    for k > 0 and indentEnd(k) == lineEnd(k) # (blank lines)
      k -= 1
    end
    if indentEnd(k) - lineAt[k] < p - lineAt[l]
      return # (already dedented)
    end
  end
  c := cursor
  ok := edit(lineAt[l], lineAt[l] + 2, "", 0)
  cursor = c - 2
  anchor = cursor
end

backspace :: proc(ctrl: Bool)
  if cursor != anchor
    ok := edit(selStart(), selEnd(), "", 0)
    return
  end
  if cursor == 0
    return
  end
  if ctrl
    ok := edit(wordLeft(cursor), cursor, "", 0)
    return
  end
  l := lineOf(cursor)
  col := cursor - lineAt[l]
  if col > 0 and indentEnd(l) >= cursor # (in the indent: back to the step before)
    n := 2 - col % 2
    ok := edit(cursor - n, cursor, "", 2)
    return
  end
  ok := edit(cursor - 1, cursor, "", 2)
end

deleteForward :: proc(ctrl: Bool)
  if cursor != anchor
    ok := edit(selStart(), selEnd(), "", 0)
  case cursor < textLen
    if ctrl
      ok := edit(cursor, wordRight(cursor), "", 0)
    else
      ok := edit(cursor, cursor + 1, "", 3)
    end
  end
end

# the lines the selection is on (or the cursor's): into first and last
first := 0
last := 0
selectedLines :: proc()
  first = lineOf(selStart())
  last = lineOf(selEnd())
  if last > first and lineAt[last] == selEnd()
    last -= 1
  end
end

# the selected lines (or the cursor's), each a step in (dir 1) or out (-1)
indentLines :: proc(dir: Int)
  selectedLines()
  a := lineAt[first]
  b := lineEnd(last)
  had := cursor != anchor
  c := cursor
  built.clear()
  for l in first..=last
    p := lineAt[l]
    e := lineEnd(l)
    if dir > 0 and e > p
      built.push(32)
      built.push(32)
    case dir < 0
      k := 0
      for k < 2 and p < e and text[p] == 32
        p += 1
        k += 1
      end
    end
    if built.len() + (e - p) + 1 > BUILT
      say("Too much to indent at once", RED)
      return
    end
    built.pushAll(text[p:e])
    if l < last
      built.push(10)
    end
  end
  delta := built.len() - (b - a)
  merging = 0
  ok := edit(a, b, built[0:built.len()].asString(), 0)
  if had or first != last
    anchor = a
    cursor = a + built.len()
  else
    cursor = max(a, c + delta)
    anchor = cursor
  end
end

tab :: proc(shift: Bool)
  if shift or lineOf(selStart()) != lineOf(selEnd())
    if shift
      indentLines(-1)
    else
      indentLines(1)
    end
    return
  end
  col := selStart() - lineAt[lineOf(selStart())]
  if col % 2 == 1
    ok := edit(selStart(), selEnd(), " ", 0)
  else
    ok := edit(selStart(), selEnd(), "  ", 0)
  end
end

# the selected lines (or the cursor's) moved up (dir -1) or down past their neighbor
moveLines :: proc(dir: Int)
  selectedLines()
  if (dir < 0 and first == 0) or (dir > 0 and last == lineCount - 1)
    return
  end
  a := lineAt[first]
  b := lineEnd(last)
  o := last + 1 # the neighbor
  if dir < 0
    o = first - 1
  end
  oa := lineAt[o]
  oe := lineEnd(o)
  if (b - a) + (oe - oa) + 1 > BUILT
    say("Too much to move at once", RED)
    return
  end
  c := cursor
  n := anchor
  built.clear()
  if dir < 0
    built.pushAll(text[a:b])
    built.push(10)
    built.pushAll(text[oa:oe])
    merging = 0
    ok := edit(oa, b, built[0:built.len()].asString(), 0)
    cursor = c - (oe - oa) - 1
    anchor = n - (oe - oa) - 1
  else
    built.pushAll(text[oa:oe])
    built.push(10)
    built.pushAll(text[a:b])
    merging = 0
    ok := edit(a, oe, built[0:built.len()].asString(), 0)
    cursor = c + (oe - oa) + 1
    anchor = n + (oe - oa) + 1
  end
end

deleteLines :: proc()
  selectedLines()
  a := lineAt[first]
  b := lineEnd(last)
  if b < textLen
    b += 1 # (the newline after)
  case a > 0
    a -= 1 # (the last line: the newline before)
  end
  merging = 0
  ok := edit(a, b, "", 0)
  moveTo(lineAt[lineOf(min(a + 1, textLen))], false)
  if a == 0
    moveTo(0, false)
  end
end

# ---------------------------------------------------------------- the clipboard

clip: Blob[..16384]
clipIsLine := false # copied with nothing selected: a whole line, pasted as one

copy :: proc(cut: Bool)
  a := selStart()
  b := selEnd()
  clipIsLine = a == b
  if clipIsLine
    l := lineOf(cursor)
    a = lineAt[l]
    b = lineEnd(l)
    if b < textLen
      b += 1
    end
  end
  if b - a > CLIP
    say("Too much to copy: 16 KB at most", RED)
    return
  end
  clip.clear()
  clip.pushAll(text[a:b])
  if clipIsLine and (b == a or text[b - 1] != 10)
    clip.push(10)
  end
  if cut
    merging = 0
    ok := edit(a, b, "", 0)
  end
end

paste :: proc()
  merging = 0
  if clipIsLine and cursor == anchor # (a whole line: above this one)
    c := cursor
    l := lineOf(cursor)
    ok := edit(lineAt[l], lineAt[l], clip[0:clip.len()].asString(), 0)
    cursor = c + clip.len()
    anchor = cursor
    return
  end
  ok := edit(selStart(), selEnd(), clip[0:clip.len()].asString(), 0)
end

# ---------------------------------------------------------------- files

last: Blob[..128] # the file it had last, and where: "path cursor top" (its save file "last")

here :: proc() -> String
  return path[0:path.len()].asString()
end

startsWith :: proc(s: String, start: String) -> Bool
  return s.len() >= start.len() and s[0:start.len()] == start
end

# the app (chord) or project (chord*) a path is in, else ""
appIn: Blob[..34]
appOf :: proc(p: String) -> String
  appIn.clear()
  for k in 0..<2
    start := "/rinc/apps/"
    if k == 1
      start = "/rinc/projects/"
    end
    if p.len() > start.len() and startsWith(p, start)
      e := start.len()
      for e < p.len() and p[e] != 47
        e += 1
      end
      ok := appIn.pushAll(p[start.len():e])
      if k == 1
        ok = appIn.push(42)
      end
    end
  end
  return appIn[0:appIn.len()].asString()
end

# read only: an installed app's files (saving makes its project), and anything outside /rinc
readOnly :: proc() -> Bool
  p := here()
  return p.len() > 0 and (not startsWith(p, "/rinc/") or startsWith(p, "/rinc/apps/"))
end

# where it is, kept for next time: on opening, saving and running; and the app or project it's in is
# the active one, the whole Rinc's setting
remember :: proc()
  last.clear()
  ok := last.pushAll(path[0:path.len()])
  last.format(" ", cursor, " ", top)
  saved := pc.saveWrite("last", last[0:last.len()].asString())
  a := appOf(here())
  if a.len() > 0
    saved = pc.settingWrite("active", a)
  end
end

# a fresh, empty text
fresh :: proc()
  textLen = 0
  cursor = 0
  anchor = 0
  top = 0
  left = 0
  wantCol = -1
  rebuildLines()
  forgetAll()
  savedTop = 0
end

setPath :: proc(p: String)
  path.clear()
  ok := path.pushAll(p[0:min(p.len(), 96)])
end

# an app's or project's main file: /rinc/apps/chord/chord.rio, /rinc/projects/chord/chord.rio
mainBuf: Blob[..96]
mainPath :: proc(ref: String) -> String
  mainBuf.clear()
  n := ref
  ok := mainBuf.pushAll("/rinc/apps/")
  if ref.len() > 1 and ref[ref.len() - 1] == 42
    n = ref[0:ref.len() - 1]
    mainBuf.clear()
    ok = mainBuf.pushAll("/rinc/projects/")
  end
  ok = mainBuf.pushAll(n)
  ok = mainBuf.push(47)
  ok = mainBuf.pushAll(n)
  ok = mainBuf.pushAll(".rio")
  return mainBuf[0:mainBuf.len()].asString()
end

# what's in text, its lines ending with 10 alone (13s taken out)
settle :: proc(n: Int)
  k := 0
  for i in 0..<n
    if text[i] != 13
      text[k] = text[i]
      k += 1
    end
  end
  textLen = k
  rebuildLines()
end

# the file at p: false if it can't be had (a new one, if it isn't there yet and it could be saved)
load :: proc(p: String) -> Bool
  n := pc.fileRead(p, one[0:0])
  a := appOf(p)
  bundled := false
  if n < 0 and a.len() > 0 and a[a.len() - 1] != 42 and p == mainPath(a) # (an app the Rinc has built in)
    n = pc.appSource(a, one[0:0])
    bundled = n >= 0
  end
  if n > CAP
    say("Too big for the editor: 32 KB at most", RED)
    return false
  end
  fresh()
  setPath(p)
  if n < 0
    if readOnly()
      say("Can't read it", RED)
      path.clear()
      return false
    end
    sayName("New: ", "", GRAY)
  else
    if bundled
      n = pc.appSource(a, text[0:CAP])
    else
      n = pc.fileRead(p, text[0:CAP])
    end
    settle(min(n, CAP))
    if not readOnly()
      sayName("", ": ^S saves, ^R runs", GRAY)
    case appOf(here()).len() > 0
      sayName("", ": read only (saving makes its project)", GRAY)
    else
      sayName("", ": read only (^Shift+S saves a copy)", GRAY)
    end
  end
  remember()
  return true
end

# /rinc/apps/chord/a.rio, in its project: /rinc/projects/chord/a.rio
inProject: Blob[..96]
projectPath :: proc(p: String) -> String
  inProject.clear()
  ok := inProject.pushAll("/rinc/projects/")
  ok = inProject.pushAll(p[11:p.len()])
  return inProject[0:inProject.len()].asString()
end

# Files, called to pick a file to open, or a place to save as: what it has kept in its stash meanwhile
# (unsaved too), to have again when it comes back (with what was picked, or nothing)
argsBuf: Blob[..128]
leaving := false
callFiles :: proc(how: String)
  if pc.appSource("files", one[0:0]) < 0
    say("There's no Files app here", RED)
    return
  end
  ok := pc.stashWrite("draft", text[0:textLen].asString())
  ok = pc.stashWrite("draftPath", here())
  ok = pc.stashWrite("calling", how)
  remember()
  leaving = true # (what's typed next is Files')
  argsBuf.clear()
  pushed := argsBuf.pushAll(how)
  pushed = argsBuf.push(32)
  p := here()
  if p.len() == 0
    a: Blob[34]
    n := min(pc.settingRead("active", a[:]), 34)
    p = "/rinc/projects"
    if n > 0
      p = mainPath(a[0:n].asString())
    end
  end
  slash := p.len() - 1
  for slash > 0 and p[slash] != 47
    slash -= 1
  end
  if startsWith(p, "/rinc/projects") and slash < 14
    slash = p.len()
  end
  pushed = argsBuf.pushAll(p[0:max(slash, 1)])
  pc.call("files", argsBuf[0:argsBuf.len()].asString())
end

saveAs :: proc()
  callFiles("save")
end

refBuf: Blob[..34]
naming := false   # (a new file: a project's name asked for, to save it as that project's main file)
runAfter := false # (and then run it)
save :: proc() -> Bool
  if path.len() == 0
    if pc.appSource("files", one[0:0]) >= 0
      saveAs()
    else
      naming = true
    end
    return false
  end
  if readOnly()
    a := appOf(here())
    if a.len() == 0
      say("Read only here: ^Shift+S saves a copy", ORANGE)
      return false
    end
    # an installed app's file: saved in its project, the app copied as one first if it hasn't one
    refBuf.clear()
    ok := refBuf.pushAll(a)
    ok = refBuf.push(42)
    if pc.appSource(refBuf[0:refBuf.len()].asString(), one[0:0]) < 0 and pc.appCopy(a, refBuf[0:refBuf.len()].asString()) != 0
      say("Couldn't make its project", RED)
      return false
    end
    setPath(projectPath(here()))
  end
  if pc.fileWrite(here(), text[0:textLen].asString()) < 0
    sayName("Couldn't save ", "", RED)
    return false
  end
  savedTop = recTop
  merging = 0
  sayName("Saved ", "", GREEN)
  remember()
  return true
end

# Ctrl+R: saved, then its app or project run (an installed app, unchanged, as it is; a new file, as a
# new project's main file, its name asked for)
run :: proc()
  if path.len() == 0
    naming = true
    runAfter = true
    return
  end
  a := appOf(here())
  if a.len() == 0
    say("Not in an app: nothing to run", ORANGE)
    return
  end
  if modified() and not save()
    return
  end
  refBuf.clear()
  ok := refBuf.pushAll(appOf(here()))
  pc.launch(refBuf[0:refBuf.len()].asString())
end

# ---------------------------------------------------------------- prompts

NONE :: 0
PALETTE :: 1
NAMING :: 2
FIND :: 3
GO_TO :: 4
mode := NONE
input: Blob[..33]
query: Blob[..48]
confirm := 0     # an action asked for again after a warning: it goes ahead

lower :: proc(c: Int) -> Int
  if c >= 65 and c <= 90
    return c + 32
  end
  return c
end

has :: proc(s: String, f: Blob) -> Bool
  for p in 0..<s.len() - f.len() + 1
    k := 0
    for k < f.len() and lower(s[p + k]) == lower(f[k])
      k += 1
    end
    if k == f.len()
      return true
    end
  end
  return false
end

# every command, for the list Ctrl+Shift+P shows: what it does, its keys, and the key it is
COMMANDS :: 21
labels := [COMMANDS]String{"Open a file", "Save", "Save as", "Run its app", "New file", "Find", "Go to line", "Undo", "Redo", "Select all", "Select the line", "Cut", "Copy", "Paste", "Delete the lines", "Move the lines up", "Move the lines down", "Indent", "Outdent", "Help", "Home"}
keyNames := [COMMANDS]String{"^O", "^S", "^Shift+S", "^R", "^N", "^F", "^G", "^Z", "^Y", "^A", "^L", "^X", "^C", "^V", "^Shift+K", "Alt+Up", "Alt+Down", "Tab", "Shift+Tab", "", "Sys+Esc"}
keys := [COMMANDS]Int{15, 19, 19 | 256, 18, 14, 6, 7, 26, 25, 1, 12, 24, 3, 22, 11 | 256, 130 | 1024, 131 | 1024, 9, 9 | 256, -1, -2}
listed: [COMMANDS]Int
nlisted := 0
pick := 0

narrow :: proc()
  nlisted = 0
  for i in 0..<COMMANDS
    if has(labels[i], input[0:input.len()])
      listed[nlisted] = i
      nlisted += 1
    end
  end
  pick = max(0, min(pick, nlisted - 1))
end

startPrompt :: proc(m: Int)
  mode = m
  input.clear()
  if m == PALETTE
    pick = 0
    narrow()
  end
end

# a command from the list
queued := 0
command :: proc(i: Int)
  mode = NONE
  if keys[i] == -1
    pc.help("edit/README")
  case keys[i] == -2
    pc.launch("home")
  else
    queued = keys[i] # (as typed: update does it)
  end
end

# Ctrl+F's text, found after the selection (or from the start, after the end), and selected
findNext :: proc()
  f := query.len()
  if f == 0
    return
  end
  for pass in 0..<2
    from := selEnd()
    if pass == 1
      from = 0
    end
    for p in from..<textLen - f + 1
      k := 0
      for k < f and lower(text[p + k]) == lower(query[k])
        k += 1
      end
      if k == f
        anchor = p
        cursor = p + f
        wantCol = -1
        merging = 0
        return
      end
    end
  end
  say("Not found", GRAY)
end

# what the prompt does with Enter
promptDone :: proc()
  m := mode
  s := input[0:input.len()].asString()
  if m == PALETTE
    if nlisted > 0
      command(listed[pick])
    end
  case m == NAMING # (a new file, as a new project's main file)
    ok := true
    for c in s
      ok = ok and ((c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 45)
    end
    if s.len() == 0 or s.len() > 32 or not ok
      say("A name is letters, digits, _ and -", RED)
      return
    end
    refBuf.clear()
    pushed := refBuf.pushAll(s)
    pushed = refBuf.push(42)
    if pc.appSource(refBuf[0:refBuf.len()].asString(), one[0:0]) >= 0
      say("There's a project of that name already", RED)
      return
    end
    mode = NONE
    setPath(mainPath(refBuf[0:refBuf.len()].asString()))
    if save() and runAfter
      run()
    end
    runAfter = false
  case m == GO_TO
    n := 0
    for c in s
      if c >= 48 and c <= 57
        n = n * 10 + c - 48
      end
    end
    mode = NONE
    if n > 0
      moveTo(lineAt[min(n, lineCount) - 1], false)
      wantCol = -1
    end
  case m == FIND
    findNext()
  end
end

promptKey :: proc(k: Int)
  if k == 27
    mode = NONE
    confirm = 0
    runAfter = false
    return
  end
  if k == 13
    promptDone()
    return
  end
  if mode == FIND
    if k == 8
      if query.len() > 0
        query.pop()
      end
    case k >= 32 and k < 127 and query.len() < 48
      query.push(k)
    end
    return
  end
  if k == 8
    if input.len() > 0
      input.pop()
    end
  case k >= 32 and k < 127 and input.len() < 32
    input.push(k)
  case mode == PALETTE and (k & 255) == UP
    pick = max(0, pick - 1)
  case mode == PALETTE and (k & 255) == DOWN
    pick = min(nlisted - 1, pick + 1)
  end
  if mode == PALETTE
    narrow()
  end
end

# ---------------------------------------------------------------- keys

key :: proc(k: Int)
  base := k & 255
  shift := k & SHIFT != 0
  ctrl := k & CTRL != 0
  alt := k & ALT != 0
  if mode != NONE
    promptKey(k)
    return
  end
  if base != 14 and base != 15
    confirm = 0 # (a warning stands only until the next key)
  end
  if base >= 32 and base < 127 and k < 256
    typeChar(base)
    if base == 100 or base == 101
      dedent()
    end
  case base == 13
    enter()
  case base == 8
    backspace(ctrl or alt)
  case base == DELETE
    deleteForward(ctrl or alt)
  case base == 9
    tab(shift)
  case base == 27
    anchor = cursor
  case base == LEFT
    if cursor != anchor and not shift and not ctrl
      moveTo(selStart(), false)
    case ctrl
      moveTo(wordLeft(cursor), shift)
    else
      moveTo(cursor - 1, shift)
    end
    wantCol = -1
  case base == RIGHT
    if cursor != anchor and not shift and not ctrl
      moveTo(selEnd(), false)
    case ctrl
      moveTo(wordRight(cursor), shift)
    else
      moveTo(cursor + 1, shift)
    end
    wantCol = -1
  case base == UP or base == DOWN
    step := 1
    if base == UP
      step = -1
    end
    if alt
      moveLines(step)
    case ctrl
      top = max(0, min(top + step, lineCount - 1))
    else
      moveToLine(lineOf(cursor) + step, shift)
    end
  case base == PAGE_UP or base == PAGE_DOWN
    step := ROWS - 1
    if base == PAGE_UP
      step = -step
    end
    top = max(0, min(top + step, lineCount - 1))
    moveToLine(lineOf(cursor) + step, shift)
  case base == HOME
    if ctrl
      moveTo(0, shift)
    else
      l := lineOf(cursor)
      p := indentEnd(l)
      if cursor == p
        p = lineAt[l]
      end
      moveTo(p, shift)
    end
    wantCol = -1
  case base == KEY_END
    if ctrl
      moveTo(textLen, shift)
    else
      moveTo(lineEnd(lineOf(cursor)), shift)
    end
    wantCol = -1
  case base == 1 # Ctrl+A
    anchor = 0
    cursor = textLen
  case base == 3
    copy(false)
  case base == 24
    copy(true)
  case base == 22
    paste()
  case base == 26 and shift
    redo()
  case base == 26
    undo()
  case base == 25
    redo()
  case base == 11 and shift
    deleteLines()
  case base == 12 # Ctrl+L: the line, and the next with each again
    l := lineOf(cursor)
    if cursor != anchor and lineAt[lineOf(selEnd())] == selEnd() # (whole lines already: one more)
      l = lineOf(selEnd())
      anchor = selStart()
    else
      anchor = lineAt[l]
    end
    if l + 1 < lineCount
      cursor = lineAt[l + 1]
    else
      cursor = textLen
    end
  case base == 19 and shift # Ctrl+Shift+S
    saveAs()
  case base == 19
    ok := save()
  case base == 18 # Ctrl+R: save, then run its app
    run()
  case base == 15 # Ctrl+O
    if modified() and confirm != 15
      say("Unsaved changes: Ctrl+O again drops them", ORANGE)
      confirm = 15
    else
      confirm = 0
      callFiles("pick")
    end
  case base == 16 and shift # Ctrl+Shift+P: every command
    startPrompt(PALETTE)
  case base == 14 # Ctrl+N
    if modified() and confirm != 14
      say("Unsaved changes: Ctrl+N again drops them", ORANGE)
      confirm = 14
    else
      confirm = 0
      fresh()
      path.clear()
      say("New: Ctrl+S saves it, where Files says", GRAY)
    end
  case base == 6
    if cursor != anchor and selEnd() - selStart() <= 48 # (what's selected, to find)
      query.clear()
      query.pushAll(text[selStart():selEnd()])
    end
    startPrompt(FIND)
  case base == 7
    startPrompt(GO_TO)
  end
end

# the cursor in view
reveal :: proc()
  l := lineOf(cursor)
  col := cursor - lineAt[l]
  if l < top
    top = l
  end
  if l >= top + ROWS
    top = l - ROWS + 1
  end
  if col < left
    left = max(0, col - 8)
  end
  if col >= left + COLS
    left = col - COLS + 8
  end
end

movedAt := 0.0 # (the cursor stays lit while it moves)

# where in the text a point on the screen is: the nearest place between characters, on the line it's on
# (the first or last line shown, above or below them)
textAt :: proc(px: Int, py: Int) -> Int
  row := 0
  if py >= TOP_Y - 1
    row = min((py - TOP_Y + 1) / 9, ROWS - 1)
  end
  l := min(top + row, lineCount - 1)
  col := left
  if px >= TEXT_X
    col = left + (px - TEXT_X + 3) / 6
  end
  return lineAt[l] + min(col, lineEnd(l) - lineAt[l])
end

# the pointer: a click puts the cursor there (dragging, selecting to there); in the
# list of commands, a click does one, and one outside it closes it; scrolling, three lines a step
dragging := false
clicked := 0
pc.pointer(pc.Pointer.ui)
pointer :: proc()
  down := pc.pointerDown(0)
  px := pc.pointerX()
  py := pc.pointerY()
  if down == 1 and clicked == 0
    if mode == PALETTE
      from := max(0, pick - LIST_ROWS + 1)
      row := (py - 52) / 10
      if px >= 44 and px < 276 and py >= 52 and row < min(nlisted - from, LIST_ROWS)
        pick = from + row
        promptKey(13)
      case px < 40 or px >= 280 or py < 24 or py >= 64 + LIST_ROWS * 10
        promptKey(27)
      end
    case mode == NONE and py < 229
      moveTo(textAt(px, py), false)
      wantCol = -1
      dragging = true
      movedAt = pc.time()
    end
  case down == 1 and dragging and mode == NONE
    was := cursor
    moveTo(textAt(px, py), true)
    if py < TOP_Y and top > 0 # (dragged above or below: scrolls)
      top -= 1
    case py >= TOP_Y + ROWS * 9 and top + ROWS < lineCount
      top += 1
    end
    if cursor != was
      movedAt = pc.time()
    end
  end
  if down == 0
    dragging = false
  end
  clicked = down
  s := pc.scroll(1)
  if mode == NONE and s != 0
    top = max(0, min(top - 3 * s, lineCount - 1))
  end
end

update* :: proc()
  c := pc.key()
  for c >= 0
    was := cursor
    key(c)
    if cursor != was
      movedAt = pc.time()
    end
    if naming # (save or run, on a new file: its project's name, asked for)
      naming = false
      startPrompt(NAMING)
    end
    if mode == NONE
      reveal()
    end
    c = -1
    if not leaving # (gone to Files: the rest typed is its)
      c = pc.key()
    end
    if c < 0 and queued != 0 and not leaving # (a command picked from the list: its key)
      c = queued
      queued = 0
    end
  end
  pointer()
end

# ---------------------------------------------------------------- the screen

KEYWORDS :: " proc struct if else for in end return break continue import include enum union switch case is nil and or not true false "

isKeyword :: proc(a, b: Int) -> Bool
  n := b - a
  for p in 1..<KEYWORDS.len() - n
    if KEYWORDS[p - 1] == 32 and KEYWORDS[p + n] == 32
      k := 0
      for k < n and KEYWORDS[p + k] == text[a + k]
        k += 1
      end
      if k == n
        return true
      end
    end
  end
  return false
end

num: Blob[..16]

drawLine :: proc(l: Int, y: Int)
  a := lineAt[l]
  e := lineEnd(l)
  s0 := selStart()
  s1 := selEnd()
  if s0 < s1 and s0 <= e and s1 > a # (the selection's part of this line)
    c0 := max(s0, a) - a - left
    c1 := min(s1, e + 1) - a - left
    c0 = max(0, c0)
    c1 = min(COLS, c1)
    if c1 > c0
      pc.rect(TEXT_X + c0 * 6 - 1, y - 1, (c1 - c0) * 6, 9, SELECTED)
    end
  end
  inString := 0 # its quote, while in one
  inComment := false
  wordEnd := a
  wordColor := WHITE
  runStart := -1
  runColor := WHITE
  for p in a..=e
    color := WHITE
    if p < e
      c := text[p]
      if inComment
        color = LAVENDER
      case inString > 0
        color = GREEN
        if c == inString and text[p - 1] != 92
          inString = 0
        end
      case p < wordEnd
        color = wordColor
      case c == 35
        inComment = true
        color = LAVENDER
      case c == 34 or c == 39
        inString = c
        color = GREEN
      case isWord(c)
        q := p
        for q < e and isWord(text[q])
          q += 1
        end
        wordEnd = q
        wordColor = WHITE
        if c >= 48 and c <= 57
          wordColor = ORANGE
        case isKeyword(p, q)
          wordColor = PINK
        case c >= 65 and c <= 90
          wordColor = PEACH
        case q < e and text[q] == 40
          wordColor = BLUE
        end
        color = wordColor
      else
        color = GRAY
      end
    end
    col := p - a - left
    visible := p < e and col >= 0 and col < COLS
    if runStart >= 0 and (not visible or color != runColor)
      pc.print(text[runStart:p].asString(), TEXT_X + (runStart - a - left) * 6, y, runColor)
      runStart = -1
    end
    if visible and runStart < 0
      runStart = p
      runColor = color
    end
    if col >= COLS
      return
    end
  end
end

# Ctrl+Shift+P's list of commands, narrowed by what's typed
drawPalette :: proc()
  pc.rect(40, 24, 240, 40 + LIST_ROWS * 10, DARK)
  pc.print("Every command (type to narrow):", 46, 28, YELLOW)
  pc.rect(44, 38, 232, 11, BACK)
  pc.print(input[0:input.len()].asString(), 46, 40, WHITE)
  pc.rect(46 + input.len() * 6, 39, 1, 9, YELLOW)
  from := max(0, pick - LIST_ROWS + 1)
  for row in 0..<min(nlisted - from, LIST_ROWS)
    i := from + row
    k := listed[i]
    y := 54 + row * 10
    color := GRAY
    if i == pick
      pc.rect(44, y - 2, 232, 10, SELECTED)
      color = WHITE
    end
    pc.print(labels[k], 48, y, color)
    pc.print(keyNames[k], 272 - keyNames[k].len() * 6, y, DIM)
  end
  if nlisted == 0
    pc.print("No such command", 48, 54, DIM)
  end
end

draw* :: proc()
  pc.cls(BACK)
  cl := lineOf(cursor)
  # the title bar: the app, whether it's changed, and where the cursor is
  pc.rect(0, 0, 320, 10, DARK)
  shown := 0
  if path.len() > 0 # (its path, /rinc/ left off; its end, if it's long)
    t := path[0:path.len()].asString()
    if startsWith(t, "/rinc/")
      t = t[6:t.len()]
    end
    if t.len() > 36
      t = t[t.len() - 36:t.len()]
    end
    color := WHITE
    if readOnly()
      color = GRAY
    end
    pc.print(t, 2, 1, color)
    shown = t.len()
  else
    pc.print("(new)", 2, 1, GRAY)
    shown = 5
  end
  if modified()
    pc.print("*", 4 + shown * 6, 1, ORANGE)
  end
  num.clear()
  num.format("Ln ", cl + 1, ", Col ", cursor - lineAt[cl] + 1)
  pc.print(num[0:num.len()].asString(), 318 - num.len() * 6, 1, GRAY)
  # the lines
  for row in 0..<ROWS
    l := top + row
    if l >= lineCount
      break
    end
    y := TOP_Y + row * 9
    num.clear()
    num.format(l + 1)
    numColor := DIM
    if l == cl
      numColor = GRAY
    end
    pc.print(num[0:num.len()].asString(), TEXT_X - 6 - num.len() * 6, y, numColor)
    drawLine(l, y)
  end
  # the cursor: lit while it moves, else blinking
  ccol := cursor - lineAt[cl] - left
  if mode == NONE and cl >= top and cl < top + ROWS and ccol >= 0 and ccol <= COLS
    if pc.time() - movedAt < 0.5 or (pc.time() * 2.0).toInt() % 2 == 0
      pc.rect(TEXT_X + ccol * 6 - 1, TOP_Y + (cl - top) * 9 - 1, 1, 9, YELLOW)
    end
  end
  # the bottom bar: a prompt, a message, or the keys
  pc.rect(0, 229, 320, 11, DARK)
  if mode == GO_TO or mode == FIND or mode == NAMING
    label := "Go to line: "
    if mode == FIND
      label = "Find (Enter: next): "
    case mode == NAMING
      label = "A new project, called: "
    end
    pc.print(label, 2, 231, YELLOW)
    t := input[0:input.len()]
    if mode == FIND
      t = query[0:query.len()]
    end
    pc.print(t.asString(), 2 + label.len() * 6, 231, WHITE)
    pc.rect(2 + (label.len() + t.len()) * 6, 230, 1, 9, YELLOW)
  case message.len() > 0 and pc.time() - messageAt < 4.0
    pc.print(message[0:message.len()].asString(), 2, 231, messageColor)
  else
    pc.print("^O open  ^S save  ^R run  ^Shift+P all", 2, 231, DIM)
  end
  if mode == PALETTE
    drawPalette()
  end
end

# ---------------------------------------------------------------- starting

# back from Files (called to open a file, or to save as): what it had, again, then what was picked;
# else the active app or project's main file (another app may have made another one active), or, if
# that's where it was, where it was, else a new file
place: [3]Int # (the path's length, the cursor, the line at the top)
lastBuf: Blob[128]
lastLen := min(pc.saveRead("last", lastBuf[0:128]), 128)
part := 0
for i in 0..<max(lastLen, 0)
  c := lastBuf[i]
  if c == 32 and part < 2
    part += 1
  case part == 0
    place[0] += 1
  case c >= 48 and c <= 57
    place[part] = place[part] * 10 + c - 48
  end
end
lastPath := lastBuf[0:place[0]].asString()
calling: Blob[8]
callingLen := pc.stashRead("calling", calling[:])
picked: Blob[128]
pickedLen := pc.result(picked[:])
activeBuf: Blob[34]
activeLen := min(pc.settingRead("active", activeBuf[0:34]), 34)
if callingLen > 0
  ok := pc.stashDelete("calling")
  draftPath: Blob[96]
  n := min(pc.stashRead("draftPath", draftPath[:]), 96)
  if n > 0
    setPath(draftPath[0:n].asString())
  end
  m := min(pc.stashRead("draft", text[0:CAP]), CAP)
  settle(max(m, 0))
  disk := pc.fileRead(here(), one[0:0])
  savedTop = recTop
  if path.len() == 0 or disk != textLen # (changed from what's saved: shown as changed)
    savedTop = -1
  end
  cursor = min(place[1], textLen)
  anchor = cursor
  top = max(0, min(place[2], lineCount - 1))
  if pickedLen > 0 and calling[0:callingLen].asString() == "save"
    setPath(picked[0:min(pickedLen, 96)].asString())
    saved := save()
  case pickedLen > 0
    loaded := load(picked[0:min(pickedLen, 128)].asString())
  end
  reveal()
case activeLen > 0 and appOf(lastPath) != activeBuf[0:activeLen].asString() # (another app, made active)
  if not load(mainPath(activeBuf[0:activeLen].asString()))
    fresh()
  end
case place[0] > 0 and load(lastPath)
  cursor = min(place[1], textLen)
  anchor = cursor
  top = max(0, min(place[2], lineCount - 1))
  reveal()
else
  fresh()
  say("New: ^S saves it, ^O opens one, ^Shift+P every command", GRAY)
end
