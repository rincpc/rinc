# Files: storage's folders and files, to look through, view, copy, rename and delete; and the apps and
# projects among them, to edit, run and install
#
# It starts in /rinc (or where it was last). Up and down (or the d-pad) pick, Enter opens a folder (..
# goes up), edits an app's main file (it becomes the active app, and the editor opens it) or shows a
# file's text; Backspace goes up too. Typing narrows the list. Space (or the secondary button, or Y)
# shows what else can be done, each with a letter. Ctrl+N starts a new project, Ctrl+Shift+N makes a
# folder here. Esc closes what's open,
# else clears what's typed. /rinc is the root; changing is only inside it. Called with
# pc.call("files", "pick"), it's a picker: Enter on a file gives its path back (pc.done), Esc nothing.
# Called with "save", it picks where to save: a name typed, in the folder shown (Enter on a file takes
# its name), and Enter gives that path back.

ROWS :: 17
TOP :: 22             # the list's first row, 11 pixels each
MOST :: 160           # entries in a folder

path: Blob[..96]      # the folder shown
listing: Blob[6144]   # its entries, a line each: "d name" or "f name"
kind: [MOST]Int       # each one's: 0 a file, 1 a folder, 2 .. (up)
nameAt: [MOST]Int
nameLen: [MOST]Int
count := 0
shown: [MOST]Int      # what's listed: each one's number
nshown := 0
filter: Blob[..24]
pick := 0
top := 0
active: Blob[34]
activeLen := 0
message: Blob[..53]
# colors: the theme's, for each role (pc.Role)
backColor := pc.theme(pc.Role.bg)
barColor := pc.theme(pc.Role.bar)
textColor := pc.theme(pc.Role.text)
softColor := pc.theme(pc.Role.soft)
dimColor := pc.theme(pc.Role.dim)
faintColor := pc.theme(pc.Role.faint)
accentColor := pc.theme(pc.Role.accent)
headingColor := pc.theme(pc.Role.heading)
pickColor := pc.theme(pc.Role.pick)
selectColor := pc.theme(pc.Role.select)
errorColor := pc.theme(pc.Role.error)
messageColor := softColor
picking := false      # (called to pick a file)
saving := false       # (called to pick where to save: a folder, and a name typed)
saveName: Blob[..60]
full: Blob[..160]     # a path, made up

FILE :: 0
FOLDER :: 1
UP :: 2

NONE :: 0
MENU :: 1
COPY :: 2
RENAME :: 3
NEW :: 4
DELETE :: 5
VIEW :: 6
NEW_FOLDER :: 7
mode := NONE
target := -1          # what it's about
input: Blob[..60]
inputFresh := false   # (its text as it started, selected: what's typed takes its place)

# back to its caller, with what was picked (what's typed after is the caller's)
leaving := false
finish :: proc(result: String)
  leaving = true
  pc.done(result)
end

# ---------------------------------------------------------------- its parts

include "parts/folder.rio"
include "parts/actions.rio"
include "parts/input.rio"
include "parts/screen.rio"

# ---------------------------------------------------------------- starting

activeLen = max(0, min(pc.settingRead("active", active[]), 34))
args: Blob[96]
argsLen := min(pc.args(args[]), 96)
start: Blob[..96]
if argsLen >= 4 and (args[0..<4].asString() == "pick" or args[0..<4].asString() == "save") # (pick, or pick /a/folder; save, likewise)
  picking = true
  saving = args[0..<4].asString() == "save"
  if argsLen > 5
    ok := start.pushAll(args[5..<argsLen])
  end
end
if start.len() == 0
  placeLen := min(pc.stashRead("place", args[]), 96)
  if placeLen > 0
    ok := start.pushAll(args[0..<placeLen])
  end
end
made := pc.dirMake("/rinc/projects") # (where projects go: there to be found, even before the first)
if start.len() == 0 or not open(start[0..<start.len()].asString())
  ok := open("/rinc")
end
