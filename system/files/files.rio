# Files: storage's folders and files, to look through, view, copy, rename and delete; and the apps and
# projects among them, to edit, run and install
#
# It starts in /rinc (or where it was last). Up and down (or the d-pad) pick, Enter opens a folder (..
# goes up), edits an app's main file (it becomes the active app, and the editor opens it) or shows a
# file's text; Backspace goes up too. Typing narrows the list. Space (or the secondary button, or Y)
# shows what else can be done, each with a letter. Ctrl+N starts a new project. Esc closes what's open,
# else clears what's typed. Looking goes wherever storage does; changing only inside /rinc. Called with
# pc.call("files", "pick"), it's a picker: Enter on a file gives its path back (pc.done), Esc nothing.

ROWS :: 17
TOP :: 22             # the list's first row, 11 pixels each
MOST :: 160           # entries in a folder

path: Blob[..96]      # the folder shown
listing: Blob[6144]   # its entries, a line each: "d name" or "f name"
kind: [MOST]Int       # each one's: 0 a file, 1 a folder, 2 .. (up)
nameAt: [MOST]Int
nameLen: [MOST]Int
count := 0
shown: [MOST]Int      # what's listed: each one's number
nshown := 0
filter: Blob[..24]
pick := 0
top := 0
active: Blob[34]
activeLen := 0
message: Blob[..53]
messageColor := 6
picking := false      # (called to pick a file)
full: Blob[..160]     # a path, made up

FILE :: 0
FOLDER :: 1
UP :: 2

NONE :: 0
MENU :: 1
COPY :: 2
RENAME :: 3
NEW :: 4
DELETE :: 5
VIEW :: 6
mode := NONE
target := -1          # what it's about
input: Blob[..60]
inputFresh := false   # (its text as it started, selected: what's typed takes its place)

# ---------------------------------------------------------------- the folder

nameOf :: proc(k: Int) -> String
  return listing[nameAt[k]:nameAt[k] + nameLen[k]].asString()
end

# a path in this folder
pathTo :: proc(name: String) -> String
  full.clear()
  ok := full.pushAll(path[0:path.len()])
  if path.len() > 1
    ok = full.push(47)
  end
  ok = full.pushAll(name)
  return full[0:full.len()].asString()
end

here :: proc() -> String
  return path[0:path.len()].asString()
end

say :: proc(s: String, color: Int)
  message.clear()
  ok := message.pushAll(s)
  messageColor = color
end

lower :: proc(c: Int) -> Int
  if c >= 65 and c <= 90
    return c + 32
  end
  return c
end

# whether a name has what's typed in it, ignoring case
has :: proc(k: Int) -> Bool
  f := filter.len()
  n := nameOf(k)
  for s in 0..<n.len() - f + 1
    i := 0
    for i < f and lower(n[s + i]) == lower(filter[i])
      i += 1
    end
    if i == f
      return true
    end
  end
  return false
end

narrow :: proc()
  nshown = 0
  for k in 0..<count
    if kind[k] == UP or has(k)
      shown[nshown] = k
      nshown += 1
    end
  end
  pick = max(0, min(pick, nshown - 1))
end

picked :: proc() -> Int
  if nshown == 0
    return -1
  end
  return shown[pick]
end

reveal :: proc()
  if pick < top
    top = pick
  end
  if pick >= top + ROWS
    top = pick - ROWS + 1
  end
end

# the folder at p, listed: false if it can't be
open :: proc(p: String) -> Bool
  n := pc.dir(p, listing[:])
  if n < 0
    say("Can't look in ", 8)
    ok := message.pushAll(p)
    return false
  end
  path.clear()
  ok := path.pushAll(p)
  count = 0
  if p.len() > 1 # (.. goes up)
    kind[0] = UP
    nameAt[0] = 0
    nameLen[0] = 0
    count = 1
  end
  at := 0
  for i in 0..<listing.len()
    if listing[i] == 10 and count < MOST and n > 0
      kind[count] = FILE
      if listing[at] == 100
        kind[count] = FOLDER
      end
      nameAt[count] = at + 2
      nameLen[count] = i - at - 2
      count += 1
      n -= 1
      at = i + 1
    end
  end
  filter.clear()
  pick = 0
  top = 0
  narrow()
  saved := pc.stashWrite("place", p)
  return true
end

# up a folder, the one it came from picked
came: Blob[..64]
goUp :: proc()
  if path.len() <= 1
    return
  end
  slash := path.len() - 1
  for slash > 0 and path[slash] != 47
    slash -= 1
  end
  came.clear()
  ok := came.pushAll(path[slash + 1:path.len()])
  upTo: Blob[..96]
  ok = upTo.pushAll(path[0:max(slash, 1)])
  if open(upTo[0:upTo.len()].asString())
    for i in 0..<nshown
      if nameOf(shown[i]) == came[0:came.len()].asString()
        pick = i
      end
    end
    reveal()
  end
end

# ---------------------------------------------------------------- apps and projects among them

inApps :: proc() -> Bool
  return here() == "/rinc/apps"
end
inProjects :: proc() -> Bool
  return here() == "/rinc/projects"
end

# an app's name for an entry: an app's folder (chord) or a project's (chord*), or its main file; "" if it's
# neither
refBuf: Blob[..34]
appRef :: proc(k: Int) -> String
  refBuf.clear()
  if kind[k] == FOLDER and (inApps() or inProjects())
    ok := refBuf.pushAll(nameOf(k))
    if inProjects()
      ok = refBuf.push(42)
    end
  case kind[k] == FILE
    p := here()
    for prefix in 0..<2
      start := "/rinc/apps/"
      if prefix == 1
        start = "/rinc/projects/"
      end
      if p.len() > start.len() and p[0:start.len()] == start
        app := p[start.len():p.len()]
        n := nameOf(k)
        if n.len() == app.len() + 4 and n[0:app.len()] == app and n[app.len():n.len()] == ".rio"
          ok := refBuf.pushAll(app)
          if prefix == 1
            ok = refBuf.push(42)
          end
        end
      end
    end
  end
  return refBuf[0:refBuf.len()].asString()
end

isActive :: proc(k: Int) -> Bool
  if activeLen == 0 or kind[k] != FOLDER
    return false
  end
  r := appRef(k)
  return r.len() > 0 and r == active[0:activeLen].asString()
end

# whether an entry can be changed: inside /rinc, but not /rinc's own folders
canChange :: proc(k: Int) -> Bool
  p := here()
  return kind[k] != UP and p.len() > 6 and p[0:6] == "/rinc/"
end

edit :: proc(ref: String)
  if pc.settingWrite("active", ref) == 0
    pc.launch("edit")
  else
    say("No storage: nothing can be edited", 8)
  end
end

# ---------------------------------------------------------------- viewing a file's text

view: Blob[16384]
viewLen := 0
viewAll := 0          # (its whole length: more than shows, if it's bigger)
lineAt: [2048]Int
lineCount := 0
viewTop := 0
VIEW_ROWS :: 22

showFile :: proc(k: Int)
  n := pc.fileRead(pathTo(nameOf(k)), view[:])
  if n < 0
    say("Can't read it", 8)
    return
  end
  viewAll = n
  viewLen = min(n, 16384)
  lineCount = 1
  lineAt[0] = 0
  for i in 0..<viewLen
    if view[i] == 10 and lineCount < 2048
      lineAt[lineCount] = i + 1
      lineCount += 1
    end
  end
  viewTop = 0
  mode = VIEW
  target = k
end

viewScroll :: proc(by: Int)
  viewTop = max(0, min(viewTop + by, lineCount - VIEW_ROWS))
end

# ---------------------------------------------------------------- what's done

# the menu: what can be done with what's picked, a letter each
OPEN_IT :: 0
EDIT_IT :: 1
RUN_IT :: 2
COPY_IT :: 3
RENAME_IT :: 4
DELETE_IT :: 5
INSTALL_IT :: 6
VIEW_IT :: 7
LABELS := [8]String{"Open", "Edit", "Run", "Copy", "Rename", "Delete", "Install as its app", "View"}
KEYS := [8]Int{111, 101, 114, 99, 110, 100, 105, 118} # o e r c n d i v
items: [8]Int
itemOk: [8]Bool
itemCount := 0
menuPick := 0

addItem :: proc(id: Int, ok: Bool)
  items[itemCount] = id
  itemOk[itemCount] = ok
  itemCount += 1
end

openMenu :: proc()
  k := picked()
  if k < 0 or kind[k] == UP
    return
  end
  target = k
  itemCount = 0
  ref := appRef(k)
  isApp := ref.len() > 0
  change := canChange(k)
  if kind[k] == FOLDER
    addItem(OPEN_IT, true)
    if isApp
      addItem(EDIT_IT, true)
      addItem(RUN_IT, true)
      addItem(COPY_IT, true)
      addItem(RENAME_IT, inProjects())
      addItem(DELETE_IT, change)
      addItem(INSTALL_IT, inProjects())
    else
      addItem(COPY_IT, change)
      addItem(RENAME_IT, change)
      addItem(DELETE_IT, change)
    end
  else
    addItem(VIEW_IT, true)
    if isApp
      addItem(EDIT_IT, true)
      addItem(RUN_IT, true)
    end
    addItem(COPY_IT, change)
    addItem(RENAME_IT, change)
    addItem(DELETE_IT, change)
  end
  menuPick = 0
  mode = MENU
end

startPrompt :: proc(m: Int)
  mode = m
  input.clear()
  inputFresh = false
  if m == RENAME or m == COPY # (from its name)
    ok := input.pushAll(nameOf(target))
    inputFresh = true
  end
end

act :: proc(i: Int)
  id := items[i]
  k := target
  mode = NONE
  if not itemOk[i]
    say("That can't be done here", 8)
    return
  end
  switch
  case id == OPEN_IT
    ok := open(pathTo(nameOf(k)))
  case id == VIEW_IT
    showFile(k)
  case id == EDIT_IT
    edit(appRef(k))
  case id == RUN_IT
    pc.launch(appRef(k))
  case id == COPY_IT
    startPrompt(COPY)
  case id == RENAME_IT
    startPrompt(RENAME)
  case id == DELETE_IT
    startPrompt(DELETE)
  case id == INSTALL_IT
    if pc.appInstall(nameOf(k)) == 0
      say("Installed as its app: ", 6)
      ok := message.pushAll(nameOf(k))
    else
      say("Couldn't install it", 8)
    end
  end
end

# a name: letters, digits, _, - and (for a file) dots, not starting with one
validName :: proc(s: String, dots: Bool) -> Bool
  if s.len() == 0 or s.len() > 60 or s[0] == 46
    return false
  end
  for c in s
    if not ((c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 45 or (dots and c == 46))
      return false
    end
  end
  return true
end

refTo: Blob[..34]
projectRef :: proc(s: String) -> String
  refTo.clear()
  ok := refTo.pushAll(s)
  ok = refTo.push(42)
  return refTo[0:refTo.len()].asString()
end

# this folder again, with name picked
reopen :: proc(name: String)
  ok := open(here())
  for i in 0..<nshown
    if nameOf(shown[i]) == name
      pick = i
    end
  end
  reveal()
end

from: Blob[..160]
promptDone :: proc()
  m := mode
  s := input[0:input.len()].asString()
  k := target
  if m == DELETE
    if s != nameOf(k)
      say("Type its whole name to delete it", 8)
      return
    end
    mode = NONE
    res := 0
    ref := appRef(k)
    if kind[k] == FOLDER and ref.len() > 0
      res = pc.appDelete(ref)
    else
      res = pc.fileDelete(pathTo(nameOf(k)))
    end
    if res == 0
      say("Deleted ", 6)
      ok := message.pushAll(s)
      reopen("")
    else
      say("Couldn't delete it", 8)
    end
    return
  end
  app := m == NEW or (kind[k] == FOLDER and appRef(k).len() > 0)
  if not validName(s, not app) or (app and s.len() > 32)
    if app
      say("A name is letters, digits, _ and -", 8)
    else
      say("A name is letters, digits, _, - and .", 8)
    end
    return
  end
  mode = NONE
  res := 0
  if m == NEW
    to := projectRef(s)
    if pc.appSource(to, input[0:0]) >= 0
      say("There's a project of that name already", 8)
      return
    end
    header: Blob[..80]
    ok := header.pushAll("# ")
    ok = header.pushAll(s)
    ok = header.pushAll(": what it does\n")
    if pc.appSave(to, header[0:header.len()].asString()) == 0
      edit(to)
    else
      say("Couldn't make it", 8)
    end
    return
  end
  if app
    if m == COPY
      res = pc.appCopy(appRef(k), projectRef(s))
    else
      res = pc.appRename(appRef(k), projectRef(s))
    end
  else
    from.clear()
    ok := from.pushAll(pathTo(nameOf(k)))
    if m == COPY
      res = pc.fileCopy(from[0:from.len()].asString(), pathTo(s))
    else
      res = pc.fileRename(from[0:from.len()].asString(), pathTo(s))
    end
  end
  if res != 0
    say("Couldn't: is something called that already?", 8)
    return
  end
  if app and m == COPY and inApps()
    say("Copied as project ", 6)
    ok := message.pushAll(s)
    ok = message.push(42)
  else
    say("Done: ", 6)
    ok := message.pushAll(s)
    reopen(s)
  end
end

# Enter, on an entry
enter :: proc(k: Int)
  if k < 0
    return
  end
  if kind[k] == UP
    goUp()
  case kind[k] == FOLDER
    ok := open(pathTo(nameOf(k)))
  case picking
    pc.done(pathTo(nameOf(k)))
  case appRef(k).len() > 0
    edit(appRef(k))
  else
    showFile(k)
  end
end

# ---------------------------------------------------------------- keys, buttons and the pointer

prompting :: proc() -> Bool
  return mode == COPY or mode == RENAME or mode == NEW or mode == DELETE
end

move :: proc(by: Int)
  if mode == VIEW
    viewScroll(by)
  case mode == MENU
    menuPick = (menuPick + by + itemCount * 8) % itemCount
  case mode == NONE and nshown > 0
    pick = max(0, min(pick + by, nshown - 1))
    reveal()
  end
end

# Esc, B: what's open closes, else back up (or, picking at the top, nothing picked)
back :: proc()
  if mode != NONE
    mode = NONE
  case filter.len() > 0
    filter.clear()
    narrow()
  case picking and path.len() <= 1
    pc.done("")
  else
    goUp()
  end
end

promptKey :: proc(c: Int)
  k := c & 255
  switch
  case k == 27
    mode = NONE
  case k == 13
    promptDone()
  case k == 8
    if inputFresh
      input.clear()
    case input.len() > 0
      input.pop()
    end
    inputFresh = false
  case c >= 32 and c < 127
    if inputFresh
      input.clear()
      inputFresh = false
    end
    if input.len() < 60
      ok := input.push(c)
    end
  end
end

menuKey :: proc(c: Int)
  k := c & 255
  switch
  case k == 27
    mode = NONE
  case k == 13
    act(menuPick)
  case k == 9
    move(1)
  else
    for i in 0..<itemCount
      if c < 256 and lower(k) == KEYS[items[i]] and mode == MENU
        act(i)
      end
    end
  end
end

viewKey :: proc(c: Int)
  k := c & 255
  switch
  case k == 27 or k == 8
    mode = NONE
  case k == 135
    viewScroll(-(VIEW_ROWS - 1))
  case k == 136 or c == 32
    viewScroll(VIEW_ROWS - 1)
  case k == 132
    viewTop = 0
  case k == 133
    viewScroll(lineCount)
  end
end

listKey :: proc(c: Int)
  k := c & 255
  switch # (the arrows are buttons too: they're handled as buttons, below)
  case k == 27
    back()
  case c == 13
    enter(picked())
  case c == 32
    openMenu()
  case c == 14 # Ctrl+N
    startPrompt(NEW)
  case k == 8
    if filter.len() > 0
      filter.pop()
      narrow()
    else
      goUp()
    end
  case c == 130 | 1024 # Alt+Up
    goUp()
  case k == 135
    move(-(ROWS - 1))
  case k == 136
    move(ROWS - 1)
  case k == 132
    move(-nshown)
  case k == 133
    move(nshown)
  case c > 32 and c < 127 and filter.len() < 24
    ok := filter.push(c)
    narrow()
    reveal()
  end
end

# an arrow typed but not held as a button (a terminal's, say): the buttons, below, take the rest
typedArrow :: proc(c: Int) -> Int
  if c & 255 == 130 and c < 1024 and pc.btn(2) == 0
    return -1
  end
  if c & 255 == 131 and c < 1024 and pc.btn(3) == 0
    return 1
  end
  return 0
end

key :: proc(c: Int)
  if typedArrow(c) != 0 and not prompting()
    move(typedArrow(c))
    return
  end
  if prompting()
    promptKey(c)
  case mode == MENU
    menuKey(c)
  case mode == VIEW
    viewKey(c)
  else
    listKey(c)
  end
end

# the row at a point on the screen (-1: none), and the menu's item (-1: none)
rowAt :: proc(px: Int, py: Int) -> Int
  row := (py - TOP + 2) / 11
  if py < TOP - 2 or px < 2 or px >= 318 or row >= min(nshown - top, ROWS)
    return -1
  end
  return top + row
end
MENU_X :: 150
MENU_Y :: 50
menuAt :: proc(px: Int, py: Int) -> Int
  i := (py - MENU_Y - 14) / 11
  if px < MENU_X or px >= MENU_X + 160 or py < MENU_Y + 14 or i >= itemCount
    return -1
  end
  return i
end

held := 0
repeat := 0
clicked := 0
wasShown := 0
pc.pointer(pc.Pointer.ui)
update* :: proc()
  c := pc.key()
  for c >= 0
    message.clear()
    key(c)
    c = pc.key()
  end
  # up and down: the arrows and the d-pad, as buttons (a step a press, then more while it's held); Y the
  # menu, B back
  bits := pc.btn(2) + pc.btn(3) * 2 + pc.btn(7) * 4 + pc.btn(5) * 8
  pressed := bits & ~held
  step := 0
  if bits & 3 != held & 3
    repeat = 15
    step = (bits & 2) / 2 - (bits & 1)
  case bits & 3 != 0
    repeat -= 1
    if repeat == 0
      repeat = 4
      step = (bits & 2) / 2 - (bits & 1)
    end
  end
  held = bits
  if step != 0 and not prompting()
    move(step)
  end
  if pressed & 4 != 0 and mode == NONE
    openMenu()
  end
  if pressed & 8 != 0 and wasShown == 0
    back()
  end
  # the pointer: a click picks, and a click on the one picked opens it (as A does, with the pointer
  # hidden); the secondary button shows the menu; in the menu, a click does that, outside it closes it
  click := pc.pointerDown(0) + pc.pointerDown(1) * 2
  if click & ~clicked != 0
    px := pc.pointerX()
    py := pc.pointerY()
    if mode == MENU
      i := menuAt(px, py)
      if i >= 0 and click & 1 != 0
        act(i)
      case i < 0
        mode = NONE
      end
    case mode == NONE
      r := rowAt(px, py)
      if r >= 0
        if click & 2 != 0
          pick = r
          openMenu()
        case r == pick
          enter(picked())
        else
          pick = r
        end
      case click & 1 != 0 and wasShown == 0
        enter(picked())
      end
    case mode == VIEW and click & 2 != 0
      mode = NONE
    end
  end
  clicked = click
  wasShown = pc.pointerShown()
  s := pc.scroll(1)
  if s != 0 and (mode == NONE or mode == VIEW)
    move(-s * 2)
  end
end

# ---------------------------------------------------------------- the screen

drawList :: proc()
  for row in 0..<min(nshown - top, ROWS)
    i := top + row
    k := shown[i]
    y := TOP + row * 11
    if i == pick
      pc.rect(2, y - 2, 316, 11, 12)
    end
    if isActive(k) # (the active app: a mark at its left)
      pc.rect(0, y - 1, 2, 9, 10)
    end
    if kind[k] == UP
      pc.print("..", 6, y, 6)
    case kind[k] == FOLDER
      color := 7
      if inProjects()
        color = 15
      end
      pc.print(nameOf(k), 6, y, color)
      pc.print("/", 6 + nameLen[k] * 6, y, 13)
    else
      pc.print(nameOf(k), 6, y, 6)
    end
  end
  if nshown <= 1 and filter.len() == 0 and (count == 0 or kind[0] == UP)
    pc.print("(empty)", 6, TOP + 11 * nshown, 13)
  end
  if filter.len() > 0
    pc.print(filter[0:filter.len()].asString(), 316 - filter.len() * 6, 2, 10)
  end
end

line: Blob[53]
drawView :: proc()
  for row in 0..<VIEW_ROWS
    l := viewTop + row
    if l >= lineCount
      break
    end
    a := lineAt[l]
    e := viewLen
    if l + 1 < lineCount
      e = lineAt[l + 1] - 1
    end
    n := max(0, min(e - a, 53))
    for i in 0..<n # (bytes that aren't text as dots)
      b := view[a + i]
      if b < 32 or b > 126
        b = 46
      end
      line[i] = b
    end
    pc.print(line[0:n].asString(), 1, 14 + row * 9, 7)
  end
end

drawBottom :: proc()
  pc.rect(0, 216, 320, 24, 0)
  if prompting()
    label := "Copy as: "
    if mode == RENAME
      label = "Rename to: "
    case mode == NEW
      label = "New project: "
    case mode == DELETE
      label = "Type its name to delete it: "
    end
    pc.print(label, 3, 219, 10)
    x := 3 + label.len() * 6
    if inputFresh # (selected)
      pc.rect(x - 1, 218, input.len() * 6 + 1, 9, 12)
    end
    pc.print(input[0:input.len()].asString(), x, 219, 7)
    pc.rect(x + input.len() * 6, 218, 1, 9, 10)
    if mode == DELETE
      pc.print("All of it, for good. Enter: delete  Esc: no", 3, 230, 8)
    else
      pc.print("Enter: done  Esc: no", 3, 230, 5)
    end
    return
  end
  if message.len() > 0
    pc.print(message[0:message.len()].asString(), 3, 219, messageColor)
  end
  if mode == VIEW
    pc.print("Esc back  Page Up/Down", 3, 230, 5)
    if viewAll > viewLen
      pc.print("(its start)", 3 + 23 * 6, 230, 13)
    end
  case picking
    pc.print("Enter pick  Backspace up  Esc none", 3, 230, 5)
  else
    pc.print("Enter open  Space more  ^N new  Backspace up", 3, 230, 5)
  end
end

letter: Blob[1]
drawMenu :: proc()
  h := 14 + itemCount * 11
  pc.rect(MENU_X - 2, MENU_Y - 2, 164, h + 4, 0)
  pc.rect(MENU_X, MENU_Y, 160, h, 2)
  pc.print(nameOf(target)[0:min(nameLen[target], 25)], MENU_X + 4, MENU_Y + 3, 10)
  for i in 0..<itemCount
    y := MENU_Y + 14 + i * 11
    color := 7
    if not itemOk[i]
      color = 13
    end
    if i == menuPick
      pc.rect(MENU_X + 2, y - 1, 156, 10, 12)
    end
    letter[0] = KEYS[items[i]]
    pc.print(letter[:].asString(), MENU_X + 5, y + 1, 10)
    pc.print(LABELS[items[i]], MENU_X + 16, y + 1, color)
  end
end

draw* :: proc()
  pc.cls(1)
  pc.rect(0, 0, 320, 11, 0)
  title := "Files"
  if picking
    title = "Pick a file"
  end
  pc.print(title, 3, 2, 10)
  p := here()
  if mode == VIEW
    p = pathTo(nameOf(target))
  end
  room := 52 - title.len() - 1 - filter.len()
  if p.len() > room # (its end, if it's long)
    p = p[p.len() - room:p.len()]
  end
  pc.print(p, 3 + (title.len() + 1) * 6, 2, 6)
  if mode == VIEW
    drawView()
  else
    drawList()
  end
  drawBottom()
  if mode == MENU
    drawMenu()
  end
end

# ---------------------------------------------------------------- starting

activeLen = max(0, min(pc.settingRead("active", active[:]), 34))
args: Blob[96]
argsLen := min(pc.args(args[:]), 96)
start: Blob[..96]
if argsLen >= 4 and args[0:4].asString() == "pick" # (pick, or pick /a/folder)
  picking = true
  if argsLen > 5
    ok := start.pushAll(args[5:argsLen])
  end
end
if start.len() == 0
  placeLen := min(pc.stashRead("place", args[:]), 96)
  if placeLen > 0
    ok := start.pushAll(args[0:placeLen])
  end
end
if start.len() == 0 or not open(start[0:start.len()].asString())
  if not open("/rinc")
    ok := open("/")
  end
end
