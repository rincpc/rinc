# Files: the screen (part of files.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- the screen

# n bytes, as a listing says it: 532 B, 4.7 KB, 24 KB, 1.2 MB
sizeText: Blob[..12]
sizeOf :: proc(n: Int) -> String
  sizeText.clear()
  if n < 1024
    _ = sizeText.print(n, " B")
  case n < 10240
    t := (n * 10 + 512) / 1024
    _ = sizeText.print(t / 10, ".", t % 10, " KB")
  case n < 1048576
    _ = sizeText.print((n + 512) / 1024, " KB")
  else
    t := (n / 1024 * 10 + 512) / 1024
    _ = sizeText.print(t / 10, ".", t % 10, " MB")
  end
  return sizeText[0..<sizeText.len()].asString()
end

# a job's box, in the middle of the screen: what it's doing, how far, the file in hand, and Esc
jobText: Blob[..64]
jobDraw :: proc()
  x := 24
  y := 74
  w := 272
  pc.rect({x - 1, y - 1}, {w + 2, 82}, accentColor)
  pc.rect({x, y}, {w, 80}, barColor)
  jobText.clear()
  verb := "Copying "
  if jobDeleting do verb = "Deleting "
  if jobMoving do verb = "Moving "
  _ = jobText.print(verb, jobItems)
  if jobItems == 1
    _ = jobText.print(" item")
  else
    _ = jobText.print(" items")
  end
  if jobDest.len() > 0 and jobText.len() + jobDest.len() < 42 do _ = jobText.print(" to ", jobDest.asString())
  if jobMoving and jobDeleting do jobText.clear()
  if jobMoving and jobDeleting do _ = jobText.print("Moving: the originals taken away")
  pc.print(jobText.asString(), {x + 6, y + 6}, accentColor)
  jobText.clear()
  if jobPhase == JOB_PLANNING
    _ = jobText.print("Looking: ", jobFolders, " folders, ", jobFiles, " files, ", sizeOf(jobBytes))
  case jobPhase == JOB_FOLDERS_LEFT
    _ = jobText.print("Folders: ", jobFolderNext + 1, " left")
  case jobMaking
    _ = jobText.print("Making folders: ", jobMade, " of ", jobFolders)
  else
    _ = jobText.print(min(jobDone + 1, jobFiles), " of ", jobFiles, " files, ")
    _ = jobText.print(sizeOf(jobDoneBytes))
    _ = jobText.print(" of ", sizeOf(jobBytes))
  end
  pc.print(jobText.asString(), {x + 6, y + 22}, textColor)
  bx := x + 6
  by := y + 36
  bw := w - 12
  pc.rect({bx, by}, {bw, 8}, backColor)
  if jobPhase == JOB_PLANNING # (not known yet how much: a block going back and forth)
    span := bw - 40
    at := jobTick * 3 % (2 * span)
    if at > span do at = 2 * span - at
    pc.rect({bx + at, by}, {40, 8}, pickColor)
  else
    part := 0 # (by bytes, a folder made counting as 4 KB of them: making one is about as slow)
    all := jobBytes + 4096 * jobFolders
    if not jobDeleting and all > 0
      part = bw * min(jobDoneBytes + 4096 * jobMade, all) / all
    case jobBytes > 0
      part = bw * min(jobDoneBytes, jobBytes) / jobBytes
    case jobFiles > 0
      part = bw * min(jobDone, jobFiles) / jobFiles
    end
    if jobPhase == JOB_FOLDERS_LEFT do part = bw
    pc.rect({bx, by}, {part, 8}, pickColor)
  end
  t := jobFrom.asString()
  if jobDeleting do t = jobTo.asString()
  s := t.len()
  for s > 0 and t[s - 1] != 47 do s -= 1
  name := t[s..<t.len()]
  if name.len() > 43 do name = name[0..<43]
  pc.print(name, {x + 6, y + 50}, softColor)
  pc.print("Esc stops it", {x + 6, y + 66}, faintColor)
  if jobFailed > 0
    jobText.clear()
    _ = jobText.print(jobFailed, " couldn't be")
    pc.print(jobText.asString(), {x + w - 6 - jobText.len() * 6, y + 66}, errorColor)
  end
end

drawList :: proc()
  for row in 0..<min(nshown - top, ROWS)
    i := top + row
    k := shown[i]
    y := TOP + row * 11
    if marked[k] # (selected: the one picked brighter; picked alone, a frame)
      color := selectColor
      if i == pick
        color = pickColor
      end
      pc.rect({2, y - 2}, {316, 11}, color)
    case i == pick
      pc.rect({2, y - 2}, {316, 1}, pickColor)
      pc.rect({2, y + 8}, {316, 1}, pickColor)
      pc.rect({2, y - 2}, {1, 11}, pickColor)
      pc.rect({317, y - 2}, {1, 11}, pickColor)
    end
    if isActive(k) # (the active app: a mark at its left)
      pc.rect({0, y - 1}, {2, 9}, accentColor)
    end
    if kind[k] == UP
      pc.print("..", {6, y}, softColor)
    case kind[k] == FOLDER
      color := textColor
      if inProjects()
        color = headingColor
      end
      pc.print(nameOf(k), {6, y}, color)
      pc.print("/", {6 + nameLen[k] * 6, y}, dimColor)
    else
      pc.print(nameOf(k), {6, y}, softColor)
      if size[k] >= 0 # (its size, at the right)
        s := sizeOf(size[k])
        pc.print(s, {314 - s.len() * 6, y}, dimColor)
      end
    end
  end
  if nshown <= 1 and filter.len() == 0 and (count == 0 or kind[0] == UP)
    pc.print("(empty)", {6, TOP + 11 * nshown}, dimColor)
  end
  if filter.len() > 0
    pc.print(filter[0..<filter.len()].asString(), {316 - filter.len() * 6, 2}, accentColor)
  end
end

line: Blob[53]
drawView :: proc()
  for row in 0..<VIEW_ROWS
    l := viewTop + row
    if l >= lineCount
      break
    end
    a := lineAt[l]
    e := viewLen
    if l + 1 < lineCount
      e = lineAt[l + 1] - 1
    end
    n := max(0, min(e - a, 53))
    for i in 0..<n # (bytes that aren't text as dots)
      b := view[a + i]
      if b < 32 or b > 126
        b = 46
      end
      line[i] = b
    end
    pc.print(line[0..<n].asString(), {1, 14 + row * 9}, textColor)
  end
end

drawBottom :: proc()
  pc.rect({0, 216}, {320, 24}, barColor)
  if prompting()
    label := "Copy as: "
    if mode == RENAME
      label = "Rename to: "
    case mode == NEW
      label = "New project: "
    case mode == DELETE and target < 0
      label = "Type delete to delete them all: "
    case mode == DELETE
      label = "Type its name to delete it: "
    case mode == NEW_FOLDER
      label = "New folder: "
    end
    pc.print(label, {3, 219}, accentColor)
    x := 3 + label.len() * 6
    field.draw({x, 219}, (318 - x) / 6, textColor, selectColor, accentColor)
    if mode == DELETE
      pc.print("All of it, for good. Enter: delete  Esc: no", {3, 230}, errorColor)
    else
      pc.print("Enter: done  Esc: no", {3, 230}, faintColor)
    end
    return
  end
  if message.len() > 0
    pc.print(message[0..<message.len()].asString(), {3, 219}, messageColor)
  end
  if mode == VIEW
    pc.print("Esc back  Page Up/Down", {3, 230}, faintColor)
    if viewAll > viewLen
      pc.print("(its start)", {3 + 23 * 6, 230}, dimColor)
    end
  case saving
    pc.print("Save as: ", {3, 219}, accentColor)
    saveField.draw({3 + 9 * 6, 219}, 43, textColor, selectColor, accentColor)
    pc.print("Type a name, Enter save  Esc no", {3, 230}, faintColor)
  case picking
    pc.print("Enter pick  Backspace up  Esc none", {3, 230}, faintColor)
  else
    if markCount > 1 # (several selected: how many, and what's done with them)
      t: Blob[..53]
      _ = t.print(markCount, " selected  ^X cut  ^C copy  Del delete")
      pc.print(t[0..<t.len()].asString(), {3, 230}, faintColor)
    else
      pc.print("Enter open  Space more  ^N project  ^Shift+N folder", {3, 230}, faintColor)
    end
  end
end

letter: Blob[1]
drawMenu :: proc()
  h := 14 + itemCount * 11
  pc.rect({MENU_X - 2, MENU_Y - 2}, {164, h + 4}, barColor)
  pc.rect({MENU_X, MENU_Y}, {160, h}, selectColor)
  pc.print(nameOf(target)[0..<min(nameLen[target], 25)], {MENU_X + 4, MENU_Y + 3}, accentColor)
  for i in 0..<itemCount
    y := MENU_Y + 14 + i * 11
    color := textColor
    if not itemOk[i]
      color = dimColor
    end
    if i == menuPick
      pc.rect({MENU_X + 2, y - 1}, {156, 10}, pickColor)
    end
    letter[0] = KEYS[items[i]]
    pc.print(letter[].asString(), {MENU_X + 5, y + 1}, accentColor)
    pc.print(LABELS[items[i]], {MENU_X + 16, y + 1}, color)
  end
end

draw* :: proc()
  pc.cls(backColor)
  pc.rect({0, 0}, {320, 11}, barColor)
  title := "Files"
  if saving
    title = "Save where"
  case picking
    title = "Pick a file"
  end
  pc.print(title, {3, 2}, accentColor)
  p := here()
  if mode == VIEW
    p = pathTo(nameOf(target))
  end
  room := 52 - title.len() - 1 - filter.len()
  if p.len() > room # (its end, if it's long)
    p = p[p.len() - room..<p.len()]
  end
  pc.print(p, {3 + (title.len() + 1) * 6, 2}, softColor)
  if mode == VIEW
    drawView()
  else
    drawList()
  end
  drawBottom()
  if mode == MENU
    drawMenu()
  end
  if mode == OPEN_WITH
    drawOpenWith()
  end
  if jobOn()
    jobDraw()
  end
end
