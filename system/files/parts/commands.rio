# Files: its commands, for the system's list (Sys+P, or Ctrl+Shift+P here), as things are when it's asked: in
# the list, its keys, then what the menu (Space) offers for what's picked; viewing a file, moving through
# it (part of files.rio, included there, in order: the names it uses are declared before it)

ACT :: 4096           # (a command of its own: 4096 + one of the menu's, on what's picked)
LIST_KEYS :: 16
listKeys := [LIST_KEYS]pc.Command{
  {label = "Open what's picked", keys = "Enter", key = 13},
  {label = "Up a folder", keys = "Alt+Up", key = 130 | 1024},
  {label = "What else can be done with it", keys = "Space", key = 32},
  {label = "New project", keys = "^N", key = 14},
  {label = "New folder here", keys = "^Shift+N", key = 14 | 256},
  {label = "The first", keys = "Home", key = 132},
  {label = "The last", keys = "End", key = 133},
  {label = "A page up", keys = "Page Up", key = 135},
  {label = "A page down", keys = "Page Down", key = 136},
  {label = "Back: what's typed cleared, or up", keys = "Esc", key = 27},
  {label = "Select all", keys = "^A", key = 1},
  {label = "The one picked, selected or not", keys = "^Space", key = 32 | 512},
  {label = "Cut, to move it elsewhere", keys = "^X", key = 24},
  {label = "Copy, to put a copy elsewhere", keys = "^C", key = 3},
  {label = "Rename the one picked", keys = "F2", key = 141},
  {label = "Delete", keys = "Delete", key = 134},
}
pasteCommand := pc.Command{label = "Paste here", keys = "^V", key = 22}
viewKeys := [5]pc.Command{
  {label = "Back to the list", keys = "Esc", key = 27},
  {label = "A page up", keys = "Page Up", key = 135},
  {label = "A page down", keys = "Page Down", key = 136},
  {label = "The start", keys = "Home", key = 132},
  {label = "The end", keys = "End", key = 133},
}
# one of the menu's, from the command list (4096 + its id), on what's picked: as its letter would
actOn :: proc(id: Int)
  k := picked()
  if picking or not fillItems(k)
    return
  end
  target = k
  for i in 0..<itemCount
    if items[i] == id
      act(i)
      return
    end
  end
end
menuKeys := [9]String{"Space O", "Space E", "Space R", "Space C", "Space N", "Space D", "Space I", "Space V", "Space F"}
listed: [26]pc.Command
commandList* :: proc() -> []pc.Command
  if mode == VIEW
    return viewKeys[0..<5]
  end
  n := 0
  for i in 0..<LIST_KEYS
    if not picking or i == 0 or i == 1 or (i >= 5 and i < 10) # (picking: no menu, nothing new, nothing changed)
      listed[n] = listKeys[i]
      n += 1
    end
  end
  if not picking and clip.len() > 2
    listed[n] = pasteCommand
    n += 1
  end
  if mode == NONE and not picking and fillItems(picked())
    for i in 0..<itemCount
      if itemOk[i] and items[i] != FOLDER_IT and items[i] != OPEN_IT and items[i] != RENAME_IT and items[i] != DELETE_IT # (those are above)
        label := LABELS[items[i]]
        if items[i] == COPY_IT
          label = "Copy as another name, here"
        end
        listed[n] = {label = label, keys = menuKeys[items[i]], key = ACT + items[i]}
        n += 1
      end
    end
  end
  return listed[0..<n]
end
