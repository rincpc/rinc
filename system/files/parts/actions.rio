# Files: what's done (part of files.rio, included there, in order: the names it uses are declared before it)

# ---------------------------------------------------------------- what's done

# the menu: what can be done with what's picked, a letter each
OPEN_IT :: 0
EDIT_IT :: 1
RUN_IT :: 2
COPY_IT :: 3
RENAME_IT :: 4
DELETE_IT :: 5
INSTALL_IT :: 6
VIEW_IT :: 7
FOLDER_IT :: 8
OPEN_WITH_IT :: 9
LABELS := [10]String{"Open", "Edit", "Run", "Copy", "Rename", "Delete", "Install as its app", "View", "New folder here", "Open with"}
KEYS := [10]Int{111, 101, 114, 99, 110, 100, 105, 118, 102, 119} # o e r c n d i v f w
items: [10]Int
itemOk: [10]Bool
itemCount := 0
menuPick := 0

addItem :: proc(id: Int, ok: Bool)
  items[itemCount] = id
  itemOk[itemCount] = ok
  itemCount += 1
end

# what the menu offers for entry k (false: nothing, for ..), into items
fillItems :: proc(k: Int) -> Bool
  itemCount = 0
  if k < 0 or kind[k] == UP
    return false
  end
  ref := appRef(k)
  isApp := ref.len() > 0
  change := canChange(k)
  if kind[k] == FOLDER
    addItem(OPEN_IT, true)
    if isApp
      addItem(EDIT_IT, true)
      addItem(RUN_IT, true)
      addItem(COPY_IT, true)
      addItem(RENAME_IT, inProjects())
      addItem(DELETE_IT, change)
      addItem(INSTALL_IT, inProjects())
    else
      addItem(COPY_IT, change)
      addItem(RENAME_IT, change)
      addItem(DELETE_IT, change)
    end
  else
    addItem(VIEW_IT, true)
    addItem(OPEN_WITH_IT, not picking)
    if isApp
      addItem(EDIT_IT, true)
      addItem(RUN_IT, true)
    end
    addItem(COPY_IT, change)
    addItem(RENAME_IT, change)
    addItem(DELETE_IT, change)
  end
  addItem(FOLDER_IT, true) # (as Ctrl+Shift+N, which a browser may keep for itself)
  return true
end
openMenu :: proc()
  k := picked()
  if not fillItems(k)
    return
  end
  target = k
  menuPick = 0
  mode = MENU
end

startPrompt :: proc(m: Int)
  mode = m
  field.set("")
  if m == RENAME or m == COPY # (from its name, selected but for a file's extension, as Windows has it)
    n := nameOf(target)
    field.set(n)
    dot := n.len()
    for i in 1..<n.len()
      if n[i] == 46 and kind[target] == FILE
        dot = i
      end
    end
    field.select(0, dot)
  end
end

act :: proc(i: Int)
  id := items[i]
  k := target
  mode = NONE
  if not itemOk[i]
    say("That can't be done here", errorColor)
    return
  end
  switch
  case id == OPEN_IT
    ok := open(pathTo(nameOf(k)))
  case id == VIEW_IT
    showFile(k)
  case id == EDIT_IT
    edit(appRef(k))
  case id == RUN_IT
    pc.launch(appRef(k))
  case id == COPY_IT
    startPrompt(COPY)
  case id == RENAME_IT
    startPrompt(RENAME)
  case id == DELETE_IT
    startPrompt(DELETE)
  case id == OPEN_WITH_IT
    startOpenWith(k, false)
  case id == FOLDER_IT
    startPrompt(NEW_FOLDER)
  case id == INSTALL_IT
    if pc.appInstall(nameOf(k)) == 0
      say("Installed as its app: ", softColor)
      ok := message.pushAll(nameOf(k))
    else
      say("Couldn't install it", errorColor)
    end
  end
end

# a name: letters, digits, _, - and (for a file) dots, not starting with one
validName :: proc(s: String, dots: Bool) -> Bool
  if s.len() == 0 or s.len() > 60 or s[0] == 46
    return false
  end
  for c in s
    if not ((c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 45 or (dots and c == 46))
      return false
    end
  end
  return true
end

refTo: Blob[..34]
projectRef :: proc(s: String) -> String
  refTo.clear()
  ok := refTo.pushAll(s)
  ok = refTo.push(43)
  return refTo[0..<refTo.len()].asString()
end

# this folder again, with name picked
reopen :: proc(name: String)
  ok := open(here())
  for i in 0..<nshown
    if nameOf(shown[i]) == name
      pick = i
    end
  end
  selectOnly(pick)
  reveal()
end

from: Blob[..160]
promptDone :: proc()
  m := mode
  s := input[0..<input.len()].asString()
  k := target
  if m == NEW_FOLDER # (here)
    if not validName(s, true)
      say("A name is letters, digits, _, - and .", errorColor)
      return
    end
    mode = NONE
    if here().len() <= 6 or here()[0..<6] != "/rinc/" or pc.dirMake(pathTo(s)) != 0
      say("Couldn't make it here: is something called that already?", errorColor)
      return
    end
    reopen(s)
    return
  end
  if m == DELETE and k < 0 # (several selected: delete typed for all of them)
    if s != "delete"
      say("Type delete to delete them", errorColor)
      return
    end
    mode = NONE
    gone := 0
    left := 0
    for j in 0..<count
      if marked[j]
        res := 0
        ref := appRef(j)
        if kind[j] == FOLDER and ref.len() > 0
          res = pc.appDelete(ref)
        else
          res = pc.fileDelete(pathTo(nameOf(j)))
        end
        if res == 0
          gone += 1
        else
          left += 1
        end
      end
    end
    reopen("")
    message.clear()
    _ = message.print("Deleted ", gone)
    messageColor = softColor
    if left > 0
      _ = message.print("; ", left, " couldn't be")
      messageColor = errorColor
    end
    return
  end
  if m == DELETE
    if s != nameOf(k)
      say("Type its whole name to delete it", errorColor)
      return
    end
    mode = NONE
    res := 0
    ref := appRef(k)
    if kind[k] == FOLDER and ref.len() > 0
      res = pc.appDelete(ref)
    else
      res = pc.fileDelete(pathTo(nameOf(k)))
    end
    if res == 0
      say("Deleted ", softColor)
      ok := message.pushAll(s)
      reopen("")
    else
      say("Couldn't delete it", errorColor)
    end
    return
  end
  app := m == NEW or (kind[k] == FOLDER and appRef(k).len() > 0)
  if not validName(s, not app) or (app and s.len() > 32)
    if app
      say("A name is letters, digits, _ and -", errorColor)
    else
      say("A name is letters, digits, _, - and .", errorColor)
    end
    return
  end
  mode = NONE
  res := 0
  if m == NEW
    to := projectRef(s)
    inputIn: Blob[..] = input[0..<0]
    if pc.appSource(to, inputIn) >= 0
      say("There's a project of that name already", errorColor)
      return
    end
    header: Blob[..80]
    ok := header.pushAll("# ")
    ok = header.pushAll(s)
    ok = header.pushAll(": what it does\n")
    if pc.appSave(to, header[0..<header.len()].asString()) == 0
      edit(to)
    else
      say("Couldn't make it", errorColor)
    end
    return
  end
  if app
    if m == COPY
      res = pc.appCopy(appRef(k), projectRef(s))
    else
      res = pc.appRename(appRef(k), projectRef(s))
    end
  else
    from.clear()
    ok := from.pushAll(pathTo(nameOf(k)))
    if m == COPY
      res = pc.fileCopy(from[0..<from.len()].asString(), pathTo(s))
    else
      res = pc.fileRename(from[0..<from.len()].asString(), pathTo(s))
    end
  end
  if res != 0
    say("Couldn't: is something called that already?", errorColor)
    return
  end
  if app and m == COPY and inApps()
    say("Copied as project ", softColor)
    ok := message.pushAll(s)
    ok = message.push(43)
  else
    say("Done: ", softColor)
    ok := message.pushAll(s)
    reopen(s)
  end
end

# Enter, on an entry
enter :: proc(k: Int)
  if k < 0
    return
  end
  if kind[k] == UP
    goUp()
  case kind[k] == FOLDER
    ok := open(pathTo(nameOf(k)))
  case saving
    saveField.set(nameOf(k))
  case picking
    finish(pathTo(nameOf(k)))
  case appRef(k).len() > 0
    edit(appRef(k))
  else # (in the app for its kind)
    openFile(k)
  end
end
