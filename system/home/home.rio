# Home: the apps, to start one
#
# Type to narrow the list, up and down to choose, Enter to start one (or the d-pad and A). Esc clears
# what's typed. A Rinc starts here, and Windows+Esc (or a controller's Xbox+Back) comes back. An app's title and description come from its first line, as
# "# Title: what it does".

names: Blob[2176] # every app's folder name, one after another
infos: Blob[6144] # and its first line
nameAt: [64]Int
nameLen: [64]Int
infoAt: [64]Int
infoLen: [64]Int
titleLen: [64]Int # the part of its first line before the colon (0: none, so the name)
count := 0
shown: [64]Int # what's listed: each app's number
nshown := 0
filter: Blob[..24]
pick := 0
top := 0 # the first row shown: it moves only to keep the pick in view
ROWS :: 13 # rows that fit above the keys at the bottom
# colors: the theme's, for each role (pc.Role)
backColor := pc.theme(pc.Role.bg)
barColor := pc.theme(pc.Role.bar)
textColor := pc.theme(pc.Role.text)
softColor := pc.theme(pc.Role.soft)
dimColor := pc.theme(pc.Role.dim)
faintColor := pc.theme(pc.Role.faint)
accentColor := pc.theme(pc.Role.accent)
pickColor := pc.theme(pc.Role.pick)
held := 0
repeat := 0

refresh :: proc()
  count = min(pc.apps(), 64)
  at := 0
  bt := 0
  for i in 0..<count
    nameAt[i] = at
    nameLen[i] = min(pc.appName(i, names[at..<at + 33]), 33)
    at += nameLen[i]
    infoAt[i] = bt
    infoLen[i] = min(pc.appInfo(i, infos[bt..<bt + 96]), 96)
    titleLen[i] = 0
    for k in 0..<min(infoLen[i], 24)
      if titleLen[i] == 0 and infos[bt + k] == 58 # (the colon)
        titleLen[i] = k
      end
    end
    bt += infoLen[i]
  end
end
refresh()

lower :: proc(c: Int) -> Int
  if c >= 65 and c <= 90
    return c + 32
  end
  return c
end

# whether text has what's typed in it, ignoring case
has :: proc(text: Blob) -> Bool
  f := filter.len()
  for s in 0..<text.len() - f + 1
    k := 0
    for k < f and lower(text[s + k]) == lower(filter[k])
      k += 1
    end
    if k == f
      return true
    end
  end
  return false
end

title :: proc(i: Int) -> Blob
  if titleLen[i] > 0
    return infos[infoAt[i]..<infoAt[i] + titleLen[i]]
  end
  return names[nameAt[i]..<nameAt[i] + nameLen[i]]
end

# the apps in order of title, ignoring case
order: [64]Int
before :: proc(i, j: Int) -> Bool
  a := title(i)
  b := title(j)
  for k in 0..<min(a.len(), b.len())
    if lower(a[k]) != lower(b[k])
      return lower(a[k]) < lower(b[k])
    end
  end
  return a.len() < b.len()
end
for i in 0..<count
  order[i] = i
  j := i
  for j > 0 and before(order[j], order[j - 1])
    t := order[j]
    order[j] = order[j - 1]
    order[j - 1] = t
    j -= 1
  end
end

# the apps whose name or title has what's typed in it
narrow :: proc()
  nshown = 0
  for k in 0..<count
    i := order[k]
    if has(names[nameAt[i]..<nameAt[i] + nameLen[i]]) or has(title(i))
      shown[nshown] = i
      nshown += 1
    end
  end
  pick = max(0, min(pick, nshown - 1))
end
narrow()

start :: proc()
  if nshown == 0
    return
  end
  k := shown[pick]
  if k >= 0
    pc.launch(names[nameAt[k]..<nameAt[k] + nameLen[k]].asString())
  end
end

# the active app or project, the whole Rinc's setting (what the editor opens): Ctrl+Enter makes the
# picked one active, and opens the editor
active: Blob[34]
activeLen := max(0, min(pc.settingRead("active", active[]), 34))
edit :: proc()
  if nshown == 0
    return
  end
  k := shown[pick]
  n := names[nameAt[k]..<nameAt[k] + nameLen[k]].asString()
  if pc.settingWrite("active", n) == 0
    pc.launch("edit")
  end
end
isActive :: proc(k: Int) -> Bool
  return activeLen > 0 and names[nameAt[k]..<nameAt[k] + nameLen[k]].asString() == active[0..<activeLen].asString()
end

# the rows shown, so the pick is among them, and never past either end of the list
follow :: proc()
  if pick < top
    top = pick
  end
  if pick >= top + ROWS
    top = pick - ROWS + 1
  end
  top = max(0, min(top, nshown - ROWS))
end

# the app listed at a point on the screen, or -1
rowAt :: proc(px: Int, py: Int) -> Int
  row := (py - 51) / 13
  if px < 8 or px >= 312 or py < 51 or row >= min(nshown - top, ROWS)
    return -1
  end
  return top + row
end

clicked := 0 # (the pointer's primary button, last frame)
wasShown := 0
pc.pointer(pc.Pointer.ui)
update* :: proc()
  c := pc.key()
  for c >= 0
    if c == 13
      start()
    case c == 13 | 512 # Ctrl+Enter
      edit()
    else
      if c == 8
        if filter.len() > 0
          filter.pop()
        end
      else
        if c == 27
          filter.clear()
        else
          if c >= 32 and c < 127 and filter.len() < 24  # (not the editing keys: the arrows are buttons too)
            ok := filter.push(c)
          end
        end
      end
    end
    narrow()
    c = pc.key()
  end
  # a click on an app opens it (a click with the pointer hidden, and not on one, opens the picked
  # one); scrolling moves the pick
  click := pc.pointerDown(0)
  if click == 1 and clicked == 0
    i := rowAt(pc.pointerX(), pc.pointerY())
    if i >= 0
      pick = i
      start()
    case wasShown == 0
      start()
    end
  end
  clicked = click
  wasShown = pc.pointerShown()
  if nshown > 0
    pick = max(0, min(pick - pc.scroll(1), nshown - 1))
  end
  bits := pc.btn(2) + pc.btn(3) * 2
  move := 0
  if bits & 3 != held & 3
    repeat = 12
    move = (bits & 2) / 2 - (bits & 1)
  else
    if bits & 3 != 0
      repeat -= 1
      if repeat == 0
        repeat = 4
        move = (bits & 2) / 2 - (bits & 1)
      end
    end
  end
  if nshown > 0
    pick = (pick + move + nshown) % nshown
  end
  follow()
  held = bits
end

# a box with its corners a pixel in: softer than a plain rectangle
pill :: proc(x: Int, y: Int, w: Int, h: Int, c: Int, under: Int)
  pc.rect(x, y, w, h, c)
  pc.pset(x, y, under)
  pc.pset(x + w - 1, y, under)
  pc.pset(x, y + h - 1, under)
  pc.pset(x + w - 1, y + h - 1, under)
end

draw* :: proc()
  pc.cls(backColor)
  pc.print("Rinc", 12, 12, textColor)
  pc.rect(12, 21, 23, 1, accentColor) # (an accent under the name)
  if count > 0
    n: Blob[..16]
    ok := n.print(count, " apps")
    pc.print(n[0..<n.len()].asString(), 308 - n.len() * 6, 12, dimColor)
  end
  pill(8, 30, 304, 15, barColor, backColor)
  if filter.len() == 0
    pc.print("Search", 14, 34, faintColor)
  end
  pc.print(filter[0..<filter.len()].asString(), 14, 34, textColor)
  pc.rect(13 + filter.len() * 6, 33, 1, 8, accentColor)
  if nshown > ROWS # (a bar at the right: how far down, and how much shows)
    h := max(6, 169 * ROWS / nshown)
    pc.rect(314, 51 + (169 - h) * top / (nshown - ROWS), 2, h, dimColor)
  end
  for row in 0..<min(nshown - top, ROWS)
    i := top + row
    y := 54 + row * 13
    selected := i == pick
    if selected
      pill(8, y - 3, 304, 13, pickColor, backColor)
    end
    k := shown[i]
    dim := dimColor
    if selected
      dim = softColor
    end
    t := title(k)
    if isActive(k) # (the active one: a mark at its left)
      pc.rect(3, y - 1, 2, 9, accentColor)
    end
    pc.print(t.asString(), 16, y, textColor)
    if names[nameAt[k] + nameLen[k] - 1] == 43 # (a project: its +)
      pc.print("+", 16 + min(t.len(), 12) * 6, y, accentColor)
    end
    if titleLen[k] > 0
      at := titleLen[k] + 1
      for at < infoLen[k] and infos[infoAt[k] + at] == 32 # (the spaces after the colon)
        at += 1
      end
      d := infos[infoAt[k] + at..<infoAt[k] + min(infoLen[k], at + 35)]
      pc.print(d.asString(), 96, y, dim)
    end
  end
  if nshown == 0
    pc.print("Nothing matches", 16, 54, dimColor)
  end
  if count == 0
    pc.print("No apps yet", 12, 216, dimColor)
  end
  pc.print("Enter open  Ctrl+Enter edit  Esc clear", 12, 228, faintColor)
end
