# Cloudlamp: a lighthouse on an island that floats above a sea of clouds. Its lamp has gone dark. The
# keeper waits by the path, and a gull says what gulls say. Walk east along the path to the lighthouse's
# yard, and light the lamp.
#
# The arrows (or the d-pad) walk; walking into someone talks to them. Its files are its own, beside it:
# the sheet (cloudlamp.png, Paint's), the map (cloudlamp.map, Maps': two screens, island and yard, each
# with a things layer of its folk, by name), the sounds (cloudlamp.snd, Sound's: a step, a chirp, a tune
# and its bass) and the song (cloudlamp.mus, Music's). Made with studio's apps on a Fruit Jam, typed at
# over its serial port; it needs only rinc (and rinc's library: tilemap, song) to run.

import tilemap
import song

GRASS :: 0            # the sheet's sprites, as Paint drew them
PATH :: 1
ROCK :: 2
CLOUD :: 3
PLAYER :: 4
SIDE :: 16            # a cell on the screen: 8 pixels, twice

sheetRoom: [2]tilemap.Sheet
layerRoom: [6]tilemap.Layer
room: Blob[2000]
m := tilemap.Map{sheets = sheetRoom[], layers = layerRoom[], room = room[]}
fine := m.load("cloudlamp.map")
pixels: Blob[..(64 + 1) * 8]
sheet := pc.imageRead("cloudlamp.png", pixels)
grounds := [2]Int{m.layerNamed("island"), m.layerNamed("yard")}
folks := [2]Int{m.layerNamed("isle_folk"), m.layerNamed("yard_folk")}

# the song and its sounds (Music's file, and Sound's it names, beside it): sounds 0 to 3 a step, a chirp,
# the tune and its bass; the song on voices 4 to 7, round and round, the game's sounds on 0
notes: Blob[4 * song.SOUND_BYTES] # (its 4 sounds, and the song's room: as Music says, at its top right)
songRoom: Blob[160]
tune := song.Song{notes = notes[], room = songRoom[], voice = 4}
fine = tune.load("cloudlamp.mus")
play :: proc(voice: Int, s: Int) do tune.sound(voice, s)

screen := 0           # 0 the island, 1 the yard
at := {3, 7}          # where the player is, in cells
said: Blob[..60]
saidFor := 0          # frames it's shown for yet
lit := false
wait := 0
say :: proc(s: String)
  said.clear()
  fine = said.pushAll(s)
  saidFor = 240
end
say("Cloudlamp. The lamp is dark: walk east.")

# who's in cell p of this screen: their name, into whom ("" for none)
whom: Blob[..15]
who :: proc(p: [2]Int)
  whom.clear()
  for j in 0..<m.things(folks[screen])
    t := m.thing(folks[screen], j)
    if t.at / 8 == p
      fine = whom.pushAll(t.name.asString())
    end
  end
end
talk :: proc(name: String)
  play(0, 1)
  if name == "keeper" and lit
    say("Keeper: the airships see us again. Thank you!")
  case name == "keeper"
    say("Keeper: our lamp went out. Its yard is east.")
  case name == "gull"
    say("Gull: Kree! Clouds below, stars above. Kree!")
  case name == "lamp" and not lit
    lit = true
    say("The lamp burns! Far off, an airship turns home.")
  case name == "lamp"
    say("The lamp burns bright.")
  end
end
step :: proc(d: [2]Int)
  to := at + d
  if to.x >= 20 and screen == 0 # (the path's east end: the yard)
    screen = 1
    to.x = 0
  case to.x < 0 and screen == 1
    screen = 0
    to.x = 19
  end
  if to.x < 0 or to.y < 0 or to.x >= 20 or to.y >= 15
    return
  end
  who(to)
  if whom.len() > 0
    talk(whom.asString())
    return
  end
  t := m.at(grounds[screen], to)
  if t == ROCK or t == CLOUD or t == tilemap.EMPTY
    return
  end
  at = to
  play(0, 0)
end

update* :: proc()
  if not tune.playing # (the song, again)
    fine = tune.play(0, false)
  end
  tune.tick()
  d := {pc.btn(1) - pc.btn(0), pc.btn(3) - pc.btn(2)}
  if d == {0, 0}
    wait = 0
  case wait == 0
    if d.x != 0
      d.y = 0
    end
    step(d)
    wait = 9
  else
    wait -= 1
  end
  if saidFor > 0
    saidFor -= 1
  end
end

sprite :: proc(layer: Int, t: Int, p: [2]Int)
  pc.blit(sheet, p, {from = m.spriteAt(layer, t, sheet.size.x), size = {8, 8}, scale = {2, 2}})
end
draw* :: proc()
  pc.cls(1)
  g := grounds[screen]
  for y in 0..<15
    for x in 0..<20
      t := m.at(g, {x, y})
      if t != tilemap.EMPTY
        sprite(g, t, {x, y} * SIDE)
      end
    end
  end
  f := folks[screen]
  for j in 0..<m.things(f)
    t := m.thing(f, j)
    if lit and t.name.asString() == "lamp" # (its light)
      pc.rect(t.at * 2 - 6, {SIDE + 12, SIDE + 12}, 10)
    end
    sprite(f, t.sprite, t.at * 2)
  end
  sprite(g, PLAYER, at * SIDE)
  if saidFor > 0
    pc.rect({0, 220}, {320, 20}, 0)
    pc.print(said.asString(), {4, 226}, 7)
  end
end
