# Cloudlamp: a lighthouse on an island that floats above a sea of clouds. Its lamp has gone dark. The
# keeper waits by the path, and a gull says what gulls say. Walk east along the path to the lighthouse's
# yard, and light the lamp.
#
# The arrows (or the d-pad) walk; walking into someone talks to them. Its files are its own, beside it:
# the sheet (cloudlamp.png, Paint's: its rock and cloud flagged solid, which walking can't cross), the
# map (cloudlamp.map, Maps': two screens, island and yard, each with a things layer of its folk, by
# name), the sounds (cloudlamp.snd, Sound's: a step, a chirp, a tune and its bass) and the song
# (cloudlamp.mus, Music's). Made with studio's apps on a Fruit Jam, typed at over its serial port; it
# needs only rinc (and rinc's library: tilemap, song) to run.
# Its title is in a font of its own, title.png, drawn in Paint (pc.fontRead).

import tilemap
import song

PLAYER :: 4                            # the sheet's sprite for the visitor

sheetRoom: [2]tilemap.Sheet
layerRoom: [6]tilemap.Layer
room: Blob[2000]                       # the map's cells, things and names (as Maps says)
pixels: Blob[..(64 + 1) * 8]           # its sheet's pixels and flags (as Paint says)
m := tilemap.Map{sheets = sheetRoom[], layers = layerRoom[], room = room[], pixels = pixels}
_ = m.load("cloudlamp.map")            # (and its sheet)
notes: Blob[4 * song.SOUND_BYTES]      # the song's 4 sounds, and its room (as Music says)
songRoom: Blob[160]
tune := song.Song{notes = notes[], room = songRoom[], voice = 4}
_ = tune.load("cloudlamp.mus")
_ = tune.loop()
pc.screen(.half)                       # 160 by 120: a cell is a sprite's 8 pixels
titleRoom: Blob[..(96 + 1) * 36 + 200] # (the title font, Paint's: its picture, then its letters' widths)
title := pc.fontRead("title.png", titleRoom)

grounds := [2]Int{m.layerNamed("island"), m.layerNamed("yard")}
folks := [2]Int{m.layerNamed("isle_folk"), m.layerNamed("yard_folk")}
solid := m.flag(grounds[0], "solid")
lamp := m.find("lamp")                 # (its layer and number)
screen := 0                            # 0 the island, 1 the yard
at := {3, 7}                           # the visitor, in cells
lit := false
said: Blob[..50]                       # what's said (a copy: a String given a proc can't be kept)
saidFor := 0

say :: proc(s: String)
  said.clear()
  _ = said.pushAll(s)
  saidFor = 240
end
say("Cloudlamp. The lamp is dark: walk east.")
talk :: proc(name: String)
  tune.sound(0, 1)
  switch name
  case "keeper"
    if lit
      say("Keeper: the airships see us again. Thank you!")
    else
      say("Keeper: our lamp went out. Its yard is east.")
    end
  case "gull"
    say("Gull: Kree! Clouds below, stars above. Kree!")
  case "lamp"
    if lit
      say("The lamp burns bright.")
    else
      say("The lamp burns! Far off, an airship turns home.")
    end
    lit = true
  end
end
step :: proc(d: [2]Int)
  to := at + d
  if to.x >= 20 and screen == 0        # (the path's east end: the yard)
    screen = 1
    to.x = 0
  case to.x < 0 and screen == 1
    screen = 0
    to.x = 19
  end
  g := grounds[screen]
  if t := m.thingIn(folks[screen], to)
    talk(t.name.asString())
  case m.at(g, to) != tilemap.EMPTY and m.flagsAt(g, to) & solid == 0
    at = to
    tune.sound(0, 0)
  end
end

update* :: proc()
  tune.tick()
  d := pc.dpadp()
  if d != {0, 0} do step(d)
  saidFor = max(saidFor - 1, 0)
end

draw* :: proc()
  camera := m.layers[grounds[screen]].at # (the screen's own place on the map)
  pc.cls(1)
  m.draw(grounds[screen], camera)
  if lit and lamp.x == folks[screen]   # (the lamp's light, under it)
    pc.rect(m.thing(lamp.x, lamp.y).at - 3, {14, 14}, 10)
  end
  m.draw(folks[screen], camera)
  m.sprite(grounds[screen], PLAYER, at * 8)
  if screen == 0 and not lit do pc.print("CLOUDLAMP", {44, 6}, 7, {font = title})
  if saidFor > 0
    pc.rect({0, 98}, {160, 22}, 0)
    pc.print(said.asString(), {2, 100}, 7, {width = 156})
  end
end
