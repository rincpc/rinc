# Cloudlamp: a lighthouse on an island that floats above a sea of clouds. Its lamp has gone dark. The
# keeper waits by the path, and a gull says what gulls say. Walk east along the path to the lighthouse's
# yard, and light the lamp.
#
# The arrows (or the d-pad) walk; walking into someone talks to them. Its files are its own, beside it:
# the sheet (cloudlamp.png, Paint's: its rock and cloud flagged solid, which walking can't cross), the
# map (cloudlamp.map, Maps': ground, the island and the yard side by side, a screen each, and folk, its
# things, by name), the sounds (cloudlamp.snd, Sound's: a step, a chirp, and the song's) and the song
# (cloudlamp.mus, Music's: after Satie's Gymnopedie No. 1, 1888). Its title is in a font of its own,
# title.png, drawn in Paint. Made with studio's apps on a Fruit Jam, typed at over its serial port; it
# needs only rinc (and rinc's library: tilemap, song, notice) to run.

import tilemap
import song
import notice

PLAYER :: 4                            # the sheet's sprite for the visitor

room: Blob[2000]                       # the map's cells, things and names (as Maps says)
pixels: Blob[..(64 + 1) * 8]           # its sheet's pixels and flags (as Paint says)
m := tilemap.Map{room = room[], pixels = pixels}
_ = m.load("cloudlamp.map")            # (and its sheet)
songRoom: Blob[1993]                   # the song's sounds and the song (as Music says)
tune := song.Song{buffer = songRoom[], voice = 1}
_ = tune.loop("cloudlamp.mus")
pc.screen(.half)                       # 160 by 120: a cell is a sprite's 8 pixels
titleRoom: Blob[..(96 + 1) * 36 + 200] # (the title font, Paint's: its picture, then its letters' widths)
title := pc.fontRead("title.png", titleRoom)

ground := m.layerNamed("ground")
folk := m.layerNamed("folk")
solid := m.flag(ground, "solid")
lamp := m.find("lamp")                 # (its layer and number)
at := {3, 7}                           # the visitor, in cells
lit := false
said := notice.Notice{}                # (at the screen's bottom, for 4 seconds)
said.say("Cloudlamp. The lamp is dark: walk east.")

talk :: proc(name: String)
  tune.sound(0, 1)
  switch name
  case "keeper"
    if lit
      said.say("Keeper: the airships see us again. Thank you!")
    else
      said.say("Keeper: our lamp went out. Its yard is east.")
    end
  case "gull"
    said.say("Gull: Kree! Clouds below, stars above. Kree!")
  case "lamp"
    if lit
      said.say("The lamp burns bright.")
    else
      said.say("The lamp burns! Far off, an airship turns home.")
    end
    lit = true
  end
end
step :: proc(d: [2]Int)
  to := at + d
  if t := m.thingIn(folk, to)
    talk(t.name.asString())
  case m.at(ground, to) != tilemap.EMPTY and m.flagsAt(ground, to) & solid == 0
    at = to
    tune.sound(0, 0)
  end
end

update* :: proc()
  d := pc.dpadp()
  if d != {0, 0} do step(d)
end

draw* :: proc()
  camera := at / {20, 15} * {160, 120} # (the screen the visitor's on: a screen at a time)
  pc.cls(1)
  m.draw(ground, camera)
  if lit                               # (the lamp's light, under it)
    pc.rect(m.thing(lamp.x, lamp.y).at - camera - 3, {14, 14}, 10)
  end
  m.draw(folk, camera)
  m.sprite(ground, PLAYER, at * 8 - camera)
  if camera.x == 0 and not lit do pc.print("CLOUDLAMP", {44, 6}, 7, {font = title})
  said.draw()
end
