# Chord: a plucked chord in 4-bit ADPCM (5.6 KB), typed in as hex, and the same chord as 16-bit
# (22 KB) and 8-bit (11 KB), made here, and on Rinc's synth, to hear the difference. V plays the ADPCM
# one, C the 16-bit one, X the 8-bit one (each on the next of the 8 voices, so they overlap), Z the
# synth's (its four notes on the next four voices, strummed as the samples are); Q (or RB) picks the
# synth's quality and W (or LB) its wave. Left and right change the pitch, up and down the pan. Measured on this chord: ADPCM and 8-bit both 36 dB signal to noise, but in the quiet
# tail ADPCM 40 dB and 8-bit 28 (8-bit's noise stays put as the sound fades; ADPCM's shrinks with it).
# ADPCM at 22 kHz is its grainy end: it gets better with the rate, about 9 dB each time it doubles.
include "parts/sound.rio" # (chord: the sound, 5590 bytes of ADPCM)
# play it: pc.sound(0, chord, {bits = 4, rate = 22050.0})
fine: [11025]Float
pluck :: proc(f: Float, start: Int)
  for i in start..<11025
    t := (i - start).toFloat() / 22050.0
    fine[i] += 0.22 * exp(-6.0 * t) * (sin(6.2831853 * f * t) + 0.3 * sin(12.566371 * f * t))
  end
end
pluck(220.0, 0)
pluck(261.63, 1102)
pluck(329.63, 2204)
pluck(440.0, 3306)
chord16: Blob[22050]
chord8: Blob[11025]
for x, i in fine
  v := max(min((x * 32767.0).toInt(), 32767), -32768)
  chord16[i * 2] = v & 255
  chord16[i * 2 + 1] = (v >> 8) & 255
  chord8[i] = max(min(round(x * 127.0).toInt(), 127), -128) & 255
end

pitch := 1.0
pan := 0.0
next := 0
held := 0
last := "ADPCM"

# the synth's chord: A3, C4, E4, A4 (semitones over 65.4 Hz), each a note that fades out (effect 5),
# strummed 3 frames apart, as the samples' notes start 50 ms apart
synthPitches := [4]Int{21, 24, 28, 33}
qualityNames := [4]String{"16K", "16K SMOOTH", "24K SMOOTH", "48K SMOOTH"}
qualityRates := [4]Float{16000.0, 16000.0, 24000.0, 48000.0}
quality := 3
waveNames := [7]String{"TRIANGLE", "TILTED", "SAW", "SQUARE", "PULSE", "ORGAN", "PHASER"}
waveIds := [7]Int{0, 1, 2, 3, 4, 5, 7}
wave := 0
notes: [4]Blob[4]
synthOn: [8]Bool # (voices playing the synth: bent for pitch, not sped up)
due: [4]Int      # (frames till each note starts; -1: none)
dueVoice: [4]Int
for i in 0..<4
  due[i] = -1
end
synthNote :: proc(i: Int) # note i of the chord, on its voice
  v := dueVoice[i]
  notes[i][0] = synthPitches[i]
  notes[i][1] = waveIds[wave]
  notes[i][2] = 5 # (of 7: four voices together, not clipping)
  notes[i][3] = 5
  pc.synthRate(v, qualityRates[quality])
  pc.synthSmooth(v, min(quality, 1))
  pc.synth(v, notes[i][], 90)
  synthOn[v] = true
end

update* :: proc()
  pressed := pc.btn(4) + pc.btn(5) * 2 + pc.btn(6) * 4 + pc.btn(7) * 8 + pc.btn(8) * 16 + pc.btn(9) * 32
  k := pc.key()
  for k >= 0
    if k == 'q' or k == 'Q'
      quality = (quality + 1) % 4
    case k == 'w' or k == 'W'
      wave = (wave + 1) % 7
    end
    k = pc.key()
  end
  if pressed & 32 == 32 and held & 32 == 0
    quality = (quality + 1) % 4
  end
  if pressed & 16 == 16 and held & 16 == 0
    wave = (wave + 1) % 7
  end
  if pc.btn(0) == 1
    pitch = max(pitch * 0.99, 0.25)
  end
  if pc.btn(1) == 1
    pitch = min(pitch * 1.01, 4.0)
  end
  if pc.btn(2) == 1
    pan = max(pan - 0.02, -1.0)
  end
  if pc.btn(3) == 1
    pan = min(pan + 0.02, 1.0)
  end
  if pressed & 1 == 1 and held & 1 == 0
    synthOn[next] = false
    pc.sound(next, chord, {bits = 4, rate = 22050.0 * pitch})
    next = (next + 1) % 8
    last = "ADPCM"
  end
  if pressed & 2 == 2 and held & 2 == 0
    synthOn[next] = false
    pc.sound(next, chord16, {rate = 22050.0 * pitch})
    next = (next + 1) % 8
    last = "16-BIT"
  end
  if pressed & 4 == 4 and held & 4 == 0
    synthOn[next] = false
    pc.sound(next, chord8, {bits = 8, rate = 22050.0 * pitch})
    next = (next + 1) % 8
    last = "8-BIT"
  end
  if pressed & 8 == 8 and held & 8 == 0 # the synth's: its notes on the next four voices, strummed
    for i in 0..<4
      dueVoice[i] = next
      due[i] = i * 3
      next = (next + 1) % 8
    end
    last = "SYNTH"
  end
  for i in 0..<4
    if due[i] == 0
      synthNote(i)
    end
    if due[i] >= 0
      due[i] -= 1
    end
  end
  held = pressed
  for v in 0..<8
    if synthOn[v]
      pc.synthBend(v, 12.0 * ln(pitch) / ln(2.0))
    else
      pc.soundRate(v, 22050.0 * pitch)
    end
    pc.soundPan(v, pan)
  end
end

draw* :: proc()
  pc.cls(1)
  pc.print("CHORD: ADPCM 5590 B, 16-BIT 22050, 8-BIT 11025", 8, 8, 7)
  pc.print("V: ADPCM   C: 16-BIT   X: 8-BIT   Z: SYNTH", 8, 24, 6)
  pc.print("LEFT/RIGHT: PITCH   UP/DOWN: PAN", 8, 34, 6)
  pc.print("Q: SYNTH QUALITY", 8, 130, 6)
  pc.print(qualityNames[quality], 116, 130, 10)
  pc.print("W: SYNTH WAVE", 8, 140, 6)
  pc.print(waveNames[wave], 116, 140, 10)
  pc.print(last, 8, 110, 10)
  for k in 0..<8
    if pc.soundPlaying(k) == 1
      pc.rect(8 + k * 14, 60, 10, 10, 8 + k)
    else
      pc.rect(8 + k * 14, 60, 10, 10, 5)
    end
  end
  pc.rect(8, 80, 120, 4, 5)
  pc.rect(8 + ((pitch - 0.25) / 3.75 * 116.0).toInt(), 78, 4, 8, 10)
  pc.rect(8, 96, 120, 4, 5)
  pc.rect(66 + (pan * 58.0).toInt(), 94, 4, 8, 12)
end
