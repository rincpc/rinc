# Shapes: pc's shapes turning and drifting. F (or A) fills or outlines them, R (or B) rounds the boxes,
# T turns the whole scene (a transform), Left and Right tilt it, Up and Down more or fewer of each, Space pauses
outline := false
round := true
count := 7
paused := false
spin := false
tilt := 0.0
t := 0.0
label: Blob[..40]
star: [5][2]Float
path: pc.Path

update* :: proc()
  c := pc.key()
  for c >= 0
    k := c & 255
    if k == 'f' or k == 'F'
      outline = not outline
    case k == 'r' or k == 'R'
      round = not round
    case k == ' '
      paused = not paused
    case k == 't' or k == 'T'
      spin = not spin
    end
    c = pc.key()
  end
  if pc.btnp(.a) == 1 do outline = not outline
  if pc.btnp(.b) == 1 do round = not round
  if pc.btnp(.up) == 1 do count = min(count + 1, 24)
  if pc.btnp(.down) == 1 do count = max(count - 1, 1)
  if not paused do t += 1.0 / 60.0
  tilt += (pc.btn(.right) - pc.btn(.left)).toFloat() * 0.02 # (held: the scene tilts on, a transform under all of it)
  how := pc.Shape{outline = outline}
  pc.cls(1)
  _ = pc.transform(pc.turnedAround(tilt, {160.0, 120.0}))
  if spin # (every shape after it through the transform: turning around the screen's middle, breathing)
    _ = pc.transformBy(pc.turnedAround(t * 0.4, {160.0, 120.0}))
    _ = pc.transformBy(pc.moved({160.0, 120.0}))
    _ = pc.transformBy(pc.scaled({0.8 + sin(t) * 0.2, 0.8 + sin(t) * 0.2}))
    _ = pc.transformBy(pc.moved({-160.0, -120.0}))
  end
  for i in 0..<count
    f := i.toFloat()
    a := t * (0.6 + f * 0.13) + f * 1.7
    x := (160.0 + cos(a) * (70.0 + f * 9.0)).toInt()
    y := (112.0 + sin(a * 1.3) * (50.0 + f * 5.0)).toInt()
    s := 10 + (sin(t * 2.0 + f) * 6.0 + 6.0).toInt()
    col := 8 + i % 8
    switch i % 7
    case 0 # (a box, rounded or not)
      box := pc.Shape{outline = outline, radius = 0}
      if round do box.radius = s / 2
      pc.rect({x - s, y - s / 2}, {s * 2, s}, col, box)
    case 1 # (an ellipse, breathing)
      pc.ellipse({x - s, y - s * 2 / 3}, {s * 2, s * 4 / 3}, col, how)
    case 2 # (a triangle, turning)
      p := [2]Int{x + (cos(a * 2.0) * s.toFloat()).toInt(), y + (sin(a * 2.0) * s.toFloat()).toInt()}
      q := [2]Int{x + (cos(a * 2.0 + 2.094) * s.toFloat()).toInt(), y + (sin(a * 2.0 + 2.094) * s.toFloat()).toInt()}
      r := [2]Int{x + (cos(a * 2.0 + 4.189) * s.toFloat()).toInt(), y + (sin(a * 2.0 + 4.189) * s.toFloat()).toInt()}
      pc.triangle(p, q, r, col, how)
    case 3 # (a curve, waving, and the line under it)
      w := (sin(t * 3.0 + f) * 20.0).toInt()
      fx := x.toFloat()
      fy := y.toFloat()
      fs := s.toFloat()
      fw := w.toFloat()
      pc.curve({fx - fs * 2.0, fy}, {fx - fs, fy - 20.0 - fw}, {fx + fs, fy + 20.0 + fw}, {fx + fs * 2.0, fy}, col)
      pc.line({x - s * 2, y + s}, {x + s * 2, y + s}, col)
    case 4 # (a star, turning: a polygon crossing itself, filled through)
      for k in 0..<5
        b := a + k.toFloat() * 2.5133 # (each point two fifths of a turn on: a star)
        star[k] = {x.toFloat() + cos(b) * (s + 6).toFloat(), y.toFloat() + sin(b) * (s + 6).toFloat()}
      end
      pc.polygon(star[], col, how)
    case 5 # (a pie chart's slice, a path: to its middle, an arc, back; growing and shrinking as it turns)
      fx := x.toFloat()
      fy := y.toFloat()
      sweep := 3.2 + sin(t * 1.5 + f) * 2.8
      path.clear()
      path.move({fx, fy})
      path.arc({fx, fy}, {(s + 4).toFloat(), (s + 4).toFloat()}, a, a + sweep)
      path.close()
      path.draw(col, how)
    case 6 # (a ring, a path: a circle, and one inside it the other way round: a hole)
      fx := x.toFloat()
      fy := y.toFloat()
      r := (s + 4).toFloat()
      path.clear()
      path.arc({fx, fy}, {r, r * 0.8}, 0.0, 6.2832)
      path.close()
      path.move({fx + r * 0.5, fy}) # (the inner one's start: else a line to it from the outer one's, outlined)
      path.arc({fx, fy}, {r * 0.5, r * 0.4}, 6.2832, 0.0)
      path.close()
      path.draw(col, how)
    end
  end
  _ = pc.transform(pc.plain()) # (the words as they are: print isn't transformed yet)
  label.clear()
  fine := label.print("Shapes: ", count)
  if outline
    fine = label.pushAll(", outlined")
  else
    fine = label.pushAll(", filled")
  end
  pc.print(label.asString(), {4, 4}, 7)
  pc.print("F fill  R round  T turn  Left/Right tilt  Up/Down count", {4, 228}, 6)
end
