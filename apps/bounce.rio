# Bounce: the arrow keys tilt gravity, V adds a ball, C shakes them all. Walls go blip
Vec :: [2]Float
Ball :: struct
  pos, vel: Vec
  c: Int
end

balls: [..512]Ball
blip: Blob[1200] # a falling square wave, 8-bit, played at 22050 a second
for i in 0..<1200
  v := (1200 - i) / 30 # (a third of full scale: square waves are harsh)
  if i / 12 % 2 == 1
    v = -v
  end
  blip[i] = v & 255
end
held := false
tick := 0

add :: proc()
  n := balls.len()
  # Use n for simple variance, but always have some nonzero dx.
  _ = balls.push(Ball{pos = {160, 40}, vel = {(n % 8).toFloat() - 3.5, 0}, c = 8 + n % 8})
end
add()

update* :: proc()
  tick += 1
  # gravity, tilted by the arrows (down, gently, when none are held)
  g := Vec{(pc.btn(1) - pc.btn(0)).toFloat(), (pc.btn(3) - pc.btn(2)).toFloat() + 1} * 0.15
  if pc.btn(4) == 1 and not held
    add()
  end
  held = pc.btn(4) == 1
  lo := Vec{4, 4}
  hi := Vec{316, 236}
  for b, k in balls
    if pc.btn(5) == 1
      # Include some variance also in the shake.
      b.vel.y -= 1.0 + 0.05 * ((k % 7).toFloat() - 3.0)
    end
    b.vel += g
    b.pos += b.vel
    hit := false
    for i in 0..<2 # off a wall, each way: slower, and kept inside
      if b.pos[i] < lo[i] or b.pos[i] > hi[i]
        b.vel[i] = -b.vel[i] * 0.9
        b.pos[i] = clamp(b.pos[i], lo[i], hi[i])
        hit = hit or abs(b.vel[i]) > 0.5
      end
    end
    if hit # its own voice, pitched by color, panned by where it hit
      pc.sound(k % 8, blip, {bits = 8, rate = 16000.0 + (b.c - 8).toFloat() * 3000.0})
      pc.soundPan(k % 8, b.pos.x / 160.0 - 1.0)
    end
  end
end
draw* :: proc()
  pc.cls(0)
  for b in balls
    pc.rect(b.pos.toInt() - 4, {8, 8}, b.c)
  end
  pc.print("arrows tilt  V adds  C shakes", {4, 4}, 6)
  # Report ball count.
  report: Blob[..100]
  report.clear()
  _ = report.print("count: ", balls.len())
  pc.print(report[].asString(), {4, 13}, 6)
end
