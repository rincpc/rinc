# rinc -hold: buttons held in the frames it says, and keys (pc.keyHeld); rinc tests/hold.rio -frames 7
# -hold "b 2-3, x 4-4, space 1-2, keyq 3-3, delete 4-4, left 5-5" (Q asked for as a capital: the same key)
frame := 0
update* :: proc()
  log("frame", frame, "b", pc.btn(5), "x", pc.btn(6), "keys", pc.keyHeld(' '), pc.keyHeld('Q'), pc.keyHeld(134), pc.keyHeld(128), pc.keyHeld(300))
  frame += 1
end
