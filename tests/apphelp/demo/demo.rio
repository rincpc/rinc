# Demo: an app with help of its own, for a test
names: Blob[..4096]
text: Blob[..64]
found := pc.helps(names)
at := 0
for k in 0..<names.len()
  if names[k] == 10
    if names[at..<k].asString() == "demo/intro"
      _ = pc.helpRead("demo/intro", text)
      log("found", text.asString())
    end
    at = k + 1
  end
end
