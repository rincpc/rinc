# notice (library/notice.rio): a few words said, shown for their seconds (0.1 here: 6 frames, counted as
# it's drawn), in their box, then gone; the box the screen's bottom when none's given; in a font of its
# own (a 5x6 one, written here: two of its 7-pixel lines, a box 18 high).
# Run with -frames 12: it logs "notice came through"
import notice
said := notice.Notice{seconds = 0.1, box = pc.Rect.of({0, 0}, {100, 22})}
low := notice.Notice{} # (none given: the screen's bottom)
sheet: Blob[30 * 6] # (a font of 5 by 6 cells, 6 across: its "!" (the second) a bar 4 high)
for y in 0..<4
  sheet[y * 30 + 5 + 1] = 7
end
assert(pc.imageWrite("/save/f.png", {pixels = sheet[], size = {30, 6}}, {notes = "sprite 5x6\nfont 32 37\nacross 6\nproportional\n"}) == 0, "")
fontRoom: Blob[..(30 + 1) * 6 + 20]
small := notice.Notice{font = pc.fontRead("/save/f.png", fontRoom)}
assert(small.font.cell == {5, 6}, "its font, read")
small.say("!!!")
assert(not said.showing(), "nothing said: nothing shown")
said.say("Hello")
low.say("Low")
frame := 0
inked :: proc(at: [2]Int, size: [2]Int, c: Int) -> Bool # (any pixel of color c there)
  for y in at.y..<at.y + size.y
    for x in at.x..<at.x + size.x
      if pc.pget({x, y}) == c do return true
    end
  end
  return false
end
update* :: proc()
  frame += 1
end
draw* :: proc()
  pc.cls(1)
  said.draw()
  low.draw()
  bottom := pc.screenSize().y
  if frame == 2 # (drawn alone, over: its box 18 high, its words in its font: "!" a bar)
    pc.cls(1)
    small.draw()
    assert(pc.pget({0, bottom - 1}) == 0 and pc.pget({0, bottom - 18}) == 0 and pc.pget({0, bottom - 19}) == 1, "in a font of its own: two of its lines, 18 high")
    assert(pc.pget({2, bottom - 16}) == 7 and pc.pget({2, bottom - 13}) == 7 and pc.pget({2, bottom - 12}) == 0, "its words in it: a ! a bar 4 high (its empty columns trimmed: from x 2)")
    pc.cls(1)
    said.draw()
    low.draw()
  end
  if frame == 2
    assert(said.showing() and pc.pget({0, 0}) == 0 and inked({2, 2}, {30, 8}, 7), "said: its box (black), its words in it (white)")
    assert(pc.pget({0, bottom - 1}) == 0 and pc.pget({0, bottom - 23}) == 1 and inked({2, bottom - 20}, {20, 8}, 7), "none given: the screen's bottom, 22 high")
  end
  if frame == 10
    assert(not said.showing() and pc.pget({0, 0}) == 1 and low.showing(), "its seconds gone: not shown (the other's 4 seconds, still)")
    log("notice came through")
  end
end
