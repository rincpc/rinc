# files an exported program carries, read as storage's: its folder's own (data/), and -files' (extra/)
out: Blob[200]
text: Blob[40]
n := pc.dir("/rinc/apps/bf/data", out[])
log("data", n, out[0..<7].asString())
k := pc.fileRead("/rinc/apps/bf/data/a.txt", text[])
log("a", k > 20, text[0..<12].asString())
n = pc.dir("/rinc/apps/extra", out[])
log("extra", n, out[0..<5].asString(), out[6..<13].asString())
k = pc.fileRead("/rinc/apps/extra/sub/c.txt", text[])
log("c", k > 5, text[0..<6].asString())
log("none", pc.dir("/rinc/apps/nothing", out[]), pc.fileRead("/rinc/apps/extra/nothing.txt", text[]))
