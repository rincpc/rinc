# an app's own files, by relative path (rinc's ctest: as installed, and as a project)
pixels: Blob[..256]
image := pc.imageRead("pic.png", pixels) # (a 12 by 6 picture: 72 pixels)
none: Blob[..] = pixels[0..<0]
m := pc.fileRead("ownfiles.rio", none)
w := pc.fileWrite("x.txt", "no") # (refused: for reading only)
if image.size == {12, 6} and image.pixels.len() == 72 and m > 0 and w < 0 do log("own files read by relative path")
log(image.size, image.pixels.len(), m, w)
