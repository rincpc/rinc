# Stash: what it had stashed last time under two keys, if anything, then this time's (pc.stashRead, stashWrite,
# stashDelete); and pc.boot, counting starts
buf: Blob[16]
n := pc.stashRead("where", buf[])
if n < 0
  log("none")
else
  log(buf[0..<n].asString())
end
log(pc.stashWrite("where", "here"), pc.stashWrite("other", "x"), pc.stashDelete("other"), pc.stashRead("other", buf[]))
log(pc.stashRead("../x", buf[]), pc.boot() > 0)
