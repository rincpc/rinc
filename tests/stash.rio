# Stash: what it had stashed last time under two keys, if anything, then this time's (stash:key, by the
# file calls); and pc.boot, counting starts
buf: Blob[..16]
if pc.fileRead("stash:where", buf) < 0
  log("none")
else
  log(buf.asString())
end
log(pc.fileWrite("stash:where", "here"), pc.fileWrite("stash:other", "x"), pc.fileDelete("stash:other"), pc.fileRead("stash:other", buf))
log(pc.fileRead("stash:../x", buf), pc.boot() > 0)
