# tilemap (library/tilemap.rio): a map of before (rinc map 2) read, and written as one of now; one of now,
# with things, read and written back as it was; things looked up, found, changed, placed and taken out;
# layers added, moved, named and taken out, their cells and things kept apart; a tiles layer reshaped
# (its offset moved back), the things after it kept; sheets shared and renumbered for a wider one; what a
# map needs, and maps too big for an app refused (the map as it was). Then drawn: tests/tilemap.py checks
# the screen (and what load logged). Its sheet's at /rinc/save/t.png, and two.map, old.map, big.map and
# bad.map beside it (the test puts them)
import tilemap
E :: tilemap.EMPTY
sheetRoom: [3]tilemap.Sheet
layerRoom: [6]tilemap.Layer
room: Blob[400]
m := tilemap.Map{sheets = sheetRoom[], layers = layerRoom[], room = room[]}
text: Blob[..2000]
same :: proc(path: String, want: String) -> Bool
  text.clear()
  n := pc.fileRead(path, text)
  if text.asString() != want
    log(path, "is", text.asString())
  end
  return n == text.len() and text.asString() == want
end

# a map of before: each layer a sheet of its own (the same path and size: one), named as it's numbered
assert(m.load("/rinc/save/two.map"), "a map of before (rinc map 2), read")
assert(m.count == 2 and m.sheetCount == 1 and m.layers[1].size == {2, 1} and m.layers[1].at == {4, 16} and m.tile(0) == {8, 8} and m.sheets[0].across == 2, "its layers and their sheet")
assert(m.at(0, {1, 0}) == 1 and m.at(0, {2, 0}) == E and m.at(1, {0, 0}) == 1 and m.at(0, {5, 5}) == E, "its cells (past an edge: empty)")
assert(m.save("/rinc/save/two3.map") and same("/rinc/save/two3.map", "rinc map 3\nsheet 1 /rinc/save/t.png 8 across 2\nlayer 1 tiles1 tiles 1\nsize 3 2\noffset 0 0\n000001---\n---001000\nlayer 2 tiles2 tiles 1\nsize 2 1\noffset 4 16\n001---\n"), "written as a map of now")

# a map of now, its things layer first (its things after the cells all the same, in the room)
three := "rinc map 3\nsheet 1 /rinc/save/t.png 8 across 2\nsheet 2 /rinc/save/my sheets/b.png 8x16 across 1\nlayer 1 actors things 1\noffset 0 0\nthing 001 at 20 30 name player\nthing --- at -5 7 span 2 3\nthing 000 at 0 0 span 2 1 name door.1\nlayer 2 ground tiles 2\nsize 2 2\noffset -8 0\n000---\n---000\n"
assert(pc.fileWrite("/rinc/save/three.map", three) == 0, "")
assert(m.load("/rinc/save/three.map"), "a map of now, with things, read")
assert(m.count == 2 and m.sheetCount == 2 and m.sheetPath(1) == "/rinc/save/my sheets/b.png" and m.tile(1) == {8, 16} and m.layers[1].kind == tilemap.TILES, "its sheets (a path with a space) and layers")
assert(m.things(0) == 3 and m.things(1) == 0 and m.layerNamed("ground") == 1 and m.layerNamed("x") == -1, "its things, and its layers by name")
t := m.thing(0, 0)
assert(t.at == {20, 30} and t.sprite == 1 and t.span == {1, 1} and t.name.asString() == "player", "a thing")
t1 := m.thing(0, 1)
assert(t1.at == {-5, 7} and t1.sprite == E and t1.span == {2, 3} and t1.name.len() == 0, "a thing with no sprite, its span, no name")
assert(m.find("door.1") == {0, 2} and m.find("nope") == {-1, -1}, "found by name")
assert(m.at(1, {0, 0}) == 0 and m.at(1, {1, 0}) == E and m.at(1, {1, 1}) == 0, "its tiles layer's cells")
assert(m.used() == 4 * 2 + 3 * 10 + 7 + 7 and m.needs() == tilemap.Room{bytes = 52, sheets = 2, layers = 2}, "the room it uses: its cells, things and names")
assert(tilemap.roomIn("/rinc/save/three.map") == tilemap.Room{bytes = 52, sheets = 2, layers = 2}, "roomIn: what its file needs")
assert(tilemap.roomIn("/rinc/save/old.map").bytes == -1, "roomIn: not a map")
assert(m.save("/rinc/save/three2.map") and same("/rinc/save/three2.map", three), "written back as it was")

# things: changed (renamed: the others' names kept), taken out, placed, picked out where they're drawn
t.name.clear()
fine := t.name.pushAll("hero")
assert(m.change(0, 0, t) and m.find("hero") == {0, 0} and m.find("player") == {-1, -1} and m.find("door.1") == {0, 2}, "renamed, the others' names as they were")
assert(m.used() == 52 - 7 + 5, "its old name's room, given back")
m.takeOut(0, 1)
assert(m.things(0) == 2 and m.thing(0, 1).name.asString() == "door.1" and m.used() == 50 - 10, "taken out, those after it moved up")
assert(m.place(0, tilemap.Thing{at = {1, 2}, sprite = 0, span = {1, 1}}) and m.things(0) == 3 and m.thing(0, 2).at == {1, 2}, "placed, after the others")
assert(not m.place(1, tilemap.Thing{span = {1, 1}}), "not in a tiles layer")
assert(not m.place(0, tilemap.Thing{span = {17, 1}}), "nor one wider than 16 sprites")
assert(m.thingOver(0, {3, 3}) == 2 and m.thingOver(0, {12, 3}) == 1 and m.thingOver(0, {21, 31}) == 0 and m.thingOver(0, {100, 100}) == -1, "the one over a pixel: the last drawn of those that are")
assert(m.at(1, {0, 0}) == 0 and m.at(1, {1, 1}) == 0, "the cells, as they were")

# layers: added (a things layer, a tiles layer as big as the nearest), moved, named, taken out
assert(m.addLayer(1, tilemap.THINGS) and m.count == 3 and m.layers[2].kind == tilemap.THINGS and m.things(2) == 0, "a things layer added, last")
assert(m.place(2, tilemap.Thing{at = {9, 9}, sprite = 1, span = {1, 1}, name = t.name}) and m.find("hero") == {0, 0}, "a thing placed in it")
assert(m.addLayer(-1, tilemap.TILES) and m.count == 4 and m.layers[0].size == {2, 2} and m.at(0, {0, 0}) == E, "a tiles layer added first: as big as the one nearest, empty")
assert(m.at(2, {0, 0}) == 0 and m.thing(1, 0).name.asString() == "hero" and m.thing(3, 0).at == {9, 9}, "the others' cells and things as they were")
m.moveLayer(0, 3)
assert(m.layerNamed("ground") == 1 and m.layers[3].kind == tilemap.TILES and m.at(1, {1, 1}) == 0, "moved, last: the others down one")
assert(m.nameLayer(3, "sky") and m.layerNamed("sky") == 3 and not m.nameLayer(3, "bad name"), "named (not with a space)")
assert(m.removeLayer(0) and m.count == 3 and m.find("hero") == {1, 0} and m.at(0, {1, 1}) == 0, "the actors taken out: their things and names gone")
assert(m.used() == 4 * 2 * 2 + 10 + 5, "their room given back")
assert(m.removeLayer(2) and m.removeLayer(1) and not m.removeLayer(0), "the last one left, never")

# a tiles layer reshaped: grown left and up (its offset back), then fitted again; wider; too big
assert(m.load("/rinc/save/three.map"), "")
assert(m.reshape(1, {3, 3}, {1, 1}) and m.layers[1].size == {3, 3} and m.layers[1].at == {-16, -16}, "grown left and up: its offset back a tile (8 by 16)")
assert(m.at(1, {1, 1}) == 0 and m.at(1, {2, 2}) == 0 and m.at(1, {0, 0}) == E and m.at(1, {2, 1}) == E, "its cells moved")
assert(m.thing(0, 0).name.asString() == "player" and m.thing(0, 2).name.asString() == "door.1" and m.thing(0, 2).span == {2, 1}, "the things, after its cells, as they were")
assert(m.reshape(1, {2, 2}, {-1, -1}) and m.layers[1].at == {-8, 0} and m.at(1, {0, 0}) == 0 and m.at(1, {1, 1}) == 0 and m.at(1, {1, 0}) == E, "fitted again")
assert(m.reshape(1, {4, 2}, {0, 0}) and m.at(1, {0, 0}) == 0 and m.at(1, {1, 1}) == 0 and m.at(1, {3, 0}) == E and m.at(1, {2, 1}) == E, "wider")
assert(m.reshape(1, {1, 2}, {-1, 0}) and m.at(1, {0, 1}) == 0 and m.at(1, {0, 0}) == E, "narrower from the left")
assert(not m.reshape(1, {100, 100}, {0, 0}) and m.layers[1].size == {1, 2}, "too big for its room: as it was")
assert(m.thing(0, 1).span == {2, 3} and m.find("door.1") == {0, 2}, "the things, still")

# sheets: one shared (the other, no layer's now, gone), renumbered for a wider one
assert(m.load("/rinc/save/three.map"), "")
assert(m.setSheet(1, "/rinc/save/t.png", {8, 8}) and m.sheetCount == 1 and m.layers[1].sheet == 0, "a layer's sheet made the other's: one sheet")
assert(m.place(0, tilemap.Thing{at = {0, 0}, sprite = 2, span = {1, 1}}), "")
m.set(1, {1, 0}, 3)
assert(m.refit(0, 24) == 0 and m.thing(0, 0).sprite == 1 and m.thing(0, 3).sprite == 3 and m.at(1, {1, 0}) == 4 and m.sheets[0].across == 3, "renumbered for a sheet 3 across: each where it was")
assert(m.refit(0, 8) == 2 and m.thing(0, 0).sprite == E and m.at(1, {1, 0}) == E and m.thing(0, 3).sprite == 1, "for one 1 across: those past its edge, gone")

# load: a file too big for the app's room, or with more sheets or layers; not a map; no file; a line
# it doesn't know: each refused, the map as it was (tests/tilemap.py checks what the log says)
assert(m.load("/rinc/save/three.map"), "")
assert(not m.load("/rinc/save/none.map"), "load: no such file")
assert(not m.load("/rinc/save/big.map") and m.count == 2 and m.things(0) == 3, "load: more than its room (the map as it was)")
assert(not m.load("/rinc/save/old.map") and not m.load("/rinc/save/bad.map") and m.count == 2, "load: not a map, and a line it doesn't know")
oneRoom: [1]tilemap.Layer
one := tilemap.Map{sheets = sheetRoom[], layers = oneRoom[], room = room[]}
assert(not one.load("/rinc/save/three.map"), "load: more layers than the app's room for them")

# a new map, its sheet not picked yet (a path of none): saved and read back
assert(m.start({2, 1}, "", {8, 8}, -1) and m.save("/rinc/save/new.map") and same("/rinc/save/new.map", "rinc map 3\nsheet 1  8 across -1\nlayer 1 tiles1 tiles 1\nsize 2 1\noffset 0 0\n------\n"), "a new map, no sheet yet, saved")
assert(m.load("/rinc/save/new.map") and m.sheetPath(0) == "" and m.layers[0].size == {2, 1}, "and read back")

# a map bigger than the pieces it's read and written in (4 KB): rows of 1024 cells (3 KB of text each),
# across pieces' edges, read back as they were written
bigRoom: Blob[3 * 1024 * 2 + 100]
bigLayers: [1]tilemap.Layer
big := tilemap.Map{sheets = sheetRoom[], layers = bigLayers[], room = bigRoom[]}
assert(big.start({1024, 3}, "/rinc/save/t.png", {8, 8}, 2), "")
for x in 0..<1024
  big.set(0, {x, x % 3}, x % 4000)
end
assert(big.save("/rinc/save/wide.map"), "a map of 9 KB, saved")
big.set(0, {5, 0}, 7)
assert(big.load("/rinc/save/wide.map") and big.layers[0].size == {1024, 3}, "and read")
wideOk := big.at(0, {5, 0}) == E
for x in 0..<1024
  wideOk = wideOk and big.at(0, {x, x % 3}) == x % 4000 and big.at(0, {x, (x + 1) % 3}) == E
end
assert(wideOk, "its cells, as they were")

# drawn: tests/tilemap.py checks two.map's layer 0 at the screen's top left, layer 1 over it, 4 pixels
# right and 16 down; a missing tile (past the sheet) a box; then three.map's things at 160 across (one
# with no sprite, not drawn), and at 240, at half size
oldSheets: [2]tilemap.Sheet # (a map of before counts a sheet a layer, the same or not)
oldLayers: [2]tilemap.Layer
oldRoom: Blob[100]
old := tilemap.Map{sheets = oldSheets[], layers = oldLayers[], room = oldRoom[]}
assert(old.load("/rinc/save/two.map") and m.load("/rinc/save/three.map"), "")
old.set(0, {0, 1}, 9)
pixels: Blob[..1024] # (room for the file's rows as they come, too)
sheet := pc.imageRead("/rinc/save/t.png", pixels)
assert(sheet.size == {16, 8}, "the sheet")
draw* :: proc()
  pc.cls(1)
  old.draw(0, sheet, {0, 0}, {missing = 7})
  old.draw(1, sheet, {0, 0})
  old.draw(0, sheet, {4, 0}, {at = {0, 100}}) # (again, lower, 4 pixels on: its first tile half off the screen's left)
  m.draw(0, sheet, {0, 0}, {at = {160, 0}})
  m.draw(0, sheet, {0, 0}, {at = {240, 0}, shrink = 2})
end
log("tilemap came through")
