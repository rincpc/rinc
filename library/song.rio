# song: songs as studio's Music makes them (a .mus file, and the file of Sound's it names), for games and
# Music alike: read, played (by Rinc itself: pc.songPlay) on up to 8 of Rinc's 16 voices, and written;
# and a file's sounds, one at a time, for a game's sound effects. (The plans: studio/plans/music-
# patterns.md, rinc/plans/song-player.md.)
#
# A song has three levels: sounds (Sound's: 32 notes each, a speed, a loop); patterns, each sounds
# placed in time (a piano roll: each at a step, on a channel, at a pitch shift, a volume and a speed);
# and the song, patterns used in turn, each use with its own shift, volume and speed (shift and volume
# ramped from its start to its end), played a number of times over (the ramps across them all), and
# marks: a loop begins, a loop ends (back to where it began), the song stops; its uses in tracks (up to 8),
# each played in turn, side by side (a drum beat under the melody's patterns). Levers over the whole song
# (shift, volume, speed) are in the file and a game can change them as it plays. Rinc plays it, on its
# own, once started: each sound as Sound plays it, from its step, at its speed, a tick (1/120 s) exact.
#
# All the room is the app's, one Blob (buffer): load puts the sounds' notes there first (SOUND_BYTES a
# sound, from the first to the last the song plays), then the patterns, uses and placements, and its
# sounds' speeds and loops (load says how much a song needs when it's short, as Music shows). Or the two
# apart, notes and room (sounds alone, for a game's effects: as many as it likes from the first). Files
# are read a line at a time (twice: counting, then filling), so a game needs no room for their text.
#
#   import song
#   buffer: Blob[2000]                       (as much as Music says the song needs)
#   tune := song.Song{buffer = buffer[], voice = 4} (its voices from 4 on; 0 to 3 the game's)
#   if tune.load("tune.mus")                 (the song, and its sounds; else the log says why)
#     _ = tune.play(0, false)                (from its first use, on to its last, or its loops)
#   end
#   tune.sound(0, 2)                         (sound 2 of the song's file, once, on voice 0)
#   tune.setShift(2)                         (the whole song 2 semitones up, at once)
#   tune.pause(true)                         (held where it is; false: on again)
#   tune.tick()                              (only to show where it's playing: playUse, playPart)

PATTERNS* :: 64           # a song's, at most
USES* :: 128              # the song's row: patterns used, at most
PLACES* :: 4096           # placements, in all the patterns, at most
PER_PATTERN* :: 255       # placements in a pattern, at most
CHANNELS* :: 8            # a pattern's, each a voice from Song.voice on (a track's after the tracks' before it)
TRACKS* :: 8              # a song's uses in tracks played side by side (a use's track: its marks' bits 4 to 6)
STEPS* :: 128             # a pattern's, at most
SHIFTS* :: 48             # a shift's reach, semitones either way
LOOP_BEGINS* :: 1         # a use's flags
LOOP_ENDS* :: 2
STOPS* :: 4
SOUNDS* :: 32             # a sound file's, each of 32 notes
NOTES* :: 32
SOUND_BYTES* :: NOTES * 4 # a sound's notes, as pc.synth takes them: pitch, wave, volume, effect each
ALL_SOUNDS* :: SOUNDS * SOUND_BYTES
PATTERN_BYTES* :: 6       # the room each takes: a pattern (steps, speed, its first placement: 2 bytes, count, 0)
USE_BYTES* :: 9           # a use (pattern, shift and shift at end + 64, volume, volume at end, speed %: 2 bytes, flags, times)
TIMES* :: 99              # a use played over, at most
PLACE_BYTES* :: 8         # a placement (step, channel, sound, shift + 64, volume, speed, hold, 0)
TOP_PITCH :: 96           # the synth's highest note
VOICES :: 16              # Rinc's
LINE :: 166               # a sound's line in its file: 6 hex digits (speed, loop start, loop end), then 5 a note
TEXT* :: 64000            # a song's text, at most (Music's stash, written whole)

Song* :: struct
  buffer: static Blob     # the app's, one Blob for both (or notes and room, given apart): load puts the
                          # sounds' notes first, as many as the song plays, and the room after
  notes: Blob             # the app's: the sounds' notes, SOUND_BYTES a sound, from the first
  room: Blob              # the app's: patterns, uses, placements, then each channel's notes as it plays
  voice: Int              # the first of its voices (channel c plays on voice + c; a later track's after the
                          # channels the tracks before it play now: past its voices, dropped)
  voices: Int             # how many voices it may take, from voice on (0: 8)
  tracks: Int             # how many tracks (its uses' highest, plus one)
  patterns: Int           # how many of each
  uses: Int
  places: Int
  channels: Int           # the channels its placements use (the highest, plus one)
  usesAt: Int             # where each table starts in room
  placesAt: Int
  infoAt: Int             # then the speeds and loops of the sounds it plays, 3 bytes each (Rinc's player reads them)
  shift: Int              # the levers: semitones, eighths of its volume, percent of its speed
  volume: Int
  speed: Int
  sounds: Int             # the file's sounds read (as many as notes has room for)
  speeds: Blob[SOUNDS]    # each sound's speed (120ths of a second a note), and its loop (loopB 0: none)
  loopAs: Blob[SOUNDS]
  loopBs: Blob[SOUNDS]
  hasSounds: Bool
  soundsPath: Blob[..96]  # its file of sounds (kept, though it isn't there)
  playing: Bool
  looping: Bool           # (loop: from its start again, at its end)
  playUse: Int            # the use playing, and which time round (from 0)
  playRep: Int
  playAlone: Bool         # (just the one)
  playPart: Float         # how far into its pattern, 0 to 1 (tick keeps these as it plays)
  id: Int                 # (given as it first plays: Rinc plays one song at a time, the last started)
end
fine := true
lastId := 0               # (the Songs given ids so far)
current := 0              # (the one Rinc's playing, or played last)

hexDigit :: proc(c: Int) -> Int
  if c >= '0' and c <= '9'
    return c - '0'
  case c >= 'a' and c <= 'f'
    return c - 'a' + 10
  case c >= 'A' and c <= 'F'
    return c - 'A' + 10
  end
  return -1
end
hexAt :: proc(s: String, k: Int) -> Int do return max(hexDigit(s[k]), 0) * 16 + max(hexDigit(s[k + 1]), 0)

# ---------------------------------------------------------------- the tables, in room

Song.pat :: proc(p: Int, k: Int) -> Int do return self.room[p * PATTERN_BYTES + k]
Song.use :: proc(u: Int, k: Int) -> Int do return self.room[self.usesAt + u * USE_BYTES + k]
Song.place :: proc(i: Int, k: Int) -> Int do return self.room[self.placesAt + i * PLACE_BYTES + k]
Song.patternSteps* :: proc(p: Int) -> Int do return self.pat(p, 0)
Song.patternSpeed* :: proc(p: Int) -> Int do return self.pat(p, 1)
Song.patternFirst* :: proc(p: Int) -> Int do return self.pat(p, 2) + self.pat(p, 3) * 256 # (its first placement)
Song.patternCount* :: proc(p: Int) -> Int do return self.pat(p, 4)                     # (its placements)
Song.usePattern* :: proc(u: Int) -> Int do return self.use(u, 0)
Song.useShift* :: proc(u: Int) -> Int do return self.use(u, 1) - 64
Song.useShiftEnd* :: proc(u: Int) -> Int do return self.use(u, 2) - 64
Song.useVolume* :: proc(u: Int) -> Int do return self.use(u, 3)
Song.useVolumeEnd* :: proc(u: Int) -> Int do return self.use(u, 4)
Song.useSpeed* :: proc(u: Int) -> Int do return self.use(u, 5) + self.use(u, 6) * 256
Song.useFlags* :: proc(u: Int) -> Int do return self.use(u, 7) % 16 # (its marks: LOOP_BEGINS, LOOP_ENDS, STOPS)
Song.useTrack* :: proc(u: Int) -> Int do return self.use(u, 7) / 16 % TRACKS
Song.useTimes* :: proc(u: Int) -> Int do return max(1, self.use(u, 8)) # (played that many times over, its ramps across them all)
Song.placeStep* :: proc(i: Int) -> Int do return self.place(i, 0)
Song.placeChannel* :: proc(i: Int) -> Int do return self.place(i, 1)
Song.placeSound* :: proc(i: Int) -> Int do return self.place(i, 2)
Song.placeShift* :: proc(i: Int) -> Int do return self.place(i, 3) - 64
Song.placeVolume* :: proc(i: Int) -> Int do return self.place(i, 4)
Song.placeSpeed* :: proc(i: Int) -> Int do return self.place(i, 5)  # (0: the sound's own)
Song.placeHold* :: proc(i: Int) -> Int do return self.place(i, 6)   # (0: as long as it plays)
Song.setUseFlags* :: proc(u: Int, f: Int) do self.room[self.usesAt + u * USE_BYTES + 7] = self.useTrack(u) * 16 + f % 16
Song.setUseTrack* :: proc(u: Int, t: Int) do self.room[self.usesAt + u * USE_BYTES + 7] = max(0, min(t, TRACKS - 1)) * 16 + self.useFlags(u)

# ---------------------------------------------------------------- sounds

# a file of Sound's, read a line at a time: as many of its sounds as notes has room for; false if it
# isn't one (hasSounds false)
line: Blob[..LINE + 8]
lineEnd := 0
# the line of file p that starts at byte at, into line (to lineEnd, its break left off): where the next
# starts, or -1 (none: the file's end, or no such file)
lineAt :: proc(p: String, at: Int) -> Int
  line.clear()
  n := pc.fileReadAt(p, at, line)
  if n < 0 or at >= n
    return -1
  end
  for i in 0..<line.len()
    if line[i] == 10
      lineEnd = i
      if i > 0 and line[i - 1] == 13
        lineEnd = i - 1
      end
      return at + i + 1
    end
  end
  lineEnd = line.len() # (the last, with no break)
  return at + line.len()
end
why: Blob[..160]          # why the last load failed (it logs it)
Song.loadSounds* :: proc(p: String) -> Bool
  at := lineAt(p, 0)
  self.hasSounds = false
  self.sounds = 0
  why.clear()
  if at < 0
    _ = why.print("sounds ", p, ": no such file")
    return false
  case line[0..<lineEnd].asString() != "rinc sound 1"
    _ = why.print("sounds ", p, ": not a file of Sound's")
    return false
  end
  room := min(SOUNDS, self.notes.len() / SOUND_BYTES)
  for s in 0..<room
    at = lineAt(p, at)
    if at < 0 or lineEnd < LINE
      _ = why.print("sounds ", p, ": not a file of Sound's")
      return false
    end
    d := line[0..<LINE].asString()
    self.speeds[s] = max(1, hexAt(d, 0))
    self.loopAs[s] = min(NOTES - 1, hexAt(d, 2))
    self.loopBs[s] = min(NOTES, hexAt(d, 4))
    for n in 0..<NOTES
      j := 6 + n * 5
      k := s * SOUND_BYTES + n * 4
      self.notes[k] = min(63, hexAt(d, j))
      self.notes[k + 1] = max(hexDigit(d[j + 2]), 0) % 8
      self.notes[k + 2] = max(hexDigit(d[j + 3]), 0) % 8
      self.notes[k + 3] = max(hexDigit(d[j + 4]), 0) % 8
    end
  end
  self.sounds = room
  self.hasSounds = true
  if p != self.soundsPath.asString()
    self.soundsPath.clear()
    fine = self.soundsPath.pushAll(p)
  end
  return true
end
# how many notes sound s plays: to its loop's end, or its last note heard (0: not read)
Song.notesOf* :: proc(s: Int) -> Int
  if s < 0 or s >= self.sounds
    return 0
  end
  if self.loopBs[s] > 0
    return self.loopBs[s]
  end
  last := 0
  for n in 0..<NOTES
    if self.notes[s * SOUND_BYTES + n * 4 + 2] > 0
      last = n + 1
    end
  end
  return last
end
# the room a song's sounds need in notes: SOUND_BYTES for each, to the last one it places
Song.needs* :: proc() -> Int
  most := 0
  for i in 0..<self.places
    most = max(most, self.placeSound(i) + 1)
  end
  return most * SOUND_BYTES
end
# sound s on voice v (once, or round its loop until stopped): a game's sound effects. v -1: the first voice
# that's free (not playing, and not the song's: pc.freeVoice), none if none is
Song.sound* :: proc(v: Int, s: Int)
  n := self.notesOf(s)
  if v < 0
    v = pc.freeVoice()
  end
  if n == 0 or v < 0
    return
  end
  pc.synth(v, self.notes[s * SOUND_BYTES..<s * SOUND_BYTES + n * 4], self.speeds[s])
  if self.loopBs[s] > 0
    pc.soundLoop(v, self.loopAs[s], self.loopBs[s])
  end
end

# ---------------------------------------------------------------- playing (Rinc's: pc.songPlay)

# the song stopped, its voices fading out
Song.stop* :: proc()
  if self.playing and current == self.id # (another's playing now: not this one's to stop)
    pc.songStop()
  end
  self.playing = false
  self.looping = false
end

# ---------------------------------------------------------------- reading

# a line's numbers (and its last word, for a use's marks)
nums: [12]Int
numCount := 0
marks: Blob[..8]
readNumbers :: proc(l: String)
  numCount = 0
  marks.clear()
  k := 0
  for k < l.len()
    for k < l.len() and l[k] == ' '
      k += 1
    end
    if k >= l.len()
      break
    end
    neg := l[k] == '-'
    if l[k] == '-' or l[k] == '+'
      k += 1
    end
    if k < l.len() and l[k] >= '0' and l[k] <= '9'
      v := 0
      for k < l.len() and l[k] >= '0' and l[k] <= '9'
        v = v * 10 + l[k] - '0'
        k += 1
      end
      if numCount < 12
        nums[numCount] = v
        if neg
          nums[numCount] = -v
        end
        numCount += 1
      end
    else
      marks.clear()
      for k < l.len() and l[k] != ' '
        fine = marks.push(l[k])
        k += 1
      end
    end
  end
end
startsWith :: proc(l: String, w: String) -> Bool do return l.len() >= w.len() and l[0..<w.len()] == w

# reading's state: the file's version, its section (0 the start, 1 a pattern's placements, 2 the
# song's uses), what's been counted or filled, and the sounds' path
version := 0
section := 0
nP := 0
nU := 0
nL := 0
most := 0                 # (channels: the highest, plus one)
trackNow := 0             # (the track the uses read are in)
mostTrack := 0            # (tracks: the highest, plus one)
soundsUsed := 0           # (sounds: the highest placed, plus one)
named: Blob[..96]
filling := false
bad := false              # (a line it couldn't take)
Song.setPattern :: proc(p: Int, steps: Int, speed: Int)
  o := p * PATTERN_BYTES
  self.room[o] = max(1, min(steps, STEPS))
  self.room[o + 1] = max(1, min(speed, 255))
  self.room[o + 2] = nL % 256
  self.room[o + 3] = nL / 256
  self.room[o + 4] = 0
  self.room[o + 5] = 0
end
Song.addPlace :: proc(step, c, s, shift, vol, speed, hold: Int)
  if nP == 0 or nL >= PLACES or (filling and self.patternCount(nP - 1) >= PER_PATTERN)
    bad = true
    return
  end
  if filling
    o := self.placesAt + nL * PLACE_BYTES
    self.room[o] = max(0, min(step, STEPS - 1))
    self.room[o + 1] = max(0, min(c, CHANNELS - 1))
    self.room[o + 2] = max(0, min(s, SOUNDS - 1))
    self.room[o + 3] = max(-SHIFTS, min(shift, SHIFTS)) + 64
    self.room[o + 4] = max(0, min(vol, 8))
    self.room[o + 5] = max(0, min(speed, 255))
    self.room[o + 6] = max(0, min(hold, 255))
    self.room[o + 7] = 0
    self.room[(nP - 1) * PATTERN_BYTES + 4] = self.patternCount(nP - 1) + 1
  end
  most = max(most, max(0, min(c, CHANNELS - 1)) + 1)
  soundsUsed = max(soundsUsed, max(0, min(s, SOUNDS - 1)) + 1)
  nL += 1
end
Song.addUse :: proc(p, shift, shiftEnd, vol, volEnd, speed, times, flags: Int)
  mostTrack = max(mostTrack, trackNow + 1)
  if nU >= USES
    bad = true
    return
  end
  if filling
    o := self.usesAt + nU * USE_BYTES
    self.room[o] = max(0, p)
    self.room[o + 1] = max(-SHIFTS, min(shift, SHIFTS)) + 64
    self.room[o + 2] = max(-SHIFTS, min(shiftEnd, SHIFTS)) + 64
    self.room[o + 3] = max(0, min(vol, 8))
    self.room[o + 4] = max(0, min(volEnd, 8))
    v := max(1, min(speed, 400))
    self.room[o + 5] = v % 256
    self.room[o + 6] = v / 256
    self.room[o + 7] = trackNow * 16 + flags % 16
    self.room[o + 8] = max(1, min(times, TIMES))
  end
  nU += 1
end
flagsOf :: proc(w: String) -> Int
  f := 0
  for k in 0..<w.len()
    switch w[k]
    case 'b'
      f = f | LOOP_BEGINS
    case 'e'
      f = f | LOOP_ENDS
    case 's'
      f = f | STOPS
    end
  end
  return f
end
# a version 1 pattern's line (each of 4 channels' sound in hex, .. for none, then its marks): a pattern
# of its sounds, from step 0 at their own speeds, its step the speed of its longest, and a use of it
Song.oldLine :: proc(l: String)
  if nP >= PATTERNS
    bad = true
    return
  end
  longest := 0
  speed := 16
  steps := NOTES
  if filling # (its sounds read by now: its length)
    looping := 0
    loopSpeed := 16
    loopSteps := NOTES
    for c in 0..<4
      a := hexDigit(l[c * 3])
      b := hexDigit(l[c * 3 + 1])
      if a >= 0 and b >= 0
        s := min(a * 16 + b, SOUNDS - 1)
        ticks := self.notesOf(s) * self.speeds[min(s, SOUNDS - 1)]
        if self.notesOf(s) > 0 and self.loopBs[s] == 0 and ticks > longest
          longest = ticks
          speed = self.speeds[s]
          steps = self.notesOf(s)
        case self.notesOf(s) > 0 and self.loopBs[s] > 0 and ticks > looping
          looping = ticks
          loopSpeed = self.speeds[s]
          loopSteps = self.notesOf(s)
        end
      end
    end
    if longest == 0 and looping > 0
      speed = loopSpeed
      steps = loopSteps
    end
    self.setPattern(nP, steps, speed)
  end
  nP += 1
  for c in 0..<4
    a := hexDigit(l[c * 3])
    b := hexDigit(l[c * 3 + 1])
    if a >= 0 and b >= 0
      self.addPlace(0, c, a * 16 + b, 0, 8, 0, 0)
    end
  end
  self.addUse(nP - 1, 0, 0, 8, 8, 100, 1, flagsOf(l[12..<l.len()]))
end
# line k of a song, l: false once it shows it isn't one (its first two lines)
Song.songLine :: proc(k: Int, l: String) -> Bool
  if k == 0
    version = 0
    section = 0
    nP = 0
    nU = 0
    nL = 0
    most = 0
    soundsUsed = 0
    trackNow = 0
    mostTrack = 0
    bad = false
    if l == "rinc music 1"
      version = 1
    case l == "rinc music 2"
      version = 2
    case l == "rinc music 3"
      version = 3
    end
    if not filling
      named.clear()
      self.shift = 0
      self.volume = 8
      self.speed = 100
    end
    return version > 0
  case k == 1
    if not startsWith(l, "sounds ")
      return false
    end
    if not filling
      fine = named.pushAll(l[7..<l.len()])
    end
    return true
  case version == 1
    if l.len() >= 12
      self.oldLine(l)
    end
    return true
  case startsWith(l, "levers")
    readNumbers(l)
    if numCount >= 3
      self.shift = max(-SHIFTS, min(nums[0], SHIFTS))
      self.volume = max(0, min(nums[1], 8))
      self.speed = max(1, min(nums[2], 400))
    end
    return true
  case startsWith(l, "pattern")
    readNumbers(l)
    if nP >= PATTERNS or numCount < 2
      bad = true
      return true
    end
    if filling
      self.setPattern(nP, nums[0], nums[1])
    end
    nP += 1
    section = 1
    return true
  case startsWith(l, "song")
    section = 2
    trackNow = 0
    return true
  case startsWith(l, "track") and section == 2 # (track N: the uses after it are its, N from 1)
    readNumbers(l)
    if numCount >= 1
      trackNow = max(0, min(nums[0] - 1, TRACKS - 1))
    end
    return true
  end
  readNumbers(l)
  if section == 1 and numCount >= 7
    self.addPlace(nums[0], nums[1], nums[2], nums[3], nums[4], nums[5], nums[6])
  case section == 2 and numCount >= 6
    times := 1 # (a 7th number: how many times; before it was written, once)
    if numCount >= 7
      times = nums[6]
    end
    self.addUse(min(nums[0], max(nP - 1, 0)), nums[1], nums[2], nums[3], nums[4], nums[5], times, flagsOf(marks.asString()))
  end
  return true
end
# a file of p's name in folder (to its last /: "" for none)
besidePath: Blob[..200]
beside :: proc(folder: String, p: String) -> String
  k := p.len()
  for k > 0 and p[k - 1] != '/'
    k -= 1
  end
  besidePath.clear()
  fine = besidePath.pushAll(folder) and besidePath.pushAll(p[k..<p.len()])
  return besidePath.asString()
end
# path p from folder (to its last /), as one path: its . and .. followed
inPath: Blob[..200]
within :: proc(folder: String, p: String) -> String
  inPath.clear()
  fine = inPath.pushAll(folder)
  at := 0
  for at <= p.len()
    e := at
    for e < p.len() and p[e] != '/'
      e += 1
    end
    part := p[at..<e]
    if part == ".." # (up one: the folder before the last /)
      k := inPath.len() - 1
      for k > 0 and inPath[k - 1] != '/'
        k -= 1
      end
      for inPath.len() > max(k, 0)
        _ = inPath.pop()
      end
    case part.len() > 0 and part != "."
      fine = inPath.pushAll(part)
      if e < p.len()
        fine = inPath.push('/')
      end
    end
    at = e + 1
  end
  return inPath.asString()
end
# why it doesn't fit: the room it needs (and, given one Blob for both, the notes too: that Blob's size)
Song.short :: proc(need: Int, atLeast: String)
  if self.buffer.len() > 0
    _ = why.print("it needs buffer Blob[", self.notes.len() + need, "]", atLeast, " (has ", self.buffer.len(), ")")
  else
    _ = why.print("it needs room Blob[", need, "]", atLeast, " (has ", self.room.len(), ")")
  end
end
# after the counting pass: the tables laid out in room, and the sounds read (from the file named, or one
# of its name beside the song: in folder); false if the room's too small (why says how much)
Song.counted :: proc(folder: String) -> Bool
  why.clear()
  if nU == 0
    _ = why.print("not a song of Music's (no patterns used)")
    return false
  end
  if self.buffer.len() > 0 # (one Blob for both: the notes its sounds need, then the room)
    k := min(soundsUsed * SOUND_BYTES, self.buffer.len())
    self.notes = self.buffer[0..<k]
    self.room = self.buffer[k..<self.buffer.len()]
  end
  tables := nP * PATTERN_BYTES + nU * USE_BYTES + nL * PLACE_BYTES
  if tables > self.room.len() # (the song as it was, then)
    self.short(tables, " at least")
    return false
  end
  self.stop()
  self.uses = 0 # (from here, a song that doesn't fit is none)
  self.patterns = 0
  self.usesAt = nP * PATTERN_BYTES
  self.placesAt = self.usesAt + nU * USE_BYTES
  self.infoAt = self.placesAt + nL * PLACE_BYTES
  p := named.asString()
  full := p # (a path from the song's folder: its sounds where the song is, wherever that is)
  if p.len() > 0 and p[0] != '/' and folder.len() > 0
    full = within(folder, p)
  end
  if self.hasSounds and full == self.soundsPath.asString() and self.sounds * SOUND_BYTES >= self.notes.len() # (read already, as many: Music plays each change this way)
    return true
  end
  if full.len() > 0 and not self.loadSounds(full) and not self.loadSounds(beside(folder, p))
    self.soundsPath.clear()
    fine = self.soundsPath.pushAll(full) # (kept, though it's not there now)
  end
  return true
end
# the room a song needs: its tables, and the speeds and loops of the sounds it plays after them
Song.roomNeeds* :: proc() -> Int do return self.infoAt + self.needs() / SOUND_BYTES * 3
# its sounds' speeds and loops, after its tables, as Rinc's player reads them
Song.writeInfo :: proc()
  if self.uses == 0 or self.roomNeeds() > self.room.len()
    return
  end
  for s in 0..<self.needs() / SOUND_BYTES
    self.room[self.infoAt + s * 3] = self.speeds[s]
    self.room[self.infoAt + s * 3 + 1] = self.loopAs[s]
    self.room[self.infoAt + s * 3 + 2] = self.loopBs[s]
  end
end
# after the filling pass: its counts kept, and the room its channels' notes take; false if room's short
Song.filled :: proc() -> Bool
  self.patterns = nP
  self.uses = nU
  self.places = nL
  self.channels = most
  self.tracks = max(1, mostTrack)
  if self.roomNeeds() > self.room.len()
    why.clear()
    self.short(self.roomNeeds(), "")
    self.uses = 0
    self.patterns = 0
    return false
  end
  self.writeInfo()
  return true
end

# a song's text (Music keeps one in its stash): read into it, false if it isn't a song, or it doesn't fit
# (why says); its sounds from the file it names (hasSounds: whether they were)
# (readSongIn: for a song whose file is in folder, to its last /: a path to its sounds there from that folder)
Song.readSongIn* :: proc(t: String, folder: String) -> Bool
  self.stop()
  for pass in 0..<2
    filling = pass == 1
    at := 0
    k := 0
    for i in 0..<t.len() + 1
      if i == t.len() or t[i] == 10
        e := i
        if e > at and t[e - 1] == 13
          e -= 1
        end
        if not self.songLine(k, t[at..<e])
          why.clear()
          _ = why.print("not a song of Music's")
          return false
        end
        k += 1
        at = i + 1
      end
    end
    if k < 2 or (pass == 0 and not self.counted(folder))
      return false
    end
  end
  return self.filled()
end
Song.readSong* :: proc(t: String) -> Bool do return self.readSongIn(t, "")
# a .mus file, read a line at a time (twice), and its sounds: false if it can't be, and the log says
# why (the room it needs, say)
Song.load* :: proc(p: String) -> Bool
  self.stop()
  k := p.len()
  for k > 0 and p[k - 1] != '/'
    k -= 1
  end
  ok := true
  for pass in 0..<2
    filling = pass == 1
    at := 0
    n := 0
    for ok
      at = lineAt(p, at)
      if at < 0
        break
      end
      ok = self.songLine(n, line[0..<lineEnd].asString())
      n += 1
    end
    why.clear()
    if n == 0
      _ = why.print("no such file")
      ok = false
    case not ok or n < 2
      _ = why.print("not a song of Music's")
      ok = false
    end
    if ok and pass == 0
      ok = self.counted(p[0..<k])
    end
    if not ok
      break
    end
  end
  ok = ok and self.filled()
  if ok and not self.hasSounds
    ok = false # (why: loadSounds')
  case ok and self.needs() > self.notes.len()
    why.clear()
    _ = why.print("its sounds need notes Blob[", self.needs(), "] (has ", self.notes.len(), ")")
    ok = false
  end
  if not ok
    said: Blob[..300]
    _ = said.print(p, ": ", why.asString())
    log(said.asString())
  end
  return ok
end
# why the last load or readSong failed
Song.reason* :: proc() -> String do return why.asString()

# ---------------------------------------------------------------- writing

# the song as text (Music saves it): false if out hasn't room. A version 2 file's, with one track (so older
# Rincs read it); version 3's with more: each track's uses after its line, "track N" (the first's, "song")
Song.write* :: proc(out: Blob[..]) -> Bool
  out.clear()
  most := 1
  for u in 0..<self.uses
    most = max(most, self.useTrack(u) + 1)
  end
  ok := out.print("rinc music ", 2 + (most > 1).toInt(), "\nsounds ", self.soundsPath.asString(), "\nlevers ", self.shift, " ", self.volume, " ", self.speed, "\n")
  for p in 0..<self.patterns
    ok = ok and out.print("pattern ", self.patternSteps(p), " ", self.patternSpeed(p), "\n")
    for i in self.patternFirst(p)..<self.patternFirst(p) + self.patternCount(p)
      ok = ok and out.print(self.placeStep(i), " ", self.placeChannel(i), " ", self.placeSound(i), " ", self.placeShift(i), " ", self.placeVolume(i), " ", self.placeSpeed(i), " ", self.placeHold(i), "\n")
    end
  end
  ok = ok and out.pushAll("song\n")
  for k in 0..<most * self.uses
    t := k / max(1, self.uses)
    u := k % max(1, self.uses)
    if u == 0 and t > 0
      ok = ok and out.print("track ", t + 1, "\n")
    end
    if self.useTrack(u) != t
      continue
    end
    ok = ok and out.print(self.usePattern(u), " ", self.useShift(u), " ", self.useShiftEnd(u), " ", self.useVolume(u), " ", self.useVolumeEnd(u), " ", self.useSpeed(u), " ", self.useTimes(u), " ")
    f := self.useFlags(u)
    if f == 0
      ok = ok and out.pushAll("-")
    end
    if f & LOOP_BEGINS != 0
      ok = ok and out.pushAll("b")
    end
    if f & LOOP_ENDS != 0
      ok = ok and out.pushAll("e")
    end
    if f & STOPS != 0
      ok = ok and out.pushAll("s")
    end
    ok = ok and out.pushAll("\n")
  end
  return ok
end

# ---------------------------------------------------------------- playing

# use u's length, in seconds: its pattern's steps at its speed, its use's and the song's
Song.lengthOf* :: proc(u: Int) -> Float
  p := self.usePattern(u)
  pct := self.useSpeed(u) * self.speed / 100
  return (self.patternSteps(p) * self.patternSpeed(p)).toFloat() * 100.0 / max(pct, 1).toFloat() / 120.0
end
# the song from use from on, played by Rinc (pc.songPlay), how it says (1 just that use, 2 round again at
# its end): false with nothing to play
Song.start :: proc(from: Int, how: Int) -> Bool
  if not self.hasSounds or from < 0 or from >= self.uses
    return false
  end
  self.writeInfo()
  if self.id == 0
    lastId += 1
    self.id = lastId
  end
  current = self.id
  pc.songLevers(self.shift, self.volume, self.speed)
  pc.songPlay(self.voice, self.room, self.notes, self.patterns, self.uses, from, how + max(0, min(self.voices, 255)) * 256)
  self.playing = true
  self.playAlone = how & 1 != 0
  self.looping = how & 2 != 0
  self.playUse = from
  self.playRep = 0
  self.playPart = 0.0
  return true
end
# the song from use from on (alone: just that one): false with nothing to play
Song.play* :: proc(from: Int, alone: Bool) -> Bool do return self.start(from, alone.toInt())
# the song, round and round: from its start again when it ends (until stop, or a use that stops it); given
# a path, read first (load: tune.loop("tune.mus"))
Song.loop* :: proc(path?: String) -> Bool
  if path.len() > 0 and not self.load(path)
    return false
  end
  return self.start(0, 2)
end
# where it's playing, into playing, playUse, playRep and playPart (Music's playhead): only for showing
# it, since Rinc plays the song on its own
Song.tick* :: proc()
  at := pc.songAt()
  self.playing = at[0] >= 0 and current == self.id # (another started since: this one's stopped)
  if self.playing
    self.playUse = at[0]
    self.playRep = at[1]
    self.playPart = at[2].toFloat() / 1000.0
  else
    self.looping = false
  end
end
# held where it is (its voices silent), or on again
Song.pause* :: proc(on: Bool)
  if current == self.id do pc.songPause(on.toInt())
end
# the levers, as it plays: shift and volume at once, speed from its next placements
Song.setShift* :: proc(semitones: Int)
  self.shift = max(-SHIFTS, min(semitones, SHIFTS))
  if current == self.id do pc.songLevers(self.shift, self.volume, self.speed)
end
Song.setVolume* :: proc(eighths: Int)
  self.volume = max(0, min(eighths, 8))
  if current == self.id do pc.songLevers(self.shift, self.volume, self.speed)
end
Song.setSpeed* :: proc(percent: Int)
  self.speed = max(1, min(percent, 400))
  if current == self.id do pc.songLevers(self.shift, self.volume, self.speed)
end
