# song: songs as studio's Music makes them (a .mus file, and the file of Sound's it names), for games and
# Music alike: read, and played on 4 of Rinc's 8 voices, a pattern after another; and a file's sounds,
# one at a time, for a game's sound effects.
#
# The sounds' notes are in the app's own Blob, 128 bytes a sound (SOUND_BYTES): as many of the file's
# sounds as it has room for are read, from the first, so a game with a few sounds keeps a few. Music
# shows the room a song needs (its top right), Sound a file's. Files are read a line at a time: a game
# needs no room for their text.
#
#   import song
#   notes: Blob[4 * song.SOUND_BYTES]        (sounds 0 to 3; song.ALL_SOUNDS for all 32)
#   tune := song.Song{notes = notes[], voice = 4} (its voices: 4 to 7; 0 to 3 the game's own)
#   if tune.load("tune.mus")                 (the song, and its sounds; else the log says why)
#     _ = tune.play(0, false)                (from its first pattern, on to its last, or its loops)
#   end
#   update* :: proc()
#     tune.tick()                            (each frame: on to the next pattern when one's done)
#     tune.sound(0, 2)                       (sound 2 of the song's file, once, on voice 0)
#   end
#
# A song is up to 64 patterns, played in turn; a pattern plays up to 4 of the sound file's 32 sounds at
# once, one on each channel, and lasts as long as the longest that doesn't loop. A pattern can start a
# loop (LOOP_BEGINS), end one (LOOP_ENDS: back to where it started) or stop the song (STOPS). The files:
# studio's music/help/README and sound/help/README.

PATTERNS* :: 64           # a song's, at most
CHANNELS* :: 4            # a pattern's
SILENT* :: 255            # a channel with no sound
LOOP_BEGINS* :: 1         # a pattern's flags
LOOP_ENDS* :: 2
STOPS* :: 4
SOUNDS* :: 32             # a sound file's, each of 32 notes
NOTES* :: 32
SOUND_BYTES* :: NOTES * 4 # a sound's notes, as pc.synth takes them: pitch, wave, volume, effect each
ALL_SOUNDS* :: SOUNDS * SOUND_BYTES
LINE :: 166               # a sound's line in its file: 6 hex digits (speed, loop start, loop end), then 5 a note
TEXT* :: 1300             # a song's text, at most: 64 patterns and their flags

Song* :: struct
  notes: Blob             # the app's: the sounds' notes, SOUND_BYTES a sound, from the first
  voice: Int              # the first of the 4 voices it plays on
  chans: Blob[PATTERNS * CHANNELS] # each pattern's sound on each channel (SILENT: none)
  flags: Blob[PATTERNS]
  count: Int              # patterns
  sounds: Int             # the file's sounds read (as many as notes has room for)
  speeds: Blob[SOUNDS]    # each sound's speed (120ths of a second a note), and its loop (loopB 0: none)
  loopAs: Blob[SOUNDS]
  loopBs: Blob[SOUNDS]
  hasSounds: Bool
  soundsPath: Blob[..96]  # its file of sounds (kept, though it isn't there)
  playing: Bool
  playRow: Int            # the pattern playing
  playAlone: Bool         # (just the one pattern)
  patternAt: Float        # when it started (pc.time)
  patternLasts: Float     # and how long it plays
end
fine := true

hexDigit :: proc(c: Int) -> Int
  if c >= '0' and c <= '9'
    return c - '0'
  case c >= 'a' and c <= 'f'
    return c - 'a' + 10
  case c >= 'A' and c <= 'F'
    return c - 'A' + 10
  end
  return -1
end
hexAt :: proc(s: String, k: Int) -> Int do return max(hexDigit(s[k]), 0) * 16 + max(hexDigit(s[k + 1]), 0)

# ---------------------------------------------------------------- reading, a line at a time

line: Blob[..LINE + 8]
lineEnd := 0
# the line of file p that starts at byte at, into line (to lineEnd, its break left off): where the next
# starts, or -1 (none: the file's end, or no such file)
lineAt :: proc(p: String, at: Int) -> Int
  line.clear()
  n := pc.fileReadAt(p, at, line)
  if n < 0 or at >= n
    return -1
  end
  for i in 0..<line.len()
    if line[i] == 10
      lineEnd = i
      if i > 0 and line[i - 1] == 13
        lineEnd = i - 1
      end
      return at + i + 1
    end
  end
  lineEnd = line.len() # (the last, with no break)
  return at + line.len()
end
why: Blob[..160]          # why the last load failed (it logs it)
# a file of Sound's, read a line at a time: as many of its sounds as notes has room for; false if it
# isn't one (hasSounds false)
Song.loadSounds* :: proc(p: String) -> Bool
  at := lineAt(p, 0)
  self.hasSounds = false
  self.sounds = 0
  why.clear()
  if at < 0
    _ = why.print("sounds ", p, ": no such file")
    return false
  case line[0..<lineEnd].asString() != "rinc sound 1"
    _ = why.print("sounds ", p, ": not a file of Sound's")
    return false
  end
  room := min(SOUNDS, self.notes.len() / SOUND_BYTES)
  for s in 0..<room
    at = lineAt(p, at)
    if at < 0 or lineEnd < LINE
      _ = why.print("sounds ", p, ": not a file of Sound's")
      return false
    end
    d := line[0..<LINE].asString()
    self.speeds[s] = max(1, hexAt(d, 0))
    self.loopAs[s] = min(NOTES - 1, hexAt(d, 2))
    self.loopBs[s] = min(NOTES, hexAt(d, 4))
    for n in 0..<NOTES
      j := 6 + n * 5
      k := s * SOUND_BYTES + n * 4
      self.notes[k] = min(63, hexAt(d, j))
      self.notes[k + 1] = max(hexDigit(d[j + 2]), 0) % 8
      self.notes[k + 2] = max(hexDigit(d[j + 3]), 0) % 8
      self.notes[k + 3] = max(hexDigit(d[j + 4]), 0) % 8
    end
  end
  self.sounds = room
  self.hasSounds = true
  if p != self.soundsPath.asString()
    self.soundsPath.clear()
    fine = self.soundsPath.pushAll(p)
  end
  return true
end
# how many notes sound s plays: to its loop's end, or its last note heard (0: not read)
Song.notesOf* :: proc(s: Int) -> Int
  if s < 0 or s >= self.sounds
    return 0
  end
  if self.loopBs[s] > 0
    return self.loopBs[s]
  end
  last := 0
  for n in 0..<NOTES
    if self.notes[s * SOUND_BYTES + n * 4 + 2] > 0
      last = n + 1
    end
  end
  return last
end
# the room a song's sounds need: SOUND_BYTES for each, to the last one its patterns play
Song.needs* :: proc() -> Int
  most := 0
  for i in 0..<self.count * CHANNELS
    if self.chans[i] < SOUNDS
      most = max(most, self.chans[i] + 1)
    end
  end
  return most * SOUND_BYTES
end
# sound s on voice v (once, or round its loop until stopped)
Song.sound* :: proc(v: Int, s: Int)
  n := self.notesOf(s)
  if n == 0
    return
  end
  pc.synth(v, self.notes[s * SOUND_BYTES..<s * SOUND_BYTES + n * 4], self.speeds[s])
  if self.loopBs[s] > 0
    pc.soundLoop(v, self.loopAs[s], self.loopBs[s])
  end
end

# ---------------------------------------------------------------- songs

# a song's lines, in order: line k, l, read into it; false if it shows it isn't a song (its first two
# lines). named: the sounds line's path; pending: the patterns read
named: Blob[..96]
pending := 0
ended := false            # (a line that isn't a pattern: the patterns' end)
Song.songLine :: proc(k: Int, l: String) -> Bool
  if k == 0
    pending = 0
    ended = false
    named.clear()
    return l == "rinc music 1"
  case k == 1
    if l.len() < 7 or l[0..<7] != "sounds "
      return false
    end
    fine = named.pushAll(l[7..<l.len()])
    return true
  case ended or pending >= PATTERNS or l.len() < 12
    ended = true
    return true
  end
  n := pending
  for c in 0..<CHANNELS
    a := hexDigit(l[c * 3])
    b := hexDigit(l[c * 3 + 1])
    self.chans[n * CHANNELS + c] = SILENT
    if a >= 0 and b >= 0
      self.chans[n * CHANNELS + c] = min(a * 16 + b, SOUNDS - 1)
    end
  end
  self.flags[n] = 0
  for j in 12..<l.len()
    switch l[j]
    case 'b'
      self.flags[n] = self.flags[n] | LOOP_BEGINS
    case 'e'
      self.flags[n] = self.flags[n] | LOOP_ENDS
    case 's'
      self.flags[n] = self.flags[n] | STOPS
    end
  end
  pending += 1
  return true
end
# a file of p's name in folder (to its last /: "" for none)
besidePath: Blob[..200]
beside :: proc(folder: String, p: String) -> String
  k := p.len()
  for k > 0 and p[k - 1] != '/'
    k -= 1
  end
  besidePath.clear()
  fine = besidePath.pushAll(folder) and besidePath.pushAll(p[k..<p.len()])
  return besidePath.asString()
end
# once its lines are read: its patterns counted, and its sounds read from the file named, or one of its
# name beside the song (in folder: a game's song and sounds, together in its folder); false with none
Song.songEnd :: proc(folder: String) -> Bool
  if pending == 0
    why.clear()
    _ = why.print("not a song of Music's")
    return false
  end
  self.count = pending
  p := named.asString()
  if p.len() > 0 and not self.loadSounds(p) and not self.loadSounds(beside(folder, p))
    self.soundsPath.clear()
    fine = self.soundsPath.pushAll(p) # (kept, though it's not there now)
  end
  return true
end
# a song's text (Music keeps one in its stash): read into it, false if it isn't a song (and the song's as
# it was); its sounds from the file it names (hasSounds: whether they were)
Song.readSong* :: proc(t: String) -> Bool
  at := 0
  k := 0
  for i in 0..<t.len() + 1
    if i == t.len() or t[i] == 10
      e := i
      if e > at and t[e - 1] == 13
        e -= 1
      end
      if not self.songLine(k, t[at..<e])
        return false
      end
      k += 1
      at = i + 1
    end
  end
  return k >= 2 and self.songEnd("")
end

# pattern p's length, in seconds: its longest sound that doesn't loop (all looping: the longest, once
# round; none: as long as a sound at speed 16)
Song.lengthOf* :: proc(p: Int) -> Float
  most := 0
  looping := 0
  for c in 0..<CHANNELS
    s := self.chans[p * CHANNELS + c]
    if self.notesOf(s) > 0
      ticks := self.notesOf(s) * self.speeds[s]
      if self.loopBs[s] > 0
        looping = max(looping, ticks)
      else
        most = max(most, ticks)
      end
    end
  end
  if most == 0
    most = looping
  end
  if most == 0
    most = NOTES * 16
  end
  return most.toFloat() / 120.0
end
Song.startPattern :: proc(p: Int)
  self.playRow = p
  self.patternAt = pc.time()
  self.patternLasts = self.lengthOf(p)
  for c in 0..<CHANNELS
    s := self.chans[p * CHANNELS + c]
    if self.notesOf(s) > 0
      self.sound(self.voice + c, s)
    else
      pc.soundStop(self.voice + c)
    end
  end
end
# the song from pattern from on (alone: just that one): false with no sounds to play
Song.play* :: proc(from: Int, alone: Bool) -> Bool
  if not self.hasSounds or from < 0 or from >= self.count
    return false
  end
  self.playing = true
  self.playAlone = alone
  self.startPattern(from)
  return true
end
Song.stop* :: proc()
  if self.playing
    for c in 0..<CHANNELS
      pc.soundStop(self.voice + c)
    end
  end
  self.playing = false
end
# each frame: on to the next pattern when one's done (back to its loop's start, after one that ends it;
# stopped after the last, or one that stops it)
Song.tick* :: proc()
  if not self.playing or pc.time() - self.patternAt < self.patternLasts
    return
  end
  p := self.playRow
  if self.playAlone or self.flags[p] & STOPS != 0 or (self.flags[p] & LOOP_ENDS == 0 and p + 1 >= self.count)
    self.stop()
    return
  end
  if self.flags[p] & LOOP_ENDS != 0
    for p > 0 and self.flags[p] & LOOP_BEGINS == 0
      p -= 1
    end
    self.startPattern(p)
    return
  end
  self.startPattern(p + 1)
end
# a .mus file, read a line at a time, and its sounds: false if it can't be, and the log says why (the
# room its sounds need, say)
Song.load* :: proc(p: String) -> Bool
  self.stop()
  k := p.len()
  for k > 0 and p[k - 1] != '/'
    k -= 1
  end
  ok := true
  at := 0
  n := 0
  for ok
    at = lineAt(p, at)
    if at < 0
      break
    end
    ok = self.songLine(n, line[0..<lineEnd].asString())
    n += 1
  end
  why.clear()
  if n == 0
    _ = why.print("no such file")
  case not ok or n < 2
    _ = why.print("not a song of Music's")
  end
  ok = ok and n >= 2 and self.songEnd(p[0..<k])
  if ok and not self.hasSounds
    ok = false # (why: loadSounds')
  case ok and self.needs() > self.notes.len()
    why.clear()
    _ = why.print("its sounds need notes Blob[", self.needs(), "] (has ", self.notes.len(), ")")
    ok = false
  end
  if not ok
    said: Blob[..300]
    _ = said.print(p, ": ", why.asString())
    log(said.asString())
  end
  return ok
end
