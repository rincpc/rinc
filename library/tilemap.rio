# tilemap: tile maps as Rinc keeps them (a .map file, as studio's Maps makes them), for games and
# editors alike: read and written (a piece at a time, so a map's text needn't fit in memory), looked
# up and changed, and drawn.
#
# It keeps nothing of a map's own. A map's bytes (its cells, 2 bytes each; its things, 10 each; and
# their names) are in the app's own Blob, its room, as big as the app likes, and its sheets and layers
# in the library's own arrays (4 and 8: for one map at a time), or the app's: so an app sizes its maps as
# it likes, and reads each new level into the same room. Each sheet's picture is the app's too: it reads it (pc.imageRead) and passes it to draw.
#
#   room: Blob[12000]                        (as Maps' top bar says, at least)
#   level := tilemap.Map{room = room[]}      (its sheets and layers: the library's own, 4 and 8; or the
#                                             app's, sheets = sheetRoom[], layers = layerRoom[], for more)
#   if level.load("/save/maps/level1.map") (else the log says why: room it needs, say)
#     pixels: Blob[..(128 + 1) * 128]        (a 128 by 128 sheet of the palette's: pc.imageRead says)
#     sheet := pc.imageRead(level.sheetPath(0), pixels)
#     level.draw(0, sheet, camera)           (each frame: layer 0, the map's pixel camera at the top left)
#   end
#
# A layer is its name, its kind and its sheet: a TILES layer, a grid of cells, each a sprite of its
# sheet by its place there, {column, row} (from {0, 0}; {-1, -1} for none: an empty cell), and its offset (where its first cell is, in the
# map's pixels); a THINGS layer, a list of things placed anywhere (pixels from its offset), each a sprite
# or a rectangle of them (its span), or none ({-1, -1}: a trigger, a start), with a name if a game looks for
# it. The file: rinc/docs/spec/maps.md. Its own room: work, 4 KB, to read and write files through (an
# app's to use between its calls).

NO_TILE* :: 65535         # a cell with no tile, packed (as cell gives it); a thing with no sprite. A tile
                          # is a sprite's place in its sheet, {column, row}, kept in a cell's 2 bytes as
                          # column + row * 256 (packed): sheets up to 256 sprites across and down, the
                          # last of them all ({255, 255}) none. So a sheet grown or shrunk across never
                          # moves a map's tiles
MOST_SIDE* :: 1024        # a tiles layer's width or height, at most
TILES* :: 0               # a layer's kinds
THINGS* :: 1
NAME_MOST* :: 15          # a name's bytes, at most
SPAN_MOST* :: 16          # a thing's sprites across or down, at most
THING :: 10               # a thing's bytes in the room: x, y (2 each, signed), its sprite (2), its span
                          # less 1 (a byte: 4 bits across, 4 down), a byte kept for later, its name (2:
                          # how far from the room's end it is, 0 for none)

Sheet* :: struct
  path: Blob[..96]
  sprite: [2]Int          # its sprites' size, in pixels
  at: Int                 # read (readSheets): its pixels, from here in the map's pixels
  size: [2]Int            # and its picture's size ({0, 0}: not read)
  flagsAt: Int            # then its sprites' flags, a byte each (flagCount of them), from here
  flagCount: Int
end
Layer* :: struct
  name: Blob[..15]
  kind: Int               # TILES or THINGS
  sheet: Int              # its sheet: which of the map's (from 0)
  at: [2]Int              # its offset: where its first cell is, or where its things count from, in pixels
  size: [2]Int            # TILES: in cells, across and down
  start: Int              # TILES: its first cell, in the room's cells; THINGS: its first thing, in its things
  count: Int              # THINGS: how many
end
Thing* :: struct          # a thing, as thing gives it (in the room, it's packed)
  at: [2]Int              # pixels, from its layer's offset
  sprite: [2]Int          # its top-left sprite, {column, row} in its sheet ({-1, -1}: none)
  span: [2]Int            # sprites across and down ({1, 1}: one)
  name: Blob[..15]        # "" for none: a copy, so it stays good as the map changes
end
Room* :: struct           # what a map needs: its room's bytes, and its sheets and layers (-1: not a map)
  bytes: Int
  sheets: Int
  layers: Int
end
Map* :: struct
  sheets: []Sheet         # the app's: as many as it has room for (none given: the library's own, 4)
  sheetCount: Int
  layers: []Layer         # the app's, as many as it has room for (none given: the library's own, 8)
  count: Int              # layers
  room: Blob              # the app's: the cells (from the start), then the things, and the names (at its end)
  cells: Int              # in all its tiles layers
  thingCount: Int         # things, in all its things layers
  names: Int              # their bytes, at the room's end
  pixels: Blob[..]        # the app's, if it gives one: its sheets' pictures and flags, read as it loads (readSheets)
end

# the library's own sheets and layers, for a map given none (a game's one map, each level read into it):
# 4 sheets, 8 layers, for one such map at a time (a second map needs arrays of its own)
ownSheets: [4]Sheet
ownLayers: [8]Layer
Map.own :: proc()
  if self.sheets.len() == 0 do self.sheets = ownSheets[]
  if self.layers.len() == 0 do self.layers = ownLayers[]
end

# ---------------------------------------------------------------- cells

# the room's bytes it uses: what a Blob for it needs to be, at least (with its sheets and layers: needs)
Map.used* :: proc() -> Int do return self.cells * 2 + self.thingCount * THING + self.names
Map.needs* :: proc() -> Room do return Room{bytes = self.used(), sheets = self.sheetCount, layers = self.count}
Map.inside* :: proc(layer: Int, p: [2]Int) -> Bool
  l := &self.layers[layer]
  return l.kind == TILES and p.x >= 0 and p.y >= 0 and p.x < l.size.x and p.y < l.size.y
end
# a tile, {column, row}, packed as a cell keeps it (NO_TILE: none, or past 255 either way)
packed* :: proc(t: [2]Int) -> Int
  if t.x < 0 or t.y < 0 or t.x > 255 or t.y > 255
    return NO_TILE
  end
  return t.x + t.y * 256
end
# a cell's packed tile, as {column, row} ({-1, -1}: none)
unpacked* :: proc(c: Int) -> [2]Int
  if c < 0 or c >= NO_TILE
    return {-1, -1}
  end
  return {c % 256, c / 256}
end
# for editors: a cell's tile packed (column + row * 256; NO_TILE past its edges), and set so
Map.cell* :: proc(layer: Int, p: [2]Int) -> Int
  if not self.inside(layer, p)
    return NO_TILE
  end
  l := &self.layers[layer]
  return self.room.getInt((l.start + p.y * l.size.x + p.x) * 2, 16)
end
Map.setCell* :: proc(layer: Int, p: [2]Int, c: Int)
  if self.inside(layer, p)
    l := &self.layers[layer]
    self.room.setInt((l.start + p.y * l.size.x + p.x) * 2, 16, c)
  end
end
# the tile at cell p of a tiles layer, {column, row} in its sheet ({-1, -1}: empty, or past its edges)
Map.at* :: proc(layer: Int, p: [2]Int) -> [2]Int do return unpacked(self.cell(layer, p))
# whether cell p of a tiles layer has a tile (not past its edges)
Map.filled* :: proc(layer: Int, p: [2]Int) -> Bool do return self.cell(layer, p) != NO_TILE
# tile t, {column, row}, at cell p of a tiles layer (nothing, past its edges; {-1, -1}: empty)
Map.set* :: proc(layer: Int, p: [2]Int, t: [2]Int) do self.setCell(layer, p, packed(t))
# cell p of a tiles layer, emptied
Map.clear* :: proc(layer: Int, p: [2]Int) do self.setCell(layer, p, NO_TILE)
# n cells from byte at on, empty (doubling: a cell, then two, four...)
Map.empty :: proc(at: Int, n: Int)
  if n < 1
    return
  end
  self.room.setInt(at, 16, NO_TILE)
  done := 1
  for done < n
    k := min(done, n - done)
    self.room.pack(at + done * 2, self.room[at..<at + k * 2])
    done += k
  end
end
# the room's bytes from at on (to the things' end) moved by d (on: room made; back: those before, gone)
Map.slide :: proc(at: Int, d: Int)
  e := self.cells * 2 + self.thingCount * THING
  if at < e
    self.room.pack(at + d, self.room[at..<e])
  end
end
# its sheet's sprites' size (8 by 8, with none)
Map.tile* :: proc(layer: Int) -> [2]Int
  s := self.layers[layer].sheet
  if s < 0 or s >= self.sheetCount
    return {8, 8}
  end
  return self.sheets[s].sprite
end
Map.sheetPath* :: proc(layer: Int) -> String
  s := self.layers[layer].sheet
  if s < 0 or s >= self.sheetCount
    return ""
  end
  return self.sheets[s].path.asString()
end
# each sheet's picture and its sprites' flags, read into pixels, one after another (load does it, for a map
# given pixels): false if one couldn't be read, or there's no room (the log says how much it needs)
Map.readSheets* :: proc() -> Bool
  self.pixels.clear()
  ok := true
  for s in 0..<self.sheetCount
    sh := &self.sheets[s]
    sh.at = self.pixels.len()
    image := pc.imageRead(sh.path.asString(), self.pixels, {bytes = true}) # (a byte a pixel: its tiles read as they're drawn)
    sh.size = image.size
    sh.flagsAt = self.pixels.len()
    sh.flagCount = 0
    if image.pixels.len() == 0 # (not a picture, or no room for it)
      sh.size = {0, 0}
      ok = false
    case pc.imageSpriteFlags(sh.path.asString(), sh.sprite.x, sh.sprite.y, self.pixels) >= 0
      sh.flagCount = self.pixels.len() - sh.flagsAt
    else
      ok = false # (no room for its flags)
    end
  end
  return ok
end
# a flag's bit, by its name in the layer's sheet (as Paint names them): 0 if it has none of that name
Map.flag* :: proc(layer: Int, name: String) -> Int do return pc.imageFlag(self.sheetPath(layer), name)
# the flags of the tile at cell p of a tiles layer (from its sheet, as readSheets read it): 0 for an empty
# cell, or one past the edges
Map.flagsAt* :: proc(layer: Int, p: [2]Int) -> Int
  t := self.at(layer, p)
  s := self.layers[layer].sheet
  if t.x < 0 or s < 0 or s >= self.sheetCount
    return 0
  end
  sh := &self.sheets[s]
  a := sh.size.x / max(1, sh.sprite.x) # (its flags: a byte a sprite, across its rows as it is now)
  n := t.y * a + t.x
  if t.x >= a or n >= sh.flagCount
    return 0
  end
  return self.pixels[sh.flagsAt + n]
end
# sprite t's top left in a layer's sheet, in pixels
Map.spriteAt* :: proc(layer: Int, t: [2]Int) -> [2]Int do return t * self.tile(layer)
# sprite t, {column, row}, of a layer's sheet (the map's own, as readSheets read it), drawn with its top left at p
Map.sprite* :: proc(layer: Int, t: [2]Int, p: [2]Int)
  s := self.layers[layer].sheet
  if s < 0 or s >= self.sheetCount or self.sheets[s].size.x == 0
    return
  end
  sh := &self.sheets[s]
  if t.x < 0
    return
  end
  pc.blit(pc.Image{pixels = self.pixels[sh.at..<sh.at + sh.size.x * sh.size.y], size = sh.size}, p, {from = self.spriteAt(layer, t), size = self.tile(layer)})
end

# ---------------------------------------------------------------- sheets

# where a things layer's thing j is, in the room's bytes
Map.thingAt :: proc(layer: Int, j: Int) -> Int do return self.cells * 2 + (self.layers[layer].start + j) * THING
# the sheet at path, its sprites sprite big: its number in the map's list, added if it isn't there, or -1
# if there's no room for another
Map.sheetFor* :: proc(path: String, sprite: [2]Int) -> Int
  for i in 0..<self.sheetCount
    if self.sheets[i].sprite == sprite and self.sheets[i].path.asString() == path
      return i
    end
  end
  if self.sheetCount >= self.sheets.len() or path.len() > 96
    return -1
  end
  s := &self.sheets[self.sheetCount]
  s.path.clear()
  fine := s.path.pushAll(path)
  s.sprite = sprite
  self.sheetCount += 1
  return self.sheetCount - 1
end
# the sheets no layer has, taken out of the list (the layers' numbers for theirs, kept right)
Map.tidySheets :: proc()
  i := 0
  for i < self.sheetCount
    used := false
    for j in 0..<self.count
      used = used or self.layers[j].sheet == i
    end
    if used
      i += 1
      continue
    end
    for k in i + 1..<self.sheetCount
      self.sheets[k - 1] = self.sheets[k]
    end
    self.sheetCount -= 1
    for j in 0..<self.count
      if self.layers[j].sheet > i
        self.layers[j].sheet -= 1
      end
    end
  end
end
# a layer's sheet, made path, its sprites sprite big: its tiles kept as they are ({column, row} in it).
# False if there's no room for another sheet (and it's as it was)
Map.setSheet* :: proc(layer: Int, path: String, sprite: [2]Int) -> Bool
  k := self.sheetFor(path, sprite)
  if k < 0
    return false
  end
  self.layers[layer].sheet = k
  self.tidySheets()
  return true
end

# ---------------------------------------------------------------- names

# whether s is a name: 1 to 15 letters, digits, _, - and .
nameOk* :: proc(s: String) -> Bool
  if s.len() < 1 or s.len() > NAME_MOST
    return false
  end
  for c in s
    if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-' or c == '.')
      return false
    end
  end
  return true
end
# a name kept at the names' bottom: how far it is from the room's end (0: "", or no room)
Map.addName :: proc(s: String) -> Int
  if s.len() == 0 or self.used() + s.len() + 1 > self.room.len()
    return 0
  end
  p := self.room.len() - self.names - s.len() - 1
  self.room[p] = s.len()
  self.room.pack(p + 1, s)
  self.names += s.len() + 1
  return self.room.len() - p
end
# the name ref is, gone: those under it moved up, and the things with them told
Map.dropName :: proc(ref: Int)
  if ref == 0
    return
  end
  p := self.room.len() - ref
  n := self.room[p] + 1
  base := self.room.len() - self.names
  self.room.pack(base + n, self.room[base..<p])
  self.names -= n
  for j in 0..<self.thingCount
    k := self.cells * 2 + j * THING + 8
    r := self.room.getInt(k, 16)
    if r > ref
      self.room.setInt(k, 16, r - n)
    end
  end
end
Map.nameAt :: proc(ref: Int) -> String
  if ref == 0
    return ""
  end
  p := self.room.len() - ref
  return self.room[p + 1..<p + 1 + self.room[p]].asString()
end
# a layer named so (-1: none)
Map.layerNamed* :: proc(name: String) -> Int
  for i in 0..<self.count
    if self.layers[i].name.asString() == name
      return i
    end
  end
  return -1
end
Map.nameLayer* :: proc(layer: Int, name: String) -> Bool
  if not nameOk(name)
    return false
  end
  self.layers[layer].name.clear()
  return self.layers[layer].name.pushAll(name)
end

# ---------------------------------------------------------------- things

Map.things* :: proc(layer: Int) -> Int
  if self.layers[layer].kind != THINGS
    return 0
  end
  return self.layers[layer].count
end
# a things layer's thing j, unpacked
Map.thing* :: proc(layer: Int, j: Int) -> Thing
  k := self.thingAt(layer, j)
  s := self.room[k + 6]
  t := Thing{at = {self.room.getInt(k, -16), self.room.getInt(k + 2, -16)}, sprite = unpacked(self.room.getInt(k + 4, 16)), span = {s / 16 + 1, s % 16 + 1}}
  fine := t.name.pushAll(self.nameAt(self.room.getInt(k + 8, 16)))
  return t
end
thingFits :: proc(t: Thing) -> Bool
  return t.at.x >= -32768 and t.at.x <= 32767 and t.at.y >= -32768 and t.at.y <= 32767 and (t.sprite == {-1, -1} or packed(t.sprite) != NO_TILE) and
    t.span.x >= 1 and t.span.y >= 1 and t.span.x <= SPAN_MOST and t.span.y <= SPAN_MOST and (t.name.len() == 0 or nameOk(t.name.asString()))
end
# thing j's bytes, as t (its name: ref)
Map.pack :: proc(k: Int, t: Thing, ref: Int)
  self.room.setInt(k, 16, t.at.x)
  self.room.setInt(k + 2, 16, t.at.y)
  self.room.setInt(k + 4, 16, packed(t.sprite))
  self.room[k + 6] = (t.span.x - 1) * 16 + t.span.y - 1
  self.room[k + 7] = 0
  self.room.setInt(k + 8, 16, ref)
end
# t placed in a things layer as its thing j, drawn after those before it (the ones from j on, one later):
# false if there's no room (or it's no thing, or j's past its last)
Map.placeAt* :: proc(layer: Int, j: Int, t: Thing) -> Bool
  l := &self.layers[layer]
  if l.kind != THINGS or j < 0 or j > l.count or not thingFits(t) or self.used() + THING + t.name.len() + (t.name.len() > 0).toInt() > self.room.len()
    return false
  end
  ref := self.addName(t.name.asString())
  at := self.thingAt(layer, j)
  self.slide(at, THING)
  e := l.start + l.count
  for i in 0..<self.count
    if i != layer and self.layers[i].kind == THINGS and self.layers[i].start >= e
      self.layers[i].start += 1
    end
  end
  self.thingCount += 1
  l.count += 1
  self.pack(at, t, ref)
  return true
end
# t placed in a things layer, after its others (drawn over them): false if there's no room (or it's no thing)
Map.place* :: proc(layer: Int, t: Thing) -> Bool do return self.placeAt(layer, self.things(layer), t)
# a things layer's thing j, made t: false if there's no room for its name (or it's no thing)
Map.change* :: proc(layer: Int, j: Int, t: Thing) -> Bool
  if not thingFits(t)
    return false
  end
  k := self.thingAt(layer, j)
  ref := self.room.getInt(k + 8, 16)
  if self.nameAt(ref) != t.name.asString()
    gone := 0
    if ref > 0
      gone = self.room[self.room.len() - ref] + 1
    end
    if self.used() - gone + t.name.len() + (t.name.len() > 0).toInt() > self.room.len()
      return false
    end
    self.dropName(ref)
    ref = self.addName(t.name.asString())
    if t.name.len() > 0 and ref == 0
      return false
    end
  end
  self.pack(k, t, ref)
  return true
end
# a things layer's thing j, taken out
Map.takeOut* :: proc(layer: Int, j: Int)
  l := &self.layers[layer]
  self.dropName(self.room.getInt(self.thingAt(layer, j) + 8, 16))
  at := self.thingAt(layer, j)
  self.slide(at + THING, -THING)
  e := l.start + j
  for i in 0..<self.count
    if i != layer and self.layers[i].kind == THINGS and self.layers[i].start > e
      self.layers[i].start -= 1
    end
  end
  self.thingCount -= 1
  l.count -= 1
end
# the thing of a things layer over the map's pixel p, the last drawn of those that are (-1: none)
Map.thingOver* :: proc(layer: Int, p: [2]Int) -> Int
  ts := self.tile(layer)
  j := self.things(layer)
  for j > 0
    j -= 1
    t := self.thing(layer, j)
    a := self.layers[layer].at + t.at
    b := a + t.span * ts
    if p.x >= a.x and p.y >= a.y and p.x < b.x and p.y < b.y
      return j
    end
  end
  return -1
end
# the first thing named so: its layer and its number ({-1, -1}: none)
Map.find* :: proc(name: String) -> [2]Int
  for i in 0..<self.count
    for j in 0..<self.things(i)
      if self.nameAt(self.room.getInt(self.thingAt(i, j) + 8, 16)) == name
        return {i, j}
      end
    end
  end
  return {-1, -1}
end

# ---------------------------------------------------------------- drawing

# a divided by b, rounded down (not toward 0)
fdiv :: proc(a: Int, b: Int) -> Int
  q := a / b
  if a % b != 0 and (a < 0) != (b < 0)
    q -= 1
  end
  return q
end
# the thing of a things layer whose top left is in cell p (in its tiles, from its offset): nil for none
Map.thingIn* :: proc(layer: Int, p: [2]Int) -> ?Thing
  ts := self.tile(layer)
  for j in 0..<self.things(layer)
    t := self.thing(layer, j)
    if {fdiv(t.at.x, ts.x), fdiv(t.at.y, ts.y)} == p
      return t
    end
  end
  return nil
end
# how a layer's drawn (each left out: as it says)
Drawing* :: struct
  sheet: pc.Image # the sheet to draw from (left out: the map's own, as readSheets read it)
  at: [2]Int      # the screen's box it's drawn in: its top left
  size: [2]Int    # and its size (0: to the screen's edge)
  shrink: Int     # 2, 4: a pixel of every so many (an editor's view of big tiles; 0: 1)
  missing: Int    # a tile past the sheet's sprites: a box of this color (0: none)
end
# a rectangle of a sheet's pixels (from, size) at p, a pixel of every k, those past the sheet left out
shrunk :: proc(sheet: pc.Image, from: [2]Int, size: [2]Int, p: [2]Int, k: Int)
  for v in 0..<size.y / k
    if from.y + v * k < sheet.size.y
      for u in 0..<size.x / k
        if from.x + u * k < sheet.size.x
          c := sheet.pixels[(from.y + v * k) * sheet.size.x + from.x + u * k]
          if c != 0
            pc.pset(p + {u, v}, c)
          end
        end
      end
    end
  end
end
# a layer from its sheet, the map's pixel camera at the top left of the box it's drawn in: a tiles
# layer's tiles; a things layer's things, in order (one with no sprite isn't drawn)
Map.drawWith :: proc(layer: Int, sheet: pc.Image, camera: [2]Int, how: &Drawing)
  l := &self.layers[layer]
  at := how.at
  box := how.size
  if box.x == 0
    box = pc.screenSize() - at
  end
  missing := how.missing
  k := max(1, how.shrink)
  ts := self.tile(layer)
  a := sheet.size.x / max(1, ts.x) # (its sprites across and down: one past them, missing)
  d := sheet.size.y / max(1, ts.y)
  corner := at + {fdiv(l.at.x - camera.x, k), fdiv(l.at.y - camera.y, k)}
  if l.kind == THINGS
    for j in 0..<l.count
      q := self.thingAt(layer, j)
      t := self.room.getInt(q + 4, 16)
      s := self.room[q + 6]
      size := {s / 16 + 1, s % 16 + 1} * ts
      p := corner + {fdiv(self.room.getInt(q, -16), k), fdiv(self.room.getInt(q + 2, -16), k)}
      if t == NO_TILE or p.x >= at.x + box.x or p.y >= at.y + box.y or p.x + size.x / k <= at.x or p.y + size.y / k <= at.y
        continue
      end
      if t % 256 >= a or t / 256 >= d
        if missing != 0
          pc.rect(p, max(size / k - 1, {1, 1}), missing)
        end
      case k == 1
        from := {t % 256, t / 256} * ts
        pc.blit(sheet, p, {from = from, size = min(size, sheet.size - from)})
      else
        shrunk(sheet, {t % 256, t / 256} * ts, size, p, k)
      end
    end
    return
  end
  cell := max(ts / k, {1, 1}) # (a cell as shown)
  lo := max({0, 0}, {fdiv(camera.x - l.at.x, ts.x), fdiv(camera.y - l.at.y, ts.y)})
  far := camera + box * k - l.at
  hi := min(l.size, {fdiv(far.x, ts.x), fdiv(far.y, ts.y)} + 1)
  for y in lo.y..<hi.y
    k2 := (l.start + y * l.size.x + lo.x) * 2
    for x in lo.x..<hi.x
      t := self.room.getInt(k2, 16)
      k2 += 2
      if t != NO_TILE
        p := corner + {x, y} * cell
        if t % 256 >= a or t / 256 >= d
          if missing != 0
            pc.rect(p, max(cell - 1, {1, 1}), missing)
          end
        case k == 1
          pc.blit(sheet, p, {from = {t % 256, t / 256} * ts, size = ts})
        else
          shrunk(sheet, {t % 256, t / 256} * ts, ts, p, k)
        end
      end
    end
  end
end
Map.draw* :: proc(layer: Int, camera: [2]Int, how?: Drawing)
  if how.sheet.size.x > 0
    self.drawWith(layer, how.sheet, camera, &how)
    return
  end
  s := self.layers[layer].sheet
  if s < 0 or s >= self.sheetCount or self.sheets[s].size.x == 0
    return
  end
  sh := &self.sheets[s]
  self.drawWith(layer, pc.Image{pixels = self.pixels[sh.at..<sh.at + sh.size.x * sh.size.y], size = sh.size}, camera, &how)
end

# ---------------------------------------------------------------- layers: their shape, added, taken out, moved

# a tiles layer's cells (w across, from cell base), the rows' cells moved d (right and down; left and up,
# negative): those moved in from past its edges, empty
Map.shiftCells :: proc(base: Int, w: Int, h: Int, d: [2]Int)
  if d.x == 0 and d.y == 0
    return
  end
  for r in 0..<h
    y := r
    if d.y > 0 # (moving down: the bottom row first, so none's written over before it's moved)
      y = h - 1 - r
    end
    row := (base + y * w) * 2
    sy := y - d.y
    if sy < 0 or sy >= h
      self.empty(row, w)
      continue
    end
    x0 := max(0, d.x)
    x1 := min(w, w + d.x)
    if x1 > x0
      self.room.pack(row + x0 * 2, self.room[(base + sy * w + x0 - d.x) * 2..<(base + sy * w + x1 - d.x) * 2])
    end
    self.empty(row, max(0, min(w, x0)))
    self.empty(row + max(0, x1) * 2, w - max(0, x1))
  end
end
# a tiles layer made size, its cells moved shift (right and down; left and up, negative), what's past its
# new edges gone, its offset moved back as far (so the rest stay where they were on the map). False if
# it doesn't fit (and it's as it was)
Map.reshape* :: proc(layer: Int, size: [2]Int, shift: [2]Int) -> Bool
  l := &self.layers[layer]
  old := l.size
  more := size.x * size.y - old.x * old.y
  if l.kind != TILES or size.x < 1 or size.y < 1 or size.x > MOST_SIDE or size.y > MOST_SIDE or self.used() + more * 2 > self.room.len()
    return false
  end
  base := l.start
  big := max(old.x * old.y, size.x * size.y)
  if more > 0 # (its room, made: those after it moved on)
    self.slide((base + old.x * old.y) * 2, more * 2)
    for i in 0..<self.count
      if i != layer and self.layers[i].kind == TILES and self.layers[i].start > base
        self.layers[i].start += more
      end
    end
    self.cells += more
  end
  # moved back first (in its old shape), then its new shape (rows from the top left), then moved on
  self.shiftCells(base, old.x, old.y, min({0, 0}, shift))
  w := min(old.x, size.x)
  if size.x > old.x # (rows wider: the last first)
    y := min(old.y, size.y)
    for y > 0
      y -= 1
      self.room.pack((base + y * size.x) * 2, self.room[(base + y * old.x) * 2..<(base + y * old.x + w) * 2])
      self.empty((base + y * size.x + w) * 2, size.x - w)
    end
  case size.x < old.x
    for y in 0..<min(old.y, size.y)
      self.room.pack((base + y * size.x) * 2, self.room[(base + y * old.x) * 2..<(base + y * old.x + w) * 2])
    end
  end
  if size.y > old.y
    self.empty((base + old.y * size.x) * 2, (size.y - old.y) * size.x)
  end
  self.shiftCells(base, size.x, size.y, max({0, 0}, shift))
  if more < 0 # (its room, given back)
    self.slide((base + big) * 2, more * 2)
    for i in 0..<self.count
      if i != layer and self.layers[i].kind == TILES and self.layers[i].start > base
        self.layers[i].start += more
      end
    end
    self.cells += more
  end
  l.size = size
  l.at -= shift * self.tile(layer)
  return true
end
layerName :: proc(kind: Int, n: Int, out: Blob[..])
  out.clear()
  if kind == TILES
    _ = out.print("tiles", n)
  else
    _ = out.print("things", n)
  end
end
# a new layer of kind after one (-1: first), with its sheet: a tiles layer as big as the nearest tiles
# layer (after's, or before or after it) and where it is, empty (or size, if it's given); a things
# layer, with none. False if there's no room
Map.addLayer* :: proc(after: Int, kind: Int, size?: [2]Int) -> Bool
  if self.count == 0 or self.count >= self.layers.len()
    return false
  end
  like := max(after, 0)
  n := Layer{kind = kind, sheet = self.layers[like].sheet, at = self.layers[like].at, start = self.thingCount}
  if kind == TILES
    t := -1
    for i in 0..<self.count # (the nearest tiles layer: its size, and where it is)
      if self.layers[i].kind == TILES and (t < 0 or abs(i - like) < abs(t - like))
        t = i
      end
    end
    n.size = {32, 16}
    if t >= 0
      n.size = self.layers[t].size
      n.at = self.layers[t].at
    end
    if size.x > 0 and size.y > 0
      n.size = min(size, {MOST_SIDE, MOST_SIDE})
    end
    if self.used() + n.size.x * n.size.y * 2 > self.room.len()
      return false
    end
    n.start = self.cells # (its cells after all the others: the things moved on)
    self.slide(self.cells * 2, n.size.x * n.size.y * 2)
    self.empty(self.cells * 2, n.size.x * n.size.y)
    self.cells += n.size.x * n.size.y
  end
  layerName(kind, self.count + 1, n.name)
  j := self.count
  for j > after + 1
    self.layers[j] = self.layers[j - 1]
    j -= 1
  end
  self.layers[after + 1] = n
  self.count += 1
  return true
end
# a layer taken out (the last one left, never): false if it wasn't
Map.removeLayer* :: proc(layer: Int) -> Bool
  if self.count < 2 or layer < 0 or layer >= self.count
    return false
  end
  l := self.layers[layer]
  if l.kind == TILES
    n := l.size.x * l.size.y
    self.slide((l.start + n) * 2, -n * 2)
    self.cells -= n
    for i in 0..<self.count
      if self.layers[i].kind == TILES and self.layers[i].start > l.start
        self.layers[i].start -= n
      end
    end
  else
    for j in 0..<l.count
      self.dropName(self.room.getInt(self.thingAt(layer, j) + 8, 16))
    end
    self.slide(self.thingAt(layer, l.count), -l.count * THING)
    self.thingCount -= l.count
    for i in 0..<self.count
      if self.layers[i].kind == THINGS and self.layers[i].start > l.start
        self.layers[i].start -= l.count
      end
    end
  end
  for j in layer + 1..<self.count
    self.layers[j - 1] = self.layers[j]
  end
  self.count -= 1
  self.tidySheets()
  return true
end
# a layer moved to be number to (drawn over those before it)
Map.moveLayer* :: proc(layer: Int, to: Int)
  if layer < 0 or layer >= self.count or to < 0 or to >= self.count
    return
  end
  l := self.layers[layer]
  j := layer
  for j < to
    self.layers[j] = self.layers[j + 1]
    j += 1
  end
  for j > to
    self.layers[j] = self.layers[j - 1]
    j -= 1
  end
  self.layers[to] = l
end
# a new map: one tiles layer of size, all empty, from the sheet at path (its sprites sprite big). False if
# there's no room
Map.start* :: proc(size: [2]Int, path: String, sprite: [2]Int) -> Bool
  self.own()
  if size.x * size.y * 2 > self.room.len() or self.layers.len() < 1 or self.sheets.len() < 1
    return false
  end
  self.sheetCount = 0
  self.cells = size.x * size.y
  self.thingCount = 0
  self.names = 0
  self.count = 1
  self.layers[0] = Layer{kind = TILES, sheet = self.sheetFor(path, sprite), size = size}
  layerName(TILES, 1, self.layers[0].name)
  self.empty(0, self.cells)
  return true
end

# ---------------------------------------------------------------- its file: read and written a piece at a time

# "rinc map 4", then its sheets, then each layer, as rinc/docs/spec/maps.md says. Maps of before read
# too, and write as one of now: "rinc map 3" (tiles numbered across their sheet's rows, its across on its
# sheet's line: made {column, row} as they're read) and "rinc map 2" (each layer its own sheet)
hexDigits := "0123456789abcdef"
hexOf: Blob[256]           # each byte's hex digit's value; 16 for -, 255 for the rest (a row's cells, read)
for c in 0..<256
  hexOf[c] = 255
end
for c in 0..<10
  hexOf['0' + c] = c
end
for c in 0..<6
  hexOf['a' + c] = 10 + c
  hexOf['A' + c] = 10 + c
end
hexOf['-'] = 16
digit :: proc(c: Int) -> Int
  if c >= '0' and c <= '9'
    return c - '0'
  case c >= 'a' and c <= 'f'
    return c - 'a' + 10
  case c >= 'A' and c <= 'F'
    return c - 'A' + 10
  end
  return -1
end
# a tile numbered as maps of before numbered it (across its sheet's rows, a sprites across; 3 hex digits,
# --- for none), packed as {column, row}
oldTile :: proc(t: Int, a: Int) -> Int
  if t < 0 or t >= 4095
    return NO_TILE
  end
  w := a
  if w < 1
    w = 16 # (no word of its width: PICO-8's, 16 across, as Maps took it)
  end
  return packed({t % w, t / w})
end
acrossRead: [64]Int # (maps of before: each sheet's across, as read, to make its tiles {column, row})
startsWith :: proc(t: String, s: String) -> Bool do return t.len() >= s.len() and t[0..<s.len()] == s
# the k-th number in s (from 0), a minus before it or not: 0 if there's none
numberIn :: proc(s: String, k: Int) -> Int
  n := -1
  v := 0
  minus := false
  inside := false
  for i in 0..<s.len() + 1
    c := 32
    if i < s.len()
      c = s[i]
    end
    if c >= '0' and c <= '9'
      if not inside
        inside = true
        n += 1
        v = 0
        minus = i > 0 and s[i - 1] == '-'
      end
      v = v * 10 + c - '0'
    case inside
      inside = false
      if n == k
        if minus
          return -v
        end
        return v
      end
    end
  end
  return 0
end
# "8" or "8x16": {0, 0} if it isn't one (each 4 to 64)
sizeIn* :: proc(s: String) -> [2]Int
  a := 0
  b := -1
  for c in s
    if c >= '0' and c <= '9'
      if b < 0
        a = a * 10 + c - '0'
      else
        b = b * 10 + c - '0'
      end
    case c == 'x' and b < 0
      b = 0
    else
      return {0, 0}
    end
  end
  if b < 0
    b = a
  end
  if a < 4 or a > 64 or b < 4 or b > 64
    return {0, 0}
  end
  return {a, b}
end
# a sheet's sprites' size, as Paint's notes in it say ("sprite 8x16"), else 8 by 8
notes: Blob[..64]
notedSize* :: proc(path: String) -> [2]Int
  notes.clear()
  _ = pc.imageNotes(path, notes)
  if notes.len() > 7 and notes[0..<7].asString() == "sprite "
    e := 7
    for e < notes.len() and notes[e] != 10 and notes[e] != 32
      e += 1
    end
    s := sizeIn(notes[7..<e].asString())
    if s.x > 0
      return s
    end
  end
  return {8, 8}
end
# the word s has from byte at on (to the next space or its end)
wordAt :: proc(s: String, at: Int) -> String
  e := at
  for e < s.len() and s[e] != 32
    e += 1
  end
  return s[min(at, s.len())..<e]
end
# where the k-th word starts in s (from 0): its length if there's none
wordStart :: proc(s: String, k: Int) -> Int
  at := 0
  for n in 0..<k
    for at < s.len() and s[at] != 32
      at += 1
    end
    for at < s.len() and s[at] == 32
      at += 1
    end
  end
  return at
end

# where it's read from, or written to: a file or the stash, through work, a piece at a time
FROM_FILE :: 0
FROM_STASH :: 1
WORK* :: 4224             # (a card's reads and writes cost most: fewer, bigger ones; a row of 1024 cells, 4 KB and its newline, fits)
# the room it reads and writes files through: an app's to use as it likes between its calls (none of them
# leaves anything in it), as Maps keeps its undo's steps there. A line read is in it, whole: the longest a
# map's file has (a row of 1024 cells) fits
work*: Blob[WORK]
ioLen := 0                # work's bytes: read (from ioPos on, not taken yet), or written (not on the card yet)
ioAt := 0                 # where work's first byte is in the file
ioPos := 0                # the next byte to read, in work
ioKind := FROM_FILE
ioName: Blob[..96]
ioBad := false            # a read or write that failed
ioWhole := false          # the whole file in work (read again: no reading)
lineFrom := 0             # the line read last: work's bytes from lineFrom to lineTo
lineTo := 0
lineNo := 0
lineText :: proc() -> String do return work[lineFrom..<lineTo].asString()
# more of the file into work, after what's not taken yet (moved to its start): false if none came (its end)
more :: proc() -> Bool
  if ioWhole # (all of it read already: no more, and no reading to find that out)
    return false
  end
  keep := ioLen - ioPos
  if ioPos > 0 and keep > 0
    work.pack(0, work[ioPos..<ioLen])
  end
  ioAt += ioPos
  ioPos = 0
  ioLen = keep
  into: Blob[..] = work[ioLen..<WORK]
  n := 0
  if ioKind == FROM_FILE
    n = pc.fileReadAt(ioName.asString(), ioAt + ioLen, into)
  else
    n = pc.stashReadAt(ioName.asString(), ioAt + ioLen, into)
  end
  ioBad = ioBad or n < 0
  ioWhole = ioAt == 0 and ioLen == 0 and n == into.len()
  ioLen += into.len()
  return into.len() > 0
end
# the line read: work's bytes from ioPos to e (without a CR before its line break), the next from next
lineEnds :: proc(e: Int, next: Int) -> Bool
  lineFrom = ioPos
  lineTo = e
  if lineTo > lineFrom and work[lineTo - 1] == 13
    lineTo -= 1
  end
  ioPos = next
  return true
end
# the next line, whole in work (lineText; without its line break): false at the file's end, or a line too
# long for work
nextLine :: proc() -> Bool
  lineNo += 1
  e := ioPos
  for true
    for e < ioLen and work[e] != 10
      e += 1
    end
    if e < ioLen # (its line break)
      return lineEnds(e, e + 1)
    end
    if ioPos == 0 and ioLen == WORK # (work full, and no line break: too long)
      ioBad = true
      return false
    end
    seen := e - ioPos
    if not more()
      if ioPos < ioLen # (the file's end: a last line, without a line break)
        return lineEnds(ioLen, ioLen)
      end
      return false
    end
    e = seen # (more moved what wasn't taken to work's start)
  end
  return false
end
# a file to read or write from its start (again: the one read before, read again; from work, if it's all there)
openIo :: proc(kind: Int, name: String, again: Bool)
  if not (again and ioWhole and ioAt == 0)
    ioLen = 0
    ioWhole = false
  end
  ioKind = kind
  ioName.clear()
  fine := ioName.pushAll(name)
  ioAt = 0
  ioPos = 0
  ioBad = false
  lineNo = 0
end
flushIo :: proc()
  n := 0
  if ioKind == FROM_FILE and ioAt == 0
    n = pc.fileWrite(ioName.asString(), work[0..<ioLen].asString())
  case ioKind == FROM_FILE
    n = pc.fileWriteAt(ioName.asString(), ioAt, work[0..<ioLen].asString())
  case ioAt == 0
    n = pc.stashWrite(ioName.asString(), work[0..<ioLen].asString())
  else
    n = pc.stashWriteAt(ioName.asString(), ioAt, work[0..<ioLen].asString())
  end
  ioBad = ioBad or n < 0
  ioAt += ioLen
  ioLen = 0
end
# s, written after what's written so far (work, onto the file as it fills)
put :: proc(s: String)
  if ioLen + s.len() > WORK
    flushIo()
  end
  if s.len() > WORK
    ioBad = true
    return
  end
  work.pack(ioLen, s)
  ioLen += s.len()
end

why: Blob[..200]          # why the last read failed (load logs it)
fails :: proc(s: String) -> Bool
  why.clear()
  _ = why.print(s, " (line ", lineNo, ")")
  return false
end
# ---------------------------------------------------------------- paths: each map an island
# A map's file names its sheets by paths from its own folder (written so; read so, and from there made
# whole for the app: sheetPath's); an older map's whole paths are read as they are.
pathText: Blob[..200]
folderOf :: proc(p: String) -> String
  k := p.len()
  for k > 0 and p[k - 1] != '/'
    k -= 1
  end
  return p[0..<k]
end
# path p from folder (to its last /), as one path: its . and .. followed
within :: proc(folder: String, p: String) -> String
  pathText.clear()
  fine := pathText.pushAll(folder)
  at := 0
  for at <= p.len()
    e := at
    for e < p.len() and p[e] != '/'
      e += 1
    end
    part := p[at..<e]
    if part == ".." # (up one: the folder before the last /)
      k := pathText.len() - 1
      for k > 0 and pathText[k - 1] != '/'
        k -= 1
      end
      for pathText.len() > max(k, 0)
        _ = pathText.pop()
      end
    case part.len() > 0 and part != "."
      fine = pathText.pushAll(part)
      if e < p.len()
        fine = pathText.push('/')
      end
    end
    at = e + 1
  end
  return pathText.asString()
end
# target, a path from folder: up (..) as far as they part, then down (a whole path, from no folder)
relativeTo :: proc(folder: String, target: String) -> String
  if folder.len() == 0 or target.len() == 0 or target[0] != '/'
    return target
  end
  same := 0
  for k in 0..<min(folder.len(), target.len())
    if folder[k] != target[k]
      break
    end
    if folder[k] == '/'
      same = k + 1
    end
  end
  pathText.clear()
  fine := true
  for k in same..<folder.len()
    if folder[k] == '/'
      fine = pathText.pushAll("../")
    end
  end
  fine = pathText.pushAll(target[same..<target.len()])
  return pathText.asString()
end
mapFolder: Blob[..200]    # the folder of the map file being read (none: a stash's), and being written
writeFolder: Blob[..200]
# a sheet's path as the file has it, made whole from the map's folder (a whole one, as it is)
fromFile :: proc(p: String) -> String
  if mapFolder.len() == 0 or p.len() == 0 or p[0] == '/'
    return p
  end
  return within(mapFolder.asString(), p)
end

# a map's text read, keep false: whether it is one, and what it needs (room); keep: into the map
need := Room{}
Map.readAs :: proc(keep: Bool) -> Bool
  need = Room{bytes = 0, sheets = 0, layers = 0}
  if not nextLine()
    return fails("no first line")
  end
  version := 0
  if lineText() == "rinc map 4"
    version = 4
  case lineText() == "rinc map 3"
    version = 3
  case lineText() == "rinc map 2"
    version = 2
  else
    return fails("not a map (its first line isn't rinc map 4)")
  end
  cellChars := 4 # (a cell's characters in a row)
  if version < 4
    cellChars = 3
  end
  kind := -1      # the layer read last's (-1: none yet)
  w := 0
  h := 0
  rows := 0
  if keep
    self.sheetCount = 0
    self.count = 0
    self.cells = 0
    self.thingCount = 0
    self.names = 0
  end
  for nextLine()
    s := lineText()
    if s.len() == 0
      continue
    end
    if startsWith(s, "sheet ") and version >= 3
      # sheet N path SIZE (rinc map 3: then across A; its path may have spaces: its size from its end)
      a := s.len()
      for a > 0 and s[a - 1] != 32
        a -= 1
      end
      e := s.len()
      if version == 3
        e = a - 8 # (" across " before it)
        if e < 7 or s[e..<a] != " across "
          return fails("a sheet's line without across")
        end
      end
      z := e
      for z > 0 and s[z - 1] != 32
        z -= 1
      end
      sprite := sizeIn(s[z..<e])
      p := wordStart(s, 1) + wordAt(s, wordStart(s, 1)).len() + 1 # (its path, after one space: none, for a map with no sheet yet)
      if numberIn(s, 0) != need.sheets + 1 or sprite.x == 0 or z - 1 < p
        return fails("a sheet's line, not as it should be")
      end
      need.sheets += 1
      if keep
        if self.sheetFor(fromFile(s[p..<z - 1]), sprite) != self.sheetCount - 1
          return fails("a sheet listed twice")
        end
        if version == 3 and self.sheetCount <= 64
          acrossRead[self.sheetCount - 1] = numberIn(s[a..<s.len()], 0)
        end
      end
    case startsWith(s, "layer ")
      if kind == TILES and rows < h
        return fails("a layer with too few rows")
      end
      need.layers += 1
      w = 0
      h = 0
      rows = 0
      kind = TILES
      if version >= 3
        k := wordAt(s, wordStart(s, 3))
        if k == "things"
          kind = THINGS
        case k != "tiles"
          return fails("a layer neither tiles nor things")
        end
        if not nameOk(wordAt(s, wordStart(s, 2))) or numberIn(wordAt(s, wordStart(s, 4)), 0) < 1 or numberIn(wordAt(s, wordStart(s, 4)), 0) > need.sheets
          return fails("a layer's line, not as it should be")
        end
      else
        need.sheets += 1 # (each layer of before has a sheet of its own)
      end
      if keep
        if self.count >= self.layers.len()
          return fails("more layers than the app has room for")
        end
        l := &self.layers[self.count]
        l.kind = kind
        l.sheet = -1
        l.at = {0, 0}
        l.size = {0, 0}
        l.start = self.cells
        l.count = 0
        l.name.clear()
        if version >= 3
          fine := l.name.pushAll(wordAt(s, wordStart(s, 2)))
          l.sheet = numberIn(wordAt(s, wordStart(s, 4)), 0) - 1
        else
          layerName(TILES, self.count + 1, l.name)
        end
        if kind == THINGS
          l.start = self.thingCount
        end
        self.count += 1
      end
    case kind < 0
      return fails("a line before its first layer")
    case startsWith(s, "tiles ") and version == 2
      a := s.len() # (its path, then its tiles' size, after the last space)
      for a > 6 and s[a - 1] != 32
        a -= 1
      end
      if keep
        sprite := sizeIn(s[a..<s.len()])
        if sprite.x == 0
          sprite = {8, 8}
        end
        sh := self.sheetFor(fromFile(s[6..<max(a - 1, 6)]), sprite)
        self.layers[self.count - 1].sheet = sh
        if sh >= 0 and sh < 64 and sh == self.sheetCount - 1
          acrossRead[sh] = -1
        end
      end
    case startsWith(s, "across ") and version == 2
      if keep
        sh := self.layers[self.count - 1].sheet
        if sh >= 0 and sh < 64 and acrossRead[sh] < 0
          acrossRead[sh] = numberIn(s, 0)
        end
      end
    case startsWith(s, "size ") and kind == TILES
      w = numberIn(s, 0)
      h = numberIn(s, 1)
      if w < 1 or h < 1 or w > MOST_SIDE or h > MOST_SIDE or rows > 0
        return fails("a layer's size, not as it should be")
      end
      need.bytes += w * h * 2
      if keep
        if need.bytes > self.room.len()
          return fails("more than the room has room for")
        end
        self.layers[self.count - 1].size = {w, h}
        self.layers[self.count - 1].start = self.cells
        self.slide(self.cells * 2, w * h * 2) # (the things read so far, moved on)
        self.cells += w * h
      end
    case startsWith(s, "offset ")
      if keep
        self.layers[self.count - 1].at = {numberIn(s, 0), numberIn(s, 1)}
      end
    case startsWith(s, "thing ") and kind == THINGS
      # thing CCRR at X Y [span W H] [name NAME]: words 0 to 4, then each that's there (CCRR: its sprite's
      # column and row, 2 hex digits each, or ----; rinc map 3's, 3 digits across its sheet's rows)
      t := Thing{sprite = {-1, -1}, span = {1, 1}}
      sp := wordAt(s, wordStart(s, 1))
      if sp.len() != cellChars or wordAt(s, wordStart(s, 2)) != "at" or wordStart(s, 4) >= s.len()
        return fails("a thing's line, not as it should be")
      end
      spOk := true
      none := true
      v := 0
      for c in sp
        none = none and c == '-'
        spOk = spOk and digit(c) >= 0
        v = v * 16 + max(0, digit(c))
      end
      if not none and spOk
        if version == 4
          t.sprite = unpacked(v % 256 * 256 + v / 256) # (CCRR: the column first)
        case keep
          sh := self.layers[self.count - 1].sheet
          a := -1
          if sh >= 0 and sh < 64
            a = acrossRead[sh]
          end
          t.sprite = unpacked(oldTile(v, a))
        else
          t.sprite = {0, 0} # (as it's checked: some sprite)
        end
      end
      t.at = {numberIn(wordAt(s, wordStart(s, 3)), 0), numberIn(wordAt(s, wordStart(s, 4)), 0)}
      k := 5
      if wordAt(s, wordStart(s, k)) == "span"
        t.span = {numberIn(wordAt(s, wordStart(s, 6)), 0), numberIn(wordAt(s, wordStart(s, 7)), 0)}
        k = 8
      end
      if wordAt(s, wordStart(s, k)) == "name"
        fine := t.name.pushAll(wordAt(s, wordStart(s, k + 1)))
        k += 2
      end
      if wordStart(s, k) < s.len() or not (none or spOk) or not thingFits(t)
        return fails("a thing's line, not as it should be")
      end
      need.bytes += THING + t.name.len() + (t.name.len() > 0).toInt()
      if keep and not self.place(self.count - 1, t)
        return fails("more than the room has room for")
      end
    case kind == TILES and h > 0 # (a row: four hex digits a cell, column then row, or ----; rinc map 3's, three across its sheet's rows, or ---)
      if rows >= h or s.len() != w * cellChars
        return fails("a row too short or long, or too many")
      end
      if not keep
        for k in 0..<w
          dashes := 0
          digits := 0
          for j in 0..<cellChars
            d := hexOf[s[k * cellChars + j]]
            dashes += (d == 16).toInt()
            digits += (d < 16).toInt()
          end
          if dashes != cellChars and digits != cellChars
            return fails("a row with a cell that isn't one")
          end
        end
      end
      if keep and version == 4
        c := (self.layers[self.count - 1].start + rows * w) * 2
        for x in 0..<w # (---- : past 255 each way, so NO_TILE)
          q := x * 4
          col := hexOf[s[q]] * 16 + hexOf[s[q + 1]]
          row := hexOf[s[q + 2]] * 16 + hexOf[s[q + 3]]
          v := NO_TILE
          if col < 256 and row < 256
            v = col + row * 256
          end
          self.room.setInt(c + x * 2, 16, v)
        end
      case keep
        c := (self.layers[self.count - 1].start + rows * w) * 2
        sh := self.layers[self.count - 1].sheet
        a := -1
        if sh >= 0 and sh < 64
          a = acrossRead[sh]
        end
        for x in 0..<w # (--- is 16 * 273: past 4095, so none)
          self.room.setInt(c + x * 2, 16, oldTile(hexOf[s[x * 3]] * 256 + hexOf[s[x * 3 + 1]] * 16 + hexOf[s[x * 3 + 2]], a))
        end
      end
      rows += 1
    else
      return fails("a line it doesn't know")
    end
  end
  if ioBad
    return fails("couldn't read it all")
  end
  if kind < 0 or (kind == TILES and rows < h)
    return fails("no layer, or a layer with too few rows")
  end
  if keep
    for i in 0..<self.count
      if self.layers[i].sheet < 0
        return fails("a layer without its sheet")
      end
    end
  end
  return true
end
# what a map's file needs of an app: its room's bytes, and its sheets and layers (-1s: not a map)
roomIn* :: proc(path: String) -> Room
  scratch := Map{}
  openIo(FROM_FILE, path, false)
  if not scratch.readAs(false)
    return Room{bytes = -1, sheets = -1, layers = -1}
  end
  return need
end
# a map's file, or what's under a key of the app's stash, read into it: false if it can't be, and the
# log says why (the room it needs, say), and the map's as it was
Map.loadFrom :: proc(kind: Int, name: String) -> Bool
  self.own()
  mapFolder.clear()
  if kind == FROM_FILE
    fine := mapFolder.pushAll(folderOf(name))
  end
  openIo(kind, name, false)
  ok := self.readAs(false)
  if ok and (need.bytes > self.room.len() or need.sheets > self.sheets.len() or need.layers > self.layers.len())
    why.clear()
    _ = why.print("needs Blob[", need.bytes, "], ", need.sheets, " sheets, ", need.layers, " layers (has ", self.room.len(), ", ", self.sheets.len(), ", ",
                  self.layers.len(), ")")
    ok = false
  end
  if ok
    openIo(kind, name, true)
    ok = self.readAs(true)
  end
  if not ok
    said: Blob[..300]
    if kind == FROM_STASH
      _ = said.print("stash ")
    end
    if ioAt == 0 and ioLen == 0 and ioBad
      _ = said.print(name, ": no such file")
    else
      _ = said.print(name, ": ", why.asString())
    end
    log(said.asString())
  end
  return ok
end
Map.load* :: proc(path: String) -> Bool # (and its sheets, given pixels: readSheets)
  return self.loadFrom(FROM_FILE, path) and (self.pixels.cap() == 0 or self.readSheets())
end
Map.loadStash* :: proc(key: String) -> Bool do return self.loadFrom(FROM_STASH, key)
numText: Blob[..12]
num :: proc(n: Int) -> String
  numText.clear()
  _ = numText.print(n)
  return numText.asString()
end
# a tile, packed, as 4 hex digits: its column, then its row (---- for none)
hex4 :: proc(t: Int)
  if t == NO_TILE
    put("----")
  else
    c := t % 256
    r := t / 256
    put(hexDigits[c / 16..<c / 16 + 1])
    put(hexDigits[c % 16..<c % 16 + 1])
    put(hexDigits[r / 16..<r / 16 + 1])
    put(hexDigits[r % 16..<r % 16 + 1])
  end
end
# its text (rinc map 4), written a piece at a time
Map.writeOut :: proc()
  put("rinc map 4\n")
  for i in 0..<self.sheetCount
    s := &self.sheets[i]
    put("sheet ")
    put(num(i + 1))
    put(" ")
    put(relativeTo(writeFolder.asString(), s.path.asString())) # (from the map's folder, to a file)
    put(" ")
    put(num(s.sprite.x))
    if s.sprite.y != s.sprite.x
      put("x")
      put(num(s.sprite.y))
    end
    put("\n")
  end
  for i in 0..<self.count
    l := &self.layers[i]
    put("layer ")
    put(num(i + 1))
    put(" ")
    put(l.name.asString())
    if l.kind == TILES
      put(" tiles ")
    else
      put(" things ")
    end
    put(num(l.sheet + 1))
    if l.kind == TILES
      put("\nsize ")
      put(num(l.size.x))
      put(" ")
      put(num(l.size.y))
    end
    put("\noffset ")
    put(num(l.at.x))
    put(" ")
    put(num(l.at.y))
    put("\n")
    if l.kind == TILES
      for y in 0..<l.size.y
        c := (l.start + y * l.size.x) * 2
        for x in 0..<l.size.x # (straight into work, a cell at a time: the most of a map's text)
          if ioLen + 4 > WORK
            flushIo()
          end
          t := self.room.getInt(c + x * 2, 16)
          if t == NO_TILE
            work[ioLen] = '-'
            work[ioLen + 1] = '-'
            work[ioLen + 2] = '-'
            work[ioLen + 3] = '-'
          else
            col := t % 256
            row := t / 256
            work[ioLen] = hexDigits[col / 16]
            work[ioLen + 1] = hexDigits[col % 16]
            work[ioLen + 2] = hexDigits[row / 16]
            work[ioLen + 3] = hexDigits[row % 16]
          end
          ioLen += 4
        end
        put("\n")
      end
    else
      for j in 0..<l.count
        t := self.thing(i, j)
        put("thing ")
        hex4(packed(t.sprite))
        put(" at ")
        put(num(t.at.x))
        put(" ")
        put(num(t.at.y))
        if t.span != {1, 1}
          put(" span ")
          put(num(t.span.x))
          put(" ")
          put(num(t.span.y))
        end
        if t.name.len() > 0
          put(" name ")
          put(t.name.asString())
        end
        put("\n")
      end
    end
  end
  flushIo()
end
# its file written (made, or written over): false if it couldn't be
Map.save* :: proc(path: String) -> Bool
  writeFolder.clear()
  fine := writeFolder.pushAll(folderOf(path))
  openIo(FROM_FILE, path, false)
  self.writeOut()
  return not ioBad
end
# kept under a key of the app's stash: false if it couldn't be
Map.saveStash* :: proc(key: String) -> Bool
  writeFolder.clear() # (whole paths, in a stash)
  openIo(FROM_STASH, key, false)
  self.writeOut()
  return not ioBad
end
